<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-mcp</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>

    <properties>
        <!--
          R385 — the docs root the build-time docs-index generator reads. A declared property, not a
          buried `../../docs` literal, because Option A (chunk + embed inside graphitron-mcp) reaches
          across the reactor's directory boundary into the sibling /docs tree: the dependency graph
          does not encode "the index depends on /docs content", so the cross-directory read is made
          explicit here and the content-hash stamp tracks recompute. graphitron-mcp lives at
          the repo root alongside the /docs tree, so the /docs tree is one level up.
        -->
        <docs.source.dir>${project.basedir}/../docs</docs.source.dir>
    </properties>

    <!--
      The MCP server embedded in the `graphitron:dev` JVM. Hosts the MCP Java SDK's servlet-based
      Streamable HTTP transport in embedded Jetty 12 (loopback only). This module is the
      dependency-quarantine seam for the live-data discovery tools (R118): heavy native deps
      land here, not on graphitron-maven-plugin's own compile surface.

      Published like graphitron-lsp (a Maven plugin resolves its declared dependencies from the
      consumer's repositories at execution time), so this module must NOT carry
      <maven.deploy.skip>.

      The reactor edges are an allowlist, and the guard test in this module's own test sources
      asserts exactly this set: graphitron-model at compile scope, graphitron and
      graphitron-sakila-db at test scope, nothing else from the reactor in any scope. Every tool
      answers from the fact store and from the handle plus reader its host passes in, so the store's
      schema and jOOQ are the whole of what it compiles against. A new reactor edge has to be argued
      for at the guard rather than noticed later, and a compile edge on graphitron is the case the
      rule exists for: while it is there, every generator projection is one import away and each one
      has to be argued down on its own merits.

      Test scope carries graphitron because the fixture drives the real pipeline to produce a
      capture, and graphitron-sakila-db because that pipeline resolves a jOOQ catalog. Naming both
      rather than exempting test scope wholesale keeps the fixture a named affordance instead of a
      hole.
    -->

    <dependencies>
        <!--
          The fact store's generated query surface and its read vocabulary, plus the jOOQ runtime
          those generated classes are written against. Both are reached transitively today and are
          declared here because they are the module's whole compile surface onto a graph's facts: a
          transitive edge would leave the pom silent about the one thing the guard asserts.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>

        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
        </dependency>

        <!--
          R372 RAG foundation. The bge ONNX embedder (langchain4j, model bundled in-jar) and the
          Lucene HNSW vector store land here, on graphitron-mcp alone: this is the dependency
          quarantine R341 created the module to hold. The heavy native footprint (ONNX Runtime JNI,
          pulled transitively by the bge module) never reaches graphitron-maven-plugin's compile
          surface. Licensing is permissive throughout (Lucene / langchain4j Apache 2.0; ONNX Runtime
          / bge MIT), safe to redistribute.
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-bge-small-en-v15-q</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          The integration tests drive the live server with the SDK's own HttpClient-based
          Streamable HTTP client transport (HttpClientStreamableHttpTransport, McpClient),
          which ships in the core `mcp` artifact pulled above; no extra coordinate needed.
        -->
        <!--
          Test-only, and the pair is one affordance: the store-backed fixture drives the real build
          pipeline (GraphQLRewriteGenerator.buildOutput) to produce the capture every store-backed
          case reads, and that pipeline resolves a jOOQ catalog from the sakila generated package.
          Rows a test asserts on have to come from a real pipeline run, so the generator is a test
          dependency rather than a projection handed to a tool. Mirrors the catalog dependency
          graphitron-lsp carries for its pipeline tests.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-sakila-db</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          The two test-jars carrying the shared fact-store harness: the store's own lifetime from
          the model, and the capture and writer levels from the generator. Both are second scopes on
          edges this module already declares, so neither adds a module dependency; what they buy is
          that a test here takes its store from the harness that owns its subject rather than
          standing one up of its own.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              R372 — the infrastructure-tier test loads the bge ONNX model through the ONNX Runtime
              JNI binding. Grant native access to the unnamed module so that load runs without the
              JDK escalating its native-access warning (the analogue of the tree-sitter note R361
              flagged for the lsp edge). This is the module's only surefire config: it sets no
              excludedGroups, so nothing turns off the `slow` group the ONNX test carries; CI's
              default `mvn verify -Plocal-db` runs everything. The `-DexcludedGroups=slow` opt-out is
              a developer inner-loop affordance supplied on the command line, never a build default.

              @{argLine} leads so the JaCoCo agent flags the coverage profile writes into the
              argLine property survive this override; without it -Pcoverage reports a false 0%.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!--
              R385 — the build-time docs-index generator. Chunks and embeds the public manual under
              <docs.source.dir> into a pre-embedded bundle written to ${project.build.outputDirectory},
              so it is packaged in the jar and async-loaded at server warm. Bound to process-classes
              (after this module's own classes compile, before package) so it runs against the freshly
              compiled BgeEmbedder + AdocChunker. The ONNX embed cost is gated by a content-hash stamp
              the generator writes beside the bundle: an unchanged manual skips the re-embed, so a plain
              `mvn install` inner loop does not pay it twice.

              Forked, not in-process (exec:exec rather than exec:java), because the embed loads a
              native library the JVM binds to one class loader for its lifetime: langchain4j's
              tokenizer does System.load on a fixed cached path, and exec:java builds a fresh class
              loader per execution inside the Maven JVM. In a reused JVM (an mvnd daemon, which the
              docs recommend) the second stale-stamp build therefore failed the whole build with
              "libtokenizers.so already loaded in another classloader" - editing any manual page and
              rebuilding was enough to hit it. A fork gets a JVM whose class loader has not loaded
              the library, so the step is idempotent across builds; it also owns its own flags, so
              the native-access grant is declared on the fork's command line rather than inherited
              from a surefire argLine that never applied to this execution.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-docs-index</id>
                        <phase>process-classes</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>no.sikt.graphitron.mcp.rag.docs.DocsIndexBuilder</argument>
                                <argument>${docs.source.dir}</argument>
                                <argument>${project.build.outputDirectory}/mcp/docs-index</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
