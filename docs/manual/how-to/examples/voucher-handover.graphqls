# Rendered by ManualExampleTest from voucher-handover.graphql. Do not edit.

# tag::IssuingHandover[]
"Subgraph A: an application's results, each vouched for to subgraph B. `id` and `eierId` are absorbed into the voucher under B's names and types, `eierId` being vouched for, and A publishes VgsResultat with the voucher alone."
type Query {
  applications: [Application!]!
}

type Application @table(name: "vouched_application") {
  results: [VgsResultat!]!
      @reference(path: [{key : "vouched_application_result_application_id_fkey"}])
}

type VgsResultat @table(name: "vouched_application_result") {
  id: ID! @field(name: "result_id")
  eierId: String! @field(name: "owner_id")
  voucher: String! @issue(scope: "vgs-resultater", ttl: "PT5M", vouchesFor: "eierId")
}
# end::IssuingHandover[]

# tag::AcceptingEntity[]
"Subgraph B: the results themselves, resolved by their own key and by the voucher A signs, the details read in the same SELECT on the connection your source leases for the vouched-for owner."
type Query {
  results: [VgsResultat!]!
}

type VgsResultat @table(name: "vouched_result") @key(fields: "id") {
  id: ID! @field(name: "result_id")
  eierId: String! @field(name: "owner_id") @inaccessible
  grade: Int!
  details: [Detail!]! @reference(path: [{key : "vouched_result_detail_result_id_fkey"}])
  voucher: String! @accept(scope: "vgs-resultater", vouchesFor: "eierId")
}

type Detail @table(name: "vouched_result_detail") {
  subject: String!
}
# end::AcceptingEntity[]
