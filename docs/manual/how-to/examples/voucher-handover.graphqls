# Rendered by ManualExampleTest from voucher-handover.graphql. Do not edit.

# tag::IssuingHandover[]
"Subgraph A: an application's results, each vouched for to subgraph B. `id` and `eierId` are absorbed into the voucher under B's names and types, `eierId` being vouched for, and A publishes VgsResultat with the voucher alone."
type Query {
  applications: [Application!]!
}

type Application @table(name: "vouched_application") {
  results: [VgsResultat!]!
      @reference(path: [{key : "vouched_application_result_application_id_fkey"}])
}

type VgsResultat
    @table(name: "vouched_application_result")
    @issue(scope: "vgs-resultater", ttl: "PT5M", vouchesFor: "eierId") {
  id: ID! @field(name: "result_id")
  eierId: String! @field(name: "owner_id")
}
# end::IssuingHandover[]

# tag::AcceptingEntity[]
"Subgraph B: the results themselves, resolved by their own key and by the voucher A signs, the details read in the same SELECT on the connection your source leases for the vouched-for owner."
type Query {
  results: [VgsResultat!]!
}

type VgsResultat
    @table(name: "vouched_result")
    @key(fields: "id")
    @accept(scope: "vgs-resultater", vouchesFor: "eierId") {
  id: ID! @field(name: "result_id")
  eierId: String! @field(name: "owner_id") @inaccessible
  grade: Int!
  details: [Detail!]! @reference(path: [{key : "vouched_result_detail_result_id_fkey"}])
}

type Detail @table(name: "vouched_result_detail") {
  subject: String!
}
# end::AcceptingEntity[]

# tag::PerEntityIssuing[]
"Subgraph A, vouching for each case by its own id: a case cannot issue itself, since a root field returns it, so the voucher sits on its event log, the same row read again by joining the case to itself over its primary key. Every absorbed field is vouched for, so the voucher's lookup section is empty."
type Query {
  cases: [Case!]!
}

type Case @table(name: "vouched_case") {
  title: String!
  eventLog: CaseEventLog @reference(path: [{key : "vouched_case_pkey"}])
}

type CaseEventLog
    @table(name: "vouched_case")
    @issue(scope: "case-events", ttl: "PT5M", vouchesFor: "caseId") {
  caseId: Int! @field(name: "case_id")
}
# end::PerEntityIssuing[]

# tag::PerEntityAccepting[]
"Subgraph B, vouching for its own key: a case's event log is vouched for by the case's id, which is also the key the voucher decodes to, so the voucher's lookup section is empty and every row of a list presents a vouched-for value of its own. The events are read on the connection your source leases for the set of case ids the operation admitted."
type Query {
  caseEventLogs: [CaseEventLog!]!
}

type CaseEventLog
    @table(name: "vouched_case")
    @key(fields: "caseId")
    @accept(scope: "case-events", vouchesFor: "caseId") {
  caseId: Int! @field(name: "case_id") @inaccessible
  events: [CaseEvent!]! @reference(path: [{key : "vouched_case_event_case_id_fkey"}])
}

type CaseEvent @table(name: "vouched_case_event") {
  what: String!
}
# end::PerEntityAccepting[]
