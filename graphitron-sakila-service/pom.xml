<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-sakila-service</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-sakila-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>
        <!--
            Compile scope for one fixture: FilmLookupClientFacingException implements
            graphql.GraphQLError alongside Throwable, which is the both-shapes source an
            @error handler carrying description: can name. Nothing else in this module
            touches graphql-java.
        -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
        </dependency>
        <!--
            Provided scope for the constraint annotations on the classes a VALIDATION-channel
            @service method takes (FilmDraft, FilmBundleDraft and their members). The example
            module supplies the API and a validation provider at runtime.
        -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
                <executions>
                    <!-- The corpus compiles with -parameters, as a consumer's own code usually does.
                         The nameless package is the exception: a library compiled without it, whose
                         classfiles carry no parameter names. It is excluded from the default compile
                         and compiled in a pass of its own with -parameters off.
                         The default compile still reads it: a {@link} into it is resolved against the
                         source, and javac would compile what it resolves with -parameters on, writing
                         a classfile the nameless pass then judges up to date on an incremental build.
                         -implicit:none keeps the read and drops the write. -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>-implicit:none</arg>
                            </compilerArgs>
                            <excludes>
                                <exclude>no/sikt/graphitron/rewrite/test/nameless/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-nameless</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <parameters>false</parameters>
                            <includes>
                                <include>no/sikt/graphitron/rewrite/test/nameless/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Classpath fixtures: code a test reads as a classpath other than the corpus,
                         so it never joins the corpus's own output. src/fixture/library is a small
                         library declaring a class under a corpus class's name with other contents,
                         compiled twice, with -parameters and without, which is the one difference
                         between the two roots. Each compiles into a directory of its own and the
                         package-classes execution below carries it in this module's output as one
                         jar resource, which a classpath walk skips: the corpus is every classfile
                         under the output, and a fixture's classfiles are not the corpus's. The
                         fixture harness in graphitron-model's tests reads the resource and arranges
                         the roots. -->
                    <execution>
                        <id>compile-library-named</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <parameters>true</parameters>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/fixture/library/java</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/fixture-classes/library-named</outputDirectory>
                            <generatedSourcesDirectory>${project.build.directory}/generated-sources/fixture-library-named</generatedSourcesDirectory>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-library-nameless</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <parameters>false</parameters>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/fixture/library/java</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/fixture-classes/library-nameless</outputDirectory>
                            <generatedSourcesDirectory>${project.build.directory}/generated-sources/fixture-library-nameless</generatedSourcesDirectory>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>package-classpath-fixtures</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <jar destfile="${project.build.outputDirectory}/classpath-fixtures/library-named.jar"
                                     basedir="${project.build.directory}/fixture-classes/library-named"/>
                                <jar destfile="${project.build.outputDirectory}/classpath-fixtures/library-nameless.jar"
                                     basedir="${project.build.directory}/fixture-classes/library-nameless"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
