<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-sakila-service</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-sakila-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>
        <!--
            Compile scope for one fixture: FilmLookupClientFacingException implements
            graphql.GraphQLError alongside Throwable, which is the both-shapes source an
            @error handler carrying description: can name. Nothing else in this module
            touches graphql-java.
        -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
                <executions>
                    <!-- The corpus compiles with -parameters, as a consumer's own code usually does.
                         The nameless package is the exception: a library compiled without it, whose
                         classfiles carry no parameter names. It is excluded from the default compile
                         and compiled in a pass of its own with -parameters off. Self-contained, so no
                         other class in this module references it at compile time. -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <excludes>
                                <exclude>no/sikt/graphitron/rewrite/test/nameless/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-nameless</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <parameters>false</parameters>
                            <includes>
                                <include>no/sikt/graphitron/rewrite/test/nameless/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
