type Film @table(name: "film") @classifiedType(as: TableType) {
  title: String @classified(source: Child, operations: [Select], target: Single, targetShape: Column)
}

extend type Query {
  "A carrier whose author declared first themselves. The mint stands down on that name and appends only after, so the declaration survives as written."
  pagedFilms(first: Int): [Film!]! @asConnection @defaultOrder(primaryKey: true)
    @classified(source: Query, operations: [OrderBy, Paginate, Select], target: Single, targetShape: Connection)

}

{
  pagedFilms(first: 2) {
    edges { node { title } }
  }
}
