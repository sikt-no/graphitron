type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }
type Film @table(name: "film") { filmId: Int! @field(name: "film_id") }
type FilmActor @table(name: "film_actor") {
  actors(actor_id: [Int!]! @lookupKey): [Actor!]!
    @classified(source: OnlyChild, operations: [Join, Lookup, OrderBy, Select], target: List, targetShape: Table)
}
extend type Query {
  filmActor: FilmActor
  "Films fetched by a caller-supplied list of ids, one row back per id."
  filmById(film_id: [ID] @lookupKey): [Film]!
    @classified(source: Query, operations: [Lookup, OrderBy, Select], target: List, targetShape: Table)

}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  Actor,        firstName,  TABLE_COLUMN, INFERRED
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Film,         filmId,     TABLE_COLUMN, INFERRED
  Query,        filmById,   LOOKUP_KEY,   AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name, classifier, trigger,   decoded
  Query,     filmById,   LOOKUP_KEY, lookupKey, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  Actor,        actor
  CorpusAnchor, category
  Film,         film
  FilmActor,    film_actor
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  Query,     filmActor,    AnchorTable, SingleRecord
  Query,     filmById,     KeyedLookup, RecordList
  """)

{
  filmById(film_id: ["1", "2"]) {
    filmId
  }
  filmActor {
    actors(actor_id: [1]) {
      firstName
    }
  }
}
