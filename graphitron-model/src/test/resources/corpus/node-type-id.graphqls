# Composing is the only opt-in, and it needs no federation @link: the document declares the
# directive the way a schema that does not link federation has to, and applies it.
directive @composeDirective(name: String!) repeatable on SCHEMA

extend schema @composeDirective(name: "@nodeType")

type Film implements Node @table(name: "film") @node(typeId: "F") @classifiedType(as: NodeType) {
  "The id the author pinned, which is the one @nodeType publishes."
  id: ID! @nodeId
}
type FilmActor implements Node @table(name: "film_actor") @node @classifiedType(as: NodeType) {
  "No id written: the id is the one the table's generated class states."
  id: ID! @nodeId
}
type Customer implements Node @table(name: "customer") @node @classifiedType(as: NodeType) {
  "No id written and none published: the type's own name answers."
  id: ID! @nodeId
}
extend type Query {
  film: Film
  filmActor: FilmActor
  customer: Customer
}

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Customer,     customer
  Film,         film
  FilmActor,    film_actor
  """)
