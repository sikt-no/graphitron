interface MediaItem @table(name: "film") @discriminate(on: "text_rating") @classifiedType(as: TableInterfaceType) { title: String }
type Film implements MediaItem @table(name: "film") @discriminator(value: "film") { title: String }
type Inventory @table(name: "inventory") {
  "The same interface at single cardinality."
  media: MediaItem @classified(source: OnlyChild, operations: [Join, Select], target: Single, targetShape: Table)
}
type Language @table(name: "language") {
  "Discriminated participants, read from one table."
  mediaList: [MediaItem!]! @reference(path: [{key: "film_language_id_fkey"}])
    @classified(source: OnlyChild, operations: [Join, OrderBy, Select], target: List, targetShape: Table)

  "The batched half paginated: the same launcher row with the windowed per-parent page tail, which is what makes the delivery pin a gate at connection cardinality."
  mediaConnection: [MediaItem!]! @asConnection @reference(path: [{key: "film_language_id_fkey"}])
    @classified(source: OnlyChild, operations: [Join, OrderBy, Paginate, Select], target: Single, targetShape: Connection)

}
extend type Query {
  inventory: Inventory
  language: Language
  "The discriminated root: one base table, discriminated, so the target shape is Table rather than Interface."
  topMedia: MediaItem @classified(source: Query, operations: [Select], target: Single, targetShape: Table)

}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Film,         title,      TABLE_COLUMN, INFERRED
  MediaItem,    title,      TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  Inventory,    inventory
  Language,     language
  MediaItem,    film
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,      source,                       result
  Language,  mediaConnection, DiscriminatedCorrelatedChain, Connection
  Language,  mediaList,       DiscriminatedCorrelatedChain, RecordList
  Query,     corpusAnchor,    AnchorTable,                  SingleRecord
  Query,     inventory,       AnchorTable,                  SingleRecord
  Query,     language,        AnchorTable,                  SingleRecord
  Query,     topMedia,        DiscriminatedTable,           SingleRecord
  """)

{
  language {
    mediaList { title }
  }
  inventory {
    media { title }
  }
}
