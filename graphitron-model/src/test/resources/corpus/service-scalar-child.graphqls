type Language @table(name: "language") @classifiedType(as: TableType) {
  name: String
  "A scalar a service produces; no SQL of its own."
  rank: Int @service(
    service: {className: "no.sikt.graphitron.rewrite.generators.TestFilmService", method: "getRankMapped"})

}
extend type Query { language: Language }

{
  language {
    name
    rank
  }
}
