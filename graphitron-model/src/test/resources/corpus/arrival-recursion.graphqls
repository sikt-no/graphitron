type Staff @table(name: "staff") {
  "Half of the store to staff FK cycle. A reachable cycle implies a second reaching edge, so both ends fold to Many."
  store: Store @reference(path: [{key: "staff_store_id_fkey"}])
    @classified(source: Child, operations: [Join, Select], target: Single, targetShape: Table)
}
"Reached by the root and by Staff.store, so the multi-edge rule folds it to Many without a fixed point."
type Store @table(name: "store") {
  "Child for the same reason its own reacher is: the cycle leaves no field on either type at One."
  manager: Staff @reference(path: [{key: "store_manager_staff_id_fkey"}])
    @classified(source: Child, operations: [Join, Select], target: Single, targetShape: Table)
}
extend type Query {
  store: Store @classified(source: Query, operations: [Select], target: Single, targetShape: Table)

}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Staff,        staff
  Store,        store
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  Query,     store,        AnchorTable, SingleRecord
  """)
