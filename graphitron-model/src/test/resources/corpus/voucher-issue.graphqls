"A film below its language vouches for itself to another subgraph: its other fields are absorbed into the voucher, and the voucher is signed over them after the row is read."
type FilmVoucher @table(name: "film") {
  filmId: ID! @field(name: "film_id")
  title: String!
  "The voucher, one per row, signed over the film's id and title."
  voucher: String! @issue(scope: "films", ttl: "PT5M", claims: "title")
    @classified(source: Child, operations: [Select], target: Single, targetShape: Column)
}
type CorpusVoucherLanguage @table(name: "language") {
  films: [FilmVoucher!]! @reference(path: [{key: "film_language_id_fkey"}])
}
extend type Query { voucherLanguage: CorpusVoucherLanguage }
