type Film implements Node @table(name: "film") @node(keyColumns: ["film_id"])
    @classifiedType(as: NodeType) {
  "The Relay global id, encoded from the node key columns."
  id: ID! @nodeId
}
extend type Query { film: Film }

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

{
  film {
    id
  }
}
