type Film @table(name: "film") { title: String }
type Language @table(name: "language") {
  name: String
  "Films for this language, produced by a service and re-queried as table rows."
  filmsViaService: [Film!]! @service(
    service: {className: "no.sikt.graphitron.rewrite.generators.TestFilmService", method: "getFilmsMapped"})
    @classified(source: OnlyChild, operations: [Reentry, ServiceCall], target: List, targetShape: Table)

}
extend type Query { language: Language }

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,      classifier,   tier
  CorpusAnchor, name,            TABLE_COLUMN, INFERRED
  Film,         title,           TABLE_COLUMN, INFERRED
  Language,     filmsViaService, SERVICE,      AUTHORED
  Language,     name,            TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,      classifier, trigger, decoded
  Language,  filmsViaService, SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  Language,     language
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,      source,           result
  Language,  filmsViaService, ServiceTableLift, LoaderDelegated
  Query,     corpusAnchor,    AnchorTable,      SingleRecord
  Query,     language,        AnchorTable,      SingleRecord
  """)

{
  language {
    name
    filmsViaService { title }
  }
}
