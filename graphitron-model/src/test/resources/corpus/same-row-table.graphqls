type CitySummary @table(name: "city") @classifiedType(as: TableType) {
  name: String @field(name: "city") @classified(source: Child, operations: [Select], target: Single, targetShape: Column)
}

type City @table(name: "city") @classifiedType(as: TableType) {
  "Bound to the parent's own table, over the table's own primary key: each row joined to itself, so the parent's own row, read as a table type."
  summary: CitySummary @reference(path: [{key: "city_pkey"}]) @classified(source: OnlyChild, operations: [Join, Select], target: Single, targetShape: Table)
}

extend type Query {
  city: City @classified(source: Query, operations: [Select], target: Single, targetShape: Table)
  citySummaries: [CitySummary!]! @classified(source: Query, operations: [OrderBy, Select], target: List, targetShape: Table)
}
