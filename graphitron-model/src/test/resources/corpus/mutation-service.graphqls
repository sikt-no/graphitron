type Film @table(name: "film") { title: String }
type FilmDetails { title: String }
type Mutation {
  "A @table return: the service's rows are re-queried through the catalog."
  importFilm: Film
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "runFilm"})
    @classified(source: Mutation, operations: [Reentry, ServiceCall], target: Single, targetShape: Table)

  "A non-table return: what the service produced is the answer."
  summariseFilm: FilmDetails
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "runDetails"})
    @classified(source: Mutation, operations: [ServiceCall], target: Single, targetShape: Record)
}

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,           result
  Mutation,  importFilm,   ProjectedReentry, SingleRecord
  Query,     corpusAnchor, AnchorTable,      SingleRecord
  """)

mutation {
  importFilm { title }
  summariseFilm { title }
}
