# A graph's federation opt-in read in steps, over one file. The first reading finds two links, one
# of them federation's, so the graph is federated by its author and imports what that link imports,
# in the order written and with the alias an object element binds. Only the federation link is
# decoded as one, the other naming another specification.

extend type Query { film: String }

extend schema @link(url: "https://specs.apollo.dev/link/v1.0")
extend schema @link(url: "https://specs.apollo.dev/federation/v2.10",
  import: ["@key", {name: "@shareable", as: "@federatedShareable"}])

extend schema @expectEquals(relation: "graphitron_ast_federation_link_entry", rows: """
  version, touched_at
  v2.10,   1000000000
  """)

extend schema @expectEquals(relation: "graphitron_federation_link", rows: """
  origin,   version, touched_at
  AUTHORED, v2.10,   1000000000
  """)

extend schema @expectEquals(relation: "graphitron_federation_link_import", rows: """
  ordinal, name,       alias,                touched_at
  0,       @key,       ,                     1000000000
  1,       @shareable, @federatedShareable,  1000000000
  """)
