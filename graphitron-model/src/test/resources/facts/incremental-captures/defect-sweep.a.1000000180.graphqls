# The fourth reading names divergingArrivals at the same element, whose declarations take staff
# to address no better, so the defect stays at the same position under the same code. What it names
# changes: the two divergingArrivals declarations are marked with this reading, and no pairOnly
# row stays under it.

type Film @table(name: "film") {
  title: String
  language: Language @reference(path: [{key: "film_language_id_fkey"}])
}
type Language @table(name: "language") { name: String }
type Address @table(name: "address") { addressId: Int @field(name: "address_id") }
type Staff @table(name: "staff") {
  staffId: Int @field(name: "staff_id")
  address: Address @reference(path: [{table: "address", condition: {
    className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
    method: "divergingArrivals"
  }}])
}
type Customer @table(name: "customer") {
  customerId: Int @field(name: "customer_id")
  address: Address @reference(path: [{condition: {
    className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
    method: "ambiguousPair"
  }}])
}

extend type Query { films: [Film!]! staffs: [Staff!]! customers: [Customer!]! }

extend schema @expectEquals(relation: "graphitron_entry_defect", where: """
  code = 'CONDITION_NO_OVERLOAD_FOR_PAIR'
  """, rows: """
  code,                           touched_at
  CONDITION_NO_OVERLOAD_FOR_PAIR, 1000000180
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_method", where: """
  code = 'CONDITION_NO_OVERLOAD_FOR_PAIR'
  """, rows: """
  method_name,       touched_at
  divergingArrivals, 1000000180
  divergingArrivals, 1000000180
  """)
