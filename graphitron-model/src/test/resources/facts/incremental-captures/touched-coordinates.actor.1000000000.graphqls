# The file the second reading leaves alone. Its coordinates are touched once, by the first reading,
# and never again. It holds one of each kind of anchor, so the second reading can show each keeps it.

type Actor implements Named {
  id: ID
  name: String
  films(first: Int): [String] @shelved
}

interface Named {
  id: ID
}

enum Rating {
  G
  PG
}

union Cast = Actor

directive @shelved(at: Int) on FIELD_DEFINITION

extend type Query { actors: [Actor] }

extend schema @assertContains(relation: "graphql_ast_touched_coordinate", rows: """
  coordinate
  Actor
  Actor.name
  Query.actors
  """)
