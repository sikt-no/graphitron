# The second reading, of the same build file with four elements taken out: the tenant column, the
# maximum page size, the unmount beside the mount, and one lint rule. Each is a different way of
# going away, and none of them produces an incoming row for an upsert to land on, so only the sweep
# removes them.
#
# A single-valued parameter that went away is a graph with no row, the state a graph that never had
# one is in. The unmount goes and the mount stays, which is the supported mount-only configuration.
# The rule still declared is a value-keyed row the reading wrote again.

extend schema @withConfiguration(
  lintDisabledRules: ["field-names-camel-case"],
  mount: "com.example.Identity#mount"
)

extend schema @assertEmpty(relation: "store_graph_tenant_column")

extend schema @assertEmpty(relation: "store_graph_max_allowed_page_size")

extend schema @assertEmpty(relation: "store_graph_session_unmount")

extend schema @expectEquals(relation: "store_graph_session_mount", rows: """
  mount_method,               touched_at
  com.example.Identity#mount, 1000000060
  """)

extend schema @expectEquals(relation: "store_graph_lint_disabled_rule", rows: """
  rule_id,                touched_at
  field-names-camel-case, 1000000060
  """)
