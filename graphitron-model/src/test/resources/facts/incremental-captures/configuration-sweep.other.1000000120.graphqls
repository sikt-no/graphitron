# The third reading changes another file and not the configuration. An unchanged configuration
# transcribes to the same rows however often it is read, and every one of them carries the reading
# that just ran: a sweep predicate wrong on a second pass shows here, as rows deleted, duplicated or
# left with the older mark.

type Unrelated { note: String }

extend schema @expectEquals(relation: "store_graph_session_supplied", rows: """
  graph_name, touched_at
  fixture,    1000000120
  """)

extend schema @expectEquals(relation: "store_graph_lint_disabled_rule", rows: """
  rule_id,                touched_at
  field-names-camel-case, 1000000120
  """)
