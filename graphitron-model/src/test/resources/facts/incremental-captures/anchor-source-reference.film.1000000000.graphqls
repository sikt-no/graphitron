# An anchor references the entries it was read from. The first reading points each field at the
# position of its own definition and of the declaration it sits in.

type Film {
  title: String
}

extend type Query { films: [Film] }

extend schema @expectEquals(relation: "graphql_field", where: "type_name = 'Film'", rows: """
  field_name, declaration_line, source_line, site_line_ref, declaration_line_ref
  title,      4,                5,           5,             4
  """)
