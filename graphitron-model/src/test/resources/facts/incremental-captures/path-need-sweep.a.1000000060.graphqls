# The second reading no longer declares Customer.address, so its occurrence goes and its need with
# it; the needs still found are marked again.

type Address @table(name: "address") { addressId: Int @field(name: "address_id") }

type Customer @table(name: "customer") {
  firstName: String @field(name: "first_name")
}

extend type Query { customers(first: Int): [Customer!]! }

extend schema @expectEquals(relation: "graphitron_path_need", where: """
  coordinate LIKE 'Customer.%' OR coordinate LIKE 'Query.customers%'
  """, rows: """
  coordinate,               target_type, start_table, landing_table, touched_at
  Customer.firstName,       String,      customer,    customer,      1000000060
  Query.customers(first:),  Customer,    customer,    customer,      1000000060
  """)

extend schema @assertEmpty(relation: "graphitron_path_need", where: """
  coordinate = 'Customer.address'
  """)
