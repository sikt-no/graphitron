# A second reading that writes only this file, leaving the redeclarations' bytes as they were:
# nothing about it changes which declaration holds the name. The redeclaring file's entries keep the
# first reading's mark, and so do the specification's, its bundled bytes being stamped and unmoved;
# and so does the anchor, this file naming no directive for the reading to re-derive.

extend schema @assertAbsent(relation: "graphql_directive", rows: """
  directive_name, source_name
  oneOf,          specification.graphqls
  deprecated,     specification.graphqls
  include,        specification.graphqls
  """)

# The instant is the entry supertype's: every oneOf declaration, the redeclaring file's and the
# specification's, keeps the first reading's.
extend schema @assertContains(relation: "graphql_ast_entry", where: """
  (graph_name, source_name, source_line, source_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_directive_definition_entry WHERE name = 'oneOf')
  """, rows: """
  source_name,            touched_at
  specification.graphqls, 1000000000
  """)

extend schema @assertAbsent(relation: "graphql_ast_entry", where: """
  (graph_name, source_name, source_line, source_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_directive_definition_entry WHERE name = 'oneOf')
  """, rows: """
  touched_at
  1000000060
  """)

extend schema @assertContains(relation: "graphql_directive", rows: """
  directive_name, touched_at
  oneOf,          1000000000
  """)
