# A local name handed from one federation definition to another between two readings, the second
# naming a definition the first reading's version does not have. The first reading links federation
# v2.0 and imports @key as @k.

extend type Query { film: String }

extend schema @link(url: "https://specs.apollo.dev/federation/v2.0",
  import: [{name: "@key", as: "@k"}])

extend schema @expectEquals(relation: "graphitron_federation_definition", where: """
  name IN ('@key', '@composeDirective')
  """, rows: """
  name, local_name, touched_at
  @key, @k,         1000000000
  """)
