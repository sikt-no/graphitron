# An argument's @reference path walked from where its field lands, the table its field's named type
# binds for a root field, and through a connection from its element type's table. The walk is the
# field site's: the same path at both sites takes the same steps. Two arguments of one field are two
# walks. A bare condition is a step its method's overload for the pair takes, composing after a key
# step; beside a key the key is the step and a condition no overload of which takes the pair is a
# defect. A wildcard arrival moves nowhere, a table two keys reach is ambiguous, and a first element
# naming no key is unresolved, each a stop. A root field's refused @reference and a field whose type
# binds nothing give their arguments nowhere to start.

type Film @table(name: "film") {
  title: String
  actors: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
}

type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }
type Customer @table(name: "customer") { customerId: Int @field(name: "customer_id") }
type Report { text: String }

extend type Query {
  films(
    inActor: String @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
    viaJunction: String @reference(path: [{key: "film_actor_film_id_fkey"}])
    titled: String @reference(path: [{table: "film_translation"}])
    inLanguage: String @reference(path: [{table: "language"}])
    unresolved: String @reference(path: [{key: "no_such_fkey"}, {key: "film_actor_actor_id_fkey"}])
    byCondition: String @reference(path: [{condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
      method: "filmToFilmActor"}}])
    keyThenCondition: String @reference(path: [{key: "film_actor_film_id_fkey"}, {condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
      method: "filmActorJunctionToActor"}}])
    conditionBesideKey: String @reference(path: [{key: "film_actor_film_id_fkey", condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
      method: "customerToAddress"}}])
  ): [Film!]!
  pagedFilms(inActor: String @reference(path: [{key: "film_actor_film_id_fkey"}])): [Film!]! @asConnection
  # The same element on the root field itself departs from Query, which binds nothing.
  rootPath(inActor: String @reference(path: [{key: "film_actor_film_id_fkey"}])): [Film!]!
    @reference(path: [{key: "film_actor_film_id_fkey"}])
  report(inActor: String @reference(path: [{key: "film_actor_film_id_fkey"}])): Report
  customers(
    anyTable: String @reference(path: [{condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
      method: "customerToAnyTable"}}])
    diverging: String @reference(path: [{condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
      method: "divergingArrivals"}}])
    perDeparture: String @reference(path: [{condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
      method: "agreeingOnArrival"}}])
  ): [Customer!]!
}

extend schema @expectEquals(relation: "graphitron_join_path_step", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, element_place, from_table, to_table
  Query.customers(diverging:), Customer, 0, 0, customer, address
  Query.customers(perDeparture:), Customer, 0, 0, customer, address
  Query.films(byCondition:), Film, 0, 0, film, film_actor
  Query.films(conditionBesideKey:), Film, 0, 0, film, film_actor
  Query.films(inActor:), Film, 0, 0, film, film_actor
  Query.films(inActor:), Film, 1, 1, film_actor, actor
  Query.films(keyThenCondition:), Film, 0, 0, film, film_actor
  Query.films(keyThenCondition:), Film, 1, 1, film_actor, actor
  Query.films(titled:), Film, 0, 0, film, film_translation
  Query.films(viaJunction:), Film, 0, 0, film, film_actor
  Query.pagedFilms(inActor:), Film, 0, 0, film, film_actor
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_key", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, constraint_name
  Query.films(conditionBesideKey:), Film, 0, film_actor_film_id_fkey
  Query.films(inActor:), Film, 0, film_actor_film_id_fkey
  Query.films(inActor:), Film, 1, film_actor_actor_id_fkey
  Query.films(keyThenCondition:), Film, 0, film_actor_film_id_fkey
  Query.films(viaJunction:), Film, 0, film_actor_film_id_fkey
  Query.pagedFilms(inActor:), Film, 0, film_actor_film_id_fkey
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_method", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, method_name
  Query.customers(diverging:), Customer, 0, divergingArrivals
  Query.customers(perDeparture:), Customer, 0, agreeingOnArrival
  Query.films(byCondition:), Film, 0, filmToFilmActor
  Query.films(keyThenCondition:), Film, 1, filmActorJunctionToActor
  """)

extend schema @expectEquals(relation: "graphitron_join_path_stop", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, element_place, moves
  Query.customers(anyTable:), Customer, 0, 0, 0
  Query.films(inLanguage:), Film, 0, 0, 2
  Query.films(unresolved:), Film, 0, 0, 0
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "coordinate LIKE 'Query.%'", rows: """
  code, coordinate
  CONDITION_NO_OVERLOAD_FOR_PAIR, Query.films(conditionBesideKey:)
  ELEMENT_UNRESOLVED, Query.films(unresolved:)
  FIELD_WITHOUT_FETCHER, Query.report
  NO_ROUTE_FROM_DEPARTURE, Query.customers(anyTable:)
  ROOT_REFERENCE_WITHOUT_ROUTINE, Query.rootPath
  ROUTE_AMBIGUOUS, Query.films(inLanguage:)
  """)


# The field site, where Film.actors writes inActor's path and its join path agrees with it step for
# step.
extend schema @expectEquals(relation: "graphitron_join_path_step",
    where: "coordinate = 'Film.actors'", rows: """
  coordinate,  position, from_table, to_table
  Film.actors, 0,        film,       film_actor
  Film.actors, 1,        film_actor, actor
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_key",
    where: "coordinate = 'Film.actors'", rows: """
  coordinate,  position, constraint_name
  Film.actors, 0,        film_actor_film_id_fkey
  Film.actors, 1,        film_actor_actor_id_fkey
  """)


