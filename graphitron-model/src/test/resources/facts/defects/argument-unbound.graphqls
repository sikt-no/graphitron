# An argument nothing binds has nowhere to go. A @service composes with no filter, so an argument its
# method takes no parameter for is ARGUMENT_UNBOUND, at the argument: Query.filmsWithExtra's extra.
# Its ids is bound by the method's parameter, as Query.filmsByService's only argument is, and those
# draw nothing. Under @condition(override: true) the condition stands in for every argument's
# predicate, so filmsByPrefixAndExtra's extra, which the method takes no parameter for, is
# ARGUMENT_UNBOUND too, while its titlePrefix, which the method reads, and filmsByPrefix's draw
# nothing.

type Film @table(name: "film") { title: String }

type Query {
  # A @service hands back its own list, which nothing limits, so a first its method takes no
  # parameter for is ARGUMENT_UNBOUND too, where a table read would be limited by it.
  filmsFirstByService(ids: [Int!]!, first: Int): [Film!]! @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmsByService"})
  filmsByService(ids: [Int!]!): [Film!]! @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmsByService"})
  filmsWithExtra(ids: [Int!]!, extra: String): [Film!]! @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmsByService"})
  # A @lookupKey drives its lookup whatever condition stands in for the filter, so filmId under the
  # override draws nothing, while titlePrefix is read by the method.
  filmsByKeyAndPrefix(filmId: [Int!] @field(name: "film_id") @lookupKey, titlePrefix: String): [Film]
    @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition"}, override: true)
  filmsByPrefix(titlePrefix: String): [Film!]! @defaultOrder(primaryKey: true)
    @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition"}, override: true)
  filmsByPrefixAndExtra(titlePrefix: String, extra: String): [Film!]! @defaultOrder(primaryKey: true)
    @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition"}, override: true)
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,             coordinate
  ARGUMENT_UNBOUND, Query.filmsFirstByService(first:)
  ARGUMENT_UNBOUND, Query.filmsWithExtra(extra:)
  ARGUMENT_UNBOUND, Query.filmsByPrefixAndExtra(extra:)
  ARGUMENT_UNBOUND, Mutation.rentWithNote(note:)
  """)

# The bound arguments bind the method's parameter; the unbound one binds nothing. The routine writes'
# bindings are the routine's own case and are pinned where routine parameters are.
extend schema @expectEquals(relation: "graphitron_occurrence_binding_parameter",
    where: "call_kind <> 'ROUTINE'", rows: """
  coordinate,                    call_coordinate,      call,     position, call_kind
  Query.filmsFirstByService(ids:), Query.filmsFirstByService, producer, 1,  SERVICE
  Query.filmsByService(ids:),    Query.filmsByService, producer, 1,        SERVICE
  Query.filmsWithExtra(ids:),    Query.filmsWithExtra, producer, 1,        SERVICE
  Query.filmsByKeyAndPrefix(titlePrefix:),   Query.filmsByKeyAndPrefix,   condition:public.film, 1, CONDITION
  Query.filmsByPrefix(titlePrefix:),         Query.filmsByPrefix,         condition:public.film, 1, CONDITION
  Query.filmsByPrefixAndExtra(titlePrefix:), Query.filmsByPrefixAndExtra, condition:public.film, 1, CONDITION
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,             coordinate
  ARGUMENT_UNBOUND, Query.filmsByKeyAndPrefix(filmId:)
  ARGUMENT_UNBOUND, Query.filmsByKeyAndPrefix(titlePrefix:)
  """)

# A routine write's re-read is keyed rather than filtered, so on a Mutation @routine every argument
# reaches a parameter or nowhere: rentWithNote takes a note rent_film has no parameter for, refused at
# the argument, while rentMapped reads every argument it takes and draws nothing. A Query routine's
# argument is not judged this way, since a read routine may take a filter.
type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }

type Mutation {
  rentWithNote(inventoryId: Int!, customerId: Int!, note: String): [Rental!]!
    @routine(name: "rent_film", argMapping: "pInventoryId: inventoryId, pCustomerId: customerId")
    @reference(path: [{table: "rental"}])
  rentMapped(inventoryId: Int!, customerId: Int!): [Rental!]!
    @routine(name: "rent_film", argMapping: "pInventoryId: inventoryId, pCustomerId: customerId")
    @reference(path: [{table: "rental"}])
}

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,             coordinate
  ARGUMENT_UNBOUND, Mutation.rentMapped(inventoryId:)
  ARGUMENT_UNBOUND, Mutation.rentMapped(customerId:)
  """)
