# A @service whose field returns a connection: the service answers film rows and graphitron would page
# them, which is not generated for a service yet.
#
# A field with more than this wrong is refused for each defect beside this one, none masking another;
# which an author reads first is the report's to order. Each defect is pinned once, in its own
# document, so the combinations are not pinned again here.

type Film @table(name: "film") {
  title: String
}

type Query {
  filmsPage(ids: [Int!]!): [Film!]! @asConnection
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmsByIds"})
}

type Mutation {
  "A mutation's @service returning a connection, refused as a query's is."
  touchFilmsPage(ids: [Int!]!): [Film!]! @asConnection
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmsByIds"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'SERVICE_CONNECTION_UNSUPPORTED'", rows: """
  code,                           coordinate
  SERVICE_CONNECTION_UNSUPPORTED, Mutation.touchFilmsPage
  SERVICE_CONNECTION_UNSUPPORTED, Query.filmsPage
  """)
