# A @nodeId argument whose whole value an argMapping entry hands to a parameter: the parameter is its
# slot, and the pair-grain relation states its own verdict on the entry. The refusal at the argument,
# a whole key landing only on the node's record or a tuple of its key, is the slot verdicts' document's.

# film_id is an Integer, and greet takes its userId as a String.
type Film @table(name: "film") @node {
  title: String
}

type Query {
  films(ids: ID @nodeId(typeName: "Film")): [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet", argMapping: "userId: ids"})
  # lookup takes its id as an Integer, the key column's own type.
  film(ids: ID @nodeId(typeName: "Film")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup", argMapping: "id: ids"})
  # The parameter shares the argument's name and its mapping feeds it from another, so it is not
  # this argument's slot: the absence is read on the parameter, and the id binds a predicate.
  redirected(id: ID @nodeId(typeName: "Film"), other: ID): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup", argMapping: "id: other"})
}

# The slot is the mapped parameter, typed off the method the reference resolved to, and not the
# one the argument is named for.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot", rows: """
  coordinate,        kind,      landing_class
  Query.film(ids:),  PARAMETER, java.lang.Integer
  Query.films(ids:), PARAMETER, java.lang.String
  """)

# One destination however the parameter was reached: the name match stands aside where a pair
# claims the parameter, so each slot above is its argument's only one. The refused one has none.
extend schema @expectEquals(relation: "intent_argmapping_projection_defect", rows: """
  coordinate,  directive_name, target_name, written_path, verdict,                  column_java_type,  param_java_type
  Query.films, service,        userId,     ids,          KEY_COLUMN_TYPE_MISMATCH, java.lang.Integer, java.lang.String
  """)
