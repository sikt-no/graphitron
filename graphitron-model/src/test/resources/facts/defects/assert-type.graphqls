# @assertType: what a requirement on a generated scalar's components is stored as, and each way one
# is refused at the element it is written on. Path is the scalar every case decodes; no Query field
# has a fetcher, a defect this document is not about.
# - The tree: Query.check's path argument and Mottaker.sti store their requirements as a tree keyed
#   by the declaration, two on the argument by their repeat, beneath the second an anyOf holding an
#   is and a not over an implements, each node named by its path from the root. They name only what
#   the schema declares, so they draw no ASSERT_TYPE defect.
# - ASSERT_TYPE_COMPONENT_UNKNOWN: Query.wrong names end, a component a path does not decode into.
#   Near miss Query.right names endType.
# - ASSERT_TYPE_ELEMENT_NOT_GENERATED: Query.plain's String is no generated scalar, never decoded, so
#   the requirement would never run. Near miss Query.generated, the same requirement on a Path.
# - ASSERT_TYPE_IS_UNKNOWN: Query.misspelt, Query.inputType and Query.nothing name a misspelt type,
#   an input type, and nothing, which graphql-java lets through a @oneOf literal as {is: null}, each
#   refused at the condition naming it. Near miss Query.named names Soker.
# - ASSERT_TYPE_IMPLEMENTS_UNKNOWN: Query.object names Sak, an object type, as an interface, nested
#   under a not. Near miss Query.iface names Node, an interface.

scalar Path @generatedScalar(kind: SCHEMA_PATH)

interface Node { id: ID! }

type Sak implements Node { id: ID! }

type Soknad implements Node { id: ID! }

type Soker { name: String }

input Mottaker {
  sti: Path @assertType(component: "endType", type: {is: "Soker"})
}

input SokerFilter { name: String }

type Query {
  check(
    path: Path
      @assertType(component: "startType", type: {implements: "Node"})
      @assertType(component: "endType", type: {anyOf: [{is: "Soker"}, {not: {implements: "Node"}}]})
    mottaker: Mottaker
  ): String
  wrong(path: Path @assertType(component: "end", type: {is: "Soker"})): String
  right(path: Path @assertType(component: "endType", type: {is: "Soker"})): String
  plain(path: String @assertType(component: "endType", type: {is: "Soker"})): String
  generated(path: Path @assertType(component: "endType", type: {is: "Soker"})): String
  misspelt(path: Path @assertType(component: "endType", type: {is: "Sokr"})): String
  inputType(path: Path @assertType(component: "endType", type: {is: "SokerFilter"})): String
  nothing(path: Path @assertType(component: "endType", type: {is: null})): String
  named(path: Path @assertType(component: "endType", type: {is: "Soker"})): String
  object(path: Path @assertType(component: "startType", type: {not: {implements: "Sak"}})): String
  iface(path: Path @assertType(component: "startType", type: {implements: "Node"})): String
}

# The tree's requirements, by the declarations they are written on.
extend schema @expectEquals(relation: "graphitron_assert_type",
    where: "coordinate IN ('Mottaker.sti', 'Query.check(path:)')", rows: """
  coordinate,         ordinal, component
  Mottaker.sti,       0,       endType
  Query.check(path:), 0,       startType
  Query.check(path:), 1,       endType
  """)

extend schema @expectEquals(relation: "graphitron_assert_type_node",
    where: "coordinate IN ('Mottaker.sti', 'Query.check(path:)')", rows: """
  coordinate,         ordinal, node_path,        parent_path, operator,   type_name
  Mottaker.sti,       0,       0,                ,            IS,         Soker
  Query.check(path:), 0,       0,                ,            IMPLEMENTS, Node
  Query.check(path:), 1,       0,                ,            ANY_OF,
  Query.check(path:), 1,       0.anyOf.0,        0,           IS,         Soker
  Query.check(path:), 1,       0.anyOf.1,        0,           NOT,
  Query.check(path:), 1,       0.anyOf.1.not,    0.anyOf.1,   IMPLEMENTS, Node
  """)

# Every ASSERT_TYPE defect the document draws: none at the tree or at a near miss.
extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code LIKE 'ASSERT_TYPE_%'", rows: """
  code,                              coordinate,             detail
  ASSERT_TYPE_COMPONENT_UNKNOWN,     Query.wrong(path:),     end
  ASSERT_TYPE_ELEMENT_NOT_GENERATED, Query.plain(path:),     String
  ASSERT_TYPE_IMPLEMENTS_UNKNOWN,    Query.object(path:),    Sak
  ASSERT_TYPE_IS_UNKNOWN,            Query.inputType(path:), SokerFilter
  ASSERT_TYPE_IS_UNKNOWN,            Query.misspelt(path:),  Sokr
  ASSERT_TYPE_IS_UNKNOWN,            Query.nothing(path:),
  """)

extend schema @assertEmpty(relation: "graphql_schema_problem")
