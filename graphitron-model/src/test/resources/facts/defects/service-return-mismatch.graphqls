# Services whose answer the field cannot be handed: records of another table than the one the field's
# type is bound to, values of another class than the field's scalar arrives as, many where the field
# is one record, one per key where the field is a list. Under Film the answer is read per key, from a
# Map's values or a List's elements in the keys' order. Film.titleByFilm and Query.filmCount answer
# their scalar's class; records under one payload with no table are lifted into it; one value under a
# list field at a root, Query.oneAsFilms, is LIST_OVER_ONE_VALUE's, pinned in list-over-one-value. A
# jOOQ record of no table is no table's record, and a list of objects under a payload holding one has
# no one object for it. Under Film an enum is answered the same way, the jOOQ enum per key from a Map,
# in the keys' order from a List, or a list of them per key for a list field, and at the root the
# enum itself; a Map naming no value class, raw or a type variable, hands the field nothing, and one
# keyed by another class than the film records handed in finds no parent's answer.

enum Rating { G PG PG_13 R NC_17 }

type Film @table(name: "film") {
  title: String
  languages: [Language!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesByFilm"})
  languagesInOrder: [Language!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesInOrder"})
  titleByFilm: String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "titleByFilm"})
  lengthText: String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "lengthByFilm"})
  filmAsLanguage: Language @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "filmAsLanguage"})
  oneLanguageInOrder: [Language!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "oneLanguageInOrder"})
  languagesAsOne: Language @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesAsOne"})
  "A child answer per key that is a jOOQ record of no table, where the field is a language record."
  languageAsPlainRecord: Language @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languageAsPlainRecord"})
  rating: Rating @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "ratingByFilm"})
  ratingInOrder: Rating @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "ratingInOrder"})
  ratings: [Rating!] @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "ratingsByFilm"})
  ratingRaw: Rating @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "ratingRaw"})
  ratingGeneric: Rating @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "ratingGeneric"})
  ratingByFilmId: Rating @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "ratingByFilmId"})
}

type FilmsPayload {
  films: [Film!]!
}

type Language @table(name: "language") {
  name: String
}

type Query {
  films: [Film!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "films"})
  languagesAsFilms: [Film!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesAsFilms"})
  filmsAsOne: Film @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "filmsAsOne"})
  oneAsFilms: [Film!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "oneAsFilms"})
  filmCount: Int @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "filmCount"})
  filmCountText: String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "filmCount"})
  filmsInPayload: FilmsPayload @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "films"})
  filmIds: FilmIdsPayload @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "films"})
  languagesAsFilmIds: FilmIdsPayload @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesAsFilms"})
  filmsIntoOneId: FilmIdPayload @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "films"})
  oneFilmIntoIds: FilmIdsPayload @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "oneAsFilms"})
  topRating: Rating @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EnumReturnShapeService", method: "topRating"})
}

# A result naming no class once its containers are peeled, a type variable, a raw list or an array,
# where the field's type is bound to a table: nothing in it says which records a lift would read.

extend type Query {
  anyFilms: [Film!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.UnclassedResultService", method: "anyFilms"})
  rawFilms: [Film!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.UnclassedResultService", method: "rawFilms"})
  filmArray: [Film!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.UnclassedResultService", method: "filmArray"})
}

# A payload encoding the records a service hands back into Film ids: film records encode, language
# records would name language rows as films, and a list of records into one id, or one record into a
# list of ids, has no one record per id.
type FilmIdsPayload {
  ids: [ID!] @nodeId(typeName: "Film")
}
type FilmIdPayload {
  id: ID @nodeId(typeName: "Film")
}

# A list of composites into a payload whose data field holds one composite.
type FilmWithActorsOnePayload {
  result: FilmWithActorsResult
}
type FilmWithActorsResult {
  film: Film! @field(name: "filmRecord")
}

extend type Query {
  filmsWithActorsIntoOne(filmIds: [Int!]!): FilmWithActorsOnePayload @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmsWithActorsService", method: "create"})
}


extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'SERVICE_RETURN_MISMATCH'", rows: """
  code,                    coordinate,                 detail
  SERVICE_RETURN_MISMATCH, Query.anyFilms,           java.util.List<T>
  SERVICE_RETURN_MISMATCH, Query.rawFilms,           java.util.List
  SERVICE_RETURN_MISMATCH, Query.filmArray,          FilmRecord[]
  SERVICE_RETURN_MISMATCH, Query.languagesAsFilms,     org.jooq.Result<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.LanguageRecord>
  SERVICE_RETURN_MISMATCH, Query.languagesAsFilmIds,   org.jooq.Result<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.LanguageRecord>
  SERVICE_RETURN_MISMATCH, Query.filmsIntoOneId,       java.util.List<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord>
  SERVICE_RETURN_MISMATCH, Query.oneFilmIntoIds,       no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord
  SERVICE_RETURN_MISMATCH, Query.filmCountText,        java.lang.Integer
  SERVICE_RETURN_MISMATCH, Film.lengthText,"java.util.Map<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, java.lang.Integer>"
  SERVICE_RETURN_MISMATCH, Query.filmsAsOne,           java.util.List<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord>
  SERVICE_RETURN_MISMATCH, Film.filmAsLanguage,"java.util.Map<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord>"
  SERVICE_RETURN_MISMATCH, Film.oneLanguageInOrder,    java.util.List<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.LanguageRecord>
  SERVICE_RETURN_MISMATCH, Film.languagesAsOne,"java.util.Map<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, java.util.List<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.LanguageRecord>>"
  SERVICE_RETURN_MISMATCH, Film.languageAsPlainRecord,"java.util.Map<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, org.jooq.Record>"
  SERVICE_RETURN_MISMATCH, Query.filmsWithActorsIntoOne, java.util.List<no.sikt.graphitron.rewrite.test.services.FilmWithActors>
  SERVICE_RETURN_MISMATCH, Film.ratingRaw,            java.util.Map
  SERVICE_RETURN_MISMATCH, Film.ratingGeneric,"java.util.Map<no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, T>"
  SERVICE_RETURN_MISMATCH, Film.ratingByFilmId,"java.util.Map<java.lang.Integer, no.sikt.graphitron.rewrite.test.jooq.public_.enums.MpaaRating>"
  """)
