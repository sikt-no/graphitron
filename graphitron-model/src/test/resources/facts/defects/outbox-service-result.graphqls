# A $result over a service's returned value is a pointer: a path read step by step off the result, each
# step as its field's own facts say. A field reads the member its bound name finds on the one class its
# parent's result holds; where it finds none and its type holds that class, the object passes through;
# where the member returns a record of the field's table-bound type, the step takes that record, whose
# @nodeId can end the path. A path ends on a member a payload can carry, on a node id, or, bare, on a
# scalar return. A path that lands but reads something a payload key cannot hold misfits, naming the
# type, or the list it goes through; one that lands nowhere is unresolved, as any argMapping path is.

extend schema @withConfiguration(outboxTable: "outbox")
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

type FilmBlurb { description: String }

# FilmBlurbHolder has no holder member, so the service's object passes through to HolderView.
type HolderView { blurb: FilmBlurb }
type BlurbPayload { holder: HolderView }

# FilmCardData's film() returns the FilmRecord of film.
type FilmCardWrapper { film: Film }

type FilmWithActorsResult { film: Film! @field(name: "filmRecord") }
type FilmsWithActorsPayload { results: [FilmWithActorsResult] }

type Mutation {
  blurb(filmId: Int!): BlurbPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
    @outbox(argMapping: "text: $result.holder.blurb.description, whole: $result.holder.blurb")
  blurbMissing(filmId: Int!): BlurbPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
    @outbox(argMapping: "missing: $result.nosuch")
  card(filmId: Int!): FilmCardWrapper
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCardFactoryService", method: "create"})
    @outbox(argMapping: "filmId: $result.film.id")
  marker(marker: String!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.MutationScopeService", method: "writeOne"})
    @outbox(argMapping: "value: $result")
  films(filmIds: [Int!]!): FilmsWithActorsPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmsWithActorsService", method: "create"})
    @outbox(argMapping: "first: $result.results.film.id")
}

# A $result path lands on the occurrences of the fields it names, nested under the call while what it
# returns has no table, and on the bound type's own field once it reaches Film. A path through a list
# lands as any other: what it may read there is its reader's to judge. A name no field has lands nowhere.
extend schema @expectEquals(relation: "graphitron_argmapping_landing", where: "directive_name = 'outbox'", rows: """
  coordinate,    parameter_name, landing_coordinate
  Mutation.blurb, text,          Mutation.blurb.holder.blurb.description
  Mutation.blurb, whole,         Mutation.blurb.holder.blurb
  Mutation.card,  filmId,        Film.id
  Mutation.films, first,         Film.id
  """)

# Each field read off the service's object reaches its value by an accessor path: holder finds no member
# on FilmBlurbHolder and HolderView is backed by it, so the object passes through; blurb and description
# are members. films.results is the payload's data element, which the service's own class backs, so it
# passes the object through too. card.film takes its keys through a member
# returning a FilmRecord, which is the lift onto film, not a path.
extend schema @expectEquals(relation: "graphitron_accessor_path", where: "coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                                   target_type
  Mutation.blurb.holder,                        HolderView
  Mutation.blurb.holder.blurb,                  FilmBlurb
  Mutation.blurb.holder.blurb.description,      String
  Mutation.blurbMissing.holder,                 HolderView
  Mutation.blurbMissing.holder.blurb,           FilmBlurb
  Mutation.blurbMissing.holder.blurb.description, String
  Mutation.films.results,                       FilmWithActorsResult
  """)

extend schema @expectEquals(relation: "graphitron_path", where: "kind = 'ACCESSOR' AND coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                                   target_type,          origin
  Mutation.blurb.holder,                        HolderView,           EMPTY
  Mutation.blurb.holder.blurb,                  FilmBlurb,            INFERRED
  Mutation.blurb.holder.blurb.description,      String,               INFERRED
  Mutation.blurbMissing.holder,                 HolderView,           EMPTY
  Mutation.blurbMissing.holder.blurb,           FilmBlurb,            INFERRED
  Mutation.blurbMissing.holder.blurb.description, String,             INFERRED
  Mutation.films.results,                       FilmWithActorsResult, EMPTY
  """)

# What each of those occurrences takes is the value at its accessor path's end, a VALUE binding: the member
# read, Class#member, or the class itself where the object passes through.
extend schema @expectEquals(relation: "graphitron_occurrence_binding_value", where: "coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                                     bound
  Mutation.blurb.holder,                          no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder
  Mutation.blurb.holder.blurb,                    no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder#blurb
  Mutation.blurb.holder.blurb.description,        no.sikt.graphitron.rewrite.test.services.FilmBlurb#description
  Mutation.blurbMissing.holder,                   no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder
  Mutation.blurbMissing.holder.blurb,             no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder#blurb
  Mutation.blurbMissing.holder.blurb.description, no.sikt.graphitron.rewrite.test.services.FilmBlurb#description
  Mutation.films.results,                         no.sikt.graphitron.rewrite.test.services.FilmWithActors
  """)

extend schema @expectEquals(relation: "graphitron_outbox_key", where: """
  coordinate LIKE 'Mutation.%'
  """, rows: """
  coordinate,      ordinal, key_name, origin,  position, fill,   reads,   source_path,              column_name, node_type_name
  Mutation.blurb,  0,       text,     MESSAGE, 0,        RESULT, MEMBER,  holder.blurb.description, ,
  Mutation.card,   0,       filmId,   MESSAGE, 0,        RESULT, NODE_ID, film.id,                  ,            Film
  Mutation.marker, 0,       value,    MESSAGE, 0,        RESULT, ROOT,    ,                         ,
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('ARGMAPPING_SOURCE_MISFIT', 'ARGMAPPING_PATH_UNRESOLVED')
  """, rows: """
  code,                       coordinate,            detail
  ARGMAPPING_SOURCE_MISFIT,   Mutation.blurb,
  ARGMAPPING_PATH_UNRESOLVED, Mutation.blurbMissing,
  ARGMAPPING_SOURCE_MISFIT,   Mutation.films,
  """)

extend schema @expectEquals(relation: "graphitron_argmapping_pair_defect", rows: """
  code,                       detail
  ARGMAPPING_SOURCE_MISFIT,   "whole: $result.holder.blurb (no.sikt.graphitron.rewrite.test.services.FilmBlurb)"
  ARGMAPPING_PATH_UNRESOLVED, $result.nosuch
  ARGMAPPING_SOURCE_MISFIT,   "first: $result.results.film.id (through a list, where a key holds one value)"
  """)
