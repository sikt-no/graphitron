# A child under a table no tenant column scopes answering rows a tenant's database holds, by a key
# naming no tenant: language carries no film_id, and film is the tenant's, so nothing says which
# tenant's database Language.films reads, whether a @service answers it or a split query reads it
# down film_language_id_fkey. Language.fannedFilms says which tenants itself, every one the request
# may see, with @tenantFanOut, and is not refused.

extend schema @withConfiguration(tenantColumn: "film_id")

type Film @table(name: "film") {
  title: String
}

type Language @table(name: "language") {
  name: String
  films: [Film!]! @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
    method: "languageFilms"})
  splitFilms: [Film!]! @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  fannedFilms: [Film] @reference(path: [{key: "film_language_id_fkey"}]) @tenantFanOut
}

type Query {
  films: [Film!]!
  languages: [Language!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code = 'UNROUTED_CHILD'", rows: """
  code,           coordinate
  UNROUTED_CHILD, Language.films
  UNROUTED_CHILD, Language.splitFilms
  """)
