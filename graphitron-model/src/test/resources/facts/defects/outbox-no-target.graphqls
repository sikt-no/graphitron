# An @outbox in a build that configures no outbox target has nowhere to write: the fault is
# reported at the @outbox, because the configuration it is missing has no position to report at.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  create(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,             coordinate,      detail
  OUTBOX_NO_TARGET, Mutation.create,
  """)
