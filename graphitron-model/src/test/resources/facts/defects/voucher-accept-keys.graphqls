extend schema @withConfiguration(sessionState: true)

"The accepting side's refusals the entity key stage decides, each at the @accept. A voucher decodes to an authored key this subgraph resolves the type by: the one key: names, field set for field set in any order, or the type's one such key where key: is left out, never a nested selection. Its vouched-for fields read one column of the type's own table each."
type NoKey @table(name: "actor") @accept(scope: "s", vouchesFor: "firstName") {
  actorId: Int @field(name: "actor_id")
  firstName: String @field(name: "first_name")
}

# A key this subgraph does not resolve by is no key to decode to.
type StubKey @table(name: "staff") @key(fields: "staffId", resolvable: false) @accept(scope: "s", vouchesFor: "firstName") {
  staffId: Int @field(name: "staff_id")
  firstName: String @field(name: "first_name")
}

type TwoKeys @table(name: "customer") @key(fields: "customerId") @key(fields: "email") @accept(scope: "s", vouchesFor: "firstName") {
  customerId: Int @field(name: "customer_id")
  email: String
  firstName: String @field(name: "first_name")
}

# key: names the first key in another order.
type Named @table(name: "inventory") @key(fields: "filmId storeId") @key(fields: "inventoryId") @accept(scope: "s", key: "storeId filmId", vouchesFor: "inventoryId") {
  inventoryId: Int @field(name: "inventory_id")
  filmId: Int @field(name: "film_id")
  storeId: Int @field(name: "store_id")
}

type Unknown @table(name: "category") @key(fields: "categoryId") @accept(scope: "s", key: "name", vouchesFor: "name") {
  categoryId: Int @field(name: "category_id")
  name: String
}

type Nested @table(name: "city") @key(fields: "cityId") @accept(scope: "s", key: "cityId { x }", vouchesFor: "city") {
  cityId: Int @field(name: "city_id")
  city: String
}

type NotColumn @table(name: "language") @key(fields: "languageId") @accept(scope: "s", vouchesFor: "tags") {
  languageId: Int @field(name: "language_id")
  tags: [String]
}

extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

type Query {
  noKeys: [NoKey!]!
  stubKeys: [StubKey!]!
  twoKeys: [TwoKeys!]!
  named: [Named!]!
  unknowns: [Unknown!]!
  nested: [Nested!]!
  notColumns: [NotColumn!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('VOUCHER_ACCEPT_WITHOUT_KEY', 'VOUCHER_ACCEPT_KEY_AMBIGUOUS', 'VOUCHER_ACCEPT_KEY_UNKNOWN',
           'VOUCHER_VOUCHED_FOR_NOT_A_COLUMN')
  """, rows: """
  code,                             type_name, detail
  VOUCHER_ACCEPT_KEY_AMBIGUOUS,     TwoKeys,   TwoKeys
  VOUCHER_ACCEPT_KEY_UNKNOWN,       Unknown,   name
  VOUCHER_ACCEPT_WITHOUT_KEY,       NoKey,     NoKey
  VOUCHER_ACCEPT_WITHOUT_KEY,       StubKey,   StubKey
  VOUCHER_VOUCHED_FOR_NOT_A_COLUMN, NotColumn, tags
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code = 'VOUCHER_ACCEPT_KEY_NESTED'
  """, rows: """
  code,                      type_name
  VOUCHER_ACCEPT_KEY_NESTED, Nested
  """)

extend schema @expectEquals(relation: "graphitron_accept_key", rows: """
  type_name, directive_name, ordinal
  Named,     key,            0
  NotColumn, key,            0
  """)
