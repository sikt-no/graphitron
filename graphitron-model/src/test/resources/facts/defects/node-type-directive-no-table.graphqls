# @node only takes effect over @table, so a node with no table has no row in the resolved node
# relation and none here; the author is told by the defect that reports the shape.

extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key", "@composeDirective"]) @composeDirective(name: "@nodeType")

type Query { ghost: Ghost }

interface Node { id: ID! }

type Ghost implements Node @node(typeId: "G") {
  id: ID!
}

extend schema @assertEmpty(relation: "graphitron_synthesized_node_type_id")
