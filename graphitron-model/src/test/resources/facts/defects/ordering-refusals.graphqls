# What an ordering cannot state, each refused where it is written: an application writing two
# surfaces; a primary key the table does not have; an index or a column the table does not have; a
# fields element naming both a column and a method; an @orderBy argument whose input type has no
# direction field, so it offers no choice; a value of an @orderBy sort enum with no @order;
# a client's choice of order on a list read inline in its parent's statement, which graphitron does
# not generate yet, though its choices are stated; and such a list over a table with no primary key
# with no order written at all. The near misses beside them draw nothing: the same keyless list
# ordered by a column, and a sort enum whose every value carries @order, read by a root list.

type Actor @table(name: "actor") {
    lastName: String @field(name: "last_name")
}

type RoleAssignment @table(name: "role_assignment") {
    roleCode: String @field(name: "role_code")
}

type RoleHolder @table(name: "role_holder") {
    rolesUnordered: [RoleAssignment!]!
    rolesByKey: [RoleAssignment!]! @defaultOrder(primaryKey: true)
    rolesOrdered: [RoleAssignment!]! @defaultOrder(fields: [{name: "role_code"}])
}

type Film @table(name: "film") {
    title: String

    actorsTwice: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(index: "idx_actor_last_name", primaryKey: true)
    actorsByNoIndex: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(index: "idx_no_such_index")
    actorsByNoColumn: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(fields: [{name: "no_such_column"}])
    actorsByBoth: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(fields: [{name: "last_name", method: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmSortKeys", method: "latestStockStore"}}])

    actorsSorted(order: ActorOrderBy @orderBy): [Actor!]!
        @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
}

input ActorOrderBy {
    field:     ActorSort!
    direction: SortDirection
}

enum ActorSort {
    LAST_NAME @order(fields: [{name: "last_name"}])
    UNSAID
}

input ActorFullOrderBy {
    field:     ActorFullSort!
    direction: SortDirection
}

enum ActorFullSort {
    LAST_NAME @order(fields: [{name: "last_name"}])
    ACTOR_ID  @order(primaryKey: true)
}

type Query {
    films: [Film!]!
    holders: [RoleHolder!]!
    actorsFullySorted(order: ActorFullOrderBy @orderBy): [Actor!]!
    actorsUndirected(order: ActorUndirectedOrderBy @orderBy): [Actor!]!
    roleAssignments: [RoleAssignment!]!
    roleAssignmentPage: [RoleAssignment!]! @asConnection
    roleAssignmentsOrdered: [RoleAssignment!]! @defaultOrder(fields: [{name: "role_code"}])
    roleAssignmentsByCode(roleCode: [String!]! @lookupKey @field(name: "role_code")): [RoleAssignment]!
    stints: [Stint!]!
    holdersSplit: [HolderSplit!]!
    filmRows(actorId: Int!, minLength: Int!): [ActorFilm!]!
        @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    filmRowsOrdered(actorId: Int!, minLength: Int!): [ActorFilm!]!
        @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
        @defaultOrder(fields: [{name: "title"}])
    actorsWithFilms: [ActorWithFilms!]!
    search: [Searchable!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect", rows: """
  source_line, code,                        detail
  19,          LIST_ORDER_UNDETERMINED,     public.role_assignment
  20,          ORDER_PRIMARY_KEY_MISSING,   public.role_assignment
  28,          ORDER_SURFACES,
  30,          ELEMENT_UNRESOLVED,          idx_no_such_index
  32,          COLUMN_UNRESOLVED,           no_such_column
  34,          ORDER_FIELD_SHAPE,
  36,          ORDER_CHOICE_ON_INLINE_LIST,
  47,          ORDER_VALUE_UNORDERED,
  64,          ORDER_INPUT_SHAPE,           ActorUndirectedOrderBy
  65,          LIST_ORDER_UNDETERMINED,     public.role_assignment
  66,          LIST_ORDER_UNDETERMINED,     public.role_assignment
  69,          LIST_ORDER_UNDETERMINED,     public.stint
  71,          LIST_ORDER_UNDETERMINED,     public.films_for_actor
  77,          LIST_ORDER_UNDETERMINED,     public.film_list
  134,         LIST_ORDER_UNDETERMINED,     public.role_assignment
  135,         LIST_ORDER_UNDETERMINED,     public.role_assignment
  145,         LIST_ORDER_UNDETERMINED,     public.films_for_actor
  161,         ORDER_FIELDS_EMPTY,
  179,         LIST_ORDER_UNDETERMINED,     public.films_for_actor
  188,         LIST_ORDER_UNDETERMINED,     public.films_for_actor
  195,         LIST_ORDER_UNDETERMINED,     public.role_assignment
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_order", where: "kind = 'CHOICE'", rows: """
  coordinate,              choice,                  surface
  Film.actorsSorted,       ActorSort.LAST_NAME,     FIELDS
  Query.actorsFullySorted, ActorFullSort.LAST_NAME, FIELDS
  Query.actorsFullySorted, ActorFullSort.ACTOR_ID,  PRIMARY_KEY
  Query.filmRowsChosen,          ActorFilmChoiceSort.TITLE, FIELDS
  Query.filmRowsChosenDefaulted, ActorFilmChoiceSort.TITLE, FIELDS
  Query.filmRowsChosenRequired,  ActorFilmChoiceSort.TITLE, FIELDS
  Query.rolesChosen,             RoleChoiceSort.CODE,       FIELDS
  Query.rolesChosenRequired,     RoleChoiceSort.CODE,       FIELDS
  """)

input ActorUndirectedOrderBy {
    field: ActorFullSort!
}

# A list or connection whose rows a query of its own reads, at the root or split from its parent, or
# a table-valued function's result, is held to the same rule: Query.roleAssignments and
# roleAssignmentPage at the root, HolderSplit.rolesSplit and rolesPaged split from role_holder,
# Query.stints over a table whose one unique key is no primary key, Query.filmRows and
# ActorWithFilms.films over films_for_actor's result, and Query.search's keyless participant
# film_list. The near misses draw nothing: the same reads ordered by a column, and
# roleAssignmentsByCode, a lookup answering in its keys' order.

type Stint @table(name: "stint") {
    validFrom: String @field(name: "valid_from")
}

type HolderSplit @table(name: "role_holder") {
    rolesSplit: [RoleAssignment!]! @splitQuery
    rolesPaged: [RoleAssignment!]! @asConnection
    rolesSplitOrdered: [RoleAssignment!]! @splitQuery @defaultOrder(fields: [{name: "role_code"}])
}

type ActorFilm {
    filmId: Int @field(name: "film_id")
    title: String
}

type ActorWithFilms @table(name: "actor") {
    films(minLength: Int!): [ActorFilm!]
        @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    filmsOrdered(minLength: Int!): [ActorFilm!]
        @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
        @defaultOrder(fields: [{name: "title"}])
}

type FilmListEntry @table(name: "film_list") {
    title: String
}

union Searchable = Film | FilmListEntry

# An order naming no field names nothing to sort by, wherever the list is read: ORDER_FIELDS_EMPTY,
# at the application, on a type nothing reaches as on any other.
type HolderNamingNothing @table(name: "role_holder") {
    rolesNamingNothing: [RoleAssignment!]! @defaultOrder(fields: [])
}

# An @orderBy argument a client may leave out states no order for when it is left out (Alf,
# 2026-11-25), so a list with nothing to fall back on needs a @defaultOrder beside it, or the
# argument non-null: Query.filmRowsChosen over films_for_actor's result and Query.rolesChosen over
# the keyless role_assignment, and ActorPages.filmsPage, a routine child connection with no order at
# all. The near misses draw nothing: the argument non-null, filmRowsChosenRequired and
# rolesChosenRequired; a @defaultOrder written, filmRowsChosenDefaulted; and
# ActorPages.recentFilmsPage, which hops from the routine on to film and is ordered by its key.

enum ActorFilmChoiceSort { TITLE @order(fields: [{name: "title"}]) }
input ActorFilmChoiceOrderBy { field: ActorFilmChoiceSort!, direction: SortDirection }

enum RoleChoiceSort { CODE @order(fields: [{name: "role_code"}]) }
input RoleChoiceOrderBy { field: RoleChoiceSort!, direction: SortDirection }

type ActorPages @table(name: "actor") {
    filmsPage(minLength: Int!): [ActorFilm!] @asConnection
        @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    recentFilmsPage(minLength: Int!): [Film!] @asConnection
        @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
        @reference(path: [{table: "film"}])
}

extend type Query {
    actorPages: [ActorPages!]!
    filmRowsChosen(actorId: Int!, minLength: Int!, order: ActorFilmChoiceOrderBy @orderBy): [ActorFilm!]!
        @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    filmRowsChosenRequired(actorId: Int!, minLength: Int!, order: ActorFilmChoiceOrderBy! @orderBy): [ActorFilm!]!
        @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    filmRowsChosenDefaulted(actorId: Int!, minLength: Int!, order: ActorFilmChoiceOrderBy @orderBy): [ActorFilm!]!
        @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
        @defaultOrder(fields: [{name: "film_id"}])
    rolesChosen(order: RoleChoiceOrderBy @orderBy): [RoleAssignment!]!
    rolesChosenRequired(order: RoleChoiceOrderBy! @orderBy): [RoleAssignment!]!
}
