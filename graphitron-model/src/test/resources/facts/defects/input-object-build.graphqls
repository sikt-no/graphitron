# An input object a call takes is built into the class its parameter holds, field by field, and what
# cannot be built is a defect at the input field or argument, each beside the shape that builds: a
# class nothing constructs, a field filling no member, a list that cannot group, two fields on one
# member, a record component no field fills, a @condition taking a jOOQ record, a field naming no
# column of the record it writes, and a filter's field naming no column of the table it filters, or
# of the result a @routine filters. A node id with no route onto the record is
# node-id-lands-on-table's.
#
# A nested input under a record groups onto its columns, and where it is named like a jOOQ embeddable
# of the record's table (Alf, 2026-11-18) a field of it naming no column says so in its detail:
# binding an input to the embeddable is not supported yet. embedded_period's period covers starts_on
# and ends_on; a period grouping whose fields bind columns says nothing, and the same failing field
# under span, no embeddable, draws the plain detail.
#
# A field nothing takes is reported once, at the outermost such field (Alf, 2026-11-17): Length, a
# nested input object whose own fields fill nothing of FilmSearchFilter, is the misspelt member
# (the setter is setLength, matched exactly), and its min and max are not reported. A nested input
# object some of whose fields fill the bean, naming, groups and binds; and a field a non-overriding
# filter compares as a column, releaseYear, needs no member.
#
# A grouping's fields fill the enclosing class as its own would, so a grouped field and a top-level
# one, or two groupings, filling one member fill it twice; a grouping renamed onto a member the class
# lacks fills nothing. A record's column written by two live fields, top-level or nested, beside a
# node id decoded into it or with a deprecated alias beside them, is written twice; the alias is no
# writer. A list cannot group onto a record either. A setter bean fills a member twice as a record
# component does. And @field(name:) names a member only when it names one: an empty name is no name.

interface Node { id: ID! }
type Film implements Node @table(name: "film") @node { id: ID! title: String }

# A filter built into nothing: nope names no column of film, so no predicate compares it, and neither
# does a cell of a list of input objects naming none, nor a field of a nested input naming none.
input FilmPlainFilterInput { title: String nope: String }
input FilmNestedFilterInput { title: String inner: FilmInnerFilterInput }
input FilmInnerFilterInput { title: String nope: String }
input FilmTitleCellInput { title: String nope: String }
# FilmTitleFilter(String title) is a record a @condition builds: an input with no title leaves its one
# component unfilled, and its note fills nothing.
input FilmUntitledInput { note: String }
# A @routine's parameters take actorId and minLength; title filters the function's result, and foo
# names none of its columns.
type ActorFilm { filmId: Int @field(name: "film_id") title: String }
input ActorFilmFilter { actorId: Int! minLength: Int title: String foo: String }
type FilmDraftsCountedPayload { count: Int }

input FilmDraftInput { title: String! }
input FilmDraftExtraInput { title: String!, subtitle: String }
input FilmDraftNotedInput { title: String!, note: String }
input FilmDraftTwiceInput { title: String!, name: String @field(name: "title") }
input FilmBundleExtrasInput { name: String, films: [FilmDraftInput!], extras: [FilmDraftInput!] }
input AbstractDraftInput { title: String }
input FilmRecordDraftInput {
  title: String @field(name: "title")
  filmId: ID @nodeId(typeName: "Film")
}
input FilmRecordExtraInput { title: String @field(name: "title"), subtitle: String }
input PeriodLeaves { starts: String }
input PeriodColumns { starts_on: String, ends_on: String }
input SpanLeaves { starts: String }
input PeriodByEmbeddable { label: String, period: PeriodLeaves }
input PeriodByColumns { label: String, period: PeriodColumns }
input PeriodBySpan { label: String, span: SpanLeaves }
input FilmLengthBoundsInput { min: Int, max: Int }
input FilmSearchMisspeltInput { title: String, Length: FilmLengthBoundsInput, subtitle: String }
input FilmSearchNamingInput { title: String }
input FilmLengthRangeInput { min: Int, max: Int }
input FilmSearchGroupedInput { naming: FilmSearchNamingInput, length: FilmLengthRangeInput }
input FilmSearchColumnInput { title: String, releaseYear: Int @field(name: "release_year") }
input FilmBundleLimitsInput { capacity: Int }
input FilmBundleCapacityTwiceInput { name: String, capacity: Int, limits: FilmBundleLimitsInput }
input FilmBundleQuotaInput { capacity: Int }
input FilmBundleTwoGroupsInput { name: String, limits: FilmBundleLimitsInput, quota: FilmBundleQuotaInput }
input FilmBundleRenamedGroupInput { name: String, limits: FilmBundleLimitsInput @field(name: "noSuchMember") }
input FilmRecordTwiceInput { title: String @field(name: "title"), name: String @field(name: "title") }
input FilmRecordAkaInput { aka: String @field(name: "title") }
input FilmRecordNestedTwiceInput { title: String @field(name: "title"), details: FilmRecordAkaInput }
input FilmRecordAliasTwiceInput {
  title: String @field(name: "title")
  name: String @field(name: "title")
  formerTitle: String @field(name: "title") @deprecated(reason: "Use title.")
}
input FilmRecordDecodeTwiceInput {
  filmId: ID @nodeId(typeName: "Film")
  id: Int @field(name: "film_id")
  key: Int @field(name: "film_id")
}
input FilmRecordListGroupInput { title: String @field(name: "title"), extras: [FilmRecordAkaInput!] }
input FilmSurveyTwiceInput { count: Int, tally: Int @field(name: "count") }
input FilmDraftBlankNameInput { title: String @field(name: "") }
input PrivateDraftInput { title: String }

type Query {
  periodsByEmbeddable(in: [PeriodByEmbeddable!]!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EmbeddedPeriodService", method: "count", argMapping: "periods: in"})
  periodsByColumns(in: [PeriodByColumns!]!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EmbeddedPeriodService", method: "count", argMapping: "periods: in"})
  periodsBySpan(in: [PeriodBySpan!]!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.EmbeddedPeriodService", method: "count", argMapping: "periods: in"})
  # Every field fills a member of FilmDraft.
  countDrafts(in: [FilmDraftInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService", method: "count", argMapping: "drafts: in"})
  # subtitle fills no member of FilmDraft.
  countExtraDrafts(in: [FilmDraftExtraInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService", method: "count", argMapping: "drafts: in"})
  # note fills no member of FilmDraft, and is no MEMBER_UNKNOWN: the pair hands it to the note
  # parameter, so it is taken, and the build leaves it out of the bean (BuildQueryTest reads it here).
  countNotedDraft(in: FilmDraftNotedInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService", method: "countNoted",
      argMapping: "draft: in, note: in.note"})
  # title and name both fill FilmDraft's title.
  countTwiceDrafts(in: [FilmDraftTwiceInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService", method: "count", argMapping: "drafts: in"})
  # films fills FilmBundleDraft's films; extras fills nothing and, a list, cannot group.
  countBundleExtras(in: FilmBundleExtrasInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBundleDraftService", method: "count", argMapping: "bundle: in"})
  # AbstractFilmDraft is abstract: nothing constructs it.
  countAbstractDraft(in: AbstractDraftInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService", method: "countAbstract", argMapping: "draft: in"})
  # A FilmRecord built column by column, its own node id decoded into its key.
  countRecordDrafts(in: [FilmRecordDraftInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # subtitle names no column of film.
  countRecordExtras(in: [FilmRecordExtraInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # A @condition takes a bean or the map, never a record.
  filmsByRecord(by: FilmRecordDraftInput): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
      method: "filmByRecord", argMapping: "film: by"}, override: true)
  # Length and subtitle fill nothing of FilmSearchFilter, on a connection whose paging arguments are
  # the page's: one row each, none for Length's fields.
  filmsBySearch(search: FilmSearchMisspeltInput): [Film!]! @asConnection @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
      method: "filmSearchBean"}, override: true)
  # naming groups title onto FilmSearchFilter, and length fills its length.
  filmsByGroupedSearch(search: FilmSearchGroupedInput): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
      method: "filmSearchBean"}, override: true)
  # capacity fills FilmBundleDraft's capacity, and so does limits' capacity, grouped onto it.
  countBundleCapacityTwice(in: FilmBundleCapacityTwiceInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBundleDraftService", method: "count", argMapping: "bundle: in"})
  # limits and quota both group their capacity onto FilmBundleDraft's.
  countBundleTwoGroups(in: FilmBundleTwoGroupsInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBundleDraftService", method: "count", argMapping: "bundle: in"})
  # limits, renamed onto noSuchMember, fills nothing of FilmBundleDraft.
  countBundleRenamedGroup(in: FilmBundleRenamedGroupInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBundleDraftService", method: "count", argMapping: "bundle: in"})
  # title and name both write film's title.
  countRecordTwice(in: [FilmRecordTwiceInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # title, and details' aka nested below it, both write film's title.
  countRecordNestedTwice(in: [FilmRecordNestedTwiceInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # title and name write film's title; formerTitle, deprecated, is no writer.
  countRecordAliasTwice(in: [FilmRecordAliasTwiceInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # filmId is decoded into film_id, and id and key both write it too.
  countRecordDecodeTwice(in: [FilmRecordDecodeTwiceInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # extras, a list, cannot group onto a FilmRecord.
  countRecordListGroup(in: [FilmRecordListGroupInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  # count and tally both fill FilmSurvey's count through its setter.
  countSurveyTwice(in: FilmSurveyTwiceInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmSurveyService", method: "count", argMapping: "survey: in"})
  # PrivateDraftService.PrivateDraft is package-private: no generated code can construct it.
  countPrivateDraft(in: PrivateDraftInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.PrivateDraftService", method: "count", argMapping: "draft: in"})
  # title's @field names no member: the name is empty.
  countBlankNameDraft(in: [FilmDraftBlankNameInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService", method: "count", argMapping: "drafts: in"})
  # releaseYear fills no member, but the filter, not overridden, compares it as a column.
  filmsByPlainFilter(filter: FilmPlainFilterInput): [Film!]! @defaultOrder(primaryKey: true)
  filmsByTitleCells(cells: [FilmTitleCellInput!]): [Film!]! @defaultOrder(primaryKey: true)
  filmsByUntitledRecord(by: FilmUntitledInput): [Film!]! @defaultOrder(primaryKey: true)
    @condition(condition: {className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
      method: "filmTitleRecord", argMapping: "filter: by"}, override: true)
  filmsByNestedFilter(filter: FilmNestedFilterInput): [Film!]! @defaultOrder(primaryKey: true)
  actorFilms(filter: ActorFilmFilter!): [ActorFilm!]
    @routine(name: "films_for_actor",
             argMapping: "pActorId: filter.actorId, pMinLength: filter.minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  filmsByColumnSearch(search: FilmSearchColumnInput): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
      method: "filmSearchBean"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('BUILT_CLASS_UNBUILDABLE', 'CONDITION_PARAMETER_RECORD', 'MEMBER_UNKNOWN', 'GROUPING_LIST',
           'MEMBER_FILLED_TWICE', 'MEMBER_UNFILLED', 'COLUMN_UNRESOLVED', 'COLUMN_AMBIGUOUS',
           'NODE_ID_LANDS_ON_TABLE')
  """, rows: """
  coordinate,                          code,                       detail
  Query.countAbstractDraft(in:),       BUILT_CLASS_UNBUILDABLE,    no.sikt.graphitron.rewrite.test.services.AbstractFilmDraft
  Query.countPrivateDraft(in:),        BUILT_CLASS_UNBUILDABLE,    no.sikt.graphitron.rewrite.test.services.PrivateDraftService$PrivateDraft
  Query.filmsByRecord(by:),            CONDITION_PARAMETER_RECORD, no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord
  FilmDraftExtraInput.subtitle,        MEMBER_UNKNOWN,             no.sikt.graphitron.rewrite.test.services.FilmDraft
  FilmSearchMisspeltInput.Length,      MEMBER_UNKNOWN,             no.sikt.graphitron.rewrite.test.conditions.FilmSearchFilter
  FilmSearchMisspeltInput.subtitle,    MEMBER_UNKNOWN,             no.sikt.graphitron.rewrite.test.conditions.FilmSearchFilter
  FilmBundleExtrasInput.extras,        GROUPING_LIST,              no.sikt.graphitron.rewrite.test.services.FilmBundleDraft
  FilmDraftTwiceInput.title,           MEMBER_FILLED_TWICE,        no.sikt.graphitron.rewrite.test.services.FilmDraft#title
  FilmRecordExtraInput.subtitle,       COLUMN_UNRESOLVED,          subtitle
  PeriodLeaves.starts,                 COLUMN_UNRESOLVED,          "starts, under period, named like the embeddable period of embedded_period, which an input does not bind to yet"
  SpanLeaves.starts,                   COLUMN_UNRESOLVED,          starts
  FilmPlainFilterInput.nope,           COLUMN_UNRESOLVED,          nope
  FilmTitleCellInput.nope,             COLUMN_UNRESOLVED,          nope
  FilmInnerFilterInput.nope,           COLUMN_UNRESOLVED,          nope
  ActorFilmFilter.foo,                 COLUMN_UNRESOLVED,          foo
  FilmBundleLimitsInput.capacity,      MEMBER_FILLED_TWICE,        no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#capacity
  FilmBundleQuotaInput.capacity,       MEMBER_FILLED_TWICE,        no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#capacity
  FilmBundleRenamedGroupInput.limits,  MEMBER_UNKNOWN,             no.sikt.graphitron.rewrite.test.services.FilmBundleDraft
  FilmRecordTwiceInput.title,          MEMBER_FILLED_TWICE,        title
  FilmRecordNestedTwiceInput.title,    MEMBER_FILLED_TWICE,        title
  FilmRecordAliasTwiceInput.title,     MEMBER_FILLED_TWICE,        title
  FilmRecordDecodeTwiceInput.key,      MEMBER_FILLED_TWICE,        film_id
  FilmRecordListGroupInput.extras,     GROUPING_LIST,              no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord
  FilmSurveyTwiceInput.tally,          MEMBER_FILLED_TWICE,        no.sikt.graphitron.rewrite.test.services.FilmSurvey#count
  FilmDraftBlankNameInput.title,       MEMBER_UNKNOWN,             no.sikt.graphitron.rewrite.test.services.FilmDraft
  Query.countBundleExtras(in:),        MEMBER_UNFILLED,            no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#capacity
  Query.countBundleCapacityTwice(in:), MEMBER_UNFILLED,            no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#films
  Query.countBundleTwoGroups(in:),     MEMBER_UNFILLED,            no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#films
  Query.countBundleRenamedGroup(in:),  MEMBER_UNFILLED,            no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#capacity
  Query.countBlankNameDraft(in:),      MEMBER_UNFILLED,            no.sikt.graphitron.rewrite.test.services.FilmDraft#title
  Query.filmsByUntitledRecord(by:),    MEMBER_UNFILLED,            no.sikt.graphitron.rewrite.test.conditions.FilmTitleFilter#title
  FilmUntitledInput.note,              MEMBER_UNKNOWN,             no.sikt.graphitron.rewrite.test.conditions.FilmTitleFilter
  """)
