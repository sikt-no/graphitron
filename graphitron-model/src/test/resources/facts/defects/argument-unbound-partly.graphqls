# A @service argument the argMapping paths take only in part leaves the rest behind: the value a
# client sends there goes nowhere. reviewPartly maps review.filmId and review.rating to the method's
# parameters and leaves review.note, which is ARGUMENT_UNBOUND at the input field Review.note declares. reviewWhole leaves
# nothing behind, and neither field draws anything at the argument, which is taken in part.

input Review {
  filmId: Int
  rating: Int
  note: String
}

input ReviewCore {
  filmId: Int
  rating: Int
}

type FilmReviewPayload {
  reviewId: Int
}

# An overriding condition takes an argument in part the same way: filmsByNested's method reads
# filter.titlePrefix, so FilmNestedFilter.inner and FilmNestedFilter.titles are ARGUMENT_UNBOUND, the
# list once as the list, and nothing is reported at the fields inside them.
type Film @table(name: "film") { title: String }

input FilmNestedFilter { titlePrefix: String inner: FilmInnerFilter titles: [FilmTitleFilter!] }
input FilmInnerFilter { description: String length: Int }
input FilmTitleFilter { title: String }

type Query {
  filmsByNested(filter: FilmNestedFilter): [Film!]! @defaultOrder(primaryKey: true)
    @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition", argMapping: "titlePrefix: filter.titlePrefix"}, override: true)
}

# A routine write's input is judged the same way: rentFromInput maps in.inventoryId and in.customerId
# to rent_film's parameters and leaves in.reason behind, ARGUMENT_UNBOUND at RentInput.reason.
type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }
input RentInput { inventoryId: Int! customerId: Int! reason: String }

type Mutation {
  rentFromInput(in: RentInput!): [Rental!]!
    @routine(name: "rent_film", argMapping: "pInventoryId: in.inventoryId, pCustomerId: in.customerId")
    @reference(path: [{table: "rental"}])
  reviewPartly(review: Review!): FilmReviewPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService",
      method: "submit",
      argMapping: "filmId: review.filmId, rating: review.rating"})
  reviewWhole(review: ReviewCore!): FilmReviewPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService",
      method: "submit",
      argMapping: "filmId: review.filmId, rating: review.rating"})
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,             coordinate
  ARGUMENT_UNBOUND, Review.note
  ARGUMENT_UNBOUND, FilmNestedFilter.inner
  ARGUMENT_UNBOUND, FilmNestedFilter.titles
  ARGUMENT_UNBOUND, RentInput.reason
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,             coordinate
  ARGUMENT_UNBOUND, Mutation.reviewPartly(review:)
  ARGUMENT_UNBOUND, Review.filmId
  ARGUMENT_UNBOUND, Review.rating
  ARGUMENT_UNBOUND, Mutation.reviewWhole(review:)
  ARGUMENT_UNBOUND, ReviewCore.filmId
  ARGUMENT_UNBOUND, ReviewCore.rating
  ARGUMENT_UNBOUND, Query.filmsByNested(filter:)
  ARGUMENT_UNBOUND, FilmNestedFilter.titlePrefix
  ARGUMENT_UNBOUND, FilmInnerFilter.description
  ARGUMENT_UNBOUND, FilmInnerFilter.length
  ARGUMENT_UNBOUND, FilmTitleFilter.title
  ARGUMENT_UNBOUND, Mutation.rentFromInput(in:)
  ARGUMENT_UNBOUND, RentInput.inventoryId
  ARGUMENT_UNBOUND, RentInput.customerId
  """)
