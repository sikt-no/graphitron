# A routine that is found but cannot be the target is invalid the same way. The event and the payload
# are passed as text or JSON, so a routine whose only parameter is an integer cannot carry either,
# however the roles are bound: rental_count_for_customer takes one integer. A table-valued function is
# a table to the catalog and is called as one, so it is no target either.

extend schema @withConfiguration(
  outboxFunction: "rental_count_for_customer",
  outboxParameters: ["type=p_customer_id", "payload=p_customer_id"]
)
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  create(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                  coordinate,      detail
  OUTBOX_TARGET_INVALID, Mutation.create, "<function> rental_count_for_customer is not one procedure or function of the jOOQ catalog, no table, whose parameters are the type, text, and the payload, JSON, JSONB or text"
  """)

extend schema @assertEmpty(relation: "graphitron_outbox_routine_target")
