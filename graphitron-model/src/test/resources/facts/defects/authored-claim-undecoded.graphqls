# A claiming directive whose arguments do not decode still claims, at its application: a @routine
# without its name is a ROUTINE claim and a @mutation without its verb a WRITE claim, the refusal
# being a schema problem beside it. A repeated @routine is again one claim at its first application.
# @lookupKey written on a field rather than an argument claims nothing. The coordinates are the ones
# authored-claim-decoded decodes, so a graph's decode silences no claim of another's, and the
# positions below are the lines of this file below the prelude.

type Film @table(name: "film") {
  title: String
  routine: [Film!]! @routine
  mutation: Film @mutation
}

extend type Query {
  routine: [Film!]! @routine
  mutation: Film @mutation
  repeated: [Film!]!
    @routine
    @routine
  raw: Film @lookupKey
}

type Mutation {
  routine: [Film!]! @routine
  mutation: Film @mutation
}

type Subscription {
  routine: [Film!]! @routine
  mutation: Film @mutation
}

# Assembly refuses every bare @routine and @mutation, and the @lookupKey on a field.
extend schema @expectEquals(relation: "graphql_schema_problem", rows: """
  stage,    error_class,                           source_line
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  81
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  82
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  86
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  87
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  88
  ASSEMBLY, DirectiveIllegalLocationError,         91
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  95
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  96
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  100
  ASSEMBLY, DirectiveMissingNonNullArgumentError,  101
  """)

extend schema @expectEquals(relation: "graphitron_claim",
    where: "coordinate NOT IN ('Query.anchor', 'FactAnchor.paymentId', 'FactAnchor')", rows: """
  coordinate       , kind      , claimer          , source_line
  Film             , TABLE_TYPE, Film             , 79
  Mutation.mutation, WRITE     , Mutation.mutation, 96
  Mutation.routine , ROUTINE   , Mutation.routine , 95
  Query.repeated   , ROUTINE   , Query.repeated   , 89
  Query.routine    , ROUTINE   , Query.routine    , 86
  """)
