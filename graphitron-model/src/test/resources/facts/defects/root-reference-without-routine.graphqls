# A @reference on a root field with no @routine written before it. A root field has no source row,
# so the path departs from nothing, and the field is told that, at the @reference, rather than the
# chain break its first element would otherwise draw. A @routine written first gives the path its
# start, and the same @reference after it draws nothing.

type Film @table(name: "film") @node {
  title: String
}

type Store @table(name: "store") {
  storeId: Int @field(name: "store_id")
}

extend type Query {
  storeForFilm(id: ID! @nodeId(typeName: "Film")): [Store!]! @reference(path: [
    {key: "inventory_film_id_fkey"},
    {key: "inventory_store_id_fkey"}
  ])
  hopped(actorId: Int!, minLength: Int!): [Film!]!
    @routine(name: "public.films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @reference(path: [{table: "film"}])
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                           coordinate
  ROOT_REFERENCE_WITHOUT_ROUTINE, Query.storeForFilm
  """)

# One defect for the field: none of the three chain breaks beside it.
extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,                           coordinate
  NO_ROUTE_FROM_DEPARTURE,        Query.storeForFilm
  ELEMENT_UNRESOLVED,             Query.storeForFilm
  NO_ROUTE_TO_TARGET,             Query.storeForFilm
  ROOT_REFERENCE_WITHOUT_ROUTINE, Query.hopped
  """)
