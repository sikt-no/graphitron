# A named type bound by a bare name two schemas declare binds no table, which is a defect at the
# type rather than a picked table.

type Film @table(name: "film") { title: String }

# Bound to a bare name two schemas declare, so it binds nothing.
type Venue @table(name: "event") { name: String }

type Report { text: String }

type Query {
  films(inActor: ID, title: String): [Film!]!
  pagedFilms(inActor: ID): [Film!]! @asConnection
  venues(inActor: ID): [Venue!]!
  report(since: String): Report
}

type Mutation {
  deleteFilm(id: ID): Boolean @mutation(typeName: DELETE, table: "film")
  createFilm(title: String): Film @mutation(typeName: INSERT, table: "actor")
  createVenue(name: String): Venue @mutation(typeName: INSERT, table: "film")
}

# A bare name two schemas declare binds no table.
extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,            coordinate
  TABLE_AMBIGUOUS, Venue
  """)
