# Decodes whose reach resolves short of the node type's table, each with its navigation beside the
# hops it did get, since an empty hop set means a stopped chain here and not identity. Two keys from
# film to language are two predicates, so discovery answers nothing; the one key film_actor declares
# toward film is discovered against its direction, a hop that departs film's referenced column and so
# lands no key position on film. An authored chain carries the hops it
# reached and no more, an input field's own path walked from its use site's table. A node type whose
# table name two schemas hold has no arrival at all.

interface Node { id: ID! }

type Film @table(name: "film") {
  title: String
}

type Language implements Node @table(name: "language") @node {
  id: ID!
}

type FilmActor implements Node @table(name: "film_actor") {
  id: ID!
}

type Category implements Node @table(name: "category") @node {
  id: ID!
}

type Event implements Node @table(name: "event") @node {
  id: ID!
}

input FilmInput {
  inCategory: ID @nodeId(typeName: "Category") @reference(path: [{key: "film_category_film_id_fkey"}])
}

type Query {
  films(
    languageId: ID @nodeId(typeName: "Language"),
    castEntryId: ID @nodeId(typeName: "FilmActor"),
    inCategory: ID @nodeId(typeName: "Category") @reference(path: [{key: "film_category_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}]),
    atEvent: ID @nodeId(typeName: "Event")
  ): [Film]
}

type Mutation {
  updateFilm(in: FilmInput): Film @mutation(typeName: UPDATE)
}

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                          bound,             position, node_type_name, column_name
  Mutation.updateFilm(in.inCategory:), public.category,   0,        Category,       category_id
  Query.films(castEntryId:),           public.film_actor, 0,        FilmActor,      actor_id
  Query.films(castEntryId:),           public.film_actor, 1,        FilmActor,      film_id
  Query.films(inCategory:),            public.category,   0,        Category,       category_id
  Query.films(languageId:),            public.language,   0,        Language,       language_id
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                          position, from_table, to_table
  Mutation.updateFilm(in.inCategory:), 0,        film,       film_category
  Query.films(castEntryId:),           0,        film,       film_actor
  Query.films(inCategory:),            0,        film,       film_category
  """)
