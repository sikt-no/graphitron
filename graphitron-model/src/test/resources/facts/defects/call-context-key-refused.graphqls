# A $context pair binds a parameter to the value the request context carries under a key, which may
# be spelt apart from the parameter. A @service reads it; a @condition does not yet, so there the pair
# is refused as unsupported, a deferral rather than an author error, while the store still states
# what it fills. A pair not written as one parameter and exactly one key fills nothing at any site and
# is the author's to fix: nothing after the dot, a second dot, or $tenant on its left. A parameter
# given a key twice, by two contextArguments elements or by an element and a pair, is filled by
# neither: each writing is a row, none written once.

type Customer @table(name: "customer") { firstName: String @field(name: "first_name") }

type Query {
  # The pair fills userId from the key viewerId, and is refused at this site.
  customersByPair: [Customer!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "customerSeenByUser", argMapping: "userId: $context.viewerId"})
  # userId twice in contextArguments: a row and a defect at each element, neither written once.
  twiceListed: String @service(service: {className: "example.Ref", method: "m"},
      contextArguments: ["userId", "userId"])
  # userId by an element and by a pair: a row and a defect at each, neither written once.
  listedAndPaired: String @service(service: {
      className: "example.Ref", method: "m", argMapping: "userId: $context.userId"},
      contextArguments: ["userId"])
  # No key after the dot, two keys, and a key under $tenant: each refused, and none a row.
  noKey: String @service(service: {
      className: "example.Ref", method: "m", argMapping: "userId: $context."})
  twoKeys: String @service(service: {
      className: "example.Ref", method: "m", argMapping: "userId: $context.a.b"})
  tenantKey: String @service(service: {
      className: "example.Ref", method: "m", argMapping: "$tenant: $context.tenantId"})
}

extend schema @expectEquals(relation: "graphitron_call_context_key", rows: """
  coordinate,            parameter_name, context_key, origin,            origin_position, written_once
  Query.customersByPair, userId,         viewerId,    PAIR,              0,               TRUE
  Query.twiceListed,     userId,         userId,      CONTEXT_ARGUMENTS, 0,               FALSE
  Query.twiceListed,     userId,         userId,      CONTEXT_ARGUMENTS, 1,               FALSE
  Query.listedAndPaired, userId,         userId,      PAIR,              0,               FALSE
  Query.listedAndPaired, userId,         userId,      CONTEXT_ARGUMENTS, 0,               FALSE
  """)

extend schema @expectEquals(relation: "graphitron_argmapping_pair_defect", rows: """
  code,                     detail,            position
  CONTEXT_SITE_UNSUPPORTED, $context.viewerId, 0
  CONTEXT_KEY_DUPLICATE,    userId,            0
  CONTEXT_KEY_MALFORMED,    $context.,         0
  CONTEXT_KEY_MALFORMED,    $context.a.b,      0
  CONTEXT_KEY_MALFORMED,    $context.tenantId, 0
  """)

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                     coordinate
  CONTEXT_SITE_UNSUPPORTED, Query.customersByPair
  CONTEXT_KEY_DUPLICATE,    Query.listedAndPaired
  CONTEXT_KEY_DUPLICATE,    Query.twiceListed
  CONTEXT_KEY_MALFORMED,    Query.noKey
  CONTEXT_KEY_MALFORMED,    Query.twoKeys
  CONTEXT_KEY_MALFORMED,    Query.tenantKey
  """)

# A @service reads the pair, so the one beside contextArguments draws only its duplicate.
extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,                     coordinate
  CONTEXT_SITE_UNSUPPORTED, Query.listedAndPaired
  """)
