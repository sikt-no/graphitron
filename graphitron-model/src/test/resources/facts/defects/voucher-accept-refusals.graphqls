extend schema @withConfiguration(sessionState: true)

"The accepting side's refusals the voucher stage decides, each at the @accept. A type is marked once, @issue or @accept, and the name Graphitron mints the voucher field under is its own; the vouchesFor names fields of the accepting type, once each, never the voucher field or a nested selection, and name at least one."
# Refused at each marker; and as the @issue absorbs every field, the accept's vouched-for field names a
# member, which is no field of the type.
type Both @table(name: "film") @issue(scope: "s", ttl: "PT5M", vouchesFor: "filmId") @accept(scope: "s", vouchesFor: "filmId") {
  filmId: ID @field(name: "film_id")
}

# A field the author names _voucher is refused at the @accept, never taken for the voucher field.
type Taken @table(name: "language") @key(fields: "languageId") @accept(scope: "s", vouchesFor: "name") {
  languageId: Int @field(name: "language_id")
  name: String
  _voucher: String
}

type NoClaims @table(name: "country") @key(fields: "countryId") @accept(scope: "s", vouchesFor: "") {
  countryId: Int @field(name: "country_id")
}

type Repeated @table(name: "category") @key(fields: "categoryId") @accept(scope: "s", vouchesFor: "name name") {
  categoryId: Int @field(name: "category_id")
  name: String
}

# A name the type does not declare, the minted voucher field, and a nested selection: one row, naming the
# first by name.
type NotAField @table(name: "city") @key(fields: "cityId") @accept(scope: "s", vouchesFor: "_voucher nosuch city { x }") {
  cityId: Int @field(name: "city_id")
  city: String
}

extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

type Query {
  cities: [NotAField!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('VOUCHER_MARKERS_BOTH', 'VOUCHER_FIELD_NAME_TAKEN', 'VOUCHER_VOUCHES_FOR_EMPTY',
           'VOUCHER_VOUCHED_FOR_REPEATED', 'VOUCHER_VOUCHED_FOR_NOT_A_FIELD')
  """, rows: """
  code,                            type_name, detail
  VOUCHER_VOUCHES_FOR_EMPTY,       NoClaims,  NoClaims
  VOUCHER_VOUCHED_FOR_NOT_A_FIELD, Both,      filmId
  VOUCHER_VOUCHED_FOR_NOT_A_FIELD, NotAField, _voucher
  VOUCHER_VOUCHED_FOR_REPEATED,    Repeated,  name
  VOUCHER_MARKERS_BOTH,            Both,      Both
  VOUCHER_MARKERS_BOTH,            Both,      Both
  VOUCHER_FIELD_NAME_TAKEN,        Taken,     Taken._voucher
  """)

# A type marked both is given the issuing voucher field, which absorbs what it declares; a type whose
# author took the name keeps the authored field, and is given none.
extend schema @expectEquals(relation: "graphitron_voucher_field", where: "type_name IN ('Both', 'Taken')", rows: """
  type_name, role
  Both,      ISSUE
  """)

# The repeated field's first naming still resolves; a vouched-for field naming no field draws no row.
extend schema @assertAbsent(relation: "graphitron_accept_vouched_for", rows: """
  type_name, field_name
  NotAField, city
  NotAField, _voucher
  """)
