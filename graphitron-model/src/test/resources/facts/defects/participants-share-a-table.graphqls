# Participants told apart by their tables must be on tables of their own. FilmPoster and FilmStill
# are both rows of film, so Query.filmImages, returning their union, is PARTICIPANTS_SHARE_A_TABLE,
# named at the participant after the first; the interface FilmPicture over the same two types is
# refused alike. Query.cast, a union of Film and Actor, is the near miss: one table each. So is
# Query.node, whose fetcher tells FilmPoster and FilmStill apart by the id's type id, not the table.

interface Node { id: ID! }

type FilmPoster implements FilmPicture & Node @table(name: "film") @node(typeId: "FP") {
    id: ID!
    title: String
}

type FilmStill implements FilmPicture & Node @table(name: "film") @node(typeId: "FS") {
    id: ID!
    title: String
}

type Film @table(name: "film") {
    title: String
}

type Actor @table(name: "actor") {
    firstName: String @field(name: "first_name")
}

interface FilmPicture {
    title: String
}

union FilmImage = FilmPoster | FilmStill

union Cast = Film | Actor

type Query {
    filmImages: [FilmImage!]!
    filmPictures: [FilmPicture!]!
    cast: [Cast!]!
    node(id: ID!): Node
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'PARTICIPANTS_SHARE_A_TABLE'", rows: """
  code,                       coordinate,         detail
  PARTICIPANTS_SHARE_A_TABLE, Query.filmImages,   FilmStill
  PARTICIPANTS_SHARE_A_TABLE, Query.filmPictures, FilmStill
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_participant",
    where: "coordinate IN ('Query.cast', 'Query.node')", rows: """
  coordinate, participant_type, recognized_by, table_name
  Query.cast, Actor,            TABLE,         actor
  Query.cast, Film,             TABLE,         film
  Query.node, FilmPoster,       TABLE,         film
  Query.node, FilmStill,        TABLE,         film
  """)
