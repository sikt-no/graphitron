# A tenant named in a build with no tenant column: nothing routes by a tenant there, so @tenant on a
# root @service's argument and a $tenant pair in a @condition's argMapping are each refused as naming
# nothing, the condition's no longer as a site not supported yet; a $tenant pair in a @service's is
# refused the same way, as tenant-routes-nothing pins. The same call naming no tenant draws nothing.

type Film @table(name: "film") { title: String }

type Query {
  filmMarked(id: Int! @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById"})
  film(id: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById"})
  filmsOnCondition(filmId: Int): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals", argMapping: "$tenant: filmId"}, override: true)
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code LIKE 'TENANT%'", rows: """
  code,                  coordinate,             detail
  TENANT_ROUTES_NOTHING, Query.filmMarked(id:),
  TENANT_ROUTES_NOTHING, Query.filmsOnCondition,
  """)
