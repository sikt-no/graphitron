# A list read inline in the orders a client composes: the store states each choice and the
# projection emitter applies the one picked, but graphitron's generated fetchers do not render it
# until the store's units replace them, so the choice stays refused where the argument is written.

type Film @table(name: "film") {
    title: String
}

type Category @table(name: "category") {
    name: String
    # By its primary key where the client picks nothing.
    filmsChosen(order: [FilmOrderBy!] @orderBy): [Film!]! @reference(path: [{table: "film_category"}, {table: "film"}])
}

input FilmOrderBy {
    field:     FilmSort!
    direction: SortDirection
}

enum FilmSort {
    # Ascending, so a client's direction reverses it.
    LENGTH @order(fields: [{name: "length"}, {name: "film_id"}])
    # Written descending, so a client's direction leaves it.
    TITLE  @order(fields: [{name: "title", direction: DESC}])
    # Compared under the collation written, which the database applies as given.
    NAME_C @order(fields: [{name: "title", collate: "C"}])
}

type Query {
    categories: [Category!]!
}

extend schema @expectEquals(relation: "graphitron_occurrence_order", where: "coordinate = 'Category.filmsChosen'", rows: """
  choice,                        kind,    surface,              argument_coordinate
  Category.filmsChosen,          DEFAULT, IMPLICIT_PRIMARY_KEY,
  FilmSort.LENGTH,               CHOICE,  FIELDS,               Category.filmsChosen(order:)
  FilmSort.NAME_C,               CHOICE,  FIELDS,               Category.filmsChosen(order:)
  FilmSort.TITLE,                CHOICE,  FIELDS,               Category.filmsChosen(order:)
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect", rows: """
  source_line, code
  12,          ORDER_CHOICE_ON_INLINE_LIST
  """)
