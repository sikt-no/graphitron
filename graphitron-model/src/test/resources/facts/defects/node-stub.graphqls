# A node this subgraph does not resolve, @node(resolvable: false), another subgraph owning it: a node
# like any other, implementing Node, its id resolving on the node tiers and binding like any node's.
# Leaving the interface out is a defect as on any @node, and so is naming a type of its shape that
# leaves the directive out. study_level's class publishes type id StudyLevel and key code.

interface Node { id: ID! }

# Answering to the id its table's class publishes.
type Level implements Node @table(name: "study_level") @node(resolvable: false) { id: ID! code: String }

# Pinning its own type id.
type PinnedLevel implements Node @table(name: "study_level") @node(typeId: "LV", resolvable: false) {
  id: ID!
  code: String
}

# Its shape without the directive: a @table type over a table publishing node metadata.
type BareLevel @table(name: "study_level") { code: String }

# A node this subgraph resolves, for contrast.
type Film implements Node @table(name: "film") @node { id: ID! }

type Interval @table(name: "level_interval") { intervalId: Int @field(name: "interval_id") }

input IntervalFilter {
  "Names the stub, its path landing on the stub's table."
  fromLevel: ID @nodeId(typeName: "Level") @reference(path: [{key: "level_interval_from_level_fkey"}])
  "Names the stub's shape left undeclared."
  toLevel: ID @nodeId(typeName: "BareLevel") @reference(path: [{key: "level_interval_to_level_fkey"}])
}

type Query {
  intervals(where: IntervalFilter): [Interval!]!
  levels: [Level!]!
  pinnedLevels: [PinnedLevel!]!
  bareLevels: [BareLevel!]!
  films: [Film!]!
}

extend schema @expectEquals(relation: "graphitron_node", rows: """
  type_name,          type_id,    type_id_origin, resolvable
  Film,               Film,       TYPE_NAME,      TRUE
  Level,              StudyLevel, JOOQ_METADATA,  FALSE
  PinnedLevel,        LV,         SDL_DECLARED,   FALSE
  """)

# Level and PinnedLevel carry the interface and draw nothing, BareLevel's name is their shape
# undeclared, and Level's binds clean. Leaving the interface out is entry-defect-node's.
extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('NODE_WITHOUT_NODE_INTERFACE', 'NODE_ID_TYPE_NAME_NOT_NODE',
           'NODE_ID_TYPE_NAME_UNDECLARED_STUB', 'NODE_ID_LANDS_ON_TABLE',
           'NODE_ID_LANDING_TYPE_DISAGREES')
  """, rows: """
  coordinate,             code,                              detail
  IntervalFilter.toLevel, NODE_ID_TYPE_NAME_UNDECLARED_STUB, BareLevel
  """)

# The stub's id binds against its key like any node's, its own id field and an id naming it alike.
extend schema @assertContains(relation: "graphitron_occurrence_node_id", rows: """
  coordinate,                        node_type_name, table_name,  column_name
  Level.id,                          Level,          study_level, code
  Query.intervals(where.fromLevel:), Level,          study_level, code
  """)
