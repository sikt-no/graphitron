# What the manual refuses of a @nodeId, one case per rule, each at the place an author edits: the
# @nodeId where one is written, the declaration where what is missing is a directive. film is
# Film's and FilmAlias's table, so a bare id over it names no one node, and plain_id has a column
# named id beside the id its node publishes.
#
# A bare @nodeId a @service takes as a table's generated record, as a parameter or a bean member,
# takes its node from the record's table, ahead of the field's return table, and is refused where
# that table has no one node; with no record and no table at all it is refused too. The record
# cases live here rather than among the scenarios because the walk, which generates those, still
# refuses a bare @nodeId it cannot infer from the return table.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID!
  "Not an ID: the directive would bind the wire value undecoded."
  titleId: String @nodeId(typeName: "Film")
}

type FilmAlias implements Node @table(name: "film") @node { id: ID! }

type Language implements Node @table(name: "language") @node {
  "A node's own id is its identity already; typeName: names what the type answers."
  id: ID! @nodeId(typeName: "Language")
}

type Inventory @table(name: "inventory") {
  "Bare on a type that is no node: nothing to inherit."
  filmNode: ID @nodeId
  "A type with no @node, and a name no type carries."
  storeId: ID @nodeId(typeName: "Store")
  nowhere: ID @nodeId(typeName: "Nope")
}

type Store @table(name: "store") { storeId: Int @field(name: "store_id") }

"Over film, which two nodes share, and no node itself."
type FilmCard @table(name: "film") { title: String }

input CardFilter { id: ID }

type FilmActor implements Node @table(name: "film_actor") @node { id: ID! }

input LanguagePairInput {
  language: ID! @nodeId
  alias: ID! @nodeId
}

input InventoryAssignmentInput { inventory: ID @nodeId }

type PlainNode implements Node @table(name: "plain_id") @node {
  "No directive, and plain_id has a column named id."
  id: ID!
}

input PlainFilter { id: ID }

"An input object marked @nodeId: what arrives is a map of its fields, no id to decode."
input NodeClaimInput { title: String, duration: DurationInput @nodeId(typeName: "Film") }
input DurationInput { minutes: Int }

type Query {
  "Lands on inventory, which no node declares itself over."
  inventories(filmId: ID @nodeId): [Inventory!]!
  "Lands on film, which two nodes declare themselves over."
  cards(filmId: ID @nodeId): [FilmCard!]!
  "An input id named for its target, over film."
  cardsBy(where: CardFilter): [FilmCard!]!
  "An input id named for its target, over plain_id."
  plains(where: PlainFilter): [PlainNode!]!
  films: [Film!]!
  filmAliases: [FilmAlias!]!
  languages: [Language!]!
  filmActors: [FilmActor!]!
  "A FilmActorRecord parameter: film_actor's one node, though the field returns no table."
  modifyFilmActor(in: ID! @nodeId): String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService", method: "modifyFilmActorRecord"})
  "A FilmRecord parameter, over film, which two nodes declare themselves over."
  modifyCard(in: ID! @nodeId): String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService", method: "modifyFilmRecord"})
  "A bean's two LanguageRecord members: language's one node each."
  assignLanguages(in: LanguagePairInput!): String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignLanguagePair"})
  "The same members under a field returning film's rows: the records decide, where the return table would name no one node."
  languagePairCards(in: LanguagePairInput!): [FilmCard!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignLanguagePair"})
  "A bean's InventoryRecord member, over inventory, which no node declares itself over."
  assignInventory(in: InventoryAssignmentInput!): String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignInventoryRecord"})
  claim(in: NodeClaimInput): String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmThrowingService", method: "titleOrRuntime"})
  "An Integer parameter and a field returning no table: nothing to take the node from."
  titleOf(id: ID! @nodeId): String @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmThrowingService", method: "titleOrRuntime"})
}

input InventoryKey { inventoryId: Int @field(name: "inventory_id") }
input FilmKey { filmId: Int @field(name: "film_id") }

type Mutation {
  "Returns the ID of a row of inventory, which no node declares itself over."
  deleteInventory(in: InventoryKey!): ID @mutation(typeName: DELETE, table: "inventory")
  "Returns the ID of a row of film, which two nodes declare themselves over."
  deleteFilmCard(in: FilmKey!): ID @mutation(typeName: DELETE, table: "film")
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code LIKE 'NODE_ID_%'
  """, rows: """
  coordinate,                 code,                             detail
  CardFilter.id,              NODE_ID_TARGET_AMBIGUOUS,         Query.cardsBy(where.id:)
  InventoryAssignmentInput.inventory, NODE_ID_TARGET_UNRESOLVED, Query.assignInventory(in.inventory:)
  Film.titleId,               NODE_ID_NOT_ID_TYPE,              String
  NodeClaimInput.duration,    NODE_ID_NOT_ID_TYPE,              DurationInput
  Inventory.filmNode,         NODE_ID_CONTAINING_TYPE_NOT_NODE, Inventory
  Inventory.nowhere,          NODE_ID_TYPE_NAME_NOT_NODE,       Nope
  Inventory.storeId,          NODE_ID_TYPE_NAME_NOT_NODE,       Store
  Language.id,                NODE_ID_TYPE_NAME_ON_OWN_ID,      Language
  Mutation.deleteFilmCard,    NODE_ID_TARGET_AMBIGUOUS,         Mutation.deleteFilmCard
  Mutation.deleteInventory,   NODE_ID_TARGET_UNRESOLVED,        Mutation.deleteInventory
  PlainFilter.id,             NODE_ID_SHADOWS_COLUMN,           id
  PlainNode.id,               NODE_ID_SHADOWS_COLUMN,           id
  Query.cards(filmId:),       NODE_ID_TARGET_AMBIGUOUS,         Query.cards(filmId:)
  Query.inventories(filmId:), NODE_ID_TARGET_UNRESOLVED,        Query.inventories(filmId:)
  Query.modifyCard(in:),      NODE_ID_TARGET_AMBIGUOUS,         Query.modifyCard(in:)
  Query.titleOf(id:),         NODE_ID_TARGET_UNRESOLVED,        Query.titleOf(id:)
  """)

# A record a @service takes decides the node, whatever the field returns.
extend schema @assertContains(relation: "graphitron_occurrence_node_id", rows: """
  coordinate,                               basis,                  node_type_name
  Query.modifyFilmActor(in:),               RECORD_TABLE_NODE_TYPE, FilmActor
  Query.assignLanguages(in.language:),      RECORD_TABLE_NODE_TYPE, Language
  Query.assignLanguages(in.alias:),         RECORD_TABLE_NODE_TYPE, Language
  Query.languagePairCards(in.language:),    RECORD_TABLE_NODE_TYPE, Language
  """)

# Neither a node id nor a column where the id shadows one.
extend schema @assertAbsent(relation: "graphitron_occurrence_node_id", rows: """
  coordinate
  PlainNode.id
  Query.plains(where.id:)
  """)
