# A @nodeId(typeName:) naming a multitable union or interface: one instruction per use site, every
# member reported with its two flags, the record supertype a slot is assignable from, and the
# verdicts that refuse the decode. The incumbent per-node-type defect view stays quiet on every
# such slot, since the container resolves no key shape for it to read.

type Customer @table(name: "customer") @node {
  firstName: String @field(name: "first_name")
  # An output field encodes, and a container has nothing to encode from.
  occupantId: ID @nodeId(typeName: "AddressOccupant")
}
type Staff @table(name: "staff") @node { firstName: String @field(name: "first_name") }
# Table-bound and not a node type.
type Rental @table(name: "rental") { rentalId: Int @field(name: "rental_id") }
# Binds no table.
type Ghost { name: String }
# film_list has no primary key, so its record is a TableRecord and not an UpdatableRecord.
type FilmListing @table(name: "film_list") @node(keyColumns: ["title"]) { title: String }

union AddressOccupant = Customer | Staff
union SoleOccupant = Customer
union WithRental = Customer | Staff | Rental
union MixedOccupant = Customer | Staff | Rental | Ghost
union Anything = Ghost
union KeylessOccupant = Customer | FilmListing
# Two node types over one table: neither binds, the id's decode not knowing which a key names.
type CustomerAlias @table(name: "customer") @node { firstName: String @field(name: "first_name") }
union SharedOccupant = Customer | CustomerAlias

# A single-table interface: the container binds a table itself.
interface MediaItem @table(name: "film") { title: String }
type Film @table(name: "film") @node { title: String }
type Inventory @table(name: "inventory") { inventoryId: Int @field(name: "inventory_id") }

input MediaFilter {
  filmId: ID @nodeId(typeName: "Film")
  itemId: ID @nodeId(typeName: "MediaItem")
}

input OccupantFilter {
  customerId: ID @nodeId(typeName: "Customer")
  occupantId: ID @nodeId(typeName: "AddressOccupant")
}

# A container id inside an input a @service takes, the bean's member being a record supertype every
# member's record has, single and as a list.
input OccupantRecordAssignmentInput {
  occupant: ID! @nodeId(typeName: "AddressOccupant")
}
input OccupantRecordListAssignmentInput {
  occupants: [ID!] @nodeId(typeName: "AddressOccupant")
}

type Query {
  # The container ids inside a @service's input, decoded at the bean's member.
  assignOccupantRecord(in: OccupantRecordAssignmentInput!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantRecord"})
  assignOccupantRecordList(in: OccupantRecordListAssignmentInput!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantRecordList"})
  # A slot typed as a record supertype every member's record has.
  occupant(occupant: ID @nodeId(typeName: "AddressOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantByArgument"})
  # One admissible member: what makes a decode polymorphic is the type named, not the count.
  sole(occupant: ID @nodeId(typeName: "SoleOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantByArgument"})
  # One member's record failing the ancestry test refuses the whole slot.
  keyless(occupant: ID @nodeId(typeName: "KeylessOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantByArgument"})
  # A List of the supertype lands each id on an element.
  keys(keys: [ID!] @nodeId(typeName: "AddressOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantsByMapping"})
  # A Set is refused on the shape, before any member is compared.
  titleTitlecase(films: [ID!] @nodeId(typeName: "AddressOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleTitlecase"})
  withRental(occupant: ID @nodeId(typeName: "WithRental")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantByArgument"})
  anything(occupant: ID @nodeId(typeName: "Anything")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantByArgument"})
  media(occupant: ID @nodeId(typeName: "MediaItem")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantByArgument"})
  # The container and a node type at one read-side field, as arguments and as input fields ...
  mediaItems(item: ID @nodeId(typeName: "MediaItem"), film: ID @nodeId(typeName: "Film"), filter: MediaFilter): [MediaItem!]!
  # ... and under a written path that stops short of film.
  inventories(item: ID @nodeId(typeName: "MediaItem") @reference(path: [{key: "inventory_store_id_fkey"}]),
      film: ID @nodeId(typeName: "Film") @reference(path: [{key: "inventory_store_id_fkey"}])): [Inventory!]!
  # No parameter is fed: the value would bind a table predicate.
  occupants(occupant: ID @nodeId(typeName: "AddressOccupant")): [Customer!]!
  # A producer class the classpath census never reached: the verdict stands aside.
  unread(occupant: ID @nodeId(typeName: "AddressOccupant")): String
    @service(service: {className: "no.example.Svc", method: "get"})
  # An input field under a generated fetch field, beside a node-typed sibling.
  filtered(filter: OccupantFilter): [Customer!]!
  # A slot typed as neither a record nor a key column's type.
  greet(userId: ID @nodeId(typeName: "AddressOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet"})
  # The same slot over members sharing a table: no member binds, so no member is refused either.
  shared(userId: ID @nodeId(typeName: "SharedOccupant")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet"})
}

# Each refusal is one defect at the @nodeId, an input field's at its declaration.
extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('NODE_ID_CONTAINER_NOT_AT_A_SLOT', 'NODE_ID_SINGLE_TABLE_CONTAINER', 'NODE_ID_NO_TABLE_MEMBERS', 'NODE_ID_MEMBER_NOT_NODE_TYPE', 'NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER', 'NODE_ID_SLOT_SHAPE_MISMATCH')
  """, rows: """
  coordinate,                   code
  Customer.occupantId,          NODE_ID_CONTAINER_NOT_AT_A_SLOT
  MediaFilter.itemId,           NODE_ID_CONTAINER_NOT_AT_A_SLOT
  OccupantFilter.occupantId,    NODE_ID_CONTAINER_NOT_AT_A_SLOT
  Query.anything(occupant:),    NODE_ID_NO_TABLE_MEMBERS
  Query.greet(userId:),         NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER
  Query.inventories(item:),     NODE_ID_CONTAINER_NOT_AT_A_SLOT
  Query.keyless(occupant:),     NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER
  Query.media(occupant:),       NODE_ID_SINGLE_TABLE_CONTAINER
  Query.mediaItems(item:),      NODE_ID_CONTAINER_NOT_AT_A_SLOT
  Query.occupants(occupant:),   NODE_ID_CONTAINER_NOT_AT_A_SLOT
  Query.titleTitlecase(films:), NODE_ID_SLOT_SHAPE_MISMATCH
  Query.withRental(occupant:),  NODE_ID_MEMBER_NOT_NODE_TYPE
  """)

# The members a per-member defect names, beneath it; the members sharing a table name none.
extend schema @expectEquals(relation: "graphitron_entry_defect_member", rows: """
  code,                                 member_type_name
  NODE_ID_MEMBER_NOT_NODE_TYPE,         Rental
  NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER, Customer
  NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER, FilmListing
  NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER, Staff
  """)

# A container id inside a @service's input reaches a slot, and its members' records are the member's
# type: no verdict.
extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: """
  coordinate LIKE 'OccupantRecord%' AND code LIKE 'NODE_ID_%'
  """)

# The disjointness: no container draws a single node's key verdict.
extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: """
  code IN ('NODE_ID_KEY_ARITY_EXCEEDS_SLOT', 'NODE_ID_KEY_COLUMN_TYPE_DISAGREEMENT')
  """)

# A container id at a bean's member decodes into each member's own record as the member's record
# supertype, as it does at a parameter.
extend schema @assertContains(relation: "graphitron_occurrence_node_id_shape", rows: """
  coordinate,                                    bound,           decode_shape
  Query.assignOccupantRecord(in.occupant:),      public.customer, SUPERTYPE
  Query.assignOccupantRecord(in.occupant:),      public.staff,    SUPERTYPE
  Query.assignOccupantRecordList(in.occupants:), public.customer, SUPERTYPE
  Query.assignOccupantRecordList(in.occupants:), public.staff,    SUPERTYPE
  Query.occupant(occupant:),                     public.customer, SUPERTYPE
  """)

# Which claims name a container, an interface or union that is no node itself: at an argument and at
# an input field alike, and not where the same element shape names a node type.
extend schema @assertContains(relation: "graphitron_binding_claim_container", rows: """
  coordinate
  Query.occupant(occupant:)
  OccupantRecordAssignmentInput.occupant
  """)
extend schema @assertAbsent(relation: "graphitron_binding_claim_container", rows: """
  coordinate
  Query.mediaItems(film:)
  OccupantFilter.customerId
  """)

# A container's slot is one, the parameter the argument is named for, and inside a @service's input
# the member of the bean its input object is built into.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot", where: """
  coordinate IN ('Query.occupant(occupant:)', 'Query.greet(userId:)')
     OR coordinate LIKE 'Query.assignOccupant%'
  """, rows: """
  coordinate,                                    kind,      slot_shape, landing_class
  Query.assignOccupantRecord(in.occupant:),      MEMBER,    SINGLE,     org.jooq.UpdatableRecord
  Query.assignOccupantRecordList(in.occupants:), MEMBER,    LIST,       org.jooq.UpdatableRecord
  Query.greet(userId:),                          PARAMETER, SINGLE,     java.lang.String
  Query.occupant(occupant:),                     PARAMETER, SINGLE,     org.jooq.UpdatableRecord
  """)

# A container binding a table itself binds no node id, at an argument, at an input field or under a
# written path, while a node type at the same coordinates does, and so does a multi-table container
# beside it, once per member node as the case below states.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate LIKE 'Query.mediaItems%' OR coordinate LIKE 'Query.inventories%' OR coordinate LIKE 'Query.filtered%'", rows: """
  coordinate,                         bound,           position, basis,              node_type_name, column_name
  Query.filtered(filter.customerId:), public.customer, 0,        EXPLICIT_TYPE_NAME, Customer,       customer_id
  Query.filtered(filter.occupantId:), public.customer, 0,        EXPLICIT_TYPE_NAME, Customer,       customer_id
  Query.filtered(filter.occupantId:), public.staff,    0,        EXPLICIT_TYPE_NAME, Staff,          staff_id
  Query.inventories(film:),           public.film,     0,        EXPLICIT_TYPE_NAME, Film,           film_id
  Query.mediaItems(film:),            public.film,     0,        EXPLICIT_TYPE_NAME, Film,           film_id
  Query.mediaItems(filter.filmId:),   public.film,     0,        EXPLICIT_TYPE_NAME, Film,           film_id
  """)

# So the path that stops short is judged for the node type, and the container beside it is refused as
# no slot.
extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  coordinate LIKE 'Query.inventories%' AND code LIKE 'NODE_ID_%'
  """, rows: """
  coordinate,               code,                             detail
  Query.inventories(film:), NODE_ID_LANDS_ON_TABLE,           public.store
  Query.inventories(item:), NODE_ID_CONTAINER_NOT_AT_A_SLOT, MediaItem
  """)


# A container named by typeName: binds once per member node, on that member's own table; a member
# that is no node binds nothing.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: """
  coordinate IN ('Query.occupant(occupant:)', 'Query.withRental(occupant:)')
  """, rows: """
  coordinate,                  bound,           position, basis,              node_type_name, column_name
  Query.occupant(occupant:),   public.customer, 0,        EXPLICIT_TYPE_NAME, Customer,       customer_id
  Query.occupant(occupant:),   public.staff,    0,        EXPLICIT_TYPE_NAME, Staff,          staff_id
  Query.withRental(occupant:), public.customer, 0,        EXPLICIT_TYPE_NAME, Customer,       customer_id
  Query.withRental(occupant:), public.staff,    0,        EXPLICIT_TYPE_NAME, Staff,          staff_id
  """)
