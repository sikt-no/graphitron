# A $session source an @outbox cannot carry is reported at the entry, as every directive's sources are.
# A member found whose type a JSON payload cannot carry, and the whole handle, are sources that exist
# but do not fit a payload key, each naming the type; a member the handle does not offer is the
# session defect, which reads every argMapping the same way wherever it is written. FilmKeySummary offers label, which is text, and
# film, a record a payload cannot carry.

extend schema @withConfiguration(
  sessionState: true,
  sessionHandle: "no.sikt.graphitron.rewrite.test.services.FilmKeySummary",
  outboxTable: "outbox"
)
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  unwritable(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox(argMapping: "f: $session.film")
  whole(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox(argMapping: "h: $session")
  unknown(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox(argMapping: "u: $session.nope")
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                                 coordinate,        detail
  ARGMAPPING_SOURCE_MISFIT,             Mutation.unwritable,
  ARGMAPPING_SOURCE_MISFIT,             Mutation.whole,
  SESSION_MEMBER_UNKNOWN,               Mutation.unknown,
  """)

extend schema @assertContains(relation: "graphitron_argmapping_pair_defect", rows: """
  code,                     detail
  SESSION_MEMBER_UNKNOWN,   nope
  ARGMAPPING_SOURCE_MISFIT, "f: $session.film (no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord)"
  ARGMAPPING_SOURCE_MISFIT, "h: $session (no.sikt.graphitron.rewrite.test.services.FilmKeySummary)"
  """)
