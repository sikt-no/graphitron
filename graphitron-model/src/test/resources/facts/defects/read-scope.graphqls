# The scope of the tables each root read reads, under a database-per-tenant build whose tenant column
# is org_number, which party_company alone carries. Query.companies reads party_company, a tenant's;
# Query.individuals reads party_individual, which no tenant column scopes; and Query.allParties reads
# party through a discriminator, with each participant joined from a detail table of its own, so the
# detail tables are read in the same statement and its scope is across both, though party itself is
# global. The read across scopes is refused, and the tenanted read naming no tenant too; their defects
# are pinned where their codes are (defects/unrouted-root-read).

extend schema @withConfiguration(tenantColumn: "org_number")

interface Party @table(name: "party") @discriminate(on: "party_kind") {
  partyId:     Int!    @field(name: "party_id")
  displayName: String! @field(name: "display_name")
}
type Individual implements Party @table(name: "party_individual") @discriminator(value: "INDIVIDUAL") {
  partyId:     Int!    @field(name: "party_id")
  displayName: String! @reference(path: [{key: "party_individual_party_id_fkey"}]) @field(name: "display_name")
  birthDate:   String  @field(name: "birth_date")
}
type Company implements Party @table(name: "party_company") @discriminator(value: "COMPANY") {
  partyId:     Int!    @field(name: "party_id")
  displayName: String! @reference(path: [{key: "party_company_party_id_fkey"}]) @field(name: "display_name")
  orgNumber:   String  @field(name: "org_number")
}

type Query {
  allParties: [Party!]!
  companies: [Company!]!
  individuals: [Individual!]!
}

extend schema @expectEquals(relation: "graphitron_occurrence_read_scope", rows: """
  coordinate,        scope
  Query.allParties,  ACROSS
  Query.companies,   TENANT
  Query.individuals, GLOBAL
  """)
