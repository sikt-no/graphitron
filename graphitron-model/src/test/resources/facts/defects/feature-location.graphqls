# A @feature without ENUM_VALUE among its locations cannot flag an enum value: each value the
# feature reaches draws FEATURE_LOCATION naming the location it needs, and is not flagged. The
# check is per element, so the fields in the same file are flagged as the definition allows.

directive @feature(flags: [String!]!) on FIELD_DEFINITION | ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

extend schema @withConfiguration(feature: "beta")

enum Rating { G PG }

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code LIKE 'FEATURE%'", rows: """
  code,             coordinate, detail
  FEATURE_LOCATION, Rating.G,   "feature beta, location ENUM_VALUE"
  FEATURE_LOCATION, Rating.PG,  "feature beta, location ENUM_VALUE"
  """)

extend schema @assertContains(relation: "diagnostic", rows: """
  lsp_code,                    coordinate, severity
  GRAPHITRON_FEATURE_LOCATION, Rating.G,   error
  """)

extend schema @expectEquals(relation: "graphitron_configured_feature", rows: """
  coordinate,           flag
  Query.anchor,         beta
  FactAnchor.paymentId, beta
  """)
