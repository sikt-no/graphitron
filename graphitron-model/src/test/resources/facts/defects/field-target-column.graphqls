# The column a scalar field reads, at each occurrence of it. With no path it is on the table its
# read departs from; with a @reference path it is on the table the path arrives at, the applications
# composed in the order written. The spelling is the @field(name:) where one is written and the field's own name
# otherwise, folded by case, and the SQL name answers before the generated one. A spelling naming no
# column there, or several, has no row and is a defect at the field. A path that arrives nowhere has
# no row either, and its defect is the path's alone: the column cannot be judged until the path is
# fixed. case_twins has "Code" and "code", which its codegen names CAPITAL_CODE and CODE.

type Film @table(name: "film") {
  # Its own name, and @field with the case changed.
  title: String
  name: String @field(name: "TITLE")
  # Names no column.
  titel: String
  renamed: String @field(name: "no_such_column")
  details: Details
  # One key, two hops, and two applications composed: each arrives at the table that has the column.
  plainKey: String @field(name: "name") @reference(path: [{key: "film_language_id_fkey"}])
  twoHop: String @field(name: "first_name") @reference(path: [{table: "film_actor"}, {table: "actor"}])
  twiceComposed: String @field(name: "first_name")
    @reference(path: [{table: "film_actor"}]) @reference(path: [{table: "actor"}])
  # film has two keys to language, so the path is not deterministic and arrives nowhere.
  languageName: String @field(name: "name") @reference(path: [{table: "language"}])
  # language has no key to film_actor, so the second application arrives nowhere.
  twiceBroken: String @field(name: "name")
    @reference(path: [{key: "film_language_id_fkey"}]) @reference(path: [{table: "film_actor"}])
  # Names no table, and names a key that does not leave film.
  nowhere: String @reference(path: [{table: "no_such_table"}])
  wrongSide: String @field(name: "first_name") @reference(path: [{key: "film_actor_actor_id_fkey"}])
  langDetails: LangDetails
  # Produces an object of its own, whose fields are read off it rather than off film.
  sharedTranslations: SharedTranslations @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.SharedValueTypeService",
    method: "translationsByFilm"
  })
}

type SharedTranslations {
  nb: String
  en: String
}

# The same through @externalField, and a level further down.
type Inventory @table(name: "inventory") {
  filmCardData: FilmCardWrapper @externalField(reference: {
    className: "no.sikt.graphitron.rewrite.test.extensions.InventoryExtensions",
    method: "filmCardData"
  })
}

type FilmCardWrapper {
  example: RecordExample
}

type RecordExample {
  fieldA: String
  fieldC: String @field(name: "rebound")
}

# A nesting type implementing Node reads id as a node's identity. One that does not reads it as a
# column, even under a node, and language has none.
interface Node { id: ID! }

type Lang implements Node @table(name: "language") @node {
  id: ID!
  info: LangInfo
  plain: LangPlain
}

type LangInfo implements Node {
  id: ID!
  name: String
}

type LangPlain {
  id: ID!
}

# An input type is no read; its deprecated @table binds it, and nothing here judges its fields.
input FilmFilter @table(name: "film") {
  titel: String
}

type Language @table(name: "language") {
  details: Details
}

# No table of its own: reached from Film and from Language, its fields read both tables. title is
# film's alone, so read from Language it names nothing.
type Details {
  lastUpdate: String @field(name: "last_update")
  title: String
}

# No table of its own: its path departs from film, whose rows it holds.
type LangDetails {
  langName: String @field(name: "name") @reference(path: [{key: "film_language_id_fkey"}])
}

type Twins @table(name: "case_twins") {
  # Only the generated name of "Code" answers.
  capital: String @field(name: "CAPITAL_CODE")
  # Both columns fold onto it.
  code: String
}

# Backed by FilmRecord, the record class of film, so read off the record.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
}

# Backed by plain classes with no table: read off the object, no column.
type FilmBlurb { description: String }
type FilmBlurbHolder { blurb: FilmBlurb }

extend type Query {
  films: [Film!]!
  filteredFilms(filter: FilmFilter): [Film!]!
  inventories: [Inventory!]!
  langs: [Lang!]!
  languages: [Language!]!
  twins: [Twins!]!
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  filmBlurbHolder(filmId: Int!): FilmBlurbHolder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                    type_name, field_name,   detail
  COLUMN_AMBIGUOUS,        Twins,     code,         code
  COLUMN_UNRESOLVED,       Details,   title,        title
  COLUMN_UNRESOLVED,       Film,      renamed,      no_such_column
  COLUMN_UNRESOLVED,       Film,      titel,        titel
  COLUMN_UNRESOLVED,       LangPlain, id,           id
  ELEMENT_UNRESOLVED,      Film,      nowhere,
  NO_ROUTE_FROM_DEPARTURE, Film,      twiceBroken,
  NO_ROUTE_FROM_DEPARTURE, Film,      wrongSide,
  ROUTE_AMBIGUOUS,         Film,      languageName,
  """)

# Nothing departs from the parent's table through a field producing its own object.
extend schema @assertAbsent(relation: "graphitron_field_source_table", rows: """
  type_name,          field_name
  SharedTranslations, nb
  FilmCardWrapper,    example
  RecordExample,      fieldA
  """)

# The same reads at each occurrence, where the path lands: the nesting type's fields once per table
# they are reached from, the record-backed carrier's under the service that returns it, and a field
# that writes a path where its walk arrives. A walk that stops arrives nowhere, so languageName,
# twiceBroken, nowhere and wrongSide have no row.
extend schema @expectEquals(relation: "graphitron_occurrence_column", rows: """
  coordinate,                    bound,                    column_name, matched_by
  FactAnchor.paymentId,          public.payment,           payment_id,  SQL_NAME
  Film.details.lastUpdate,       public.film,              last_update, SQL_NAME
  Film.details.title,            public.film,              title,       SQL_NAME
  Film.langDetails.langName,     public.language,          name,        SQL_NAME
  Film.name,                     public.film,              title,       SQL_NAME
  Film.plainKey,                 public.language,          name,        SQL_NAME
  Film.title,                    public.film,              title,       SQL_NAME
  Film.twiceComposed,            public.actor,             first_name,  SQL_NAME
  Film.twoHop,                   public.actor,             first_name,  SQL_NAME
  Lang.info.name,                public.language,          name,        SQL_NAME
  Language.details.lastUpdate,   public.language,          last_update, SQL_NAME
  Query.filmDetailsBatch.filmId, public.film,              film_id,     SQL_NAME
  Twins.capital,                 nodeidfixture.case_twins, Code,        JOOQ_NAME
  """)
