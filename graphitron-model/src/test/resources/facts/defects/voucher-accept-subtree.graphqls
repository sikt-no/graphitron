extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

"An accepting type's entity is read on the vouched connection, and so is everything its SELECT projects, a reference child nested in it included. A @service below it reads on the connection the entity row hands down. Any other field below it with a fetcher of its own, a split query or a service returning a connection here, does not yet read on that connection, so an accepting type with one anywhere in the subtree its SELECT reads is refused at the @accept. The walk follows the projected fields type by type, a type it reaches twice being one step, so a subtree that leads back to a type it has read ends there."
type Projected @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  language: Language! @reference(path: [{key: "film_language_id_fkey"}])
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type Split @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  language: Language! @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type Language @table(name: "language") {
  name: String!
}

# A child service runs on the key the entity row hands down, so it is accepted; one returning a
# connection pages, which the vouched connection does not reach yet.
type Serviced @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  languages: [Language!]! @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService",
    method: "languagesByFilm"})
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type Connected @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  languages: [Language!]! @asConnection
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService",
      method: "languagesByFilm"})
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

# A projected subtree that leads back to its own types: the walk ends, and nothing below has a fetcher.
type Cyclic @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  language: CycleLanguage! @reference(path: [{key: "film_language_id_fkey"}])
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type CycleLanguage @table(name: "language") {
  name: String!
  films: [Cyclic!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# A projected cycle with a split query two types down: the walk reaches it.
type Deep @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  language: DeepLanguage! @reference(path: [{key: "film_language_id_fkey"}])
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type DeepLanguage @table(name: "language") {
  name: String!
  films: [DeepFilm!]! @reference(path: [{key: "film_language_id_fkey"}])
}

type DeepFilm @table(name: "film") {
  title: String!
  language: DeepLanguage! @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
}

type Query {
  projected: [Projected!]!
  split: [Split!]!
  cyclic: [Cyclic!]!
  deep: [Deep!]!
  serviced: [Serviced!]!
  connected: [Connected!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'VOUCHER_ACCEPT_NOT_GENERATED'", rows: """
  code,                         type_name, detail
  VOUCHER_ACCEPT_NOT_GENERATED, Connected, Connected.voucher
  VOUCHER_ACCEPT_NOT_GENERATED, Deep,      Deep.voucher
  VOUCHER_ACCEPT_NOT_GENERATED, Split,     Split.voucher
  """)
