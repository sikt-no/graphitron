extend schema @withConfiguration(sessionState: true)
extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

"An accepting type's entity is read on the vouched connection, and so is everything its SELECT projects, a reference child nested in it included. A field below it with a fetcher of its own, a split query here, does not yet read on that connection, so an accepting type with one anywhere in the subtree its SELECT reads is refused at the @accept, naming the field."
type Projected @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  language: Language! @reference(path: [{key: "film_language_id_fkey"}])
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type Split @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  title: String!
  language: Language! @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  voucher: String! @accept(scope: "films", vouchesFor: "title")
}

type Language @table(name: "language") {
  name: String!
}

type Query {
  projected: [Projected!]!
  split: [Split!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'VOUCHER_ACCEPT_NOT_GENERATED'", rows: """
  code,                         type_name, detail
  VOUCHER_ACCEPT_NOT_GENERATED, Split,     Split.voucher
  """)
