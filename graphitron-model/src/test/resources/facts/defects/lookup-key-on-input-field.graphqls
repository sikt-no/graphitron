# @lookupKey is declared on arguments only, so assembly refuses it on an input field, on the query
# side and the mutation side alike, at the application's own line. Each is an application at its
# input field's coordinate all the same, beside the argument's.

type Film @table(name: "film") {
  title: String
}

input FilmKey {
  title: String @lookupKey
}

input FilmInput {
  title: String @lookupKey
}

type Query {
  filmsByKey(key: [FilmKey]): [Film]
  filmsByTitle(title: [String] @lookupKey): [Film]
}

type Mutation {
  createFilm(in: FilmInput!): Film @mutation(typeName: INSERT)
}

extend schema @expectEquals(relation: "graphql_schema_problem", rows: """
  stage,    error_class,                    source_line
  ASSEMBLY, DirectiveIllegalLocationError,  10
  ASSEMBLY, DirectiveIllegalLocationError,  14
  """)

extend schema @expectEquals(relation: "graphql_directive_application", where: "directive_name = 'lookupKey'", rows: """
  coordinate
  FilmKey.title
  FilmInput.title
  Query.filmsByTitle(title:)
  """)
