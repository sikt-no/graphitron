# Which column a scalar binds on the table its type is bound to, no directive involved but @field.
# The name is the @field binding where one is written, matched across case, the SQL name answering
# before the generated one, and only a scalar or enum leaf binds a column. A field matching nothing
# binds nothing, a bare @table binds the table its type is named for, a qualified one splits on its
# dot, and a name two schemas declare binds both candidates and so no column. A field a @service
# produces binds no column of its own, and a node's id is a node id rather than its table's id column.

interface Node { id: ID! }

enum Rating { G PG }

type Film @table(name: "film") {
  title: String
  year: Int @field(name: "release_year")
  certificate: String @field(name: "rating")
  heading: String @field(name: "TITLE")
  Rating: String
  rating: Rating
  language_id: Language
}

type Unbound @table(name: "film") {
  year: Int
  certificate: String
}

type Language @table {
  unmatched: String
}

type Served @table(name: "film") {
  title: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
  rating: String
}

type Dup @table(name: "note") {
  body: String
}

type Qualified @table(name: "multischema_a.note") {
  body: String
}

type Holder implements Node @table(name: "array_holder") @node {
  id: ID!
}

extend type Query @table(name: "film") {
  films: [Film!]!
  unbound: [Unbound!]!
  served: [Served!]!
  dups: [Dup!]!
  qualified: [Qualified!]!
  holders: [Holder!]!
}

extend schema @expectEquals(relation: "graphitron_occurrence_column",
    where: "coordinate NOT IN ('Query.anchor', 'FactAnchor.paymentId')", rows: """
  coordinate      , table_schema , table_name, column_name , matched_by
  Film.Rating     , public       , film      , rating      , SQL_NAME
  Film.certificate, public       , film      , rating      , SQL_NAME
  Film.heading    , public       , film      , title       , SQL_NAME
  Film.rating     , public       , film      , rating      , SQL_NAME
  Film.title      , public       , film      , title       , SQL_NAME
  Film.year       , public       , film      , release_year, SQL_NAME
  Qualified.body  , multischema_a, note      , body        , SQL_NAME
  Served.rating   , public       , film      , rating      , SQL_NAME
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_producer", where: "coordinate LIKE 'Served.%'", rows: """
  coordinate  , kind   , start
  Served.title, SERVICE, CHILD
  """)
