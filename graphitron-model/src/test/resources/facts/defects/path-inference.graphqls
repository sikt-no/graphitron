# An output field no claim covers between two table-bound types takes the one foreign key joining
# their tables, in either direction. A field on its parent's own table takes the table's one
# self-referencing key, forward from a single-valued field and in reverse from a list. Where no key
# does it is NO_ROUTE_TO_TARGET, which includes a field on a table with no self-referencing key,
# narrowed by an argument or not; where several do it is ROUTE_AMBIGUOUS. Each sits at the field's
# declaration, naming the two tables, and the keys to choose between.
#
# A routine's derived table has no foreign key: a field starting on it reaches its target by the
# target's primary key, every column of it matched by name among the routine's result columns, and
# one lacking a primary-key column is NO_ROUTE_TO_TARGET naming the first missing.
#
# A claim covers a need at the field itself, a @referenceFor naming the need's type or any other
# claim there, or at the same-named field of an interface the field's type implements, member by
# member. An implementation's own claim beats an inherited one, and an interface extending another
# overrides the claim it redeclares; two interfaces neither extending the other that both claim the
# field for one member are INHERITED_PATH_AMBIGUOUS at the implementation's field, naming the two.

type Film @table(name: "film") {
  title: String
  # No foreign key joins film and city.
  cities: [City!]!
  # On film's own table and narrowed by its argument: a written path is needed.
  sameTableById(filmId: Int @field(name: "film_id")): [Film!]!
  # film_language_id_fkey and film_original_language_id_fkey both join film and language.
  language: Language
}

# category_parent_category_id_fkey is category's one self-referencing key.
type Category @table(name: "category") {
  name: String
  # Single-valued: forward, to the row the key points at.
  parent: Category
  # A list: in reverse, to the rows pointing here.
  children(name: String): [Category!]!
  # A discriminated interface on category and a union with a member on it ride the key the same
  # way, the union's other member over the one key between category and category_label.
  parentKind: CategoryKind
  childKinds: [CategoryKind!]!
  parentLink: CategoryLink
  links: [CategoryLink!]!
}

interface CategoryKind @table(name: "category") @discriminate(on: "name") { name: String }
type Genre implements CategoryKind @table(name: "category") @discriminator(value: "GENRE") { name: String }
type CategoryLabel @table(name: "category_label") { label: String }
union CategoryLink = Category | CategoryLabel

type City @table(name: "city") { cityId: Int @field(name: "city_id") }
type Rental @table(name: "rental") { rentalId: Int @field(name: "rental_id") }

# What rent_film returns, a derived table whose one column is rental_id.
type RentFilmPayload {
  # rental's primary key, rental_id, is among the result's columns: inferred.
  rental: Rental
  # customer's primary key, customer_id, is not: no route.
  customer: Customer
}

type Mutation {
  rentFilm(inventoryId: Int!, customerId: Int!): RentFilmPayload
    @routine(name: "rent_film", argMapping: "pInventoryId: inventoryId, pCustomerId: customerId")
}
type Language @table(name: "language") { name: String }
type Address @table(name: "address") { addressId: Int @field(name: "address_id") }

interface Person { email: String }

# Two interfaces neither extending the other, each claiming address.
interface Addressed { address: Address @reference(path: [{table: "address"}]) }
interface Located { address: Address @reference(path: [{key: "staff_address_id_fkey"}]) }

# An interface extending another, redeclaring its claim.
interface Base { home: Address @reference(path: [{table: "address"}]) }
interface Derived implements Base { home: Address @reference(path: [{key: "customer_address_id_fkey"}]) }

type Customer implements Person & Addressed & Derived & Base @table(name: "customer") {
  email: String
  # Inherited from Addressed alone: covered, so no path yet and no inference.
  address: Address
  # Derived overrides Base: inherited from Derived, no conflict.
  home: Address
}

type Staff implements Person & Addressed & Located @table(name: "staff") {
  email: String
  # Inherited from Addressed and from Located: ambiguous.
  address: Address
}

interface Staffed {
  people: [Person!]! @referenceFor(type: "Customer", path: [{key: "customer_store_id_fkey"}])
}

type Store implements Staffed @table(name: "store") {
  # Staff written here and Customer inherited from Staffed's @referenceFor: both covered.
  people: [Person!]! @referenceFor(type: "Staff", path: [{key: "staff_store_id_fkey"}])
  # Staff written here and nothing written for Customer anywhere: Customer is inferred over
  # customer_store_id_fkey, the one key between store and customer.
  peopleInferred: [Person!]! @referenceFor(type: "Staff", path: [{key: "staff_store_id_fkey"}])
}

extend type Query {
  categories: [Category!]!
  films: [Film!]!
  customers: [Customer!]!
  staff: [Staff!]!
  stores: [Store!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code IN ('NO_ROUTE_TO_TARGET', 'ROUTE_AMBIGUOUS', 'INHERITED_PATH_AMBIGUOUS')", rows: """
  code,                     coordinate,          detail
  NO_ROUTE_TO_TARGET,       Film.cities,         public.film to public.city
  NO_ROUTE_TO_TARGET,       RentFilmPayload.customer, "public.rent_film to public.customer, whose result has no column customer_id of the primary key"
  NO_ROUTE_TO_TARGET,       Film.sameTableById,  "public.film to public.film, which takes a written path: the primary-key self-join {key: ""film_pkey""} or a self-referencing key"
  ROUTE_AMBIGUOUS,          Film.language,       public.film to public.language by film_language_id_fkey or film_original_language_id_fkey
  INHERITED_PATH_AMBIGUOUS, Staff.address,       Addressed and Located
  """)

# The defective needs have no path; the needs nothing covers that one key joins are inferred, the
# self-referencing key's included, and the narrowed field's argument starts and lands on film, an
# empty path, as does the argument of the list over category's key, an argument never inferring a
# self-referencing key. A covered need's path is its claim's, walked: an inherited claim INHERITED,
# the one Derived overrides Base with included, and the field's own WRITTEN, the root routine's on
# the derived table it returns.
extend schema @expectEquals(relation: "graphitron_path",
    where: "origin <> 'EMPTY' OR coordinate IN ('Film.sameTableById(filmId:)', 'Category.children(name:)')", rows: """
  coordinate,                    target_type,     kind, origin
  Category.children,             Category,        JOIN, INFERRED
  Category.children(name:),      Category,        JOIN, EMPTY
  Category.childKinds,           Genre,           JOIN, INFERRED
  Category.links,                Category,        JOIN, INFERRED
  Category.links,                CategoryLabel,   JOIN, INFERRED
  Category.parent,               Category,        JOIN, INFERRED
  Category.parentKind,           Genre,           JOIN, INFERRED
  Category.parentLink,           Category,        JOIN, INFERRED
  Category.parentLink,           CategoryLabel,   JOIN, INFERRED
  Customer.address,              Address,         JOIN, INHERITED
  Customer.home,                 Address,         JOIN, INHERITED
  Film.sameTableById(filmId:),   Film,            JOIN, EMPTY
  Mutation.rentFilm,             RentFilmPayload, JOIN, WRITTEN
  Mutation.rentFilm.rental,      Rental,          JOIN, INFERRED
  Store.people,                  Customer,        JOIN, INHERITED
  Store.people,                  Staff,           JOIN, WRITTEN
  Store.peopleInferred,          Customer,        JOIN, INFERRED
  Store.peopleInferred,          Staff,           JOIN, WRITTEN
  """)

# Derived's key, not Base's table, is the inherited path Customer.home follows.
extend schema @expectEquals(relation: "graphitron_join_path_claimed",
    where: "coordinate IN ('Customer.address', 'Customer.home')", rows: """
  coordinate,        target_type, claim_coordinate,  claim_target_type
  Customer.address,  Address,     Addressed.address, Address
  Customer.home,     Address,     Derived.home,      Address
  """)

# Each rides category's one key, the single field from the declaring row to the one it points at, the
# list from the parent's key to the rows declaring it, whatever the field reaches category for.
extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key",
    where: "coordinate LIKE 'Category.%' AND target_type IN ('Category', 'Genre')", rows: """
  coordinate,           target_type, position, constraint_name
  Category.childKinds,  Genre,       0,        category_parent_category_id_fkey
  Category.children,    Category,    0,        category_parent_category_id_fkey
  Category.links,       Category,    0,        category_parent_category_id_fkey
  Category.parent,      Category,    0,        category_parent_category_id_fkey
  Category.parentKind,  Genre,       0,        category_parent_category_id_fkey
  Category.parentLink,  Category,    0,        category_parent_category_id_fkey
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_column",
    where: "coordinate LIKE 'Category.%' AND target_type IN ('Category', 'Genre')", rows: """
  coordinate,           target_type, position, ordinal, from_table, from_column,        to_table, to_column
  Category.childKinds,  Genre,       0,        0,       category,   category_id,        category, parent_category_id
  Category.children,    Category,    0,        0,       category,   category_id,        category, parent_category_id
  Category.links,       Category,    0,        0,       category,   category_id,        category, parent_category_id
  Category.parent,      Category,    0,        0,       category,   parent_category_id, category, category_id
  Category.parentKind,  Genre,       0,        0,       category,   parent_category_id, category, category_id
  Category.parentLink,  Category,    0,        0,       category,   parent_category_id, category, category_id
  """)

extend schema @assertAbsent(relation: "graphitron_path", rows: """
  coordinate
  Film.cities
  Film.sameTableById
  Film.language
  Mutation.rentFilm.customer
  Staff.address
  """)

# Interface-to-interface implementation is a row of its own, which is what lets Derived override
# Base.
extend schema @assertContains(relation: "graphql_implements_interface", rows: """
  type_name, interface_name
  Derived,   Base
  """)
