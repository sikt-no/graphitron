# A @service under an object answering a union of two tables: each address's occupants may be
# customers or staff, which the store-fed fetcher lifts participant by participant for a root call
# only.

type Customer @table(name: "customer") { firstName: String @field(name: "first_name") }
type Staff @table(name: "staff") { firstName: String @field(name: "first_name") }
union AddressOccupant = Customer | Staff

type Address @table(name: "address") {
  occupants: [AddressOccupant!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.AddressOccupantCarrierService", method: "occupantsOf"})
}

type Query { addresses: [Address!]! }

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'SERVICE_CHILD_POLYMORPHIC_UNSUPPORTED'", rows: """
  code,                                  coordinate
  SERVICE_CHILD_POLYMORPHIC_UNSUPPORTED, Address.occupants
  """)
