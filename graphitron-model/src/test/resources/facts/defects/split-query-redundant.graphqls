# A @splitQuery where the rows arrive from a query of their own anyway changes nothing, and is
# admitted with a warning (Alf, 2026-11-19). FilmDetails is the class FilmCarrierService.filmById
# returns, and its language, a table-bound type reached by a path, draws SPLIT_QUERY_REDUNDANT at its
# @splitQuery. So does a payload's data field, which re-reads its producer's records by their keys
# whatever wrote them: AddFilmPayload.film under an INSERT, RentFilmsPayload.rentals under a
# routine, and FilmLookupOutcome.film under a @service whose payload carries errors beside it. The same directive on Film, whose rows graphitron reads, splits a query and draws nothing,
# and neither does FilmDetails's languageInline, written without it.
#
# A child connection is fetched in a query of its own whether @splitQuery is written or not, each
# parent paging its own rows (Alf, 2026-11-25), so the directive is redundant there too: on a
# table-backed child connection, Film.actorsSplit, and on a routine-backed one, Actor.filmsSplit,
# whose target is the function's result, bound to no table. Their twins written without it,
# Film.actors and Actor.films, draw nothing.

type Language @table(name: "language") { name: String }

type Film @table(name: "film") {
  title: String
  language: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  actorsSplit: [Actor!]! @asConnection @splitQuery
    @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
  actors: [Actor!]! @asConnection
    @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
}

type ActorFilm { filmId: Int @field(name: "film_id"), title: String }

type Actor @table(name: "actor") {
  filmsSplit(minLength: Int!): [ActorFilm!] @splitQuery @asConnection
    @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  films(minLength: Int!): [ActorFilm!] @asConnection
    @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

type FilmDetails {
  language: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  languageInline: Language @reference(path: [{key: "film_language_id_fkey"}])
}

type AddFilmPayload { film: Film @splitQuery }

type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }

type RentFilmsPayload { rentals: [Rental!] @splitQuery }

type FilmLookupOutcome { film: Film @splitQuery, errors: [FilmLookupFailure] }
type FilmLookupMissing @error(handlers: [{handler: DATABASE}]) { path: [String!]!, message: String! }
union FilmLookupFailure = FilmLookupMissing

input FilmInput @table(name: "film") { title: String }

type Query {
  film: Film
  actors: [Actor!]!
  details(id: Int!): FilmDetails
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  filmLookupOutcome(id: Int!): FilmLookupOutcome
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierWithErrorsService", method: "filmById"})
}

type Mutation {
  addFilm(input: FilmInput!): AddFilmPayload @mutation(typeName: INSERT, table: "film")
  rentFilms(firstInventoryId: Int!, secondInventoryId: Int!, customerId: Int!): RentFilmsPayload
    @routine(name: "rent_films",
             argMapping: "pFirstInventoryId: firstInventoryId, pSecondInventoryId: secondInventoryId, pCustomerId: customerId")
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
                            where: "code = 'SPLIT_QUERY_REDUNDANT'", rows: """
  coordinate,               suppressed
  Actor.filmsSplit,         FALSE
  AddFilmPayload.film,      FALSE
  Film.actorsSplit,         FALSE
  FilmDetails.language,     FALSE
  FilmLookupOutcome.film,   FALSE
  RentFilmsPayload.rentals, FALSE
  """)

extend schema @assertContains(relation: "diagnostic", rows: """
  lsp_code,                                severity
  GRAPHITRON_SPLIT_QUERY_REDUNDANT,        warning
  """)
