# A call's tenant named twice, by a $tenant pair and by @tenant on another argument; a value named
# as the tenant whose scalar arrives as another class than the tenant column's, film_id an Integer,
# or which is an input object, beside a list of the column's class, each element a tenant, which
# passes; $tenant written where nothing routes by it yet, a @condition; a call handed a connection,
# re-reading film rows and naming no tenant; one whose only tenant value may be left out, beside one
# needing no tenant, which runs unscoped; @tenant beside @nodeId, beside the node id alone, whose
# decoded film_id routes the call; @tenant read by a child @service and by a query field, beside it
# read by a root @service, which binds it; and a node id of a union over film and film_actor, each
# holding film_id at its own key position, which names no one tenant, as an argument and inside a
# bean a call handed a connection takes. A root handed a connection and naming no tenant is refused
# alone, the payload's films under it running on the key it hands down; and the session handle alone
# is a connection too, so a call taking only $session and naming no tenant is refused as one handed
# the jOOQ context is.

extend schema @withConfiguration(tenantColumn: "film_id", sessionState: true,
  sessionHandle: "no.sikt.graphitron.rewrite.test.services.FilmKeySummary")

type Film @table(name: "film") @node {
  title: String
  rated(org: Int @tenant): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
}

type FilmActor @table(name: "film_actor") @node { actorId: Int @field(name: "actor_id") }
union FilmThing = Film | FilmActor

# Handed film's records with no connection, under a type no table binds: the records are read as
# handed, nothing re-reads a tenant's rows, and the call needs no tenant. The same service handed a
# connection, titlesOnConnection, is unrouted: its own SQL is opaque, and no mark says it is global.
type FilmTitles { title: String }

input FilmWhere { filmId: Int! }

input ThingAssignmentInput { occupant: ID! @nodeId(typeName: "FilmThing") }
input FilmIdRatingInput { filmId: Int!, rating: Int }
type RateFilmsPayload { ranOn: String, films: [Film!]! }

type Query {
  filmTwice(id: Int! @tenant, org: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmMistyped(id: Int!, org: String!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmUnrouted(id: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById"})
  # Handed a connection and re-reading film's rows, its one tenant value optional: it needs a tenant
  # a request may leave out.
  filmOptional(id: Int!, org: Int): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  # filmOptional's near miss: handed no connection and returning no table's rows, so it needs no
  # tenant and runs on the empty tenant part whether or not the request names one.
  labelOptional(id: Int @tenant): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.ParameterShapeService",
      method: "byFilmId"})
  filmByMarkedNodeId(id: ID! @nodeId(typeName: "Film") @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  filmByNodeId(id: ID! @nodeId(typeName: "Film")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  filmMarked(id: Int! @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  filmWhereMarked(id: Int!, where: FilmWhere! @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  titlesMarked(ids: [Int!]! @tenant): [FilmTitles!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmsByIds"})
  # filmMarked with the union's id beside it: one slot reads one node's key, and either member's id
  # may arrive, so the call is refused whatever else names its tenant.
  filmMarkedBesideThing(id: Int! @tenant, thing: ID! @nodeId(typeName: "FilmThing")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  # The union's id handed to a service that is given no connection and re-reads no rows: the call
  # needs no tenant, so the id routes nothing and the call runs on the empty tenant part.
  thingAssigned(occupant: ID! @nodeId(typeName: "FilmThing")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService",
      method: "assignOccupantByArgument"})
  # The union's id inside a bean, the call handed a connection: either member's id may arrive.
  thingInBean(in: ThingAssignmentInput!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReviewService", method: "assignOccupantRecordOnConnection"})
  # The session handle and nothing else, naming no tenant.
  sessionOnly: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummarySessionService",
      method: "labelOfHandle", argMapping: "summary: $session"})
  filmsMarked(filmId: Int @tenant @field(name: "film_id")): [Film!]!
  titlesOnConnection(ids: [Int!]!): [FilmTitles!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmsByIds"})
  filmTitles: [FilmTitles!]! @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "films"})
  filmsOnCondition(filmId: Int): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals", argMapping: "$tenant: filmId"}, override: true)
}

type Mutation {
  # Handed a connection, naming no tenant: refused at the root alone.
  rateByFilmId(ratings: [FilmIdRatingInput!]!): RateFilmsPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService", method: "rateFilmsByFilmId"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code LIKE 'TENANT%' OR code = 'UNROUTED_SERVICE_CALL'", rows: """
  code,                         coordinate,                   detail
  UNROUTED_SERVICE_CALL,        Query.filmUnrouted,
  UNROUTED_SERVICE_CALL,        Query.filmTwice,
  UNROUTED_SERVICE_CALL,        Query.titlesOnConnection,
  UNROUTED_SERVICE_CALL,        Query.filmMarkedBesideThing,
  UNROUTED_SERVICE_CALL,        Query.thingInBean,
  UNROUTED_SERVICE_CALL,        Query.sessionOnly,
  UNROUTED_SERVICE_CALL,        Mutation.rateByFilmId,
  TENANT_SLOTS_OPTIONAL_ONLY,   Query.filmOptional,
  TENANT_NAMED_TWICE,           Query.filmTwice,              Query.filmTwice(id:)
  TENANT_VALUE_TYPE_DISAGREES,  Query.filmMistyped,           java.lang.String where the tenant column is java.lang.Integer
  TENANT_VALUE_TYPE_DISAGREES,  Query.filmWhereMarked(where:), the input object FilmWhere where the tenant column is java.lang.Integer
  TENANT_SITE_UNSUPPORTED,      Query.filmsOnCondition,       condition
  TENANT_MARKER_BESIDE_NODE_ID, Query.filmByMarkedNodeId(id:),
  TENANT_SITE_UNSUPPORTED,      Film.rated(org:),             Film.rated
  TENANT_SITE_UNSUPPORTED,      Query.filmsMarked(filmId:),   Query.filmsMarked
  """)

# The call named twice has no binding, so nothing routes it on a guess: it is refused as unrouted
# beside the pair's own defect.
extend schema @assertEmpty(relation: "graphitron_occurrence_binding_tenant",
    where: "call_coordinate = 'Query.filmTwice'")

# The marker beside @nodeId binds nothing, so its ID is not judged as the tenant's value: the node
# id's key names the tenant, as it does for the field without the marker.
extend schema @assertEmpty(relation: "graphitron_occurrence_binding_tenant",
    where: "call_coordinate = 'Query.filmByMarkedNodeId'")

# The marker a child service reads binds nothing, so the argument binds no parameter of its method
# either, and is unbound as any such argument is: Film.rated(org:) also draws ARGUMENT_UNBOUND, which
# argument-unbound.graphqls claims. The root service's marker binds its call.
extend schema @assertEmpty(relation: "graphitron_occurrence_binding_tenant",
    where: "coordinate LIKE '%.rated(org:)'")
extend schema @assertContains(relation: "graphitron_occurrence_binding_tenant", rows: """
  coordinate,            origin
  Query.filmMarked(id:), DIRECTIVE
  """)

# The union's id is a slot per member, film_id at position 0 of film's key and 1 of film_actor's, so
# the call beside it is refused where filmMarked alone is routed; the call needing no tenant draws no
# defect.
extend schema @expectEquals(relation: "graphitron_occurrence_tenant_slot",
    where: "coordinate LIKE '%(thing:)' OR coordinate LIKE '%occupant:)'", rows: """
  producer_coordinate,             kind,        coordinate,                          key_position
  Query.thingInBean,           NODE_ID_KEY, Query.thingInBean(in.occupant:),     0
  Query.thingInBean,           NODE_ID_KEY, Query.thingInBean(in.occupant:),     1
  Query.filmMarkedBesideThing, NODE_ID_KEY, Query.filmMarkedBesideThing(thing:), 0
  Query.filmMarkedBesideThing, NODE_ID_KEY, Query.filmMarkedBesideThing(thing:), 1
  Query.thingAssigned,         NODE_ID_KEY, Query.thingAssigned(occupant:),      0
  Query.thingAssigned,         NODE_ID_KEY, Query.thingAssigned(occupant:),      1
  """)

# filmOptional's near miss draws no defect above, so it has a connection, and it is unscoped: not
# routed by the slot a request may leave out.
extend schema @assertEmpty(relation: "graphitron_occurrence_connection",
    where: "coordinate = 'Query.labelOptional' AND outcome <> 'UNSCOPED'")

# The refused root's payload hands its films the key it was handed, so they are not refused again.
extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: "code = 'UNROUTED_CHILD' AND coordinate LIKE 'RateFilmsPayload.%'")
