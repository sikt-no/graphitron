# A call's tenant named twice, by a $tenant pair and by @tenant on another argument; a value named as
# the tenant whose scalar arrives as another class than the tenant column's, film_id an Integer;
# $tenant written where nothing routes by it yet, a @condition; a call handed a connection, re-reading
# film rows and naming no tenant; one whose only tenant value may be left out; and @tenant beside
# @nodeId, beside the node id alone, whose decoded film_id routes the call.

extend schema @withConfiguration(tenantColumn: "film_id")

type Film @table(name: "film") @node { title: String }

type Query {
  filmTwice(id: Int! @tenant, org: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmMistyped(id: Int!, org: String!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmUnrouted(id: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById"})
  filmOptional(id: Int!, org: Int): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmByMarkedNodeId(id: ID! @nodeId(typeName: "Film") @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  filmByNodeId(id: ID! @nodeId(typeName: "Film")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id"})
  filmsOnCondition(filmId: Int): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals", argMapping: "$tenant: filmId"}, override: true)
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code LIKE 'TENANT%' OR code = 'UNROUTED_SERVICE_CALL'", rows: """
  code,                         coordinate,                   detail
  UNROUTED_SERVICE_CALL,        Query.filmUnrouted,
  UNROUTED_SERVICE_CALL,        Query.filmTwice,
  TENANT_SLOTS_OPTIONAL_ONLY,   Query.filmOptional,
  TENANT_NAMED_TWICE,           Query.filmTwice,              Query.filmTwice(id:)
  TENANT_VALUE_TYPE_DISAGREES,  Query.filmMistyped,           java.lang.String where the tenant column is java.lang.Integer
  TENANT_SITE_UNSUPPORTED,      Query.filmsOnCondition,       condition
  TENANT_MARKER_BESIDE_NODE_ID, Query.filmByMarkedNodeId(id:),
  """)

# The call named twice has no binding, so nothing routes it on a guess: it is refused as unrouted
# beside the pair's own defect.
extend schema @assertEmpty(relation: "graphitron_occurrence_binding_tenant",
    where: "call_coordinate = 'Query.filmTwice'")

# The marker beside @nodeId binds nothing, so its ID is not judged as the tenant's value: the node
# id's key names the tenant, as it does for the field without the marker.
extend schema @assertEmpty(relation: "graphitron_occurrence_binding_tenant",
    where: "call_coordinate = 'Query.filmByMarkedNodeId'")
