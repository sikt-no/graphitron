# A @feature whose flags argument is a single String cannot take the list the configuration
# applies, flags: ["beta"]: every element the feature reaches draws FEATURE_ARGUMENTS, and none is
# flagged.

directive @feature(flags: String!) on FIELD_DEFINITION | ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION | ENUM_VALUE

extend schema @withConfiguration(feature: "beta")

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code LIKE 'FEATURE%'", rows: """
  code,              coordinate,           detail
  FEATURE_ARGUMENTS, Query.anchor,         feature beta
  FEATURE_ARGUMENTS, FactAnchor.paymentId, feature beta
  """)

extend schema @assertAbsent(relation: "graphitron_configured_feature", rows: """
  coordinate
  Query.anchor
  FactAnchor.paymentId
  """)
