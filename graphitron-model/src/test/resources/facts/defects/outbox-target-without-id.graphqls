# A message has an id a consumer drops a second delivery by, since a relay delivers at least once: an
# outbox table with no primary key has none to give, so it is refused at every @outbox it serves.
# No table target is derived for it.

extend schema @withConfiguration(outboxTable: "outbox_without_id")
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  create(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                  coordinate,      detail
  OUTBOX_TARGET_INVALID, Mutation.create, "<table> outbox_without_id has no primary key, so a consumer cannot tell a message delivered twice from two messages"
  """)

extend schema @assertEmpty(relation: "graphitron_outbox_target")
