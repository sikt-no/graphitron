# A @service under an object type is fetched for many parents at once, so its method takes their
# keys and answers by them. One taking none would be called once per parent, a query per row, which
# is refused: SampleQueryService.filmCount takes only the jOOQ context, so under FilmBlurbHolder,
# which a service hands back, its keys have nowhere to go.

type FilmBlurbHolder {
  filmCount: Int @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmCount"})
}

type Query {
  holder(filmId: Int!): FilmBlurbHolder @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                     coordinate
  SOURCE_PARAMETER_MISSING, FilmBlurbHolder.filmCount
  """)
