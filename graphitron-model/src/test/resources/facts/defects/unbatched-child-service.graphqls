# A @service under an object type is fetched for many parents at once, so its method takes their
# keys and answers by them. One taking none would be called once per parent, a query per row, which
# is refused: SampleQueryService.filmCount takes only the jOOQ context, so under FilmBlurbHolder,
# which a service hands back, its keys have nowhere to go. What the method hands back does not
# change that: SampleQueryService.filmByServiceUnchecked answers a film record by an id argument,
# and under the holder it is still called once per parent. Nested in a table's row the same holds:
# under CityNames, in City's row, filmCount's keys have nowhere to go either. Under a table's row it
# holds as well, a context argument the only thing the method takes: UserGreetingService.greet under
# Film, which the walk refuses too, as declaring no Sources parameter.

type Film @table(name: "film") {
  title: String
  greeting: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet"},
      contextArguments: ["userId"])
}

type FilmBlurbHolder {
  filmCount: Int @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmCount"})
  film(id: Int): Film @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmByServiceUnchecked"})
}

type City @table(name: "city") { city: String, names: CityNames }
type CityNames {
  noKeys: Int @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "filmCount"})
}

type Query {
  films: [Film!]!
  cities: [City!]!
  holder(filmId: Int!): FilmBlurbHolder @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                     coordinate
  SOURCE_PARAMETER_MISSING, FilmBlurbHolder.filmCount
  SOURCE_PARAMETER_MISSING, FilmBlurbHolder.film
  SOURCE_PARAMETER_MISSING, CityNames.noKeys
  SOURCE_PARAMETER_MISSING, Film.greeting
  """)
