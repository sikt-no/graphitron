# A field fetching its own rows under a parent holding an object, with nothing the parent holds to
# key them: FilmLookupPayload's class has no member returning a film record, so its film field
# draws the defect. FilmKeySummary's film() returns one, so the same field there takes its keys
# through it and draws nothing. Holder is handed back as an Object, a class nothing is read off, so
# its langs, keyed by film records, has none either. SchemaBEventsPayload's class has a member
# named events, but it returns multischema_b's event records under a field typed as multischema_a's
# event: another table's records are no value of the field and key nothing, so events draws the
# defect too.
#
# A field read off the parent's object names a member its class offers: a record's component, any
# other class's get or is getter. FilmKeySummary is a record with no component named missing, and
# FilmTitleView answers title through a bare title() and note through a public field, neither read,
# so missing, title and note are MEMBER_UNRESOLVED; its filmId reads getFilmId and draws nothing.
# FilmBlurb is nested in a film row and handed over as an object by FilmBlurbHolderService, and is
# judged on the object: its description is a column and a component, so it draws nothing, but title
# is a column only, so it is MEMBER_UNRESOLVED however the row reads it.

type Film @table(name: "film") { title: String, blurb: FilmBlurb }
type FilmBlurb { description: String, title: String }
type FilmBlurbHolder { blurb: FilmBlurb }
type FilmLookupPayload { title: String, film: Film }
type FilmKeySummary { label: String, film: Film, missing: String }
type FilmTitleView { filmId: Int, title: String, note: String }
type Language @table(name: "language") { name: String }
type Event @table(name: "multischema_a.event") { name: String }
type SchemaBEventsPayload { events: [Event!] }
type Holder {
  langs: [Language!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesByFilm"})
}

type Query {
  films: [Film]
  lookup(id: Int!): FilmLookupPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup"})
  summaries: [FilmKeySummary!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "summaries"})
  titleView: FilmTitleView
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "titleView"})
  holder(input: String): Holder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.ComputingService", method: "compute"})
  blurbHolder(filmId: Int!): FilmBlurbHolder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
  schemaBEvents: SchemaBEventsPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.MultiSchemaEventsPayloadService", method: "schemaBEvents"})
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  NO_KEY_FROM_PARENT, FilmLookupPayload.film
  NO_KEY_FROM_PARENT, Holder.langs
  NO_KEY_FROM_PARENT, SchemaBEventsPayload.events
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  NO_KEY_FROM_PARENT, FilmKeySummary.film
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code = 'MEMBER_UNRESOLVED'", rows: """
  code,              coordinate,             detail
  MEMBER_UNRESOLVED, FilmBlurb.title,        no.sikt.graphitron.rewrite.test.services.FilmBlurb
  MEMBER_UNRESOLVED, FilmKeySummary.missing, no.sikt.graphitron.rewrite.test.services.FilmKeySummary
  MEMBER_UNRESOLVED, FilmTitleView.note,     no.sikt.graphitron.rewrite.test.services.FilmTitleView
  MEMBER_UNRESOLVED, FilmTitleView.title,    no.sikt.graphitron.rewrite.test.services.FilmTitleView
  """)

# Under a parent's table row, a @routine fetched in a query of its own is called once for the whole
# batch of parents, and its rows are told apart by the row each call took a value from (Alf,
# 2026-11-25). ActorPage.filmsUnkeyed, a child connection, which is always split, calls
# films_for_actor with arguments alone, so nothing keys its rows; so does filmsUnkeyedSplit, a list
# written with @splitQuery. The detail is the parent's table. ActorPage.films binds pActorId to
# $source.actor_id, and Film.castFilms steps through film_actor before the routine, which keys it,
# so neither draws it.

type ActorFilm { filmId: Int @field(name: "film_id"), title: String }

type ActorPage @table(name: "actor") {
  filmsUnkeyed(actorId: Int!, minLength: Int!): [ActorFilm!] @asConnection
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  filmsUnkeyedSplit(actorId: Int!, minLength: Int!): [ActorFilm!] @splitQuery
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  films(minLength: Int!): [ActorFilm!] @asConnection
    @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

extend type Film {
  castFilms(minLength: Int!): [ActorFilm!] @asConnection
    @reference(path: [{table: "film_actor"}])
    @routine(name: "films_for_actor", argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

extend type Query { actorPages: [ActorPage!]! }

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'NO_KEY_FROM_PARENT' AND coordinate LIKE 'ActorPage.%'", rows: """
  code,               coordinate,                  detail
  NO_KEY_FROM_PARENT, ActorPage.filmsUnkeyed,      actor
  NO_KEY_FROM_PARENT, ActorPage.filmsUnkeyedSplit, actor
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  NO_KEY_FROM_PARENT, Film.castFilms
  """)
