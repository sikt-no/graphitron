# A field fetching its own rows under a parent holding an object, with nothing the parent holds to
# key them: FilmLookupPayload's class has no member returning a film record, so its film field
# draws the defect. FilmKeySummary's film() returns one, so the same field there takes its keys
# through it and draws nothing.

type Film @table(name: "film") { title: String }
type FilmLookupPayload { title: String, film: Film }
type FilmKeySummary { label: String, film: Film }

type Query {
  films: [Film]
  lookup(id: Int!): FilmLookupPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup"})
  summaries: [FilmKeySummary!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "summaries"})
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  NO_KEY_FROM_PARENT, FilmLookupPayload.film
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  NO_KEY_FROM_PARENT, FilmKeySummary.film
  """)
