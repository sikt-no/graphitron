# What an @assertType requires, stored as a tree keyed by the declaration it is written on. The
# argument's two requirements are two rows by their repeat; beneath the second, an anyOf holding an is
# and a not over an implements, each node named by its path from the root. The input field carries a
# requirement of its own, keyed by its coordinate. The requirements name only what the schema
# declares, so they draw no defect of their own. Query.check has no fetcher, a defect this document
# is not about.

scalar Path @generatedScalar(kind: SCHEMA_PATH)

interface Node { id: ID! }

type Sak implements Node { id: ID! }

type Soknad implements Node { id: ID! }

type Soker { name: String }

input Mottaker {
  sti: Path @assertType(component: "endType", type: {is: "Soker"})
}

type Query {
  check(
    path: Path
      @assertType(component: "startType", type: {implements: "Node"})
      @assertType(component: "endType", type: {anyOf: [{is: "Soker"}, {not: {implements: "Node"}}]})
    mottaker: Mottaker
  ): String
}

extend schema @expectEquals(relation: "graphitron_assert_type", rows: """
  coordinate,         ordinal, component
  Mottaker.sti,       0,       endType
  Query.check(path:), 0,       startType
  Query.check(path:), 1,       endType
  """)

extend schema @expectEquals(relation: "graphitron_assert_type_node", rows: """
  coordinate,         ordinal, node_path,        parent_path, operator,   type_name
  Mottaker.sti,       0,       0,                ,            IS,         Soker
  Query.check(path:), 0,       0,                ,            IMPLEMENTS, Node
  Query.check(path:), 1,       0,                ,            ANY_OF,
  Query.check(path:), 1,       0.anyOf.0,        0,           IS,         Soker
  Query.check(path:), 1,       0.anyOf.1,        0,           NOT,
  Query.check(path:), 1,       0.anyOf.1.not,    0.anyOf.1,   IMPLEMENTS, Node
  """)

extend schema @assertEmpty(relation: "graphitron_entry_defect", where: "code LIKE 'ASSERT_TYPE_%'")
