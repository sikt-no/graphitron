# An @asFacet field taken only by a field returning a connection type the author declared. That is a
# valid schema, and graphitron does not yet generate the facets field on a connection type it did not
# generate, so FilmFilter.title draws AUTHORED_CONNECTION_FACET_UNSUPPORTED at the @asFacet, naming the
# input type, and not FACET_SURFACED_NOWHERE. LanguageFilter is the near miss: a field returning the
# declared LanguagesPage takes it, and so does an @asConnection field, which surfaces its facet.

type Film @table(name: "film") { title: String }
type Language @table(name: "language") { name: String }

input FilmFilter { title: [String!] @field(name: "title") @asFacet }
input LanguageFilter { name: [String!] @field(name: "name") @asFacet }

type FilmsPage { edges: [FilmsEdge!]! pageInfo: PageInfo! }
type FilmsEdge { cursor: String! node: Film! }
type LanguagesPage { edges: [LanguagesEdge!]! pageInfo: PageInfo! }
type LanguagesEdge { cursor: String! node: Language! }
type PageInfo { hasNextPage: Boolean! hasPreviousPage: Boolean! startCursor: String endCursor: String }

type Query {
  films(filter: FilmFilter, first: Int, after: String): FilmsPage @defaultOrder(primaryKey: true)
  languagePage(filter: LanguageFilter, first: Int, after: String): LanguagesPage @defaultOrder(primaryKey: true)
  languages(filter: LanguageFilter): [Language!]! @asConnection @defaultOrder(primaryKey: true)
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code IN ('AUTHORED_CONNECTION_FACET_UNSUPPORTED', 'FACET_SURFACED_NOWHERE')", rows: """
  code,                                  coordinate,       detail
  AUTHORED_CONNECTION_FACET_UNSUPPORTED, FilmFilter.title, FilmFilter
  """)
