# A child service batches its parents' keys, and under a @table type a parent is a row of that table.
# CallShapeService.byFilm takes its parents as a Set of FilmRecord: under Film that is the parents
# themselves, while under Language nothing turns a language row into a film record, so the call is
# refused there for the record class it takes.

type Film @table(name: "film") {
  title: String
  shape: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.CallShapeService", method: "byFilm"})
}

type Language @table(name: "language") {
  name: String
  shape: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.CallShapeService", method: "byFilm"})
}

type Query {
  films: [Film!]!
  languages: [Language!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'SERVICE_SOURCES_OTHER_TABLE'", rows: """
  code,                        coordinate,     detail
  SERVICE_SOURCES_OTHER_TABLE, Language.shape, no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord
  """)
