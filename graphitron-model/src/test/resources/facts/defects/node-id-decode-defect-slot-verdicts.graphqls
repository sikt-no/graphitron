# A @nodeId argument whose decoded value reaches a Java parameter by name, judged at that parameter:
# the whole key lands only on the node's own record or a tuple of its key, so it is refused at any
# other class, on a tuple typed otherwise than the key, or on the slot's shape, and otherwise carried
# out. One key column is taken by projecting it with argMapping. A @condition's parameter is judged
# as a @service's, the id an argument or an input field. Each verdict sits beside the shapes
# that resolve, since the relation is the population the decode does not claim and an absence there
# is a resolution.

type Film @table(name: "film") @node { title: String }

# A composite key, (actor_id, film_id).
type FilmActor @table(name: "film_actor") @node { filmId: Int @field(name: "film_id") }

# A pinned key column the table does not have, so the catalog cannot type it.
type Pinned @table(name: "language") @node(keyColumns: ["not_a_column"]) { name: String }

type Address @table(name: "address") @node { district: String }

type Customer @table(name: "customer") { firstName: String @field(name: "first_name") }

# A @nodeId input field whose own @condition takes the whole key at the column's type: refused; the
# projected twin takes the column's value.
input CustomerAddressFilter {
  addressId: ID @nodeId(typeName: "Address") @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "addressDistrictAlberta"}, override: true)
}

input CustomerAddressProjectedFilter {
  addressId: ID @nodeId(typeName: "Address") @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "addressDistrictAlberta", argMapping: "addressId: addressId.address_id"}, override: true)
}

input PairingInput {
  title: String
  pairingId: ID @nodeId(typeName: "FilmActor")
}

type Query {
  # A composite key at a parameter holding one String: refused.
  pairings(userId: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet"})
  # A one-column key at a String parameter: refused the same way, a whole key never landing as a value.
  greetings(userId: ID @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet"})
  # ... even at the key column's own type, Integer ...
  film(id: ID @nodeId(typeName: "Film")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup"})
  # ... and so is a pair handing the whole id to a parameter, at the column's type or another ...
  filmByPair(ids: ID @nodeId(typeName: "Film")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup", argMapping: "id: ids"})
  greetingsByPair(ids: ID @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet", argMapping: "userId: ids"})
  # ... which a pair projecting the column into the parameter takes as the column's value.
  filmByProjection(ref: ID @nodeId(typeName: "Film")): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup", argMapping: "id: ref.film_id"})
  # The node type's own record takes the whole tuple, at any arity.
  filmActorRecord(in: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService", method: "modifyFilmActorRecord"})
  # A @condition's parameter taking the whole key by its name at the column's type: refused, as a
  # @service's is; projected, it takes the column's value.
  filmsByConditionKey(filmId: ID @nodeId(typeName: "Film")): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals"}, override: true)
  filmsByConditionProjection(filmId: ID @nodeId(typeName: "Film")): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals", argMapping: "filmId: filmId.film_id"}, override: true)
  customersByAddress(filter: CustomerAddressFilter): [Customer!]!
  customersByAddressProjected(filter: CustomerAddressProjectedFilter): [Customer!]!
  # No parameter at all: a table predicate.
  films(ids: [ID!] @nodeId(typeName: "Film")): [Film!]!
  # A key column the catalog cannot type resolves no key, so nothing is judged.
  pinned(userId: ID @nodeId(typeName: "Pinned")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService", method: "greet"})
  # A primitive parameter is refused at one key column ...
  untyped(ids: ID @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "untyped"})
  # ... and at two.
  untypedPairing(ids: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "untyped"})
  # A list lands on the element: a List of the node type's own record ...
  filmActorsByIds(ids: [ID!] @nodeId(typeName: "FilmActor")): [FilmActor]
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmActorCarrierService", method: "filmActorsByIds"})
  # ... and not of the sole key column's type, refused per element ...
  filmsByIds(ids: [ID!] @nodeId(typeName: "Film")): [Film]
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  # ... as an element of another type is.
  rateFilms(ratings: [ID!] @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService", method: "rateFilms"})
  # A composite key at a List of single values is refused per element.
  pairingsByIds(ids: [ID!] @nodeId(typeName: "FilmActor")): [Film]
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  # A Set of the very record: the element is right and the container is not.
  titleTitlecase(films: [ID!] @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleTitlecase"})
  # One id at a List parameter.
  filmActorByIds(ids: ID @nodeId(typeName: "FilmActor")): [FilmActor]
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmActorCarrierService", method: "filmActorsByIds"})
  # An overloaded producer resolves several candidate slots and no verdict.
  byIds(ids: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "byIds"})
  # A jOOQ tuple typed by the key columns in key order takes the key: one column ...
  filmByTuple(key: ID @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "filmByTuple"})
  # ... two, as a record ...
  pairByTuple(key: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "pairByTuple"})
  # ... or as the row values of a list.
  pairsByRows(keys: [ID!] @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "pairsByRows"})
  # A tuple of the key's degree whose types are not the key columns' is refused on the types ...
  pairByMistypedRow(key: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "pairByMistypedRow"})
  # ... and one of another degree as any class other than the key's.
  pairByWideTuple(key: ID @nodeId(typeName: "FilmActor")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NodeIdSlotService", method: "pairByWideTuple"})
  # An input field whose root argument feeds a parameter: the value lands inside the bean.
  echo(by: PairingInput): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmTitleEchoService", method: "echo"})
}

# Each refusal is a defect at the @nodeId, the parameter it lands in as its detail.
extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code IN ('NODE_ID_SLOT_SHAPE_MISMATCH', 'NODE_ID_KEY_ARITY_EXCEEDS_SLOT', 'NODE_ID_KEY_COLUMN_TYPE_DISAGREEMENT',
           'NODE_ID_KEY_TUPLE_TYPE_DISAGREEMENT')
  """, rows: """
  coordinate,                     code,                                 detail
  Query.pairByMistypedRow(key:),  NODE_ID_KEY_TUPLE_TYPE_DISAGREEMENT,  key
  Query.pairByWideTuple(key:),    NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       key
  Query.film(id:),                NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       id
  Query.filmsByConditionKey(filmId:), NODE_ID_KEY_ARITY_EXCEEDS_SLOT,   filmId
  CustomerAddressFilter.addressId, NODE_ID_KEY_ARITY_EXCEEDS_SLOT,      addressId
  Query.filmByPair(ids:),         NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       id
  Query.greetingsByPair(ids:),    NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       userId
  Query.filmsByIds(ids:),         NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       ids
  Query.greetings(userId:),       NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       userId
  Query.pairings(userId:),        NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       userId
  Query.pairingsByIds(ids:),      NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       ids
  Query.rateFilms(ratings:),      NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       ratings
  Query.titleTitlecase(films:),   NODE_ID_SLOT_SHAPE_MISMATCH,          films
  Query.filmActorByIds(ids:),     NODE_ID_SLOT_SHAPE_MISMATCH,          ids
  Query.untyped(ids:),            NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       ids
  Query.untypedPairing(ids:),     NODE_ID_KEY_ARITY_EXCEEDS_SLOT,       ids
  """)

# What the decode lands in at each slot the verdicts read.
extend schema @assertContains(relation: "graphitron_occurrence_node_id_slot", rows: """
  coordinate,                    kind,      slot_shape, landing_class
  Query.greetings(userId:),      PARAMETER, SINGLE,     java.lang.String
  Query.pairingsByIds(ids:),     PARAMETER, LIST,       java.lang.Integer
  Query.rateFilms(ratings:),     PARAMETER, LIST,       no.sikt.graphitron.rewrite.test.services.FilmRating
  Query.titleTitlecase(films:),  PARAMETER, MISMATCH,   java.util.Set
  Query.filmActorByIds(ids:),    PARAMETER, MISMATCH,   java.util.List
  """)

# How each decode that resolves lands: the node's own record, a jOOQ tuple typed by the key columns
# in key order, or the value of the one column a pair projects.
extend schema @assertContains(relation: "graphitron_occurrence_node_id_shape", rows: """
  coordinate,                 bound,             decode_shape
  Query.filmByProjection(ref:), public.film,      KEY_VALUE
  Query.filmActorRecord(in:), public.film_actor, OWN_RECORD
  Query.filmByTuple(key:),    public.film,       RECORD_N
  Query.pairByTuple(key:),    public.film_actor, RECORD_N
  Query.pairsByRows(keys:),   public.film_actor, ROW_N
  """)
