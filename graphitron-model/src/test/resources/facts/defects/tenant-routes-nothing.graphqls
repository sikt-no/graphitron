# A tenant named for a root @service whose result is a global table's, under a build whose tenant
# column is film_id: language has no film_id, so its rows are read on the key with an empty tenant
# part whatever the call names, here by a $tenant pair; @tenant is refused the same way, as
# tenant-routes-nothing-untenanted pins. The same marker on a call returning film's rows routes it
# and draws nothing.

extend schema @withConfiguration(tenantColumn: "film_id")

type Language @table(name: "language") { name: String }
type Film @table(name: "film") { title: String }

type Query {
  languagesPaired(org: Int!): [Language!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService",
      method: "languagesAsFilms", argMapping: "$tenant: org"})
  filmMarked(id: Int! @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code LIKE 'TENANT%' OR code = 'UNROUTED_SERVICE_CALL'", rows: """
  code,                  coordinate,            detail
  TENANT_ROUTES_NOTHING, Query.languagesPaired, language
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_tenant_slot", rows: """
  producer_coordinate,       kind,     coordinate
  Query.languagesPaired, AUTHORED, Query.languagesPaired(org:)
  Query.filmMarked,      AUTHORED, Query.filmMarked(id:)
  """)
