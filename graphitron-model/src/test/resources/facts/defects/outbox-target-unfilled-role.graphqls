# A role is something graphitron fills, and it fills two: the event's type and its payload. A
# configuration binding another, as Debezium's aggregatetype, binds something nothing writes, so it is
# refused at every @outbox, though the table itself would serve.

extend schema @withConfiguration(outboxTable: "outbox", outboxColumns: ["aggregatetype=written_by"])
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  create(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                  coordinate,      detail
  OUTBOX_TARGET_INVALID, Mutation.create, "<columns> binds aggregatetype, a role graphitron does not fill: a message is its type and its payload, and a target's other columns are the database's"
  """)
