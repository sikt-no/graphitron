# What a @lookupKey asks that no key can state: a lookup on a field returning a connection, which
# pages where the keys answer one row each; a lookup on a field below the root returning one value by
# a column that identifies no row, which several rows could match; and a node id argument of a node on
# another table than the field reads, which unpacks into no key of its rows. Each is refused at the
# application. Beside them the near misses: a single child looked up by its table's primary key, a
# single-valued lookup at the root and a node id of the field's own node, all keys; an input object's
# node id of another table's node, carried back through the foreign key, is a key too, stated in
# scenarios/inline-list-lookup-key.

type Store implements Node @table(name: "store") @node(typeId: "Store", keyColumns: ["store_id"]) {
    id: ID!
}

type Customer @table(name: "customer") {
    email: String
}

type Film implements Node @table(name: "film") @node(typeId: "Film", keyColumns: ["film_id"]) {
    id: ID!
    title: String

    # Below the root, one value, by the film's primary key.
    sequel(film_id: Int @lookupKey @field(name: "film_id")): Film
        @reference(path: [{key: "film_original_language_id_fkey"}, {key: "film_language_id_fkey"}])
    # The same by its title, which identifies no film.
    sequelByTitle(title: String @lookupKey @field(name: "title")): Film
        @reference(path: [{key: "film_original_language_id_fkey"}, {key: "film_language_id_fkey"}])
}

type Query {
    filmsPaged(film_id: [Int] @lookupKey @field(name: "film_id")): [Film] @asConnection

    customersByStore(store: [ID] @nodeId(typeName: "Store") @lookupKey): [Customer]

    filmByKey(film_id: Int! @lookupKey @field(name: "film_id")): Film
    filmsById(id: [ID] @nodeId(typeName: "Film") @lookupKey): [Film]
    node(id: ID!): Node
}

interface Node {
    id: ID!
}

# A single child looked up by its table's primary key, the emitter's execution test reading it: among
# the cities of the address's country, the one the caller names.
type City @table(name: "city") {
    name: String @field(name: "city")
}

type AddressRow @table(name: "address") {
    address: String
    neighbour(city_id: Int! @lookupKey @field(name: "city_id")): City!
        @reference(path: [{key: "address_city_id_fkey"}, {key: "city_country_id_fkey"}, {key: "city_country_id_fkey"}])
}

extend schema @expectEquals(relation: "graphitron_entry_defect", rows: """
  source_line, code,                       detail
  26,          LOOKUP_KEY_NOT_IDENTIFYING, public.film
  31,          LOOKUP_KEY_ON_CONNECTION,
  33,          LOOKUP_KEY_OFF_TABLE,       public.store
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_lookup_key", rows: """
  coordinate,       bound,       key_coordinate,             key_bound,   key_kind, argument_ordinal, field_ordinal
  AddressRow.neighbour, public.city, AddressRow.neighbour(city_id:), public.city, COLUMN, 0,       -1
  Film.sequel,      public.film, Film.sequel(film_id:),      public.film, COLUMN,   0,                -1
  Film.sequelByTitle, public.film, Film.sequelByTitle(title:), public.film, COLUMN, 0,              -1
  Query.filmsPaged, public.film, Query.filmsPaged(film_id:), public.film, COLUMN,   0,                -1
  Query.filmByKey,  public.film, Query.filmByKey(film_id:),  public.film, COLUMN,   0,                -1
  Query.filmsById,  public.film, Query.filmsById(id:),       public.film, NODE_ID,  0,                -1
  """)
