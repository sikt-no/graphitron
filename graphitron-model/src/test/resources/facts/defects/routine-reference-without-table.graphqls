# A @reference takes its target from the return type's @table, a @routine before it included, so a
# path ending on a @reference whose return type has no @table has nowhere to arrive, reported at the
# claim, the field declaration. A path ending on the @routine does: its type's rows are the
# function's result, which needs no table.

type FilmRow {
  title: String
}

type ActorFilm {
  filmId: Int @field(name: "FILM_ID")
}

type Film @table(name: "film") {
  title: String
  # The path ends on the routine, so ActorFilm's rows are films_for_actor's result.
  castFilms(minLength: Int!): [ActorFilm!]
    @reference(path: [{table: "film_actor"}])
    @routine(name: "films_for_actor",
             argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

extend type Query {
  films: [Film]
  # The path ends on a @reference into film, and FilmRow names no table to arrive at.
  recentFilmRows(actorId: Int!, minLength: Int!): [FilmRow!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @reference(path: [{table: "film"}])
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code = 'REFERENCE_WITHOUT_TARGET_TABLE'
  AND (graph_name, source_name, source_line, source_column) IN (
    SELECT graph_name, source_name, source_line, source_column FROM graphitron_join_path_claim)
  """, rows: """
  coordinate,           detail
  Query.recentFilmRows, FilmRow
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,                           coordinate
  REFERENCE_WITHOUT_TARGET_TABLE, Film.castFilms
  """)
