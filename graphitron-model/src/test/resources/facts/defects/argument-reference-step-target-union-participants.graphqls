# An argument on a field returning a union has a need per participant, each walked from that
# participant's table: film_actor reaches film by its foreign key, and the table-valued function
# films_for_actor by a name match, its result exposing film's whole primary key. Each need takes its
# one step and none stops.

type FilmActor @table(name: "film_actor") { lastUpdate: String @field(name: "last_update") }
type FilmForActor @table(name: "films_for_actor") { title: String }

union AnyFilmRow = FilmActor | FilmForActor

extend type Query {
  rows(filmed: String @reference(path: [{table: "film"}])): [AnyFilmRow!]!
}

extend schema @expectEquals(relation: "graphitron_join_path_step", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, element_place, from_table, to_table
  Query.rows(filmed:), FilmActor, 0, 0, film_actor, film
  Query.rows(filmed:), FilmForActor, 0, 0, films_for_actor, film
  """)

extend schema @assertEmpty(relation: "graphitron_join_path_stop")
