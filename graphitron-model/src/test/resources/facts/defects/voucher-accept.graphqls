extend schema @withConfiguration(sessionState: true)

"A field marked @accept is the voucher field of an entity another subgraph vouches for: its application is captured as written, its claims parsed one selection per row, and it binds by the voucher kind, so the column rule never looks for a voucher column. Until the dispatch that verifies vouchers is generated, @accept is refused at the application."
type Film @table(name: "film") @key(fields: "filmId") {
  filmId: ID! @field(name: "film_id")
  languageId: Int @field(name: "language_id")
  title: String
  voucher: String! @accept(scope: "films", claims: "languageId")
}

# A node may accept: its node key and its voucher key are both minted, numbered once after the key its
# author wrote.
type Store implements Node @table(name: "store") @node @key(fields: "managerStaffId") {
  id: ID!
  managerStaffId: Int @field(name: "manager_staff_id")
  addressId: Int @field(name: "address_id")
  voucher: String @accept(scope: "stores", claims: "addressId")
}

interface Node {
  id: ID!
}

extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

type Query {
  films: [Film!]!
  stores: [Store!]!
}

extend schema @expectEquals(relation: "graphitron_ast_accept_entry", rows: """
  scope,  claims
  films,  languageId
  stores, addressId
  """)

# key: was left out, which is a null, not the one authored key filled in.
extend schema @assertEmpty(relation: "graphitron_ast_accept_entry", where: "key_fields IS NOT NULL")

extend schema @expectEquals(relation: "graphitron_ast_accept_claim_entry", rows: """
  position, field_name, nested
  0,        addressId,  FALSE
  0,        languageId, FALSE
  """)

# Each claim resolved to the field of the accepting type it names.
extend schema @expectEquals(relation: "graphitron_accept_claim", rows: """
  position, type_name, field_name
  0,        Film,      languageId
  0,        Store,     addressId
  """)

# The accepting type's other fields are fields like any other: an @accept absorbs nothing.
extend schema @assertEmpty(relation: "graphitron_voucher_member")

extend schema @expectEquals(relation: "graphitron_occurrence_binding", where: """
  kind = 'VOUCHER'
  """, rows: """
  kind,    bound
  VOUCHER, public.film
  VOUCHER, public.store
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,              detail
  COLUMN_UNRESOLVED, Film.voucher
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code = 'VOUCHER_ACCEPT_NOT_GENERATED'
  """, rows: """
  code,                         type_name, detail
  VOUCHER_ACCEPT_NOT_GENERATED, Film,      Film.voucher
  VOUCHER_ACCEPT_NOT_GENERATED, Store,     Store.voucher
  """)

# The voucher keys its type as a key this subgraph resolves, beside the one its author wrote, and is
# kept from clients.
extend schema @expectEquals(relation: "graphitron_minted_key", rows: """
  type_name, role,   fields,  resolvable, ordinal
  Film,      ACCEPT, voucher, TRUE,       1
  Store,     ACCEPT, voucher, TRUE,       2
  Store,     NODE,   id,      TRUE,       1
  """)

extend schema @expectEquals(relation: "graphitron_directive_application", where: """
  origin = 'MINTED' AND directive_name IN ('key', 'inaccessible')
  """, rows: """
  coordinate,    directive_name, ordinal
  Film,          key,            1
  Film.voucher,  inaccessible,   0
  Store,         key,            1
  Store,         key,            2
  Store.voucher, inaccessible,   0
  """)

extend schema @expectEquals(relation: "graphitron_directive_application_arg", where: """
  coordinate = 'Film' AND directive_name = 'key' AND ordinal = 1 AND directive_argument_name = 'resolvable'
  """, rows: """
  value_sdl
  true
  """)

# The voucher alternative, stated: the voucher key's one field binds the voucher, and each @accept decodes
# to its type's one authored resolvable key, the one it names being left out.
extend schema @expectEquals(relation: "graphitron_key_field_binding", where: "kind = 'VOUCHER'", rows: """
  type_name, ordinal, position, field_name, kind,    bound
  Film,      1,       0,        voucher,    VOUCHER, public.film
  Store,     2,       0,        voucher,    VOUCHER, public.store
  """)

extend schema @expectEquals(relation: "graphitron_accept_key", rows: """
  type_name, directive_name, ordinal
  Film,      key,            0
  Store,     key,            0
  """)
