# A child @routine's parameter reads a name, and the name is an argument of the field or a column of
# the table the path stands on. Here actor_id is both: Actor.films takes an argument actor_id, and
# actor has a column actor_id. Neither is preferred, so the parameter binds nothing and the
# @routine draws the defect; the binding view says which parameter. pMinLength reads an argument
# only and binds.

type ActorFilm {
  filmId: Int @field(name: "film_id")
}

type Actor @table(name: "actor") {
  films(actor_id: Int!, minLength: Int!): [ActorFilm!]
    @routine(name: "films_for_actor",
             argMapping: "pActorId: actor_id, pMinLength: minLength")
}

extend type Query {
  actors: [Actor]
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                        coordinate
  ROUTINE_PARAMETER_AMBIGUOUS, Actor.films
  """)

extend schema @expectEquals(relation: "graphitron_field_path_parameter", rows: """
  type_name, field_name, position, parameter_name, from_table, from_column, argument
  Actor,     films,      0,        pMinLength,     ,           ,            minLength
  """)

extend schema @expectEquals(relation: "graphitron_field_path_parameter_binding", rows: """
  type_name, field_name, parameter_name, bound_to,  argument_name, from_column
  Actor,     films,      pActorId,       actor_id,  actor_id,      actor_id
  Actor,     films,      pMinLength,     minLength, minLength,
  """)
