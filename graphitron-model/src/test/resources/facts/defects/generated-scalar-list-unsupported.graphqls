# A generated scalar is decoded once per call, into one record of components. A list of them, or
# one read through a list of input objects, would need a decode per element, which is deferred: each
# is refused at the argument or input field, the detail the scalar, and the positive rule does not
# judge it. The near miss takes a component of a single value and draws nothing.

scalar Path @generatedScalar(kind: SCHEMA_PATH)

input PathHolder { sti: Path }

type Query {
  many(paths: [Path!]): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.ParameterShapeService", method: "byTitle", argMapping: "title: paths.endType"})
  throughList(in: [PathHolder!]): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.ParameterShapeService", method: "byTitle", argMapping: "title: in.sti.startType"})
  one(path: Path): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.ParameterShapeService", method: "byTitle", argMapping: "title: path.startType"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code LIKE 'GENERATED_SCALAR_%'", rows: """
  code,                              coordinate,            detail
  GENERATED_SCALAR_LIST_UNSUPPORTED, Query.many(paths:),    Path
  GENERATED_SCALAR_LIST_UNSUPPORTED, PathHolder.sti,        Path
  """)
