# What a sort key's path cannot state, each refused at the fields element that writes it, as the walk
# refuses it: an element carrying a condition, a hop reaching many rows, a key that does not touch the
# table the path stands on, and a name that is no column of the table the path lands on. Beside them
# the near miss: one hop forward along a film's original language key, to-one, reading the language's
# name.

type Film @table(name: "film") {
    title: String
}

type Language @table(name: "language") {
    name: String
}

type Query {
    filmsByOriginalLanguage: [Film!]! @defaultOrder(fields: [{name: "name", path: [{key: "film_original_language_id_fkey"}]}])
    filmsByCondition: [Film!]! @defaultOrder(fields: [{name: "name", path: [{key: "film_language_id_fkey", condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "agreeingOnBoth"}}]}])
    languagesByFilm: [Language!]! @defaultOrder(fields: [{name: "title", path: [{key: "film_language_id_fkey"}]}])
    filmsByStore: [Film!]! @defaultOrder(fields: [{name: "address", path: [{key: "inventory_store_id_fkey"}]}])
    filmsByNoColumn: [Film!]! @defaultOrder(fields: [{name: "no_such_column", path: [{key: "film_language_id_fkey"}]}])
}

# The condition is refused too, pinned where undecided/code-reference-resolution writes one.
extend schema @expectEquals(relation: "graphitron_entry_defect", where: "code IN ('SORT_KEY_PATH_TO_MANY', 'SORT_KEY_PATH_UNRESOLVED', 'SORT_KEY_COLUMN_OFF_PATH')", rows: """
  source_line, code,                       detail
  18,          SORT_KEY_PATH_TO_MANY,       film_language_id_fkey
  19,          SORT_KEY_PATH_UNRESOLVED,    inventory_store_id_fkey
  20,          SORT_KEY_COLUMN_OFF_PATH,    public.language
  """)

extend schema @expectEquals(relation: "graphitron_order_sort_key_hop", rows: """
  choice,                        hop, constraint_name,                direction, from_table, to_table, to_one
  Query.filmsByOriginalLanguage, 0,   film_original_language_id_fkey, FORWARD,   film,       language, TRUE
  Query.filmsByCondition,        0,   film_language_id_fkey,          FORWARD,   film,       language, TRUE
  Query.languagesByFilm,         0,   film_language_id_fkey,          BACKWARD,  language,   film,     FALSE
  Query.filmsByNoColumn,         0,   film_language_id_fkey,          FORWARD,   film,       language, TRUE
  """)

# A whole path lands where its last hop does, whether or not its name is a column there; a path a
# hop refuses, or a condition, lands nowhere.
extend schema @expectEquals(relation: "graphitron_order_sort_key_landing", rows: """
  choice,                        kind, to_table
  Query.filmsByOriginalLanguage, PATH, language
  Query.filmsByNoColumn,         PATH, language
  """)

extend schema @expectEquals(relation: "graphitron_order_sort_key_column", rows: """
  choice,                        kind, table_name, column_name
  Query.filmsByOriginalLanguage, PATH, language,   name
  """)
