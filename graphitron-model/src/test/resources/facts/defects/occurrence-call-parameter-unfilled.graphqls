# A service call's parameter that nothing fills, that more than one argument could fill by type, or
# that two written fills reach, and the edges around them. unfilledFilms takes a method whose ids
# parameter, a List<Integer>, has no argument of its name, no pair and no argument of its type: its
# one argument other is a list of String, so the two are the last parameter and argument left, but
# both have a Java type and they disagree, and a call pairing them would not compile.
# ambiguousFilms offers two lists of Int to that one parameter, so type cannot choose. greetedTwice names userId in argMapping and in contextArguments both, so nothing says which
# fills it. namelessList calls a class compiled without -parameters, whose parameters carry no name
# for an argument to match; the one Int argument still fills the one int parameter by type, while
# namelessUnfilled, with no argument to fill it by type, is the build's to fix, not an unbound name.
# unlandedFilms names filmIds in a pair whose path lands nowhere: that is the pair's defect, so the parameter has no
# fill and is not reported unfilled a second time. contextPair fills userId from a $context pair,
# which this site refuses while the fill itself is still stated.
#
# A root has no parent to batch against, so a parameter taking a batch of keys, records or rows, is
# one nothing fills there, at Query and Mutation alike, whatever the method returns. A list parameter
# beside a lone input-object argument is no pair for it, list against one value, so nothing fills it
# either. And a child's parameter nothing fills is refused as a root's is.

input FilmIdInput { filmId: ID }

type Film @table(name: "film") {
  title: String
  unfilledChild: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.ParameterShapeService", method: "byTitle"})
}

type Mutation {
  rowsAtRoot: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.CallShapeService", method: "byRow"})
}

type Query {
  films: [Film!]!
  recordsAtRoot: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBatchShapeService", method: "titlesInOrder"})
  listForInput(in: FilmIdInput): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.ParameterShapeService", method: "byTitles"})
  unfilledFilms(other: [String!]): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmsByService"})
  ambiguousFilms(first: [Int!], second: [Int!]): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmsByServiceRenamed"})
  greetedTwice(name: String): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService",
      method: "greet", argMapping: "userId: name"}, contextArguments: ["userId"])
  namelessList(limit: Int!): [String] @service(service: {
      className: "no.sikt.graphitron.rewrite.test.nameless.NamelessService",
      method: "list"})
  namelessUnfilled: [String] @service(service: {
      className: "no.sikt.graphitron.rewrite.test.nameless.NamelessService",
      method: "list"})
  unlandedFilms(ids: [Int!]): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.SampleQueryService",
      method: "filmsByServiceRenamed", argMapping: "filmIds: nowhere"})
  contextPair: String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.UserGreetingService",
      method: "greet", argMapping: "userId: $context.userId"})
}

extend schema @assertContains(relation: "graphitron_occurrence_call_parameter_defect", rows: """
  coordinate,          position, parameter_name, code
  Query.unfilledFilms, 1,        ids,            PARAMETER_UNFILLED
  Query.ambiguousFilms, 1,       filmIds,        PARAMETER_AMBIGUOUS
  Query.greetedTwice,  0,        userId,         PARAMETER_FILLED_TWICE
  Query.namelessUnfilled, 0,     ,               PARAMETER_NAMES_MISSING
  Query.recordsAtRoot, 0,        films,          PARAMETER_UNFILLED
  Mutation.rowsAtRoot, 0,        keys,           PARAMETER_UNFILLED
  Query.listForInput,  0,        titles,         PARAMETER_UNFILLED
  Film.unfilledChild,  0,        title,          PARAMETER_UNFILLED
  """)

extend schema @assertAbsent(relation: "graphitron_occurrence_call_parameter_defect", rows: """
  coordinate
  Query.unlandedFilms
  Query.contextPair
  Query.namelessList
  """)

# The mismatched last pair is no candidate either, so nothing calls it ambiguous instead.
extend schema @assertAbsent(relation: "graphitron_occurrence_call_parameter_candidate", rows: """
  coordinate,          position
  Query.unfilledFilms, 1
  """)

extend schema @assertAbsent(relation: "graphitron_occurrence_call_parameter", rows: """
  coordinate,          position
  Query.unfilledFilms, 1
  Query.greetedTwice,  0
  Query.ambiguousFilms, 1
  Query.unlandedFilms, 1
  """)

extend schema @assertContains(relation: "graphitron_occurrence_call_parameter", rows: """
  coordinate,          position, fill,        context_key
  Query.unlandedFilms, 0,        DSL_CONTEXT,
  Query.contextPair,   0,        CONTEXT_KEY, userId
  Query.namelessList,  0,        ARGUMENT,
  """)

# Each parameter nothing fills, two arguments could fill or two fills reach is refused at its call.
extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                       coordinate
  PARAMETER_UNFILLED,         Query.unfilledFilms
  PARAMETER_AMBIGUOUS,        Query.ambiguousFilms
  PARAMETER_FILLED_TWICE,     Query.greetedTwice
  ARGMAPPING_PATH_UNRESOLVED, Query.unlandedFilms
  CONTEXT_SITE_UNSUPPORTED,   Query.contextPair
  """)

# A nameless parameter nothing fills is one defect at the reference, naming the class to recompile,
# and no unbound name beside it.
extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                    coordinate,             detail
  PARAMETER_NAMES_MISSING, Query.namelessUnfilled, no.sikt.graphitron.rewrite.test.nameless.NamelessService
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  PARAMETER_UNFILLED, Query.namelessUnfilled
  """)

# Each defect names the parameters it is about, under it.
extend schema @assertContains(relation: "graphitron_entry_defect_parameter_rule", rows: """
  code,                   coordinate,           call,     position, parameter_name
  PARAMETER_UNFILLED,     Query.unfilledFilms,  producer, 1,        ids
  PARAMETER_AMBIGUOUS,    Query.ambiguousFilms, producer, 1,        filmIds
  PARAMETER_FILLED_TWICE, Query.greetedTwice,   producer, 0,        userId
  """)
