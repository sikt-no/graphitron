# What each claiming directive claims, as written and wherever written, roots included: a claim decides
# nothing, so a @table or @error on a root type and an @externalField or @nodeId on a root field are
# claims like any other, for the readers and the conflict rule to weigh. A repeated @routine is one
# claim at its first application, and each marked argument its own LOOKUP claim on the field. An
# input-typed argument without the directive claims nothing, the directive being declared on
# arguments only.

type Film @table(name: "film") {
  title: String
  claimed: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmExtensions"})
    @nodeId
  routine: [Film!]! @routine(name: "film_fn")
  mutation: Film @mutation(typeName: INSERT)
  marked(id: ID @lookupKey): Film
}

type Failure @table(name: "film") @error(handlers: [{handler: DATABASE}]) {
  title: String
}

input LookupInput { key: Int }

type Query @table(name: "film") @error(handlers: [{handler: DATABASE}]) {
  claimed: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmExtensions"})
    @nodeId
  routine: [Film!]! @routine(name: "film_fn")
  mutation: Film @mutation(typeName: INSERT)
  marked(id: ID @lookupKey): Film
  repeated: [Film!]!
    @routine(name: "first_fn")
    @routine(name: "second_fn")
  markedTwice(
    first: ID @lookupKey
    second: ID @lookupKey
  ): Film
  byInput(in: LookupInput): Film
  untouched(in: ID): Film
}

type Mutation @table(name: "film") @error(handlers: [{handler: DATABASE}]) {
  claimed: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmExtensions"})
    @nodeId
  routine: [Film!]! @routine(name: "film_fn")
  mutation: Film @mutation(typeName: INSERT)
  marked(id: ID @lookupKey): Film
}

type Subscription @table(name: "film") @error(handlers: [{handler: DATABASE}]) {
  claimed: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmExtensions"})
    @nodeId
  routine: [Film!]! @routine(name: "film_fn")
  mutation: Film @mutation(typeName: INSERT)
  marked(id: ID @lookupKey): Film
}

extend schema @expectEquals(relation: "graphitron_claim",
    where: "coordinate NOT IN ('Query.anchor', 'FactAnchor.paymentId', 'FactAnchor')", rows: """
  coordinate          , kind      , claimer                   , source_line
  Failure             , ERROR_TYPE, Failure                   , 19
  Failure             , TABLE_TYPE, Failure                   , 19
  Film                , TABLE_TYPE, Film                      , 8
  Film.claimed        , EXPRESSION, Film.claimed              , 12
  Film.claimed        , NODE_ID   , Film.claimed              , 13
  Film.claimed        , SERVICE   , Film.claimed              , 11
  Mutation            , ERROR_TYPE, Mutation                  , 44
  Mutation            , TABLE_TYPE, Mutation                  , 44
  Mutation.claimed    , EXPRESSION, Mutation.claimed          , 47
  Mutation.claimed    , NODE_ID   , Mutation.claimed          , 48
  Mutation.claimed    , SERVICE   , Mutation.claimed          , 46
  Mutation.mutation   , INSERT    , Mutation.mutation         , 50
  Mutation.routine    , ROUTINE   , Mutation.routine          , 49
  Query               , ERROR_TYPE, Query                     , 25
  Query               , TABLE_TYPE, Query                     , 25
  Query.claimed       , EXPRESSION, Query.claimed             , 28
  Query.claimed       , NODE_ID   , Query.claimed             , 29
  Query.claimed       , SERVICE   , Query.claimed             , 27
  Query.marked        , LOOKUP    , Query.marked(id:)         , 32
  Query.markedTwice   , LOOKUP    , Query.markedTwice(first:) , 37
  Query.markedTwice   , LOOKUP    , Query.markedTwice(second:), 38
  Query.repeated      , ROUTINE   , Query.repeated            , 34
  Query.routine       , ROUTINE   , Query.routine             , 30
  Subscription        , ERROR_TYPE, Subscription              , 54
  Subscription        , TABLE_TYPE, Subscription              , 54
  Subscription.claimed, EXPRESSION, Subscription.claimed      , 57
  Subscription.claimed, NODE_ID   , Subscription.claimed      , 58
  Subscription.claimed, SERVICE   , Subscription.claimed      , 56
  """)
