# The generator writes one file per type, named for the type, and a filesystem that folds case
# keeps one of two names that differ only in case. Each such type is a defect at its declaration.
# A scalar gets no file of its own, so it collides with nothing.

type Film { title: String }
type FILM { title: String }

# The same spelling as an enum and a scalar: the enum collides, the scalar does not count.
enum Rating { G }
scalar RATING

type Query {
  film: Film
  shouty: FILM
  rating: Rating
  ratingScalar: RATING
}

# The collisions, all of them. The root fields only reach the types, and nothing fetches them, which
# is a defect of its own.
extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "code = 'TYPE_NAME_CASE_COLLISION'", rows: """
  code,                     type_name, field_name, detail
  TYPE_NAME_CASE_COLLISION, FILM,      ,           Film
  TYPE_NAME_CASE_COLLISION, Film,      ,           FILM
  """)

# The rule finds a collision by the folded name the store keeps on each type, so the names that
# collide share it and a name with no twin has its own.
extend schema @expectEquals(relation: "graphitron_type", where: "type_name IN ('Film', 'FILM', 'Rating', 'RATING', 'Query')", rows: """
  type_name, type_name_folded
  FILM,      FILM
  Film,      FILM
  Query,     QUERY
  RATING,    RATING
  Rating,    RATING
  """)
