# A graph resolves its columns through the catalog it was captured against and no other, though
# every graph's catalog sits in one store: solo_parent is this catalog's and its name binds, the
# column naming this catalog, and film is only the fixture catalog's, so its title binds nothing here.

extend schema @withConfiguration(jooqPackage: "no.sikt.graphitron.rewrite.singleschemafixture")

type Parent @table(name: "solo_parent") {
  name: String
}

type Film @table(name: "film") {
  title: String
}

type Query {
  parents: [Parent!]!
  films: [Film!]!
}

extend schema @expectEquals(relation: "graphitron_occurrence_column",
    where: "coordinate NOT IN ('Query.anchor', 'FactAnchor.paymentId')", rows: """
  coordinate , table_source_name                             , table_schema, table_name , column_name
  Parent.name, no.sikt.graphitron.rewrite.singleschemafixture, singleschema, solo_parent, name
  """)
