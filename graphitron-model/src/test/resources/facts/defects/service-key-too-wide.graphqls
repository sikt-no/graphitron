# A service's records are read back through a derived table holding each one's position, its
# parent's and its key, a typed jOOQ record of the key's columns and two more, and jOOQ types records
# of at most 22 values. nodeidfixture.too_wide has a 23-column primary key, so a service handing back
# its records, one or a list, has nothing to read them back by. A service handing back film records,
# keyed on one column, is lifted as usual.

type TooWide @table(name: "nodeidfixture.too_wide") { k1: String }

type Film @table(name: "film") { title: String }

type Query {
  wides: [TooWide!]! @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.TooWideService", method: "all"})
  wide: TooWide @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.TooWideService", method: "one"})
  films: [Film!]! @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "films"})
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site",
    where: "code = 'SERVICE_KEY_TOO_WIDE_UNSUPPORTED'", rows: """
  code,                             coordinate,  detail
  SERVICE_KEY_TOO_WIDE_UNSUPPORTED, Query.wides, too_wide
  SERVICE_KEY_TOO_WIDE_UNSUPPORTED, Query.wide,  too_wide
  """)
