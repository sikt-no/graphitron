# @mutation(typeName: UPSERT) is a write graphitron does not generate yet. The schema means
# something, so the verdict rests on UNSUPPORTED, at the @mutation as written. The verb is still a
# claim: graphitron would generate the write, so a @service beside it, whose author provides the
# code, is the conflict whatever the verb. An upsert runs nothing yet, so it is no producer, and the
# refusal is its only defect rather than a field nothing fetches.
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

type Film @table(name: "film") {
  title: String
}

input FilmInput @table(name: "film") {
  title: String
}

type Mutation {
  upsertFilm(input: FilmInput): Film @mutation(typeName: UPSERT)
  upsertOrService(input: FilmInput): Film
    @mutation(typeName: UPSERT)
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  insertFilm(input: FilmInput): Film @mutation(typeName: INSERT)
}

extend schema @expectEquals(relation: "graphitron_producer_claim", rows: """
  coordinate,               kind
  Mutation.upsertFilm,      UPSERT
  Mutation.upsertOrService, UPSERT
  Mutation.upsertOrService, SERVICE
  Mutation.insertFilm,      INSERT
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                    coordinate
  MUTATION_UPSERT,         Mutation.upsertFilm
  MUTATION_UPSERT,         Mutation.upsertOrService
  CLAIMS_CONFLICT,         Mutation.upsertOrService
  """)

extend schema @expectEquals(relation: "graphitron_producer", where: """
  type_name = 'Mutation'
  """, rows: """
  type_name, field_name, kind
  Mutation,  insertFilm, INSERT
  """)

extend schema @assertContains(relation: "diagnostic", rows: """
  lsp_code,                   coordinate,          severity, actionable
  GRAPHITRON_MUTATION_UPSERT, Mutation.upsertFilm, error,    FALSE
  """)
