# A @routine naming no routine with a generated call draws ELEMENT_UNRESOLVED at the element, a
# child's where its walk breaks, the step having no move from where the walk stands, and a root
# field's, a read's or a write's, though no walk stands on it, its routine being the producer's call.
# A root routine the catalog holds draws nothing.

type ActorFilm {
  filmId: Int @field(name: "FILM_ID")
}

type Actor @table(name: "actor") {
  firstName: String @field(name: "first_name")
  missing(minLength: Int!): [ActorFilm!]
    @routine(name: "no_such_function", argMapping: "pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

type Film @table(name: "film") { title: String }
type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }

type Query {
  actors: [Actor]
  missingFilms: [Film!]! @routine(name: "no_such_function")
  recentFilmsForActor(actorId: Int!, minLength: Int!): [Film!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
}

type Mutation {
  missingRental: [Rental!]! @routine(name: "no_such_function")
}

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  ELEMENT_UNRESOLVED, Actor.missing
  ELEMENT_UNRESOLVED, Query.missingFilms
  ELEMENT_UNRESOLVED, Mutation.missingRental
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,               coordinate
  ELEMENT_UNRESOLVED, Query.recentFilmsForActor
  """)
