# path-entry, read in steps: each @withFacts writes the files of one reading, the clock
# moving between readings, and the claims after it check what that reading left.

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/path-entry/a-t0", as: "path-entry.a"}])

# The field declaration anchors its @reference's two elements, in the order written.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_definition_entry WHERE type_name = 'Customer' AND name = 'city')
  """, rows: """
  place, element_column, touched_at
  0,     34,             1000000000
  1,     69,             1000000000
  """)

# The @referenceFor application on people naming Staff anchors its own path, at its at sign, and is
# no place in the field's.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT r.graph_name, r.source_name, r.source_line, r.source_column
      FROM graphitron_ast_reference_for_entry r
      JOIN graphql_ast_entry e
        ON e.graph_name = r.graph_name AND e.source_name = r.source_name
       AND e.source_line = r.source_line AND e.source_column = r.source_column
      JOIN graphql_ast_field_definition_entry f
        ON f.graph_name = e.graph_name AND f.source_name = e.source_name
       AND f.source_line = e.parent_line AND f.source_column = e.parent_column
     WHERE r.participant_type_ref = 'Staff' AND f.name = 'people')
  """, rows: """
  place, element_column, touched_at
  0,     58,             1000000000
  """)

# The argument anchors its @reference's elements.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_argument_entry
     WHERE type_name = 'Store' AND field_name = 'customers' AND name = 'cityId')
  """, rows: """
  place, element_column, touched_at
  0,     35,             1000000000
  1,     70,             1000000000
  """)

# The input field anchors its @reference's element.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_input_field_entry WHERE type_name = 'CustomerFilter' AND name = 'addressId')
  """, rows: """
  place, element_column, touched_at
  0,     36,             1000000000
  """)

# One anchor per declared element and type reached, at the position its elements are keyed under:
# Customer.city reaches the scalar it returns; the interface's field is one anchor at Located.address,
# its implementation writing nothing; people's two @referenceFor name two members and are two anchors;
# managers names Staff twice and keeps the first written; the argument and the input field reach the
# type they name. Both references stand.
extend schema @expectEquals(relation: "graphitron_join_path_claim", rows: """
  element_coordinate,       target_type, claim_kind,   source_line, source_column, element_coordinate_ref,   target_type_ref, touched_at
  Customer.city,            String,      FIELD,         10,          3,             Customer.city,            String,          1000000000
  Located.address,          Address,     FIELD,         17,          3,             Located.address,          Address,         1000000000
  CustomerFilter.addressId, Int,         INPUT_FIELD,   23,          3,             CustomerFilter.addressId, Int,             1000000000
  Store.people,             Staff,       REFERENCE_FOR, 27,          22,            Store.people,             Staff,           1000000000
  Store.people,             Customer,    REFERENCE_FOR, 28,          5,             Store.people,             Customer,        1000000000
  Store.managers,           Staff,       REFERENCE_FOR, 29,          24,            Store.managers,           Staff,           1000000000
  Store.customers(cityId:), Int,         ARGUMENT,      33,          5,             Store.customers(cityId:), Int,             1000000000
  """)

# The second @referenceFor naming Staff on managers is the defect, at its at sign, naming the type;
# people's two, naming different members, draw nothing.
extend schema @expectEquals(relation: "graphitron_entry_defect", where: """
  code = 'REFERENCE_FOR_DUPLICATE_TYPE'
  """, rows: """
  source_line, source_column, detail, touched_at
  30,          5,             Staff,  1000000000
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/path-entry/a-t60", as: "path-entry.a"}])

# The field's path is one element now, rewritten at this reading.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_definition_entry WHERE type_name = 'Customer' AND name = 'city')
  """, rows: """
  place, element_column, touched_at
  0,     34,             1000000060
  """)

# The @referenceFor application on people naming Staff, unchanged and marked again.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT r.graph_name, r.source_name, r.source_line, r.source_column
      FROM graphitron_ast_reference_for_entry r
      JOIN graphql_ast_entry e
        ON e.graph_name = r.graph_name AND e.source_name = r.source_name
       AND e.source_line = r.source_line AND e.source_column = r.source_column
      JOIN graphql_ast_field_definition_entry f
        ON f.graph_name = e.graph_name AND f.source_name = e.source_name
       AND f.source_line = e.parent_line AND f.source_column = e.parent_column
     WHERE r.participant_type_ref = 'Staff' AND f.name = 'people')
  """, rows: """
  place, element_column, touched_at
  0,     58,             1000000060
  """)

# The argument wrote no path at this reading, so its rows are swept.
extend schema @assertEmpty(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_argument_entry
     WHERE type_name = 'Store' AND field_name = 'customers' AND name = 'cityId')
  """)

# The input field's row, marked again.
extend schema @expectEquals(relation: "graphitron_ast_path_entry", where: """
  (graph_name, source_name, anchor_line, anchor_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_input_field_entry WHERE type_name = 'CustomerFilter' AND name = 'addressId')
  """, rows: """
  place, element_column, touched_at
  0,     36,             1000000060
  """)

# The anchors still written are marked again, at the positions the edit moved them to; the
# argument's is swept, and managers keeps the one @referenceFor naming Staff it still writes.
extend schema @expectEquals(relation: "graphitron_join_path_claim", rows: """
  element_coordinate,       target_type, claim_kind,   source_line, source_column, touched_at
  Customer.city,            String,      FIELD,         9,           3,             1000000060
  Located.address,          Address,     FIELD,         15,          3,             1000000060
  CustomerFilter.addressId, Int,         INPUT_FIELD,   21,          3,             1000000060
  Store.people,             Staff,       REFERENCE_FOR, 25,          22,            1000000060
  Store.people,             Customer,    REFERENCE_FOR, 26,          5,             1000000060
  Store.managers,           Staff,       REFERENCE_FOR, 27,          24,            1000000060
  """)

# managers names Staff once now, so the defect is swept.
extend schema @assertEmpty(relation: "graphitron_entry_defect", where: """
  code = 'REFERENCE_FOR_DUPLICATE_TYPE'
  """)
