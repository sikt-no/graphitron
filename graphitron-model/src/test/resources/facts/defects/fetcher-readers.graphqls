"A result flows down from the producer that made it, through the fields that read it, to every type it reaches. A ROW is a row of a statement graphitron runs, which a field's read is projected into; an OBJECT is a value in memory, read through an accessor. A field of a type holding a result runs something or reads it, and a field that does neither is a defect where it was written."

type Film @table(name: "film") {
  "A column of film's row."
  title: String
  "An expression projected into film's statement."
  titleUppercase: String
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.services.FilmService"})
  "No table of its own, so a row nested in film's."
  details: FilmDetails
  "A pivot's aggregate makes a row of its own."
  translations: Translations
    @reference(path: [{table: "film_translation"}])
    @pivot(on: "lang_code", value: "title_txt", vocabulary: "PivotLang")
  "Nested here, and handed back by a service below as an object of its own class: two shapes on one type, each field dispatching on which it was handed."
  texts: Texts
  "Nested here, and handed back by a service below as film's own record: two shapes graphitron does not serve."
  recordTexts: RecordTexts
  "A child over the interface no table-bound type implements, as a list and as a connection."
  props: [Prop!]!
  pagedProps: [Prop!]! @asConnection
  "A child over the interface carrying @table no type implements."
  shelves: [Shelf!]!
}

type FilmDetails {
  summary: String
  "Nested inside nested, still film's row."
  inner: FilmInner
}

type FilmInner { note: String }

type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }

union Media = Film | Actor

enum PivotLang { EN NO }
type Translations { EN: String NO: String }

"Backed by FilmRecord through the service that produces it: a value handed back, read through the Record API, not a row; nothing selected it."
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  "An errors field under an object reads through an accessor."
  errors: [CarrierFailure]
}

"An @error type holds the exception a producer caught, whatever its parent holds."
type CarrierError @error(handlers: [{handler: DATABASE}]) { message: String }
union CarrierFailure = CarrierError

type Holder { blurb: Blurb, note: String }
type Blurb { description: String }

type Texts { en: String }

type RecordTexts { title: String }

"The element of a connection over a routine: a row of the function's result, the carrier only paging it."
type ActorFilm { title: String }

"Its @table names nothing the catalog holds: that is its own defect, and the field returning it still selects."
type Unresolved @table(name: "no_such_table") { label: String }

"Returned by nothing, so no result reaches it and nothing fetches its field."
type Orphan { label: String }

"A plain interface no table-bound type implements: a field returning it has nothing to fetch."
interface Prop { label: String }
type PlainProp implements Prop { label: String }

"An interface carrying @table no type implements: read per participant, so nothing to read."
interface Shelf @table(name: "film") { title: String }

type AddFilmPayload { film: Film }
input FilmInput @table(name: "film") { title: String }

type Query {
  "A connection's producer hands back the page as an object; its parts read it."
  pagedFilms: [Film!]! @asConnection
  "Over a union: nodes and Edge.node still read the page rather than run a statement."
  pagedMedia: [Media!]! @asConnection
  holder(filmId: Int): Holder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  texts: Texts
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.PivotTextsService", method: "translatedTexts"})
  actorFilms(actorId: Int, minLength: Int): [ActorFilm!]! @asConnection
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
  recordTexts(id: Int): RecordTexts
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  unresolved: Unresolved
  "Over the interface no table-bound type implements, as a connection and as a list."
  pagedProps: [Prop!]! @asConnection
  propList: [Prop!]!
  "Over the interface carrying @table no type implements."
  shelves: [Shelf!]!
}

type Mutation {
  "The insert's payload is an object; its data field re-reads film's row."
  addFilmWithPayload(input: FilmInput): AddFilmPayload @mutation(typeName: INSERT)
  "Nothing written, so nothing runs: a mutation-root field with no fetcher."
  nothing: Film
}

extend schema @assertContains(relation: "graphitron_result", rows: """
  type_name,                      shape
  Film,                           ROW
  FilmDetails,                    ROW
  FilmInner,                      ROW
  Translations,                   ROW
  FilmDetailsCarrier,             OBJECT
  Actor,                          ROW
  Holder,                         OBJECT
  CarrierError,                   OBJECT
  Blurb,                          OBJECT
  AddFilmPayload,                 OBJECT
  QueryPagedFilmsConnection,      OBJECT
  QueryPagedFilmsConnectionEdge,  OBJECT
  QueryPagedMediaConnection,      OBJECT
  QueryPagedMediaConnectionEdge,  OBJECT
  """)

# A routine connection's element holds the function's row and no object of its carrier.
extend schema @expectEquals(relation: "graphitron_result", where: "type_name = 'ActorFilm'", rows: """
  type_name, shape
  ActorFilm, ROW
  """)

# Texts and RecordTexts are reached both ways; only RecordTexts, an object of film's record, is the
# defect below.
extend schema @expectEquals(relation: "graphitron_result", where: "type_name IN ('Texts', 'RecordTexts', 'Orphan')", rows: """
  type_name,   shape
  RecordTexts, OBJECT
  RecordTexts, ROW
  Texts,       OBJECT
  Texts,       ROW
  """)

extend schema @assertContains(relation: "graphitron_result_table", rows: """
  type_name,          table_schema, table_name
  Film,               public,       film
  FilmDetails,        public,       film
  FilmInner,          public,       film
  """)

extend schema @expectEquals(relation: "graphitron_result_pivot", rows: """
  type_name,    pivot_type_name, pivot_field_name
  Translations, Film,            translations
  """)

extend schema @assertContains(relation: "graphitron_result_class", rows: """
  type_name
  Holder
  """)

extend schema @assertContains(relation: "graphitron_reader", rows: """
  type_name,                     field_name,     reads
  Film,                          title,          COLUMN
  Film,                          titleUppercase, EXPRESSION
  Film,                          details,        NESTED
  Film,                          translations,   NESTED
  FilmDetails,                   summary,        COLUMN
  FilmDetails,                   inner,          NESTED
  FilmInner,                     note,           COLUMN
  Translations,                  EN,             COLUMN
  FilmDetailsCarrier,            filmId,         ACCESSOR
  FilmDetailsCarrier,            errors,         ACCESSOR
  CarrierError,                  message,        ACCESSOR
  Holder,                        blurb,          ACCESSOR
  Holder,                        note,           ACCESSOR
  Blurb,                         description,    ACCESSOR
  QueryPagedFilmsConnection,     edges,          ACCESSOR
  QueryPagedFilmsConnection,     nodes,          ACCESSOR
  QueryPagedFilmsConnectionEdge, node,           ACCESSOR
  QueryPagedFilmsConnectionEdge, cursor,         ACCESSOR
  QueryPagedMediaConnection,     nodes,          ACCESSOR
  QueryPagedMediaConnectionEdge, node,           ACCESSOR
  """)

# A connection's parts run nothing of their own, over a union as much as over a table.
extend schema @assertEmpty(relation: "graphitron_producer", where: """
  type_name IN ('QueryPagedFilmsConnectionEdge', 'QueryPagedMediaConnectionEdge')
  OR (type_name IN ('QueryPagedFilmsConnection', 'QueryPagedMediaConnection')
      AND field_name IN ('edges', 'nodes', 'pageInfo'))
  """)

# A type no result reaches is not fetched, and is no defect.
extend schema @assertEmpty(relation: "graphitron_fetcher", where: "type_name = 'Orphan'")

extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  coordinate,       code
  Mutation.nothing, FIELD_WITHOUT_FETCHER
  RecordTexts,      RESULT_SHAPES_CONFLICT
  Query.pagedProps, FIELD_WITHOUT_FETCHER
  Query.propList,   FIELD_WITHOUT_FETCHER
  Film.props,       FIELD_WITHOUT_FETCHER
  Film.pagedProps,  FIELD_WITHOUT_FETCHER
  Query.shelves,    FIELD_WITHOUT_FETCHER
  Film.shelves,     FIELD_WITHOUT_FETCHER
  """)

extend schema @assertContains(relation: "graphitron_producer", rows: """
  type_name, field_name, kind
  Query,     unresolved, SELECT
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  coordinate,   code
  Query.unresolved, FIELD_WITHOUT_FETCHER
  Query.pagedMedia, FIELD_WITHOUT_FETCHER
  CarrierError, RESULT_SHAPES_CONFLICT
  Texts,        RESULT_SHAPES_CONFLICT
  Orphan.label, FIELD_WITHOUT_FETCHER
  Texts.en,     FIELD_WITHOUT_FETCHER
  """)
