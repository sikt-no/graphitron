# Where a named node id's path ends, against the node's table. A written path must end there. With
# none, the slot's own table must be the node's or reach it by exactly one foreign key, in either
# direction. film declares two keys to language, inventory one to film, and nothing joins film to
# actor directly; category's one key is to itself.
# An id handed to a call by argMapping or under a @service binds no predicate and owes no route,
# unless its input object is built into a jOOQ record, whose columns the id is decoded into.
# An argument's or input field's own written path is judged as an output field's, so filmsByActor,
# ending on language for a node on actor, lands on the wrong table. With no path written, the one key
# joining the slot's table and the node's infers the path there, whichever table declares it; none or
# several leaves it empty, which the rule judges. A self-referencing key is never inferred at an
# argument: a node on the slot's own table is its own rows.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID!
  "Two keys to language: no route without a path."
  languageId: ID @nodeId(typeName: "Language")
  "The key named, ending on language."
  languageByKey: ID @nodeId(typeName: "Language") @reference(path: [{key: "film_language_id_fkey"}])
  "A path ending on language, for a node on actor."
  wrongLanding: ID @nodeId(typeName: "Actor") @reference(path: [{key: "film_language_id_fkey"}])
  "No key between film and actor."
  actorId: ID @nodeId(typeName: "Actor")
}

type Language implements Node @table(name: "language") @node { id: ID! }

type Actor implements Node @table(name: "actor") @node { id: ID! }

type Inventory implements Node @table(name: "inventory") @node {
  id: ID!
  "One key to film."
  filmId: ID @nodeId(typeName: "Film")
}

type Category implements Node @table(name: "category") @node { id: ID! }

input FilmFilter {
  "Two keys to language."
  languageId: ID @nodeId(typeName: "Language")
  "Its own table's node."
  id: ID @nodeId(typeName: "Film")
}

input InventoryFilter { filmId: ID @nodeId(typeName: "Film") }

"Two keys to language, but the id goes to a call, not a predicate."
input LanguageFilter { languageId: ID @nodeId(typeName: "Language") }

"Two keys to language, and the id is decoded into the film record a @service takes."
input FilmRecordLanguageInput { title: String @field(name: "title"), languageId: ID @nodeId(typeName: "Language") }

type FilmDraftsCountedPayload { count: Int }

type Query {
  films(languageId: ID @nodeId(typeName: "Language")): [Film!]!
  filmsByKey(languageId: ID @nodeId(typeName: "Language")
               @reference(path: [{key: "film_language_id_fkey"}])): [Film!]!
  filmsByActor(actorId: ID @nodeId(typeName: "Actor")
                 @reference(path: [{key: "film_language_id_fkey"}])): [Film!]!
  "No key between film and actor."
  filmsByActorId(actorId: ID @nodeId(typeName: "Actor")): [Film!]!
  "One key, inventory's to film, declared on the node's table."
  filmsByInventoryId(inventoryId: ID @nodeId(typeName: "Inventory")): [Film!]!
  "A node on category's own table, which has one key to itself."
  categoriesById(id: ID @nodeId(typeName: "Category")): [Category!]!
  filmsWhere(where: FilmFilter): [Film!]!
  inventories(filmId: ID @nodeId(typeName: "Film")): [Inventory!]!
  inventoriesWhere(where: InventoryFilter): [Inventory!]!
  filmsMapped(where: LanguageFilter): [Film!]!
    @condition(condition: {className: "no.sikt.graphitron.rewrite.test.conditions.FilmConditions",
                           method: "byLanguage", argMapping: "languageId: where.languageId"})
  filmsServed(languageId: ID @nodeId(typeName: "Language")): [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  countRecordLanguages(in: [FilmRecordLanguageInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  languages: [Language!]!
  actors: [Actor!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code LIKE 'NODE_ID_%'
  """, rows: """
  coordinate,                code,                   detail
  Film.actorId,              NODE_ID_LANDS_ON_TABLE, public.film
  Film.languageId,           NODE_ID_LANDS_ON_TABLE, public.film
  Film.wrongLanding,         NODE_ID_LANDS_ON_TABLE, public.language
  FilmFilter.languageId,     NODE_ID_LANDS_ON_TABLE, public.film
  FilmRecordLanguageInput.languageId, NODE_ID_LANDS_ON_TABLE, public.film
  Query.films(languageId:),  NODE_ID_LANDS_ON_TABLE, public.film
  Query.filmsByActor(actorId:), NODE_ID_LANDS_ON_TABLE, public.language
  Query.filmsByActorId(actorId:), NODE_ID_LANDS_ON_TABLE, public.film
  """)

# No key or several leave the slot's path empty, ending where it starts; one key infers it, ending on
# the node's table, and a written one ends where its steps do.
extend schema @expectEquals(relation: "graphitron_join_path", where: """
  coordinate IN ('Query.films(languageId:)', 'Query.filmsByActorId(actorId:)',
                 'Query.filmsByActor(actorId:)', 'Query.inventories(filmId:)',
                 'Query.filmsWhere(where.languageId:)', 'Query.inventoriesWhere(where.filmId:)',
                 'Query.filmsByInventoryId(inventoryId:)', 'Query.categoriesById(id:)')
  """, rows: """
  coordinate,                            target_type, target_table
  Query.categoriesById(id:),             Category,    category
  Query.films(languageId:),              Film,        film
  Query.filmsByActorId(actorId:),        Film,        film
  Query.filmsByActor(actorId:),          Film,        language
  Query.filmsByInventoryId(inventoryId:), Film,       inventory
  Query.inventories(filmId:),            Inventory,   film
  Query.filmsWhere(where.languageId:),   Film,        film
  Query.inventoriesWhere(where.filmId:), Inventory,   film
  """)

extend schema @expectEquals(relation: "graphitron_path", where: """
  coordinate IN ('Query.films(languageId:)', 'Query.filmsByActorId(actorId:)',
                 'Query.filmsByActor(actorId:)', 'Query.inventories(filmId:)',
                 'Query.filmsWhere(where.languageId:)', 'Query.inventoriesWhere(where.filmId:)',
                 'Query.filmsByInventoryId(inventoryId:)', 'Query.categoriesById(id:)')
  """, rows: """
  coordinate,                            target_type, origin
  Query.categoriesById(id:),             Category,    EMPTY
  Query.films(languageId:),              Film,        EMPTY
  Query.filmsByActorId(actorId:),        Film,        EMPTY
  Query.filmsByActor(actorId:),          Film,        WRITTEN
  Query.filmsByInventoryId(inventoryId:), Film,       INFERRED
  Query.inventories(filmId:),            Inventory,   INFERRED
  Query.filmsWhere(where.languageId:),   Film,        EMPTY
  Query.inventoriesWhere(where.filmId:), Inventory,   INFERRED
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key", where: """
  coordinate IN ('Query.inventories(filmId:)', 'Query.inventoriesWhere(where.filmId:)',
                 'Query.filmsByInventoryId(inventoryId:)', 'Query.categoriesById(id:)')
  """, rows: """
  coordinate,                            target_type, position, constraint_name
  Query.filmsByInventoryId(inventoryId:), Film,       0,        inventory_film_id_fkey
  Query.inventories(filmId:),            Inventory,   0,        inventory_film_id_fkey
  Query.inventoriesWhere(where.filmId:), Inventory,   0,        inventory_film_id_fkey
  """)
