# Where a named node id's path ends, against the node's table. A written path must end there. With
# none, the slot's own table must be the node's or reach it by exactly one foreign key, in either
# direction. film declares two keys to language, inventory one to film, and nothing joins film to
# actor directly; category's one key is to itself.
# An id under a @service binds no predicate and owes no route, unless its input object is built into a
# jOOQ record, whose columns the id is decoded into. One a @condition's argMapping hands to its method
# is still compared, the condition adding to the filter unless it overrides it, so filmsMapped's
# languageId owes film a route to language as any filter's does.
# A bare @nodeId over a union binds the nodes among its participants, here CustomerRow alone, and
# StaffPlain's staff, which no foreign key joins to customer, has no route to it.
# An argument's or input field's own written path is judged as an output field's, so filmsByActor,
# ending on language for a node on actor, lands on the wrong table. With no path written, the one key
# joining the slot's table and the node's infers the path there, whichever table declares it; none or
# several leaves it empty, which the rule judges. A self-referencing key is never inferred at an
# argument: a node on the slot's own table is its own rows.
# Ids built into records whose keys are not the plain case: xlat_child's one key to xlat_parent
# references its alternate unique column, not the node's key, so a node id has nothing to land in;
# reordered_fk_child's composite key lists the parent's key columns in another order, and the id's
# positions land on the child's columns in the node key's order; studierett's two keys to
# studieprogram are told apart by the one the path names. A film_actor id built into a film record
# reaches film_actor by the one key film_actor declares to film, which carries film_id back and not
# actor_id, so the id has no whole key to land in.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID!
  "Two keys to language: no route without a path."
  languageId: ID @nodeId(typeName: "Language")
  "The key named, ending on language."
  languageByKey: ID @nodeId(typeName: "Language") @reference(path: [{key: "film_language_id_fkey"}])
  "A path ending on language, for a node on actor."
  wrongLanding: ID @nodeId(typeName: "Actor") @reference(path: [{key: "film_language_id_fkey"}])
  "No key between film and actor."
  actorId: ID @nodeId(typeName: "Actor")
}

type Language implements Node @table(name: "language") @node { id: ID! }

type Actor implements Node @table(name: "actor") @node { id: ID! }

type Inventory implements Node @table(name: "inventory") @node {
  id: ID!
  "One key to film."
  filmId: ID @nodeId(typeName: "Film")
}

type Category implements Node @table(name: "category") @node { id: ID! }

type Store implements Node @table(name: "store") @node { id: ID! }

type FilmActor implements Node @table(name: "film_actor") @node { id: ID! }

type CustomerRow implements Node @table(name: "customer") @node { id: ID! }
type StaffPlain @table(name: "staff") { staffId: Int! @field(name: "staff_id") }
union CustomerOrStaff = CustomerRow | StaffPlain

"A film_actor id built into a film record, reached only by the key film_actor declares to film."
input FilmRecordPairInput { title: String @field(name: "title"), pairing: ID @nodeId(typeName: "FilmActor") }

input FilmFilter {
  "Two keys to language."
  languageId: ID @nodeId(typeName: "Language")
  "Its own table's node."
  id: ID @nodeId(typeName: "Film")
}

input InventoryFilter { filmId: ID @nodeId(typeName: "Film") }

"Two keys to language, but the id goes to a call, not a predicate."
input LanguageFilter { languageId: ID @nodeId(typeName: "Language") }

"Two keys to language, and the id is decoded into the film record a @service takes."
input FilmRecordLanguageInput { title: String @field(name: "title"), languageId: ID @nodeId(typeName: "Language") }

"Ids built into a film record: its own key, a key one path step carries back, and one two steps away."
input FilmRecordRefsInput {
  title: String @field(name: "title")
  filmId: ID @nodeId(typeName: "Film")
  languageRef: ID @nodeId(typeName: "Language") @reference(path: [{key: "film_language_id_fkey"}])
  storeId: ID @nodeId(typeName: "Store")
    @reference(path: [{key: "inventory_film_id_fkey"}, {key: "inventory_store_id_fkey"}])
}

"Two ids of film itself built into its record: both are its own key, decoded into film_id."
input FilmRecordTwinIdsInput {
  title: String @field(name: "title")
  filmId: ID @nodeId(typeName: "Film")
  otherFilmId: ID @nodeId(typeName: "Film")
}

type XlatParent implements Node @table(name: "xlat_parent") @node { id: ID! }
type ReorderedPkParent implements Node @table(name: "nodeidfixture.reordered_pk_parent") @node { id: ID! }
type Studieprogram implements Node @table(name: "idreffixture.studieprogram") @node { id: ID! }

input XlatChildRecordInput {
  note: String @field(name: "note")
  parent: ID @nodeId(typeName: "XlatParent") @reference(path: [{key: "xlat_child_parent_alt_key_fkey"}])
}
input ReorderedChildRecordInput {
  parent: ID @nodeId(typeName: "ReorderedPkParent") @reference(path: [{key: "reordered_fk_child_parent_fkey"}])
}
input StudierettRecordInput {
  registrar: ID @nodeId(typeName: "Studieprogram")
    @reference(path: [{key: "studierett_registrar_studieprogram_fkey"}])
}

type FilmDraftsCountedPayload { count: Int }

type Query {
  films(languageId: ID @nodeId(typeName: "Language")): [Film!]!
  filmsByKey(languageId: ID @nodeId(typeName: "Language")
               @reference(path: [{key: "film_language_id_fkey"}])): [Film!]!
  filmsByActor(actorId: ID @nodeId(typeName: "Actor")
                 @reference(path: [{key: "film_language_id_fkey"}])): [Film!]!
  "No key between film and actor."
  filmsByActorId(actorId: ID @nodeId(typeName: "Actor")): [Film!]!
  "One key, inventory's to film, declared on the node's table."
  filmsByInventoryId(inventoryId: ID @nodeId(typeName: "Inventory")): [Film!]!
  "A node on category's own table, which has one key to itself."
  categoriesById(id: ID @nodeId(typeName: "Category")): [Category!]!
  filmsWhere(where: FilmFilter): [Film!]!
  inventories(filmId: ID @nodeId(typeName: "Film")): [Inventory!]!
  inventoriesWhere(where: InventoryFilter): [Inventory!]!
  filmsMapped(where: LanguageFilter): [Film!]!
    @condition(condition: {className: "no.sikt.graphitron.rewrite.test.conditions.FilmConditions",
                           method: "byLanguage", argMapping: "languageId: where.languageId"})
  customersOrStaff(ids: [ID] @nodeId): [CustomerOrStaff!]!
  filmsServed(languageId: ID @nodeId(typeName: "Language")): [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  countRecordLanguages(in: [FilmRecordLanguageInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  countRecordRefs(in: [FilmRecordRefsInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  countRecordTwins(in: [FilmRecordTwinIdsInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  countRecordPairs(in: [FilmRecordPairInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService", method: "count", argMapping: "drafts: in"})
  filmActors: [FilmActor!]!
  languages: [Language!]!
  actors: [Actor!]!
  describeXlatChild(in: XlatChildRecordInput!): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.KeyedRecordInputService", method: "describeXlatChild"})
  describeReorderedChild(in: ReorderedChildRecordInput!): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.KeyedRecordInputService", method: "describeReorderedChild"})
  describeStudierett(in: StudierettRecordInput!): String @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.KeyedRecordInputService", method: "describeStudierett"})
  xlatParents: [XlatParent!]!
  reorderedParents: [ReorderedPkParent!]!
  studieprogrammer: [Studieprogram!]!
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: """
  code LIKE 'NODE_ID_%'
  """, rows: """
  coordinate,                code,                   detail
  Film.actorId,              NODE_ID_LANDS_ON_TABLE, public.film
  Film.languageId,           NODE_ID_LANDS_ON_TABLE, public.film
  Film.wrongLanding,         NODE_ID_LANDS_ON_TABLE, public.language
  FilmFilter.languageId,     NODE_ID_LANDS_ON_TABLE, public.film
  LanguageFilter.languageId, NODE_ID_LANDS_ON_TABLE, public.film
  Query.customersOrStaff(ids:), NODE_ID_LANDS_ON_TABLE, public.staff
  FilmRecordLanguageInput.languageId, NODE_ID_LANDS_ON_TABLE, public.film
  FilmRecordPairInput.pairing,    NODE_ID_LANDS_ON_TABLE, public.film
  FilmRecordRefsInput.storeId,    NODE_ID_LANDS_ON_TABLE, public.film
  Query.films(languageId:),  NODE_ID_LANDS_ON_TABLE, public.film
  Query.filmsByActor(actorId:), NODE_ID_LANDS_ON_TABLE, public.language
  Query.filmsByActorId(actorId:), NODE_ID_LANDS_ON_TABLE, public.film
  XlatChildRecordInput.parent,    NODE_ID_LANDS_ON_TABLE, public.xlat_child
  """)

# No key or several leave the slot's path empty, ending where it starts; one key infers it, ending on
# the node's table, and a written one ends where its steps do.
extend schema @expectEquals(relation: "graphitron_join_path", where: """
  coordinate IN ('Query.films(languageId:)', 'Query.filmsByActorId(actorId:)',
                 'Query.filmsByActor(actorId:)', 'Query.inventories(filmId:)',
                 'Query.filmsWhere(where.languageId:)', 'Query.inventoriesWhere(where.filmId:)',
                 'Query.filmsByInventoryId(inventoryId:)', 'Query.categoriesById(id:)')
  """, rows: """
  coordinate,                            target_type, target_table
  Query.categoriesById(id:),             Category,    category
  Query.films(languageId:),              Film,        film
  Query.filmsByActorId(actorId:),        Film,        film
  Query.filmsByActor(actorId:),          Film,        language
  Query.filmsByInventoryId(inventoryId:), Film,       inventory
  Query.inventories(filmId:),            Inventory,   film
  Query.filmsWhere(where.languageId:),   Film,        film
  Query.inventoriesWhere(where.filmId:), Inventory,   film
  """)

extend schema @expectEquals(relation: "graphitron_path", where: """
  coordinate IN ('Query.films(languageId:)', 'Query.filmsByActorId(actorId:)',
                 'Query.filmsByActor(actorId:)', 'Query.inventories(filmId:)',
                 'Query.filmsWhere(where.languageId:)', 'Query.inventoriesWhere(where.filmId:)',
                 'Query.filmsByInventoryId(inventoryId:)', 'Query.categoriesById(id:)')
  """, rows: """
  coordinate,                            target_type, origin
  Query.categoriesById(id:),             Category,    EMPTY
  Query.films(languageId:),              Film,        EMPTY
  Query.filmsByActorId(actorId:),        Film,        EMPTY
  Query.filmsByActor(actorId:),          Film,        WRITTEN
  Query.filmsByInventoryId(inventoryId:), Film,       INFERRED
  Query.inventories(filmId:),            Inventory,   INFERRED
  Query.filmsWhere(where.languageId:),   Film,        EMPTY
  Query.inventoriesWhere(where.filmId:), Inventory,   INFERRED
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key", where: """
  coordinate IN ('Query.inventories(filmId:)', 'Query.inventoriesWhere(where.filmId:)',
                 'Query.filmsByInventoryId(inventoryId:)', 'Query.categoriesById(id:)')
  """, rows: """
  coordinate,                            target_type, position, constraint_name
  Query.filmsByInventoryId(inventoryId:), Film,       0,        inventory_film_id_fkey
  Query.inventories(filmId:),            Inventory,   0,        inventory_film_id_fkey
  Query.inventoriesWhere(where.filmId:), Inventory,   0,        inventory_film_id_fkey
  """)

# Where each key position of an id built into a film record lands: its own key with no path, the
# column one step carries back; and nothing for the store two steps away, which is refused above.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot_record_column", where: """
  coordinate LIKE 'Query.countRecordRefs%'
  """, rows: """
  coordinate,                            bound,           key_position, column_name
  Query.countRecordRefs(in.filmId:),      public.film,     0,            film_id
  Query.countRecordRefs(in.languageRef:), public.language, 0,            language_id
  """)
extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot_record_column", where: """
  coordinate LIKE 'Query.countRecordTwins%'
  """, rows: """
  coordinate,                              bound,       key_position, column_name
  Query.countRecordTwins(in.filmId:),      public.film, 0,            film_id
  Query.countRecordTwins(in.otherFilmId:), public.film, 0,            film_id
  """)
extend schema @expectEquals(relation: "graphitron_occurrence_node_id_shape", where: """
  coordinate LIKE 'Query.countRecordRefs%'
  """, rows: """
  coordinate,                            decode_shape
  Query.countRecordRefs(in.filmId:),      OWN_RECORD
  Query.countRecordRefs(in.languageRef:), REFERENCING_RECORD
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot_record_column", where: """
  coordinate LIKE 'Query.describeReorderedChild%' OR coordinate LIKE 'Query.describeStudierett%'
  """, rows: """
  coordinate,                              bound,                              key_position, column_name
  Query.describeReorderedChild(in.parent:), nodeidfixture.reordered_pk_parent, 0,            fk_a
  Query.describeReorderedChild(in.parent:), nodeidfixture.reordered_pk_parent, 1,            fk_b
  Query.describeReorderedChild(in.parent:), nodeidfixture.reordered_pk_parent, 2,            fk_c
  Query.describeStudierett(in.registrar:), idreffixture.studieprogram,       0,            registrar_studieprogram
  """)
