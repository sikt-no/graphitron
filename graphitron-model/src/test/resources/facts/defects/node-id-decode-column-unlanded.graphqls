# Decodes whose key lands short. A key pinned in SDL that a compound departure reaches only part of
# still binds every position of it. An input field's own path that stops at a junction still binds
# the node's key column. A node type no tier resolves key columns for binds nothing.

interface Node { id: ID! }

type Film @table(name: "film") {
  title: String
}

type Category implements Node @table(name: "category") @node {
  id: ID!
}

type Project implements Node @table(name: "project") @node(keyColumns: ["org_id", "name"]) {
  id: ID!
}

type ProjectNote @table(name: "project_note") {
  body: String
}

type FilmList implements Node @table(name: "film_list") @node {
  id: ID!
}

input FilmInput {
  inCategory: ID @nodeId(typeName: "Category") @reference(path: [{key: "film_category_film_id_fkey"}])
}

type Query {
  projectNotes(ofProject: ID @nodeId(typeName: "Project") @reference(path: [{key: "project_note_project_fkey"}])): [ProjectNote]
  films(onList: ID @nodeId(typeName: "FilmList")): [Film]
}

type Mutation {
  updateFilm(in: FilmInput): Film @mutation(typeName: UPDATE)
}

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                          bound,           position, node_type_name, column_name
  Mutation.updateFilm(in.inCategory:), public.category, 0,        Category,       category_id
  Query.projectNotes(ofProject:),      public.project,  0,        Project,        org_id
  Query.projectNotes(ofProject:),      public.project,  1,        Project,        name
  """)
