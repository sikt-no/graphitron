# A single child below the root looked up by its table's primary key: the store states the lookup and
# the projection emitter reads the one row the key matches, but graphitron's generated fetchers do not
# render it until the store's units replace them, the walk refusing the shape itself. This document
# holds the schema the emitter's execution test reads.

type City @table(name: "city") {
    name: String @field(name: "city")
}

type AddressRow @table(name: "address") {
    address: String
    # Among the cities of the address's country, the one the caller names.
    neighbour(city_id: Int! @lookupKey @field(name: "city_id")): City!
        @reference(path: [{key: "address_city_id_fkey"}, {key: "city_country_id_fkey"}, {key: "city_country_id_fkey"}])
}

type Query {
    addresses: [AddressRow!]!
}

extend schema @expectEquals(relation: "graphitron_occurrence_lookup_key", where: "coordinate = 'AddressRow.neighbour'", rows: """
  key_coordinate,                      key_kind
  AddressRow.neighbour(city_id:),      COLUMN
  """)
