# A configured function that does not resolve is reported at every @outbox it serves, as a table that
# does not is: a routine the catalog does not hold, here. No routine target is derived for it.

extend schema @withConfiguration(outboxFunction: "no_such_routine")
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  create(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox
}

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                  coordinate,      detail
  OUTBOX_TARGET_INVALID, Mutation.create, "<function> no_such_routine is not one procedure or function of the jOOQ catalog, no table, whose parameters are the type, text, and the payload, JSON, JSONB or text"
  """)

extend schema @assertEmpty(relation: "graphitron_outbox_routine_target")
