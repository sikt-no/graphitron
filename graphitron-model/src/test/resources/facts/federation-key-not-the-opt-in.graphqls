"A graph that links, but to nothing that federates it. The opt-in is a prefix over a link's url, so a link naming another spec does not match it and a link whose url the author omitted is a null that matches no prefix at all; the null guard falls out of the join rather than being a condition spelled twice. Stated as the unlinked document states it: nothing is minted, and the directive anchor holds the author's key alone."
type Film @table(name: "film") @node @key(fields: "title") {
  id: ID
  title: String
}

extend schema @link(url: "https://specs.apollo.dev/tag/v0.3")

# A url the author omitted, which reaches the predicate as a null rather than as a non-match.
extend schema @link(import: ["@key"])

# Keyless and a node, which is the shape the federation link would give a key to.
type Language @table(name: "language") @node {
  id: ID
  name: String
}

extend type Query {
  films: [Film!]!
  languages: [Language!]!
}

extend schema @assertEmpty(relation: "graphitron_directive_application", where: """
  directive_name = 'key' AND origin = 'MINTED'
  """)

extend schema @assertContains(relation: "graphitron_directive_application", rows: """
  coordinate, directive_name, ordinal, origin
  Film,       key,            0,       AUTHORED
  """)

extend schema @assertAbsent(relation: "graphitron_directive_application", rows: """
  coordinate, directive_name, origin
  Language,   key,            MINTED
  """)

# A link that is not federation's declares no @key, which the toolchain refuses and capture records.
extend schema @expectEquals(relation: "graphql_schema_problem", rows: """
  stage,    error_class
  ASSEMBLY, DirectiveUndeclaredError
  """)
