"A graph that links, but to nothing that federates it. The opt-in is a prefix over a link's url, so a link naming another spec does not match it and a link whose url the author omitted is a null that matches no prefix at all; the null guard falls out of the join rather than being a condition spelled twice. Stated as the unlinked document states it: the synthesis holds no row, and the directive anchor holds the author's key and nothing minted beside it."
type Film @table(name: "film") @node @key(fields: "title") {
  id: ID
  title: String
}

extend schema @link(url: "https://specs.apollo.dev/tag/v0.3")

# A url the author omitted, which reaches the predicate as a null rather than as a non-match.
extend schema @link(import: ["@key"])

# Keyless and a node, which is the shape the federation link would give a key to.
type Language @table(name: "language") @node {
  id: ID
  name: String
}

extend type Query {
  films: [Film!]!
  languages: [Language!]!
}

extend schema @assertAbsent(relation: "graphitron_synthesized_federation_key", rows: """
  type_name
  Film
  Language
  """)

extend schema @assertContains(relation: "graphitron_directive_application", rows: """
  coordinate, directive_name, ordinal, origin
  Film,       key,            0,       AUTHORED
  """)

extend schema @assertAbsent(relation: "graphitron_directive_application", rows: """
  coordinate, directive_name, origin
  Language,   key,            MINTED
  """)
