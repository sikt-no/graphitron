"The same node types in a graph that declares no federation link. Federation is opt-in and absence is the default, so no key is minted however many nodes the graph declares; what an author wrote still composes, an authored key being a fact about the type rather than a consequence of the opt-in. Stated twice: nothing is minted, and the directive anchor holds the author's key alone. Resolvable is left out of the claim because an authored key that does not spell it records absence rather than the default, which is a separate fact from the one this document is about."
type Film @table(name: "film") @node @key(fields: "title") {
  id: ID
  title: String
}

# A node with no key of its own, which in a linked graph would be given one.
type Language @table(name: "language") @node {
  id: ID
  name: String
}

extend type Query {
  films: [Film!]!
  languages: [Language!]!
}

extend schema @assertEmpty(relation: "graphitron_directive_application", where: """
  directive_name = 'key' AND origin = 'MINTED'
  """)

extend schema @assertContains(relation: "graphitron_directive_application", rows: """
  coordinate, directive_name, ordinal, origin
  Film,       key,            0,       AUTHORED
  """)

extend schema @assertAbsent(relation: "graphitron_directive_application", rows: """
  coordinate, directive_name, origin
  Language,   key,            MINTED
  """)

# With no federation link nothing declares @key, which the toolchain refuses and capture records.
extend schema @expectEquals(relation: "graphql_schema_problem", rows: """
  stage,    error_class
  ASSEMBLY, DirectiveUndeclaredError
  """)
