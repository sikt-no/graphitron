# How a condition routes a path hop when the path element names it and no table and no key: the
# method's own signature is the only route there is, parameter 0 the departure and parameter 1 the
# arrival. Each argument below writes one case, every method being in ConditionMethodRouteFixtures,
# and the rows are every route the document draws, so a case drawing none is one with no row.

type Customer @table(name: "customer") {
  customerId: Int
  # The same pair written at a second site, an output field's path, is still one route.
  addressByCondition: Address
    @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "customerToAddress"}}])
}

type Address @table(name: "address") { addressId: Int }

extend type Query {
  customers(
    # Both parameters concrete.
    concrete: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "customerToAddress"}}])
    # An arrival no generated table is: the wildcard, a primitive, and a class that is not a table.
    anyTable: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "customerToAnyTable"}}])
    primitive: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "customerToInt"}}])
    notATable: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "customerToRange"}}])
    # Overloads: the declarations must agree on the arrival, every one of them declaring one.
    agreeing: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "agreeingOnBoth"}}])
    perDeparture: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "agreeingOnArrival"}}])
    diverging: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "divergingArrivals"}}])
    wildcardBeside: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "wildcardBesideConcrete"}}])
    nonTableBeside: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "nonTableBesideConcrete"}}])
    # A declaration with no second parameter declares no arrival and suppresses nothing.
    oneParameter: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "oneParameterBesideTwo"}}])
    # Not a condition, and not a method at all.
    notACondition: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "notACondition"}}])
    missing: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "noSuchMethod"}}])
    # Beside a key the key is the route, and the condition that hop's filter.
    besideKey: String @reference(path: [{key: "customer_address_id_fkey", condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "besideAKey"}}])
  ): [Customer!]!
}

extend schema @expectEquals(relation: "graphitron_condition_method_route", rows: """
  method,            from_table, to_table
  customerToAddress, customer,   address
  agreeingOnBoth,    customer,   address
  agreeingOnArrival, customer,   address
  agreeingOnArrival, film_actor, address
  oneParameterBesideTwo, customer, address
  """)
