"A producer claim is what a field claims it runs, by the field and the kind, not by the directive that said it. A kind no author writes is no claim: the node signature's lookup is decided by position, so a written @service takes the node field over rather than conflicting with it. Each argument written as a key claims its field, so two are two claims of one kind, which is no conflict; two kinds on one field are the conflict the defects document holds."

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput @table(name: "film") {
  title: String
}

type Query {
  "The node signature with a service written on it: one claim, SERVICE."
  node(id: Int!): Node
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  "The node signature with nothing written: no claim, and the rule's LOOKUP."
  nodes(ids: [ID!]!): [Node]!
  "Two arguments written as keys: two LOOKUP claims, one by each argument."
  filmsByKeys(filmId: [Int!] @lookupKey @field(name: "film_id"), languageId: [Int!] @lookupKey @field(name: "language_id")): [Film]!
  "With nothing written: no claim, and the rule's SELECT."
  films: [Film!]!
}

type Mutation {
  "The verb written is the kind claimed."
  addFilm(input: FilmInput): Film @mutation(typeName: INSERT)
}

# Each LOOKUP is where its argument's @lookupKey was written.
extend schema @expectEquals(relation: "graphitron_producer_claim", rows: """
  coordinate,        kind,    claimer,                       source_column
  Query.node,        SERVICE, Query.node,                    5
  Query.filmsByKeys, LOOKUP,  Query.filmsByKeys(filmId:),     30
  Query.filmsByKeys, LOOKUP,  Query.filmsByKeys(languageId:), 85
  Mutation.addFilm,  INSERT,  Mutation.addFilm,              35
  """)

extend schema @expectEquals(relation: "graphitron_producer", where: """
  type_name = 'Query' AND field_name IN ('node', 'nodes', 'filmsByKeys', 'films')
  """, rows: """
  type_name, field_name,  kind
  Query,     node,        SERVICE
  Query,     nodes,       LOOKUP
  Query,     filmsByKeys, LOOKUP
  Query,     films,       SELECT
  """)

# Who claimed it: each @lookupKey argument claims its field, so the one LOOKUP above is two claims.
extend schema @expectEquals(relation: "graphitron_claim", where: "kind = 'LOOKUP'", rows: """
  coordinate,        claimer,                       priority
  Query.filmsByKeys, Query.filmsByKeys(filmId:),     0
  Query.filmsByKeys, Query.filmsByKeys(languageId:), 0
  """)

# The service on the node field is its producer, not a second claim beside the signature.
extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  coordinate, code
  Query.node, CLAIMS_CONFLICT
  """)
