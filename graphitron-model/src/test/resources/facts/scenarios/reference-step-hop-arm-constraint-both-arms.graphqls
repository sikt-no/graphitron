# A key element and a bare condition element, each a step of its field's join path stated by the
# subtype saying how it joins: the key it rides, or the condition method its two tables chose.

type Film @table(name: "film") {
  title: String
  filmActors: [FilmActor!]! @reference(path: [{key: "film_actor_film_id_fkey"}])
  filmActorsByCondition: [FilmActor!]! @reference(path: [{condition: {
    className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
    method: "filmToFilmActor"}}])
}

type FilmActor @table(name: "film_actor") { lastUpdate: String @field(name: "last_update") }

extend type Query { films: [Film!]! }

extend schema @expectEquals(relation: "graphitron_join_path_step_key", where: "coordinate LIKE 'Film.%'", rows: """
  coordinate, target_type, position, constraint_name
  Film.filmActors, FilmActor, 0, film_actor_film_id_fkey
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_method", where: "coordinate LIKE 'Film.%'", rows: """
  coordinate, target_type, position, method_name
  Film.filmActorsByCondition, FilmActor, 0, filmToFilmActor
  """)
