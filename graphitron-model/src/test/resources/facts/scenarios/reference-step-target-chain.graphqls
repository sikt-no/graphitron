# A field's @reference path walked element by element from its type's table into its join path's
# steps. A table element discovers its key, and a key name answers as the SQL constraint name or,
# where none does, as the generated Keys constant, either without regard to case. A
# self-referential key is one step landing on its own table. A bare condition is a step its
# method's parameters route, riding no key.

type Film @table(name: "film") {
  title: String
  actors: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
  titleTexts: [String] @field(name: "title_txt") @reference(path: [{table: "film_translation"}])
  bySqlName: Language @reference(path: [{key: "film_language_id_fkey"}])
  byKeysConstant: Language @reference(path: [{key: "FILM__FILM_LANGUAGE_ID_FKEY"}])
  byUpperCase: Language @reference(path: [{key: "FILM_LANGUAGE_ID_FKEY"}])
  filmActors: [FilmActor!]! @reference(path: [{condition: {
    className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
    method: "filmToFilmActor"}}])
}

type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }
type Language @table(name: "language") { name: String }
type FilmActor @table(name: "film_actor") { lastUpdate: String @field(name: "last_update") }

type Category @table(name: "category") {
  name: String
  parent: Category @reference(path: [{key: "category_parent_category_id_fkey"}])
}

extend type Query { films: [Film!]! categories: [Category!]! }

extend schema @expectEquals(relation: "graphitron_join_path_step", rows: """
  coordinate,          position, from_table, to_table
  Film.actors,         0,        film,       film_actor
  Film.actors,         1,        film_actor, actor
  Film.titleTexts,     0,        film,       film_translation
  Film.bySqlName,      0,        film,       language
  Film.byKeysConstant, 0,        film,       language
  Film.byUpperCase,    0,        film,       language
  Film.filmActors,     0,        film,       film_actor
  Category.parent,     0,        category,   category
  """)

# The key each step rides: the key a name answers to, or a table element's one key, inferred. A
# bare condition rides none.
extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key", rows: """
  coordinate,      position, constraint_name
  Film.titleTexts, 0,        film_translation_film_id_fkey
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_key", rows: """
  coordinate,          position, constraint_name
  Film.actors,         0,        film_actor_film_id_fkey
  Film.actors,         1,        film_actor_actor_id_fkey
  Film.bySqlName,      0,        film_language_id_fkey
  Film.byKeysConstant, 0,        film_language_id_fkey
  Film.byUpperCase,    0,        film_language_id_fkey
  Category.parent,     0,        category_parent_category_id_fkey
  """)

# The table element's spelling resolves although no @table wrote it, only the path element.
extend schema @assertContains(relation: "graphitron_spelled_table", rows: """
  spelling,         table_schema, table_name,       candidates
  film_translation, public,       film_translation, 1
  """)

extend schema @assertAbsent(relation: "graphitron_table_entry", rows: """
  table_ref
  film_translation
  """)
