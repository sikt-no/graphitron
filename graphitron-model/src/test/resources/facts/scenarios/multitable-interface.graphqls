# A multitable interface: each implementation is on a table of its own, so a row is told apart by
# the table it is a row of. The service hands back records of either, a list of them or one, and
# the participants are stated at the occurrence returning the interface rather than at any child,
# a field under a table-bound parent being spelled by its own type.

interface Searchable {
    title: String
}

type Film implements Searchable @table(name: "film") {
    title: String @field(name: "TITLE")
}

type Actor implements Searchable @table(name: "actor") {
    title: String @field(name: "FIRST_NAME")
}

type Query {
    search: [Searchable!]!
        @service(service: {className: "no.sikt.graphitron.rewrite.test.services.PolymorphicSearchService", method: "searchDocuments"})
    searchOne: Searchable
        @service(service: {className: "no.sikt.graphitron.rewrite.test.services.PolymorphicSearchService", method: "searchOne"})
}

type Mutation {
    "The same records at a mutation's root, a list whose elements may be null."
    searchAllNullable: [Searchable]
        @service(service: {className: "no.sikt.graphitron.rewrite.test.services.PolymorphicSearchService", method: "searchDocuments"})
    "The same records at a mutation's root, a list whose elements may not be null."
    searchAll: [Searchable!]!
        @service(service: {className: "no.sikt.graphitron.rewrite.test.services.PolymorphicSearchService", method: "searchDocuments"})
}

extend schema @expectEquals(relation: "graphitron_occurrence_participant", rows: """
  coordinate,   participant_type, recognized_by, table_name
  Query.search, Actor,            TABLE,         actor
  Query.search, Film,             TABLE,         film
  Query.searchOne, Actor,         TABLE,         actor
  Query.searchOne, Film,          TABLE,         film
  Mutation.searchAllNullable, Actor, TABLE,      actor
  Mutation.searchAllNullable, Film,  TABLE,      film
  Mutation.searchAll, Actor,      TABLE,         actor
  Mutation.searchAll, Film,       TABLE,         film
  """)

# A participant told apart by its table carries no column and no value.
extend schema @assertEmpty(relation: "graphitron_occurrence_participant", where: """
  discriminator_column IS NOT NULL OR discriminator_value IS NOT NULL OR base_name IS NOT NULL
  """)

extend schema @assertContains(relation: "graphitron_occurrence_call_method", rows: """
  coordinate,                 call,     call_kind, method_name
  Mutation.searchAllNullable, producer, SERVICE,   searchDocuments
  Mutation.searchAll,         producer, SERVICE,   searchDocuments
  """)
extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: """
  coordinate IN ('Mutation.searchAllNullable', 'Mutation.searchAll')
  """)
