# A multitable interface: each implementation is on a table of its own, so a row is told apart by
# the table it is a row of. The service hands back records of either, and the participants are
# stated at the occurrence returning the interface rather than at any child, a field under a
# table-bound parent being spelled by its own type.

interface Searchable {
    title: String
}

type Film implements Searchable @table(name: "film") {
    title: String @field(name: "TITLE")
}

type Actor implements Searchable @table(name: "actor") {
    title: String @field(name: "FIRST_NAME")
}

type Query {
    search: [Searchable!]!
        @service(service: {className: "no.sikt.graphitron.rewrite.test.services.PolymorphicSearchService", method: "searchDocuments"})
}

extend schema @expectEquals(relation: "graphitron_occurrence_participant", rows: """
  coordinate,   participant_type, recognized_by, table_name
  Query.search, Actor,            TABLE,         actor
  Query.search, Film,             TABLE,         film
  """)

# A participant told apart by its table carries no column and no value.
extend schema @assertEmpty(relation: "graphitron_occurrence_participant", where: """
  discriminator_column IS NOT NULL OR discriminator_value IS NOT NULL OR base_name IS NOT NULL
  """)
