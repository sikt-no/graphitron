# The key a @nodeId decode yields: one row per position of the node type's key, on the node's own
# table, whatever path the slot takes there. A composite key binds every position, and a node over a
# junction, a key referencing an alternate key, or a reverse hop binds its own key just the same.
# Which column of a record the value then loads into is not a fact here: the decode emitter reads it
# off the record table's one foreign key to the node's table when it emits.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID!
}

type Actor implements Node @table(name: "actor") @node {
  id: ID!
}

type Category implements Node @table(name: "category") @node {
  id: ID!
}

type FilmActor implements Node @table(name: "film_actor") {
  id: ID!
}

type LevelA implements Node @table(name: "nodeidfixture.level_a") @node {
  id: ID!
}

type LevelC @table(name: "nodeidfixture.level_c") {
  name: String
}

type Project implements Node @table(name: "project") @node {
  id: ID!
}

type ProjectNote @table(name: "project_note") {
  body: String
}

type XlatParent implements Node @table(name: "xlat_parent") @node {
  id: ID!
}

type XlatChild implements Node @table(name: "xlat_child") @node {
  id: ID!
}

type Query {
  films(
    ids: [ID] @nodeId(typeName: "Film"),
    inCategory: ID @nodeId(typeName: "Category") @reference(path: [{key: "film_category_film_id_fkey"}, {key: "film_category_category_id_fkey"}]),
    castEntry: ID @nodeId(typeName: "FilmActor") @reference(path: [{key: "film_actor_film_id_fkey"}])
  ): [Film]
  filmActors(actorId: ID @nodeId(typeName: "Actor")): [FilmActor]
  levelCs(ofA: ID @nodeId(typeName: "LevelA") @reference(path: [{key: "level_c_level_b_fk"}, {key: "level_b_level_a_fk"}])): [LevelC]
  projectNotes(ofProject: ID @nodeId(typeName: "Project")): [ProjectNote]
  xlatChildren(ofParent: ID @nodeId(typeName: "XlatParent") @reference(path: [{key: "xlat_child_parent_alt_key_fkey"}])): [XlatChild]
  xlatParents(childRow: ID @nodeId(typeName: "XlatChild") @reference(path: [{key: "xlat_child_parent_alt_key_fkey"}])): [XlatParent]
}

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate,                     bound,                 position, node_type_name, column_name
  Query.filmActors(actorId:),     public.actor,          0,        Actor,          actor_id
  Query.films(castEntry:),        public.film_actor,     0,        FilmActor,      actor_id
  Query.films(castEntry:),        public.film_actor,     1,        FilmActor,      film_id
  Query.films(ids:),              public.film,           0,        Film,           film_id
  Query.films(inCategory:),       public.category,       0,        Category,       category_id
  Query.levelCs(ofA:),            nodeidfixture.level_a, 0,        LevelA,         k1
  Query.levelCs(ofA:),            nodeidfixture.level_a, 1,        LevelA,         k2
  Query.projectNotes(ofProject:), public.project,        0,        Project,        org_id
  Query.projectNotes(ofProject:), public.project,        1,        Project,        project_id
  Query.xlatChildren(ofParent:),  public.xlat_parent,    0,        XlatParent,     pk_id
  Query.xlatParents(childRow:),   public.xlat_child,     0,        XlatChild,      child_id
  """)
