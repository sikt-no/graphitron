# What a list is ordered by, stated at its occurrence: the default a @defaultOrder writes, by a
# table's primary key, an index or named elements, or the primary key a list with none falls back
# to; and each choice an @orderBy argument offers, one per value of its sort enum. Each key is a
# column of the list's table, a method computing one, or a column read through a path, in order,
# with its direction and collation. Beside them what identifies a row of each table-bound type: its
# table's primary key, a node key standing in where the table has none, or a unique key.

# A node over a table with a primary key: two identifying keys, the primary key ranked first.
type Actor implements Node @table(name: "actor") @node {
    id: ID!
    lastName: String @field(name: "last_name")
}

type Language @table(name: "language") {
    name: String

    # A method key, then a column, each in its own direction.
    films: [Film!]! @reference(path: [{key: "film_language_id_fkey"}])
        @defaultOrder(fields: [
            {method: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmSortKeys", method: "latestStockStore"}, direction: DESC},
            {name: "film_id"}
        ])
}

type Film @table(name: "film") {
    title: String

    # Named columns, the first collated and descending, the second in the application's direction.
    actors: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(fields: [{name: "last_name", collate: "C", direction: DESC}, {name: "first_name"}])

    # An index, in the application's direction.
    actorsByIndex: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(index: "idx_actor_last_name", direction: DESC)

    # A column read through a path, whose steps are not resolved here.
    language: Language @reference(path: [{key: "film_language_id_fkey"}])
}

input ActorOrderBy {
    field:     ActorSort!
    direction: SortDirection
}

enum ActorSort {
    LAST_NAME @order(fields: [{name: "last_name", direction: DESC}])
    ACTOR_ID  @order(primaryKey: true)
    BY_INDEX  @index(name: "idx_actor_last_name")
}

type Store @table(name: "store") {
    films: [Film!]! @reference(path: [{key: "inventory_store_id_fkey"}, {key: "inventory_film_id_fkey"}])
        @defaultOrder(fields: [{name: "name", path: [{key: "film_original_language_id_fkey"}]}])
}

# A table with no primary key: the node key stands in for its rows' identity, and a list over it
# states the order it is read in.
type RoleAssignment implements Node @table(name: "role_assignment") @node(typeId: "RoleAssignment", keyColumns: ["holder_id", "role_code"]) {
    id: ID!
    roleCode: String @field(name: "role_code")
}

type RoleHolder @table(name: "role_holder") {
    roles: [RoleAssignment!]! @defaultOrder(fields: [{name: "role_code"}])
}

# A table with no primary key and no node: its first unique key whose columns refuse null.
type Stint @table(name: "stint") {
    validFrom: String @field(name: "valid_from")
}

type Query {
    films: [Film!]!
    # Nothing written: the table's primary key, and each choice the argument offers. A client's
    # choice is applied where the list is read by a query of its own; inline it is deferred.
    actorsOrdered(order: [ActorOrderBy!] @orderBy): [Actor!]!
    holders: [RoleHolder!]!
    stores: [Store!]!
    stints: [Stint!]! @defaultOrder(fields: [{name: "valid_from"}])
    node(id: ID!): Node
}

interface Node {
    id: ID!
}

