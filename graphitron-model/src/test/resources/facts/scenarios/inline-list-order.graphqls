# What a list is ordered by, stated at its occurrence: the default a @defaultOrder writes, by a
# table's primary key, an index or named elements, or the primary key a list with none falls back
# to; and each choice an @orderBy argument offers, one per value of its sort enum. Each key is a
# column of the list's table or a column read through a path, in order,
# with its direction and collation. Beside them what identifies a row of each table-bound type: its
# table's primary key, a node key standing in where the table has none, or a unique key.

# A node over a table with a primary key: two identifying keys, the primary key ranked first.
type Actor implements Node @table(name: "actor") @node {
    id: ID!
    lastName: String @field(name: "last_name")
}

type Language @table(name: "language") {
    name: String

    # Two columns, each in its own direction.
    films: [Film!]! @reference(path: [{key: "film_language_id_fkey"}])
        @defaultOrder(fields: [
            {name: "title", direction: DESC},
            {name: "film_id"}
        ])
}

type Film @table(name: "film") {
    title: String

    # Named columns, the first collated and descending, the second in the application's direction.
    actors: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(fields: [{name: "last_name", collate: "C", direction: DESC}, {name: "first_name"}])

    # An index, in the application's direction.
    actorsByIndex: [Actor!]! @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
        @defaultOrder(index: "idx_actor_last_name", direction: DESC)

    # A column read through a path, whose steps are not resolved here.
    language: Language @reference(path: [{key: "film_language_id_fkey"}])
}

input ActorOrderBy {
    field:     ActorSort!
    direction: SortDirection
}

enum ActorSort {
    LAST_NAME @order(fields: [{name: "last_name", direction: DESC}])
    ACTOR_ID  @order(primaryKey: true)
    BY_INDEX  @index(name: "idx_actor_last_name")
}

type Store @table(name: "store") {
    films: [Film!]! @reference(path: [{key: "inventory_store_id_fkey"}, {key: "inventory_film_id_fkey"}])
        @defaultOrder(fields: [{name: "name", path: [{key: "film_original_language_id_fkey"}]}])
}

# A table with no primary key: the node key stands in for its rows' identity, and a list over it
# states the order it is read in.
type RoleAssignment implements Node @table(name: "role_assignment") @node(typeId: "RoleAssignment", keyColumns: ["holder_id", "role_code"]) {
    id: ID!
    roleCode: String @field(name: "role_code")
}

type RoleHolder @table(name: "role_holder") {
    roles: [RoleAssignment!]! @defaultOrder(fields: [{name: "role_code"}])
}

# A table with no primary key and no node: its first unique key whose columns refuse null.
type Stint @table(name: "stint") {
    validFrom: String @field(name: "valid_from")
}

type Query {
    films: [Film!]!
    # Nothing written: the table's primary key, and each choice the argument offers. A client's
    # choice is applied where the list is read by a query of its own; inline it is deferred.
    actorsOrdered(order: ActorOrderBy @orderBy): [Actor!]!
    holders: [RoleHolder!]!
    stores: [Store!]!
    stints: [Stint!]! @defaultOrder(fields: [{name: "valid_from"}])
    node(id: ID!): Node
}

interface Node {
    id: ID!
}

extend schema @expectEquals(relation: "graphitron_occurrence_order", rows: """
  coordinate,          bound,                  choice,              kind,    argument_coordinate
  Film.actors,         public.actor,           Film.actors,         DEFAULT,
  Film.actorsByIndex,  public.actor,           Film.actorsByIndex,  DEFAULT,
  Query.actorsOrdered, public.actor,           ActorSort.ACTOR_ID,  CHOICE,  Query.actorsOrdered(order:)
  Query.actorsOrdered, public.actor,           ActorSort.BY_INDEX,  CHOICE,  Query.actorsOrdered(order:)
  Query.actorsOrdered, public.actor,           ActorSort.LAST_NAME, CHOICE,  Query.actorsOrdered(order:)
  Query.actorsOrdered, public.actor,           Query.actorsOrdered, DEFAULT,
  Language.films,      public.film,            Language.films,      DEFAULT,
  Query.films,         public.film,            Query.films,         DEFAULT,
  Query.holders,       public.role_holder,     Query.holders,       DEFAULT,
  Query.stints,        public.stint,           Query.stints,        DEFAULT,
  Query.stores,        public.store,           Query.stores,        DEFAULT,
  RoleHolder.roles,    public.role_assignment, RoleHolder.roles,    DEFAULT,
  Store.films,         public.film,            Store.films,         DEFAULT,
  """)

extend schema @expectEquals(relation: "graphitron_order", rows: """
  choice,              read_table,      surface
  ActorSort.ACTOR_ID,  actor,           PRIMARY_KEY
  ActorSort.BY_INDEX,  actor,           INDEX
  ActorSort.LAST_NAME, actor,           FIELDS
  Film.actors,         actor,           FIELDS
  Film.actorsByIndex,  actor,           INDEX
  Language.films,      film,            FIELDS
  Query.actorsOrdered, actor,           IMPLICIT_PRIMARY_KEY
  Query.films,         film,            IMPLICIT_PRIMARY_KEY
  Query.holders,       role_holder,     IMPLICIT_PRIMARY_KEY
  Query.stints,        stint,           FIELDS
  Query.stores,        store,           IMPLICIT_PRIMARY_KEY
  RoleHolder.roles,    role_assignment, FIELDS
  Store.films,         film,            FIELDS
  """)

extend schema @expectEquals(relation: "graphitron_order_sort_key", rows: """
  choice,              read_table,      position, kind,   direction, collation
  Film.actors,         actor,           0,        COLUMN, DESC,      C
  Film.actors,         actor,           1,        COLUMN, ASC,
  Film.actorsByIndex,  actor,           0,        COLUMN, DESC,
  ActorSort.ACTOR_ID,  actor,           0,        COLUMN, ASC,
  ActorSort.BY_INDEX,  actor,           0,        COLUMN, ASC,
  ActorSort.LAST_NAME, actor,           0,        COLUMN, DESC,
  Query.actorsOrdered, actor,           0,        COLUMN, ASC,
  Language.films,      film,            0,        COLUMN, DESC,
  Language.films,      film,            1,        COLUMN, ASC,
  Query.films,         film,            0,        COLUMN, ASC,
  Query.holders,       role_holder,     0,        COLUMN, ASC,
  Query.stints,        stint,           0,        COLUMN, ASC,
  Query.stores,        store,           0,        COLUMN, ASC,
  RoleHolder.roles,    role_assignment, 0,        COLUMN, ASC,
  Store.films,         film,            0,        PATH,   ASC,
  """)

extend schema @expectEquals(relation: "graphitron_order_sort_key_column", rows: """
  choice,              read_table,      position, column_name
  Film.actors,         actor,           0,        last_name
  Film.actors,         actor,           1,        first_name
  Film.actorsByIndex,  actor,           0,        last_name
  ActorSort.ACTOR_ID,  actor,           0,        actor_id
  ActorSort.BY_INDEX,  actor,           0,        last_name
  ActorSort.LAST_NAME, actor,           0,        last_name
  Query.actorsOrdered, actor,           0,        actor_id
  Language.films,      film,            0,        title
  Language.films,      film,            1,        film_id
  Query.films,         film,            0,        film_id
  Query.holders,       role_holder,     0,        holder_id
  Query.stints,        stint,           0,        valid_from
  Query.stores,        store,           0,        store_id
  RoleHolder.roles,    role_assignment, 0,        role_code
  Store.films,         film,            0,        name
  """)

# What identifies each list's rows, ranked: the primary key, else the node key standing in over a
# table with none, else a unique key whose columns refuse null.
extend schema @assertContains(relation: "graphitron_occurrence_identifying_key_column", rows: """
  coordinate,       rank, position, key_kind,    key_name,              column_name
  Film.actors,      -2,   0,        PRIMARY_KEY, actor_pkey,            actor_id
  Query.films,      -2,   0,        PRIMARY_KEY, film_pkey,             film_id
  RoleHolder.roles, -1,   0,        NODE_KEY,    RoleAssignment,        holder_id
  RoleHolder.roles, -1,   1,        NODE_KEY,    RoleAssignment,        role_code
  Query.stints,     0,    0,        UNIQUE_KEY,  stint_person_from_key, person_id
  Query.stints,     0,    1,        UNIQUE_KEY,  stint_person_from_key, valid_from
  """)

# The row-key columns completing an order that lists no identifying key, after its written keys in
# the last one's direction, a client's choice as the default: a path key counts for nothing.
extend schema @expectEquals(relation: "graphitron_occurrence_sort_key_completion", rows: """
  coordinate,         choice,             position, direction, column_name
  Film.actors,        Film.actors,        0,        ASC,       actor_id
  Film.actorsByIndex, Film.actorsByIndex, 0,        DESC,      actor_id
  Query.actorsOrdered, ActorSort.BY_INDEX,  0,       ASC,       actor_id
  Query.actorsOrdered, ActorSort.LAST_NAME, 0,       DESC,      actor_id
  Query.stints,       Query.stints,       0,        ASC,       person_id
  RoleHolder.roles,   RoleHolder.roles,   0,        ASC,       holder_id
  Store.films,        Store.films,        0,        ASC,       film_id
  """)

# A sort key's path is written in the one path grammar and its key resolved as any written key is.
extend schema @expectEquals(relation: "graphitron_path_element_key", where: """
  (graph_name, source_name, source_line, source_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphitron_ast_reference_key_step_entry WHERE key_ref = 'film_original_language_id_fkey')
  """, rows: """
  constraint_table, constraint_name
  film,             film_original_language_id_fkey
  """)

# The index each INDEX order sorts by, matched once; the keys above read its columns from here.
extend schema @expectEquals(relation: "graphitron_order_index", rows: """
  choice,             read_table, index_table, index_name
  Film.actorsByIndex, actor,      actor,       idx_actor_last_name
  ActorSort.BY_INDEX, actor,      actor,       idx_actor_last_name
  """)

extend schema @expectEquals(relation: "graphitron_order_input", rows: """
  type_name,    sort_field_name, direction_field_name
  ActorOrderBy, field,           direction
  """)

extend schema @assertEmpty(relation: "graphitron_entry_defect")

# The key columns @node names keep the order they were written in.
extend schema @expectEquals(relation: "graphitron_ast_node_keycolumn_entry", rows: """
  position, column_ref
  0,        holder_id
  1,        role_code
  """)
