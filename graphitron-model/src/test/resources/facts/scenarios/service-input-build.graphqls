# An input object a service takes is built into the class the service's parameter holds, one member
# per field: a list of input objects into a list of that class, a grouping whose fields bind against
# the enclosing class (FilmBundleLimitsInput's capacity is FilmBundleDraft's own), a nested input
# object into its member's class, a class with setters (FilmSurvey) by them, and a jOOQ record on the
# column axis, one column per field: a deprecated alias of a column writes it where the live field was
# not sent, and a node id is decoded into the record's own key.

input FilmDraftInput { title: String! }
input FilmBundleLimitsInput { capacity: Int }
input FilmBundleDraftInput {
  name: String
  limits: FilmBundleLimitsInput
  films: [FilmDraftInput!]
}
input FilmRecordDraftInput { title: String @field(name: "title") }
input FilmRecordDatedDraftInput {
  title: String @field(name: "title")
  releaseYear: Int @field(name: "release_year")
  year: Int @field(name: "release_year") @deprecated(reason: "Use releaseYear.")
  filmId: ID @nodeId(typeName: "Film")
}
enum FilmMood { HAPPY, SAD }
input FilmSurveyInput { count: Int!, mood: FilmMood, note: String }

interface Node { id: ID! }
type Film implements Node @table(name: "film") @node { id: ID! }
type FilmDraftsCountedPayload { count: Int }

type Query {
  countFilmDrafts(in: [FilmDraftInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmDraftService",
      method: "count", argMapping: "drafts: in"})
  countFilmBundleDraft(in: FilmBundleDraftInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmBundleDraftService",
      method: "count", argMapping: "bundle: in"})
  countFilmRecordDrafts(in: [FilmRecordDraftInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService",
      method: "count", argMapping: "drafts: in"})
  countFilmRecordDatedDrafts(in: [FilmRecordDatedDraftInput!]!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmRecordDraftService",
      method: "count", argMapping: "drafts: in"})
  countFilmSurvey(in: FilmSurveyInput!): FilmDraftsCountedPayload @service(service: {
      className: "no.sikt.graphitron.rewrite.test.services.FilmSurveyService",
      method: "count", argMapping: "survey: in"})
  films: [Film!]!
}

# Each call's one parameter takes its argument whole; what the argument is built into is the build.
extend schema @expectEquals(relation: "graphitron_occurrence_call_parameter", rows: """
  coordinate,                 position, parameter_name, fill,     landing_coordinate
  Query.countFilmDrafts,      0,        drafts,         ARGUMENT, Query.countFilmDrafts(in:)
  Query.countFilmBundleDraft, 0,        bundle,         ARGUMENT, Query.countFilmBundleDraft(in:)
  Query.countFilmRecordDrafts, 0,       drafts,         ARGUMENT, Query.countFilmRecordDrafts(in:)
  Query.countFilmRecordDatedDrafts, 0,  drafts,         ARGUMENT, Query.countFilmRecordDatedDrafts(in:)
  Query.countFilmSurvey,      0,        survey,         ARGUMENT, Query.countFilmSurvey(in:)
  """)

# The class each input object is built into: the parameter's at the argument, a list's element; a
# member's below it; and its parent's own where it groups. A record's fields write columns rather than
# fill members, so the only class below a record is the record itself, for an input object grouping
# onto it.
extend schema @expectEquals(relation: "graphitron_occurrence_built_class", rows: """
  coordinate,                               class_name,                                                         declared_via, member_names
  Query.countFilmDrafts(in:),               no.sikt.graphitron.rewrite.test.services.FilmDraft,                 PARAMETER,    BOUND
  Query.countFilmBundleDraft(in:),          no.sikt.graphitron.rewrite.test.services.FilmBundleDraft,           PARAMETER,    BOUND
  Query.countFilmBundleDraft(in.limits:),   no.sikt.graphitron.rewrite.test.services.FilmBundleDraft,           GROUPING,     BOUND
  Query.countFilmBundleDraft(in.films:),    no.sikt.graphitron.rewrite.test.services.FilmDraft,                 MEMBER,       BOUND
  Query.countFilmRecordDrafts(in:),         no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, PARAMETER, BOUND
  Query.countFilmRecordDatedDrafts(in:),    no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, PARAMETER, BOUND
  Query.countFilmSurvey(in:),               no.sikt.graphitron.rewrite.test.services.FilmSurvey,                PARAMETER,    BOUND
  """)

# The member each field fills, of the class its parent is built into: a grouping's field fills the
# enclosing class's member, its parent the grouping.
extend schema @expectEquals(relation: "graphitron_occurrence_binding_member", rows: """
  coordinate,                                      bound,                                                             parent_coordinate
  Query.countFilmDrafts(in.title:),                no.sikt.graphitron.rewrite.test.services.FilmDraft#title,          Query.countFilmDrafts(in:)
  Query.countFilmBundleDraft(in.name:),            no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#name,     Query.countFilmBundleDraft(in:)
  Query.countFilmBundleDraft(in.limits.capacity:), no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#capacity, Query.countFilmBundleDraft(in.limits:)
  Query.countFilmBundleDraft(in.films:),           no.sikt.graphitron.rewrite.test.services.FilmBundleDraft#films,    Query.countFilmBundleDraft(in:)
  Query.countFilmBundleDraft(in.films.title:),     no.sikt.graphitron.rewrite.test.services.FilmDraft#title,          Query.countFilmBundleDraft(in.films:)
  Query.countFilmSurvey(in.count:),                no.sikt.graphitron.rewrite.test.services.FilmSurvey#count,         Query.countFilmSurvey(in:)
  Query.countFilmSurvey(in.mood:),                 no.sikt.graphitron.rewrite.test.services.FilmSurvey#mood,          Query.countFilmSurvey(in:)
  Query.countFilmSurvey(in.note:),                 no.sikt.graphitron.rewrite.test.services.FilmSurvey#note,          Query.countFilmSurvey(in:)
  """)

# A node id in an input object built into a jOOQ record lands on that record, whose columns take its
# key; it fills no member.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot", rows: """
  coordinate,                                   kind,   landing_class,                                                           slot_shape
  Query.countFilmRecordDatedDrafts(in.filmId:), RECORD, no.sikt.graphitron.rewrite.test.jooq.public_.tables.records.FilmRecord, SINGLE
  """)
