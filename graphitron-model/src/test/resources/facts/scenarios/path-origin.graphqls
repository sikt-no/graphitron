# The paths of the needs no claim covers, each a JOIN path with the table it reaches. A need starting
# where it lands is EMPTY, its target its start: an argument or input field with nothing written, a
# target bound to no table, a scalar or a nested object, and a field its parent's producer lifted
# onto its target's table, a write payload's data field or a field read off a handed-back record. An
# output field between two tables one foreign key joins is INFERRED, its target its landing. A need a
# claim covers has no path here: its path is the claim's, written once its steps reach the target.
# The schema is scenarios/path-need's, with FilmActor.film added for a plain inferred field.

interface MediaItem @table(name: "film") @discriminate(on: "text_rating") {
  title: String
}

type Film implements MediaItem @table(name: "film") @discriminator(value: "G") {
  title: String
  details: FilmDetails
  # A scalar that writes a path: its arguments wait for the join path.
  languageName(upper: Boolean): String
    @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")
  # A plain type reached by a written path: its fields start where the path lands, film_translation,
  # so they wait for the join path.
  titleTexts: TranslatedTexts
    @reference(path: [{table: "film_translation"}])
    @pivot(on: "lang_code", value: "title_txt", vocabulary: "PivotLang")
  # A connection under a table-bound parent, its path inferred from film_actor's one key to film, split
  # into its own query as the generator requires of a connection on a table field.
  actorRows: [FilmActor!]! @asConnection @splitQuery
  # A path ending on a @routine that returns a plain object: the field lands on no table yet, and
  # its argument and its fields wait for the path, with no source and no needs.
  castFilms(minLength: Int!): [ActorFilm!]
    @reference(path: [{table: "film_actor"}])
    @routine(name: "films_for_actor",
             argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

type ActorFilm { filmId: Int @field(name: "FILM_ID") }

type FilmActor @table(name: "film_actor") {
  actorId: Int @field(name: "actor_id")
  # Nothing written, and film_actor_film_id_fkey the one key between film_actor and film: inferred.
  film: Film
  # A single-table interface target: a need per implementation with a table, never the interface.
  media: MediaItem @reference(path: [{key: "film_actor_film_id_fkey"}])
  # A union target: a need per member with a table.
  credits: [Searchable]
    @referenceFor(type: "Film", path: [{key: "film_actor_film_id_fkey"}])
    @referenceFor(type: "Language", path: [{key: "film_actor_film_id_fkey"}, {key: "film_language_id_fkey"}])
}

type FilmDetails { length: Int }

enum PivotLang {
  nn @field(name: "nno")
  en @field(name: "eng")
}

type TranslatedTexts { nn: String en: String }

interface Node { id: ID! }

type Language implements Node @table(name: "language") @node { id: ID! name: String }

union Searchable = Film | Language

input FilmFilter {
  title: String
  span: YearSpan
}

input YearSpan { from: Int @field(name: "release_year") }

type Row { title: String }

# Backed by the FilmRecord list the service hands back: filmId reads the record, language its key row.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# Backed by the FilmRecord the service hands back, whose film field refetches by its key row.
type FilmServicePayload {
  film: Film
}

# A plain class whose films() returns FilmRecords: an ACCESSOR key row, so films reads the object.
type CreateFilmsPayload {
  films: [Film!]!
}

# A plain class whose blurb() is what blurb reads.
type FilmBlurbHolder {
  blurb: FilmBlurb
}

type FilmBlurb { description: String }

input FilmInput @table(name: "film") { title: String }

type FilmInvalid @error(handlers: [{handler: DATABASE}]) { path: [String!]!, message: String! }
union FilmFailure = FilmInvalid

type AddFilmOutcome { film: Film, errors: [FilmFailure] }

input LanguageDeleteInput { languageId: Int! @field(name: "language_id") }

# A delete's payload: the ids of the deleted languages, which read off what the write produced.
type DeletedLanguagesPayload { deletedIds: [ID!] }

extend type Query {
  films(filter: FilmFilter, first: Int): [Film!]!
  search(languageId: Int @field(name: "language_id")): [Searchable]
  topMedia(title: String): MediaItem
  rows(actorId: Int!, minLength: Int!): [Row!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  serviceFilmById(id: Int!): FilmServicePayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  recentlyCreatedFilmsBatched: [CreateFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CreateFilmsPayloadService", method: "recentlyCreatedFilmsBatched"})
  filmBlurbHolder(filmId: Int!): FilmBlurbHolder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

type Mutation {
  addFilm(input: FilmInput): AddFilmOutcome @mutation(typeName: INSERT)
  deleteLanguages(in: [LanguageDeleteInput!]!): DeletedLanguagesPayload
    @mutation(typeName: DELETE, table: "language")
}


# Every path that is not empty: the two output fields between two tables one key joins.
extend schema @expectEquals(relation: "graphitron_path", where: "origin <> 'EMPTY'", rows: """
  coordinate,      target_type, kind, origin
  Film.actorRows,  FilmActor,   JOIN, INFERRED
  FilmActor.film,  Film,        JOIN, INFERRED
  """)

# An empty path for a scalar, a nested object and its field, an argument, an input field, a write
# payload's data field and a field read off the record a service hands back.
extend schema @assertContains(relation: "graphitron_path", rows: """
  coordinate,                      target_type, kind, origin
  Film.title,                      String,      JOIN, EMPTY
  Film.details,                    FilmDetails, JOIN, EMPTY
  Film.details.length,             Int,         JOIN, EMPTY
  Film.actorRows(first:),          FilmActor,   JOIN, EMPTY
  Query.films(filter.title:),      Film,        JOIN, EMPTY
  Mutation.addFilm.film,           Film,        JOIN, EMPTY
  Query.serviceFilmById.film,      Film,        JOIN, EMPTY
  Query.filmDetailsBatch.filmId,   Int,         JOIN, EMPTY
  """)

# What each reaches: an inferred path its landing, an empty one its start.
extend schema @assertContains(relation: "graphitron_join_path", rows: """
  coordinate,                      target_type, target_table, target_table_ref
  Film.actorRows,                  FilmActor,   film_actor,   film_actor
  FilmActor.film,                  Film,        film,         film
  Film.title,                      String,      film,         film
  Film.details,                    FilmDetails, film,         film
  Film.actorRows(first:),          FilmActor,   film_actor,   film_actor
  Query.films(filter.title:),      Film,        film,         film
  Mutation.addFilm.film,           Film,        film,         film
  Query.serviceFilmById.film,      Film,        film,         film
  """)

# A need its own claim covers has no path yet, a written path, a @referenceFor and the field of a
# service's carrier alike; nor does a need landing on no table yet.
extend schema @assertAbsent(relation: "graphitron_path", rows: """
  coordinate
  FilmActor.media
  FilmActor.credits
  Query.filmDetailsBatch.language
  Film.languageName
  Film.titleTexts
  Film.castFilms
  """)
