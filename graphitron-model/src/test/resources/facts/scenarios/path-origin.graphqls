# The paths of the needs, each a JOIN path with the table it reaches. A need starting
# where it lands is EMPTY, its target its start: an argument or input field with nothing written, a
# target bound to no table, a scalar or a nested object, and a field a producer lifted onto its
# target's table: a write payload's data field, a field read off a handed-back record, and a child
# whose own service hands back its target's records. An output field between two tables one foreign
# key joins is INFERRED, its target its landing. A need a claim covers has the claim's path, WRITTEN
# once its steps reach the target. The schema is scenarios/path-need's, with
# FilmActor.film added for a plain inferred field and Film.languageByService for a child service.

interface MediaItem @table(name: "film") @discriminate(on: "text_rating") {
  title: String
}

type Film implements MediaItem @table(name: "film") @discriminator(value: "G") {
  title: String
  details: FilmDetails
  # Its own service hands back LanguageRecords, so it reads language, where its rows come from: an
  # empty path, the two keys between film and language being no matter.
  languageByService: Language
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "languageByService"})
  # A scalar that writes a path: its arguments start where its join path lands, language, their
  # paths empty.
  languageName(upper: Boolean): String
    @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")
  # A plain type reached by a written path: its fields start where its join path lands,
  # film_translation, their paths empty.
  titleTexts: TranslatedTexts
    @reference(path: [{table: "film_translation"}])
    @pivot(on: "lang_code", value: "title_txt", vocabulary: "PivotLang")
  # A connection under a table-bound parent, its path inferred from film_actor's one key to film, split
  # into its own query as the generator requires of a connection on a table field.
  actorRows: [FilmActor!]! @asConnection @splitQuery
  # A path ending on a @routine that returns a plain object: the field's need lands on no table, and
  # its argument and its fields start where its join path lands, the function's derived table, their
  # paths empty.
  castFilms(minLength: Int!): [ActorFilm!]
    @reference(path: [{table: "film_actor"}])
    @routine(name: "films_for_actor",
             argMapping: "pActorId: $source.actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

type ActorFilm { filmId: Int @field(name: "FILM_ID") }

type FilmActor @table(name: "film_actor") {
  actorId: Int @field(name: "actor_id")
  # Nothing written, and film_actor_film_id_fkey the one key between film_actor and film: inferred.
  film: Film
  # A single-table interface target: a need per implementation with a table, never the interface.
  media: MediaItem @reference(path: [{key: "film_actor_film_id_fkey"}])
  # A union target: a need per member with a table.
  credits: [Searchable]
    @referenceFor(type: "Film", path: [{key: "film_actor_film_id_fkey"}])
    @referenceFor(type: "Language", path: [{key: "film_actor_film_id_fkey"}, {key: "film_language_id_fkey"}])
}

type FilmDetails { length: Int }

enum PivotLang {
  nn @field(name: "nno")
  en @field(name: "eng")
}

type TranslatedTexts { nn: String en: String }

interface Node { id: ID! }

type Language implements Node @table(name: "language") @node { id: ID! name: String }

union Searchable = Film | Language

input FilmFilter {
  title: String
  span: YearSpan
  # Its own path, from film, where its argument starts, to language.
  languageName: String @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")
}

# Under an argument writing a path: its field starts and lands where the argument starts.
input LanguageMatch { languageId: Int @field(name: "language_id") }

type Customer @table(name: "customer") { customerId: Int @field(name: "customer_id") }

type Address implements Node @table(name: "address") @node { id: ID! }

input YearSpan { from: Int @field(name: "release_year") }

type Row { title: String }

# Backed by the FilmRecord list the service hands back: filmId reads the record, language its key row.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# Backed by the FilmRecord the service hands back, whose film field refetches by its key row.
type FilmServicePayload {
  film: Film
}

# A plain class whose films() returns FilmRecords: an ACCESSOR key row, so films reads the object.
type CreateFilmsPayload {
  films: [Film!]!
}

# A plain class whose blurb() is what blurb reads.
type FilmBlurbHolder {
  blurb: FilmBlurb
}

type FilmBlurb { description: String }

input FilmInput @table(name: "film") { title: String }

type FilmInvalid @error(handlers: [{handler: DATABASE}]) { path: [String!]!, message: String! }
union FilmFailure = FilmInvalid

type AddFilmOutcome { film: Film, errors: [FilmFailure] }

input LanguageDeleteInput { languageId: Int! @field(name: "language_id") }

# A delete's payload: the ids of the deleted languages, which read off what the write produced.
type DeletedLanguagesPayload { deletedIds: [ID!] }

type Query {
  films(filter: FilmFilter, first: Int): [Film!]!
  # A written argument path, from film to language.
  filmsByLanguageName(name: String @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")): [Film!]!
  # An argument of an input type writing a path.
  filmsByLanguage(language: LanguageMatch @reference(path: [{key: "film_language_id_fkey"}])): [Film!]!
  # A named node id with nothing written, inferred over customer's one key to address.
  customers(addressId: ID @nodeId(typeName: "Address")): [Customer!]!
  # A bare node id, the node its field returns, on that node's own table.
  languages(id: ID @nodeId): [Language!]!
  search(languageId: Int @field(name: "language_id")): [Searchable]
  topMedia(title: String): MediaItem
  rows(actorId: Int!, minLength: Int!): [Row!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  serviceFilmById(id: Int!): FilmServicePayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  recentlyCreatedFilmsBatched: [CreateFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CreateFilmsPayloadService", method: "recentlyCreatedFilmsBatched"})
  filmBlurbHolder(filmId: Int!): FilmBlurbHolder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

type Mutation {
  addFilm(input: FilmInput): AddFilmOutcome @mutation(typeName: INSERT)
  deleteLanguages(in: [LanguageDeleteInput!]!): DeletedLanguagesPayload
    @mutation(typeName: DELETE, table: "language")
  # A write returning a scalar: its argument and input field start and land on the table it mutates.
  deleteLanguage(in: LanguageDeleteInput!): ID @mutation(typeName: DELETE, table: "language")
}


# Every path that is not empty: the two output fields between two tables one key joins, and each
# need a claim covers, its path walked: a written path, a @referenceFor, a single-table interface's
# implementation, the field of a service's carrier, a scalar, a plain type reached by a path, a
# root field's @routine, its path ending on the derived table it returns, an argument's and an input
# field's own @reference, and a named node id inferred over the one key its argument's start declares.
extend schema @expectEquals(relation: "graphitron_path", where: "origin <> 'EMPTY'", rows: """
  coordinate,                      target_type,     kind, origin
  Film.actorRows,                  FilmActor,       JOIN, INFERRED
  Film.castFilms,                  ActorFilm,       JOIN, WRITTEN
  Film.languageName,               String,          JOIN, WRITTEN
  Film.titleTexts,                 TranslatedTexts, JOIN, WRITTEN
  FilmActor.credits,               Film,            JOIN, WRITTEN
  FilmActor.credits,               Language,        JOIN, WRITTEN
  FilmActor.film,                  Film,            JOIN, INFERRED
  FilmActor.media,                 Film,            JOIN, WRITTEN
  Query.filmDetailsBatch.language, Language,        JOIN, WRITTEN
  Query.rows,                      Row,             JOIN, WRITTEN
  Query.customers(addressId:),     Customer,        JOIN, INFERRED
  Query.films(filter.languageName:), Film,          JOIN, WRITTEN
  Query.filmsByLanguage(language:), Film,           JOIN, WRITTEN
  Query.filmsByLanguageName(name:), Film,           JOIN, WRITTEN
  """)

# An empty path for a scalar, a nested object and its field, an argument, an input field, a write
# payload's data field, a field read off the record a service hands back, and the argument and input
# field of a write returning a scalar.
extend schema @assertContains(relation: "graphitron_path", rows: """
  coordinate,                      target_type, kind, origin
  Film.title,                      String,      JOIN, EMPTY
  Film.details,                    FilmDetails, JOIN, EMPTY
  Film.details.length,             Int,         JOIN, EMPTY
  Film.actorRows(first:),          FilmActor,   JOIN, EMPTY
  Query.films(filter.title:),      Film,        JOIN, EMPTY
  Mutation.addFilm.film,           Film,        JOIN, EMPTY
  Query.serviceFilmById.film,      Film,        JOIN, EMPTY
  Query.filmDetailsBatch.filmId,   Int,         JOIN, EMPTY
  Film.languageByService,          Language,    JOIN, EMPTY
  Mutation.deleteLanguage(in:),    ID,          JOIN, EMPTY
  Mutation.deleteLanguage(in.languageId:), ID,  JOIN, EMPTY
  """)

# What each reaches: an inferred path its landing, an empty one its start.
extend schema @assertContains(relation: "graphitron_join_path", rows: """
  coordinate,                      target_type, target_table, target_table_ref
  Film.actorRows,                  FilmActor,   film_actor,   film_actor
  FilmActor.film,                  Film,        film,         film
  Film.title,                      String,      film,         film
  Film.details,                    FilmDetails, film,         film
  Film.actorRows(first:),          FilmActor,   film_actor,   film_actor
  Query.films(filter.title:),      Film,        film,         film
  Mutation.addFilm.film,           Film,        film,         film
  Query.serviceFilmById.film,      Film,        film,         film
  Film.languageByService,          Language,    language,     language
  """)

# The child service reads the table its result names, and not its parent's.
extend schema @expectEquals(relation: "graphitron_occurrence_source_table",
    where: "coordinate = 'Film.languageByService'", rows: """
  coordinate,              table_name
  Film.languageByService,  language
  """)

# A written path reaches where its last step lands: a scalar the table its column is read from, a
# plain type the table a path names, and a path ending on a @routine the function's derived table.
extend schema @assertContains(relation: "graphitron_join_path", rows: """
  coordinate,         target_type,     target_table
  Film.languageName,  String,          language
  Film.titleTexts,    TranslatedTexts, film_translation
  Film.castFilms,     ActorFilm,       films_for_actor
  Query.rows,         Row,             films_for_actor
  """)

# What hangs under each starts there, its own path empty: the scalar's argument, the plain type's
# fields, and the routine path's argument and field.
extend schema @expectEquals(relation: "graphitron_join_path",
    where: "coordinate IN ('Film.languageName(upper:)', 'Film.titleTexts.en', 'Film.titleTexts.nn', 'Film.castFilms(minLength:)', 'Film.castFilms.filmId')", rows: """
  coordinate,                 target_type, target_table
  Film.languageName(upper:),  String,      language
  Film.titleTexts.en,         String,      film_translation
  Film.titleTexts.nn,         String,      film_translation
  Film.castFilms(minLength:), ActorFilm,   films_for_actor
  Film.castFilms.filmId,      Int,         films_for_actor
  """)

extend schema @expectEquals(relation: "graphitron_path",
    where: "coordinate IN ('Film.languageName(upper:)', 'Film.titleTexts.en', 'Film.titleTexts.nn', 'Film.castFilms(minLength:)', 'Film.castFilms.filmId')", rows: """
  coordinate,                 target_type, kind, origin
  Film.languageName(upper:),  String,      JOIN, EMPTY
  Film.titleTexts.en,         String,      JOIN, EMPTY
  Film.titleTexts.nn,         String,      JOIN, EMPTY
  Film.castFilms(minLength:), ActorFilm,   JOIN, EMPTY
  Film.castFilms.filmId,      Int,         JOIN, EMPTY
  """)

# An argument's or input field's own path starts where its field lands, film, and ends where its
# steps do; a named node id with nothing written ends on the node's table over its start's one key;
# what hangs under an argument writing a path, and a bare node id on its own node's table, end where
# they start.
extend schema @expectEquals(relation: "graphitron_join_path", where: """
  coordinate IN ('Query.filmsByLanguageName(name:)', 'Query.filmsByLanguage(language:)',
                 'Query.filmsByLanguage(language.languageId:)', 'Query.films(filter.languageName:)',
                 'Query.customers(addressId:)', 'Query.languages(id:)')
  """, rows: """
  coordinate,                                  target_type, target_table
  Query.customers(addressId:),                 Customer,    address
  Query.films(filter.languageName:),           Film,        language
  Query.filmsByLanguage(language:),            Film,        language
  Query.filmsByLanguage(language.languageId:), Film,        film
  Query.filmsByLanguageName(name:),            Film,        language
  Query.languages(id:),                        Language,    language
  """)

extend schema @assertContains(relation: "graphitron_path", rows: """
  coordinate,                                  target_type, kind, origin
  Query.filmsByLanguage(language.languageId:), Film,        JOIN, EMPTY
  Query.languages(id:),                        Language,    JOIN, EMPTY
  """)

# Each follows its own claim, matched by the element: the claim reaches the declared type, a scalar or
# an input type, while the need reaches the type the field returns.
extend schema @expectEquals(relation: "graphitron_join_path_claimed", where: """
  coordinate IN ('Query.filmsByLanguageName(name:)', 'Query.filmsByLanguage(language:)',
                 'Query.films(filter.languageName:)')
  """, rows: """
  coordinate,                         target_type, claim_coordinate,                 claim_target_type
  Query.films(filter.languageName:),  Film,        FilmFilter.languageName,          String
  Query.filmsByLanguage(language:),   Film,        Query.filmsByLanguage(language:), LanguageMatch
  Query.filmsByLanguageName(name:),   Film,        Query.filmsByLanguageName(name:), String
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step", where: """
  coordinate IN ('Query.filmsByLanguageName(name:)', 'Query.customers(addressId:)')
  """, rows: """
  coordinate,                        target_type, position, element_place, from_table, to_table
  Query.customers(addressId:),       Customer,    0,        ,              customer,   address
  Query.filmsByLanguageName(name:),  Film,        0,        0,             film,       language
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key",
    where: "coordinate = 'Query.customers(addressId:)'", rows: """
  coordinate,                   target_type, position, constraint_name
  Query.customers(addressId:),  Customer,    0,        customer_address_id_fkey
  """)
