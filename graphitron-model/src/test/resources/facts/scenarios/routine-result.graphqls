# What a field whose path ends on a @routine hands the type it returns: a row of the function's
# result, root or child alike. The type carries no @table, and none binds it: the row is the
# function's, which the field calls.

type Tilgang {
  organisasjonskode: Int
  rollekode: String
}

type ActorFilm {
  filmId: Int @field(name: "FILM_ID")
  # Reads the title column of films_for_actor's result, ActorFilm's rows being that result.
  title: String
  # Departs films_for_actor's result, matching film's key by column name.
  film: Film @reference(path: [{table: "film"}])
}

type Film @table(name: "film") {
  description: String
}

type Actor @table(name: "actor") {
  firstName: String @field(name: "first_name")
  # A child @routine ends the path, its actor_id parameter bound from the parent's row.
  films(minLength: Int!): [ActorFilm!]
    @routine(name: "films_for_actor",
             argMapping: "pActorId: actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  # A second field returning ActorFilm from the same function: still one place ActorFilm is read.
  longFilms(minLength: Int!): [ActorFilm!]
    @routine(name: "films_for_actor",
             argMapping: "pActorId: actor_id, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
}

extend type Query {
  actors: [Actor]
  # A root @routine with nothing written after it.
  tilganger(env: String!, serviceId: String!, feideId: String!): [Tilgang!]!
    @routine(name: "tilganger_for_feidebruker_med_fs_fiktivt_fnr",
             argMapping: "pEnv: env, pServiceId: serviceId, pFeideId: feideId")
    @defaultOrder(fields: [{name: "organisasjonskode"}, {name: "rollekode"}])
}

extend schema @expectEquals(relation: "graphitron_path_element_routine", rows: """
  table_schema, routine_name
  public,       films_for_actor
  public,       tilganger_for_feidebruker_med_fs_fiktivt_fnr
  """)

extend schema @assertContains(relation: "graphitron_result_table", rows: """
  type_name, shape, table_name
  Tilgang,   ROW,   tilganger_for_feidebruker_med_fs_fiktivt_fnr
  ActorFilm, ROW,   films_for_actor
  """)

# A type whose rows are a function's result is bound to no table.
extend schema @assertAbsent(relation: "graphitron_resolved_type_binding", rows: """
  type_name
  Tilgang
  ActorFilm
  """)

extend schema @assertContains(relation: "graphitron_field_target_column", rows: """
  type_name, field_name, from_table,                                    column_name
  ActorFilm, title,      films_for_actor,                               title
  Tilgang,   rollekode,  tilganger_for_feidebruker_med_fs_fiktivt_fnr, rollekode
  """)

extend schema @assertContains(relation: "intent_column_match_claim", rows: """
  type_name, field_name, table_name,                                    column_name
  ActorFilm, title,      films_for_actor,                               title
  Tilgang,   rollekode,  tilganger_for_feidebruker_med_fs_fiktivt_fnr, rollekode
  """)

extend schema @assertContains(relation: "graphitron_field_path", rows: """
  type_name, field_name, start_table,     position, from_table,      to_table
  ActorFilm, film,       films_for_actor, 0,        films_for_actor, film
  """)

extend schema @expectEquals(relation: "graphitron_field_source_table", where: "type_name = 'ActorFilm'", rows: """
  field_name, from_table,      basis
  filmId,     films_for_actor, SOURCE_TYPE
  title,      films_for_actor, SOURCE_TYPE
  film,       films_for_actor, SOURCE_TYPE
  """)
