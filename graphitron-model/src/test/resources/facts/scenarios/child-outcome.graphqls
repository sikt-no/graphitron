# A child @service catching into its outcome: the service's throw a handler claims is the outcome's
# errors, and any other throw is redacted. Generated for graphitron's ChildOutcomeExecutionTest.

extend type Query {
  "Every film."
  films: [Film!]!
}

"A film, read from the film table."
type Film @table(name: "film") {
  "The film's key."
  id: Int! @field(name: "film_id")
  "The film's title."
  title: String
  "Caught into its outcome: the verdict on success, the refusal when the service throws one."
  verdict: FilmVerdictOutcome
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmVerdictService", method: "verdict"})
}

"A verdict on a film, or why there is none."
type FilmVerdictOutcome {
  "The verdict, when the service gave one."
  verdict: String
  "Why there is no verdict."
  errors: [VerdictFailure]
}

"The service refused to give a verdict."
type VerdictRefused @error(handlers: [{handler: GENERIC, className: "no.sikt.graphitron.rewrite.test.services.VerdictRefusedException"}]) {
  "Where the refusal arose."
  path: [String!]!
  "Why it was refused."
  message: String!
}

"What can stop a verdict."
union VerdictFailure = VerdictRefused

# The outcome's errors field holds the union of @error types.
extend schema @expectEquals(relation: "graphitron_errors_field", rows: """
  type_name,          field_name, container_name
  FilmVerdictOutcome, errors,     VerdictFailure
  """)

# The child service is a producer handing back an outcome, as a root one would.
extend schema @expectEquals(relation: "graphitron_producer_outcome", rows: """
  type_name, field_name, kind,    outcome_type_name,  errors_field_name
  Film,      verdict,    SERVICE, FilmVerdictOutcome, errors
  """)
