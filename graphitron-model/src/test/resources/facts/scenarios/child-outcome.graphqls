# A child @service catching into its outcome: the service's throw a handler claims is the outcome's
# errors, and any other throw is redacted. A root service hands back an outcome the same way, with no
# parent to take keys off. A child service under a root's outcome takes its keys off the outcome's
# value, the film record the root service handed back. Generated for graphitron's
# ChildOutcomeExecutionTest.

type Query {
  "Every film."
  films: [Film!]!
  "A film looked up by its key, or why it was not found."
  filmLookup(id: Int!): FilmLookupPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmLookupService", method: "lookup"})
  "A film's record looked up by its key, or why it was not found."
  filmRecordLookup(id: Int!): FilmRecordOutcome
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierWithErrorsService", method: "filmById"})
}

"A film's record, or why there is none."
type FilmRecordOutcome {
  "The film's title upper-cased, keyed on the film record the outcome holds."
  titleUppercase: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercaseOfRecords"})
  "Why there is no film."
  errors: [VerdictFailure]
}

"A film's title, or why there is none."
type FilmLookupPayload {
  "The title, when the film was found."
  title: String
  "Why there is no title."
  errors: [VerdictFailure]
}

"A film, read from the film table."
type Film @table(name: "film") {
  "The film's key."
  id: Int! @field(name: "film_id")
  "The film's title."
  title: String
  "Caught into its outcome: the verdict on success, the refusal when the service throws one."
  verdict: FilmVerdictOutcome
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmVerdictService", method: "verdict"})
}

"A verdict on a film, or why there is none."
type FilmVerdictOutcome {
  "The verdict, when the service gave one."
  verdict: String
  "Why there is no verdict."
  errors: [VerdictFailure]
}

"The service refused to give a verdict."
type VerdictRefused @error(handlers: [{handler: GENERIC, className: "no.sikt.graphitron.rewrite.test.services.VerdictRefusedException"}]) {
  "Where the refusal arose."
  path: [String!]!
  "Why it was refused."
  message: String!
}

"What can stop a verdict."
union VerdictFailure = VerdictRefused

# The outcome's errors field holds the union of @error types.
extend schema @expectEquals(relation: "graphitron_errors_field", rows: """
  type_name,          field_name, container_name
  FilmLookupPayload,  errors,     VerdictFailure
  FilmRecordOutcome,  errors,     VerdictFailure
  FilmVerdictOutcome, errors,     VerdictFailure
  """)

# The child service is a producer handing back an outcome, as the root one does. FilmRecordOutcome
# being one is what makes the service under it read its keys off the outcome's value.
extend schema @expectEquals(relation: "graphitron_producer_outcome", rows: """
  type_name, field_name,       kind,    outcome_type_name,  errors_field_name
  Film,      verdict,          SERVICE, FilmVerdictOutcome, errors
  Query,     filmLookup,       SERVICE, FilmLookupPayload,  errors
  Query,     filmRecordLookup, SERVICE, FilmRecordOutcome,  errors
  """)

