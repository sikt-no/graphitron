extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key", "@inaccessible"])

"Subgraph B: the results themselves, resolved by their own key and by the voucher A signs, the details read in the same SELECT on the connection your source leases for the vouched-for owner."
type Query {
  results: [VgsResultat!]!
  resultCount: Int @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService",
    method: "filmCount"})
}

type VgsResultat @table(name: "vouched_result") @key(fields: "id") @accept(scope: "vgs-resultater", vouchesFor: "eierId") {
  id: ID! @field(name: "result_id")
  eierId: String! @field(name: "owner_id") @inaccessible
  grade: Int!
  details: [Detail!]! @reference(path: [{key: "vouched_result_detail_result_id_fkey"}])
  servicedDetails: [Detail!]! @service(service: {className: "no.sikt.graphitron.rewrite.test.services.VouchedResultService",
    method: "servicedDetails"})
}

type Detail @table(name: "vouched_result_detail") {
  subject: String!
}

extend schema @assertEmpty(relation: "graphitron_entry_defect_site")

# The voucher alternative's facts: the minted key beside the authored one, the authored key its vouchers
# decode to, and the one vouched-for field.
extend schema @expectEquals(relation: "graphitron_minted_key", rows: """
  type_name,   role,   fields,  resolvable
  VgsResultat, ACCEPT, internalGraphitronVoucher, TRUE
  """)

extend schema @expectEquals(relation: "graphitron_accept_vouched_for", rows: """
  type_name,   field_name
  VgsResultat, eierId
  """)

# The child service inherits the connection the vouched entity hands down; the roots, the root
# service among them, run on the request's own, so they have no row.
extend schema @expectEquals(relation: "graphitron_occurrence_connection", rows: """
  coordinate,                  outcome
  VgsResultat.servicedDetails, INHERIT
  """)

# The minted voucher field is nullable here: this subgraph receives a voucher in a representation but
# never computes one, so a row it reads by any other route has none to give.
extend schema @expectEquals(relation: "graphitron_field", where: "coordinate = 'VgsResultat.internalGraphitronVoucher'", rows: """
  type_sdl, non_null
  String,   FALSE
  """)
