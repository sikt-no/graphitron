# A field reads by its bound name: its own name, or the one @field names. The member it reads off the
# class its parent's result holds is the one that name finds, which nothing stores.

type FilmBlurb {
  description: String
  "The record's description component, under another name."
  text: String @field(name: "description")
}

type FilmBlurbHolder {
  blurb: FilmBlurb
}

extend type Query {
  filmBlurbHolder(filmId: Int!): FilmBlurbHolder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

# The name a field reads by is anchored on the field: its @field(name:) where written, else its own.
extend schema @expectEquals(relation: "graphitron_field", where: """
  type_name IN ('FilmBlurb', 'FilmBlurbHolder')
  """, rows: """
  type_name,       field_name,  bound_name
  FilmBlurb,       description, description
  FilmBlurb,       text,        description
  FilmBlurbHolder, blurb,       blurb
  """)
