# The steps a field's path takes through intermediate tables, which the fan-out advisory judges:
# whether a table one step arrives at and the next leaves can hold more than one row per set of
# columns the two bind. The steps state how each joins, by a key, by a method alone, or by names
# matched out of a routine's result; the verdicts are the advisory's own and its tests'. A root
# field's @routine is its producer's call and no step, so its first step is the element after it.

type Film @table(name: "film") {
  title: String
  # film_actor's key is exactly the pair the two steps bind.
  actors: [Actor] @reference(path: [
    {key: "film_actor_film_id_fkey"},
    {key: "film_actor_actor_id_fkey"}
  ])
  # film_actor_credit carries lang_code in its key, which neither step binds.
  credits: [Actor] @reference(path: [
    {key: "film_actor_film_id_fkey"},
    {key: "film_actor_credit_pair_fkey"},
    {key: "film_actor_credit_actor_id_fkey"}
  ])
  # Ends on the many side, so film_actor is the last step and no intermediate.
  castLinks: [Cast] @reference(path: [{key: "film_actor_film_id_fkey"}])
  # The step out of film_actor joins by a method.
  bridged: [Actor] @reference(path: [
    {key: "film_actor_film_id_fkey"},
    {condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
      method: "filmActorJunctionToActor"
    }}
  ])
}

type Actor @table(name: "actor") {
  firstName: String @field(name: "first_name")
}

type Cast @table(name: "film_actor") {
  actorId: Int @field(name: "actor_id")
  # film_pkey is bound by the arriving key step alone, and the leaving step joins by a method, so
  # the intermediate is declined and names no covering constraint.
  players: [Cast] @reference(path: [
    {key: "film_actor_film_id_fkey"},
    {condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
      method: "filmToFilmActor"
    }}
  ])
}

type StintPerson @table(name: "stint_person") {
  personId: Int @field(name: "person_id")
  # stint's uniqueness is over the person and the date; the steps bind the person alone.
  crews: [StintCrew] @reference(path: [{key: "stint_person_fkey"}, {key: "stint_crew_fkey"}])
  # stint_single's is over the person.
  singleCrews: [StintCrew] @reference(path: [
    {key: "stint_single_person_fkey"},
    {key: "stint_single_crew_fkey"}
  ])
}

type StintCrew @table(name: "stint_crew") {
  personId: Int @field(name: "person_id")
}

type Language @table(name: "language") {
  name: String
}

extend type Query {
  films: [Film]
  casts: [Cast]
  stintPeople: [StintPerson]
  # A routine's result reaches film by matching the key's columns by name, a step no key states.
  searchLanguages(actorId: Int!, minLength: Int!): [Language]
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @reference(path: [{table: "film"}, {key: "film_language_id_fkey"}])
  # The same name-matched arrival, left by a key that would cover film_pkey on its own.
  searchCasts(actorId: Int!, minLength: Int!): [Cast]
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @reference(path: [{table: "film"}, {key: "film_actor_film_id_fkey"}])
}

extend schema @expectEquals(relation: "graphitron_join_path_step", rows: """
  coordinate,              target_type, position, from_table,        to_table,          element_place
  Cast.players,            Cast,        0,        film_actor,        film,              0
  Cast.players,            Cast,        1,        film,              film_actor,        1
  Film.actors,             Actor,       0,        film,              film_actor,        0
  Film.actors,             Actor,       1,        film_actor,        actor,             1
  Film.bridged,            Actor,       0,        film,              film_actor,        0
  Film.bridged,            Actor,       1,        film_actor,        actor,             1
  Film.castLinks,          Cast,        0,        film,              film_actor,        0
  Film.credits,            Actor,       0,        film,              film_actor,        0
  Film.credits,            Actor,       1,        film_actor,        film_actor_credit, 1
  Film.credits,            Actor,       2,        film_actor_credit, actor,             2
  Query.searchCasts,       Cast,        0,        films_for_actor,   film,              1
  Query.searchCasts,       Cast,        1,        film,              film_actor,        2
  Query.searchLanguages,   Language,    0,        films_for_actor,   film,              1
  Query.searchLanguages,   Language,    1,        film,              language,          2
  StintPerson.crews,       StintCrew,   0,        stint_person,      stint,             0
  StintPerson.crews,       StintCrew,   1,        stint,             stint_crew,        1
  StintPerson.singleCrews, StintCrew,   0,        stint_person,      stint_single,      0
  StintPerson.singleCrews, StintCrew,   1,        stint_single,      stint_crew,        1
  """)

# A step joined by a method alone, and one matched to a routine's result by name: the two the
# question is declined at.
extend schema @expectEquals(relation: "graphitron_join_path_step_method", rows: """
  coordinate,   position, method_name
  Cast.players, 1,        filmToFilmActor
  Film.bridged, 1,        filmActorJunctionToActor
  """)
extend schema @expectEquals(relation: "graphitron_join_path_step_matched_key", rows: """
  coordinate,            position, table_name
  Query.searchCasts,     0,        film
  Query.searchLanguages, 0,        film
  """)
