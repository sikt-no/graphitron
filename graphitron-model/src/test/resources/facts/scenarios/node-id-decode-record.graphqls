# A node id decoded into a jOOQ record. Film's id carries the explicit type id F, which the decode
# reads off the id. Into a record of the node's own table the id loads its key; into a record of the
# table its path starts on, the columns the path carries the key back to: inventories(filmId:) over
# the one foreign key inferred from inventory to film, and inventories(storeId:) over the one to
# store. Language's id states no path from film, which
# has two foreign keys to language, so nothing says which it fills on a film record, and Inventory's
# inventoryId carries no node id at all. rentals(filmId:) writes a path from rental through inventory
# to film; film_id leaves it at inventory, so nothing carries it back to a rental record.

interface Node { id: ID! }
type Film implements Node @table(name: "film") @node(typeId: "F") { id: ID! }
type Language implements Node @table(name: "language") @node { id: ID! }
type Inventory @table(name: "inventory") { inventoryId: Int @field(name: "inventory_id") }
type Store implements Node @table(name: "store") @node { id: ID! }
type Rental @table(name: "rental") { rentalId: Int @field(name: "rental_id") }

type Query {
  inventories(filmId: ID @nodeId(typeName: "Film"), storeId: ID @nodeId(typeName: "Store")): [Inventory!]!
  languages: [Language!]!
  stores: [Store!]!
  rentals(filmId: ID @nodeId(typeName: "Film")
      @reference(path: [{key: "rental_inventory_id_fkey"}, {key: "inventory_film_id_fkey"}])): [Rental!]!
}

extend schema @assertContains(relation: "graphitron_occurrence_node_id", rows: """
  coordinate,                 bound,           position, basis,              node_type_name, column_name
  Language.id,                public.language, 0,        OWN_ID_FIELD,       Language,       language_id
  Query.inventories(filmId:), public.film,     0,        EXPLICIT_TYPE_NAME, Film,           film_id
  Store.id,                   public.store,    0,        OWN_ID_FIELD,       Store,          store_id
  """)
