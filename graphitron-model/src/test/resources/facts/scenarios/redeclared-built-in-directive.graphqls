# redeclared-built-in-directive, read in steps: each @withFacts writes the files of one reading, the clock
# moving between readings, and the claims after it check what that reading left.

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/redeclared-built-in-directive/a-t0", as: "redeclared-built-in-directive.a"}])

# graphql-java builds the schema over the redeclarations, so the reading refuses nothing, and @oneOf
# is the authored declaration, written at line 5 of the redeclaring file.
extend schema @assertEmpty(relation: "graphql_schema_problem")

extend schema @assertContains(relation: "graphql_directive", where: """
  source_name LIKE '%/redeclared-built-in-directive.a.graphqls'
  """, rows: """
  directive_name, source_line
  oneOf,          5
  """)

extend schema @assertAbsent(relation: "graphql_directive", rows: """
  directive_name, source_name
  oneOf,          specification.graphqls
  deprecated,     specification.graphqls
  include,        specification.graphqls
  """)

extend schema @assertContains(relation: "graphql_directive", rows: """
  directive_name, source_name
  skip,           specification.graphqls
  specifiedBy,    specification.graphqls
  """)

extend schema @assertContains(relation: "graphql_directive_location", rows: """
  directive_name, location
  oneOf,          INPUT_OBJECT
  deprecated,     FIELD_DEFINITION
  include,        FIELD
  """)

extend schema @assertAbsent(relation: "graphql_directive_location", rows: """
  directive_name, location
  deprecated,     ENUM_VALUE
  include,        FRAGMENT_SPREAD
  include,        INLINE_FRAGMENT
  """)

extend schema @assertContains(relation: "graphql_directive_argument", rows: """
  directive_name, argument_name, type_sdl, default_value_sdl
  deprecated,     reason,        String,
  include,        if,            Boolean,
  """)

extend schema @assertAbsent(relation: "graphql_directive_argument", rows: """
  directive_name, argument_name, type_sdl
  include,        if,            Boolean!
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/redeclared-built-in-directive/b-t60", as: "redeclared-built-in-directive.b"}])

extend schema @assertAbsent(relation: "graphql_directive", rows: """
  directive_name, source_name
  oneOf,          specification.graphqls
  deprecated,     specification.graphqls
  include,        specification.graphqls
  """)

# The instant is the entry supertype's: every oneOf declaration, the redeclaring file's and the
# specification's, keeps the first reading's.
extend schema @assertContains(relation: "graphql_ast_entry", where: """
  (graph_name, source_name, source_line, source_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_directive_definition_entry WHERE name = 'oneOf')
  """, rows: """
  source_name,            touched_at
  specification.graphqls, 1000000000
  """)

extend schema @assertAbsent(relation: "graphql_ast_entry", where: """
  (graph_name, source_name, source_line, source_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_directive_definition_entry WHERE name = 'oneOf')
  """, rows: """
  touched_at
  1000000060
  """)

extend schema @assertContains(relation: "graphql_directive", rows: """
  directive_name, touched_at
  oneOf,          1000000000
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/redeclared-built-in-directive/a-t120", as: "redeclared-built-in-directive.a"}])

extend schema @assertContains(relation: "graphql_directive", rows: """
  directive_name, source_name
  oneOf,          specification.graphqls
  deprecated,     specification.graphqls
  include,        specification.graphqls
  """)

extend schema @assertContains(relation: "graphql_directive_location", rows: """
  directive_name, location
  deprecated,     ENUM_VALUE
  include,        INLINE_FRAGMENT
  """)

extend schema @assertContains(relation: "graphql_directive_argument", rows: """
  directive_name, argument_name, type_sdl
  include,        if,            Boolean!
  """)

extend schema @assertAbsent(relation: "graphql_directive_argument", rows: """
  directive_name, argument_name, type_sdl, default_value_sdl
  deprecated,     reason,        String,
  """)
