# An @outbox is a message each. A field's applications are kept in the order they were written, at
# ordinals from zero, whatever their events are; an event the author left out is the field's own
# coordinate. The mapping of each is read
# by the generic argMapping writer into pairs, placed at the application it was written on, and
# each entry becomes a key by what fills it: an argument path, the node id of the result, a
# column of the written type, or a member of the field's scope. The configured common payload adds
# its own leaves to every message, and a message's own key wins over a common one of the same name.

extend schema @withConfiguration(
  outboxTable: "outbox",
  outboxPayload: "operation: $scope.operationName, where: $scope.coordinate"
)
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmInput { title: String }

type Mutation {
  createFilm(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox(event: "FilmCreated", argMapping: "filmId: $result.id, title: in.title, name: $result.title")
    @outbox(argMapping: "all: in, place: $scope.alias")
  createFilmAgain(in: FilmInput!): Film
    @mutation(typeName: INSERT)
    @outbox
}

extend schema @expectEquals(relation: "graphitron_ast_outbox_entry", rows: """
  event_ref,   argmapping
  FilmCreated, "filmId: $result.id, title: in.title, name: $result.title"
  ,            "all: in, place: $scope.alias"
  ,
  """)

extend schema @expectEquals(relation: "graphitron_outbox_key", rows: """
  coordinate,               ordinal, key_name,  origin,  position, fill,     reads,   source_path,   column_name, node_type_name
  Mutation.createFilm,      0,       filmId,    MESSAGE, 0,        RESULT,   NODE_ID, id,            ,            Film
  Mutation.createFilm,      0,       title,     MESSAGE, 1,        ARGUMENT, ,        in.title,      ,
  Mutation.createFilm,      0,       name,      MESSAGE, 2,        RESULT,   COLUMN,  title,         title,
  Mutation.createFilm,      0,       operation, COMMON,  0,        SCOPE,    ,        operationName, ,
  Mutation.createFilm,      0,       where,     COMMON,  1,        SCOPE,    ,        coordinate,    ,
  Mutation.createFilm,      1,       all,       MESSAGE, 0,        ARGUMENT, ,        in,            ,
  Mutation.createFilm,      1,       place,     MESSAGE, 1,        SCOPE,    ,        alias,         ,
  Mutation.createFilm,      1,       operation, COMMON,  0,        SCOPE,    ,        operationName, ,
  Mutation.createFilm,      1,       where,     COMMON,  1,        SCOPE,    ,        coordinate,    ,
  Mutation.createFilmAgain, 0,       operation, COMMON,  0,        SCOPE,    ,        operationName, ,
  Mutation.createFilmAgain, 0,       where,     COMMON,  1,        SCOPE,    ,        coordinate,    ,
  """)

extend schema @expectEquals(relation: "graphitron_outbox_target", rows: """
  table_name, type_column, aggregatetype_column, aggregateid_column, payload_column, payload_kind
  outbox,     type,        aggregatetype,        aggregateid,        payload,        JSON
  """)

extend schema @expectEquals(relation: "graphitron_ast_argmapping_pair_entry", where: "bound_to LIKE '$result%' OR bound_to LIKE '$scope%' OR bound_to = 'in.title'", rows: """
  position, param_name, bound_to
  0,        filmId,     $result.id
  1,        title,      in.title
  2,        name,       $result.title
  1,        place,      $scope.alias
  """)

# Each entry's path lands as a service's does, under the occurrence of the field it is written on: an
# argument path on the argument or input field it names, a $result path on the field of what the call
# returns, here a field of Film, which is bound to a table and so starts its own chain.
extend schema @expectEquals(relation: "graphitron_argmapping_landing", where: "directive_name = 'outbox'", rows: """
  coordinate,          ordinal, parameter_name, call_coordinate,     landing_coordinate,              trailing_name
  Mutation.createFilm, 0,       filmId,         Mutation.createFilm, Film.id,                         
  Mutation.createFilm, 0,       title,          Mutation.createFilm, Mutation.createFilm(in.title:),  
  Mutation.createFilm, 0,       name,           Mutation.createFilm, Film.title,                      
  Mutation.createFilm, 1,       all,            Mutation.createFilm, Mutation.createFilm(in:),        
  """)
