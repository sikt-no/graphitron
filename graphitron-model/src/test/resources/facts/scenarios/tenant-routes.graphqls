# Which connection each root @service call, root read and routine write runs on under the tenant column
# film_id. A required value names the tenant, so a call cannot come without one, whether a $tenant pair
# names it or a root read's predicate binds film_id, on its own table or on one its @reference reaches. A
# list argument names it per element, and a call given an empty list, a service's or a lookup's keyed by
# it, answers the field's own empty list without a connection. A root read of language, which no tenant
# column scopes, runs on the key with an empty tenant part.
# A child service under film rows runs
# on the key its parent handed down; one under language rows, which no tenant column scopes, on the key
# with an empty tenant part. A routine write re-reading rental rows, which no tenant column scopes,
# runs on the key with an empty tenant part too: it names no tenant and needs none. So does a root
# service that names no tenant, takes no connection and hands back a Java object rather than a table's
# rows, though a film lies below it; its film runs on the key that service hands down.

extend schema @withConfiguration(tenantColumn: "film_id")

type Film @table(name: "film") {
  title: String
  servedBy: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
    method: "servedBy"})
}

type Language @table(name: "language") {
  name: String
  servedBy: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
    method: "languageServedBy"})
}

type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }

type Inventory @table(name: "inventory") { inventoryId: Int! @field(name: "inventory_id") }

# Backed by the HandedFilm record the service returns, whose film() hands over a FilmRecord.
type HandedFilm {
  name: String
  film: Film
}

type Query {
  films(filmId: Int! @field(name: "film_id")): [Film!]!
  filmsByKey(filmId: [Int!]! @field(name: "film_id") @lookupKey): [Film]!
  inventoriesOfFilm(filmId: Int! @field(name: "film_id")
    @reference(path: [{key: "inventory_film_id_fkey"}])): [Inventory!]!
  languages: [Language!]!
  filmByPair(id: Int!, org: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmsByIds(ids: [Int!]!): [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmsByIds", argMapping: "ids: ids, $tenant: ids"})
  handedFilm: HandedFilm
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.HandedFilmService", method: "make"})
}

type Mutation {
  rentFilm(inventoryId: Int!, customerId: Int!): [Rental!]!
    @routine(name: "rent_film", argMapping: "pInventoryId: inventoryId, pCustomerId: customerId")
    @reference(path: [{table: "rental"}])
}

extend schema @expectEquals(relation: "graphitron_occurrence_connection", rows: """
  coordinate,                outcome
  Query.films,               ROUTED
  Query.filmsByKey,          ROUTED
  Query.inventoriesOfFilm,   ROUTED
  Query.languages,           UNSCOPED
  Query.filmByPair,          ROUTED
  Query.filmsByIds,          ROUTED
  Query.handedFilm,          UNSCOPED
  Query.handedFilm.film,     INHERIT
  Mutation.rentFilm,         UNSCOPED
  Film.servedBy,             INHERIT
  Language.servedBy,         UNSCOPED
  """)

# A routed connection's key has a tenant part, and what a call naming no tenant gets is the part's.
extend schema @expectEquals(relation: "graphitron_occurrence_connection_part", rows: """
  coordinate,              part,   when_empty
  Query.films,             TENANT, UNREACHABLE
  Query.filmsByKey,        TENANT, EMPTY
  Query.inventoriesOfFilm, TENANT, UNREACHABLE
  Query.filmByPair,        TENANT, UNREACHABLE
  Query.filmsByIds,        TENANT, EMPTY
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_producer_empty",
    where: "coordinate LIKE 'Query.film%'", rows: """
  coordinate,       empty
  Query.filmsByKey, LIST
  Query.filmsByIds, LIST
  """)
