# A list pinned on @node(keyColumns:) beats the columns the table's class publishes: Keyed binds
# published_elsewhere, whose class publishes code, and pins alt. The published twin,
# node-key-published, binds the same type name to the same table with no list, so a store holding
# both graphs shows whether either graph's tier leaks into the other.
#
# The table has a column named id beside the key, so the node id says it is one with @nodeId.

interface Node { id: ID! }

type Keyed implements Node @table(name: "published_elsewhere") @node(keyColumns: ["alt"]) { id: ID! @nodeId }

type Query { keyed: [Keyed!]! }

extend schema @expectEquals(relation: "graphitron_node", rows: """
  type_name
  Keyed
  """)

extend schema @expectEquals(relation: "graphitron_node_keycolumn", rows: """
  type_name, position, column_name, column_origin
  Keyed,     0,        alt,         SDL_PINNED
  """)
