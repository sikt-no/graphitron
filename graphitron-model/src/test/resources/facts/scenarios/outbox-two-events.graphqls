# One write emitting two messages: each @outbox application names its event and maps its payload
# from the result and the input, and the field's applications are kept in the order written.

extend schema @withConfiguration(outboxTable: "outbox")
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String
}

input FilmCreateInput {
  title: String
  languageId: Int @field(name: "language_id")
  releaseYear: Int @field(name: "release_year")
}

type Mutation {
  createFilm(in: FilmCreateInput!): Film
    @mutation(typeName: INSERT)
    @outbox(event: "FilmCreated",
            argMapping: "filmId: $result.id, title: in.title, languageId: in.languageId")
    @outbox(event: "FilmCatalogued",
            argMapping: "filmId: $result.id, releaseYear: in.releaseYear")
}

extend schema @expectEquals(relation: "graphitron_ast_outbox_entry", rows: """
  event_ref
  FilmCreated
  FilmCatalogued
  """)

extend schema @expectEquals(relation: "graphitron_outbox_key", rows: """
  coordinate,          ordinal, key_name,    origin,  position, fill,     reads,   source_path
  Mutation.createFilm, 0,       filmId,      MESSAGE, 0,        RESULT,   NODE_ID, id
  Mutation.createFilm, 0,       title,       MESSAGE, 1,        ARGUMENT, ,        in.title
  Mutation.createFilm, 0,       languageId,  MESSAGE, 2,        ARGUMENT, ,        in.languageId
  Mutation.createFilm, 1,       filmId,      MESSAGE, 0,        RESULT,   NODE_ID, id
  Mutation.createFilm, 1,       releaseYear, MESSAGE, 1,        ARGUMENT, ,        in.releaseYear
  """)
