# An author declaring every type @asConnection would generate for Query.films, each with what the
# Relay specification requires and graphitron's nodes and totalCount beside: the declarations stand,
# nothing is minted, and nothing is short.

type Film @table(name: "film") { title: String }

type Query {
  films: [Film!]! @asConnection @defaultOrder(primaryKey: true)
}

type QueryFilmsConnection {
  edges: [QueryFilmsConnectionEdge!]!
  nodes: [Film!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type QueryFilmsConnectionEdge { cursor: String! node: Film! }

type PageInfo { hasNextPage: Boolean! hasPreviousPage: Boolean! startCursor: String endCursor: String }

extend schema @assertEmpty(relation: "graphitron_type_minted")

extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: "code = 'MINTED_TYPE_DECLARED_SHORT'")
