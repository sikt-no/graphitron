# How a @nodeId decode reaches the table its node type's key lives on, and the steps that take it
# there. A slot on the node's own table is own-row identity and walks nothing. A written @reference
# is the authored path even where it departs and arrives at one table, a self-key, and contributes
# its steps in written order. With nothing written and two tables, the one key between them is
# inferred, from the use site's table for an input field.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID!
  title: String
}

type Actor implements Node @table(name: "actor") @node {
  id: ID!
}

type Category implements Node @table(name: "category") @node {
  id: ID!
}

type FilmActor @table(name: "film_actor") {
  lastUpdate: String @field(name: "last_update")
}

type Inventory @table(name: "inventory") {
  filmNodeId: ID @nodeId(typeName: "Film")
}

input CastInput {
  actorId: ID @nodeId(typeName: "Actor")
}

type Query {
  films(
    ids: [ID] @nodeId(typeName: "Film"),
    inCategory: ID @nodeId(typeName: "Category") @reference(path: [{key: "film_category_film_id_fkey"}, {key: "film_category_category_id_fkey"}])
  ): [Film]
  categories(childOf: ID @nodeId(typeName: "Category") @reference(path: [{key: "category_parent_category_id_fkey"}])): [Category]
  filmActors(actorId: ID @nodeId(typeName: "Actor")): [FilmActor]
  inventories: [Inventory]
}

type Mutation {
  addCastEntry(in: CastInput): FilmActor @mutation(typeName: INSERT)
}

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                         bound,           position, node_type_name, column_name
  Mutation.addCastEntry(in.actorId:), public.actor,    0,        Actor,          actor_id
  Query.categories(childOf:),         public.category, 0,        Category,       category_id
  Query.filmActors(actorId:),         public.actor,    0,        Actor,          actor_id
  Query.films(ids:),                  public.film,     0,        Film,           film_id
  Query.films(inCategory:),           public.category, 0,        Category,       category_id
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                         position, from_table,    to_table
  Mutation.addCastEntry(in.actorId:), 0,        film_actor,    actor
  Query.categories(childOf:),         0,        category,      category
  Query.filmActors(actorId:),         0,        film_actor,    actor
  Query.films(inCategory:),           0,        film,          film_category
  Query.films(inCategory:),           1,        film_category, category
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Mutation.%'", rows: """
  coordinate,                         position, constraint_table, constraint_name
  Mutation.addCastEntry(in.actorId:), 0,        film_actor,       film_actor_actor_id_fkey
  Query.filmActors(actorId:),         0,        film_actor,       film_actor_actor_id_fkey
  """)
