# The orders a root's @orderBy argument picks one from, beside the default. FilmSort's orders: the
# primary key, a title that follows the request's direction, a title its author fixed descending, a
# length that may be NULL, and a name read down a path to the film's original language. filmsPicked
# falls back to the title.

type Film @table(name: "film") {
    filmId: Int!   @field(name: "film_id")
    title:  String @field(name: "title")
}

enum FilmSort {
    FILM_ID @order(primaryKey: true)
    TITLE   @order(fields: [{name: "title"}])
    TITLE_DESC @order(fields: [{name: "title", direction: DESC}])
    LENGTH  @order(fields: [{name: "length"}])
    ORIGINAL_LANGUAGE @order(fields: [{name: "name", path: [{key: "film_original_language_id_fkey"}]}])
}

input FilmOrderBy {
    field:     FilmSort!
    direction: SortDirection
}

type Query {
    filmsPicked(order: FilmOrderBy @orderBy): [Film!]! @defaultOrder(fields: [{name: "title"}])
}

extend schema @expectEquals(relation: "graphitron_order_sort_key_column",
    where: "choice <> 'Query.filmsComposed'", rows: """
  choice,                     read_table, position, column_name
  Query.filmsPicked,          film,       0,        title
  FilmSort.FILM_ID,           film,       0,        film_id
  FilmSort.LENGTH,            film,       0,        length
  FilmSort.ORIGINAL_LANGUAGE, film,       0,        name
  FilmSort.TITLE,             film,       0,        title
  FilmSort.TITLE_DESC,        film,       0,        title
  """)
