"A table-bound type's projection unit is its fields' occurrences and, inline beneath a nesting field, the nesting type's: Film projects its title's column, the key column its node id packs, its language's name down a path and, through the non-null nesting field facts, the length and release_year columns of the same film row and the language's name again. The participants of a discriminated interface write an interface field under the interface's name. Language.spoken is a nullable nesting field, whose null contract the store does not state yet."

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID! @nodeId
  title: String!
  "A column down a path, read by a subselect from the film row."
  languageName: String @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")
  "Non-null, so it is the film row's whatever its columns hold."
  facts: FilmFacts!
  "A split keyed on the language's key, read off the film row's language_id."
  languageSplit: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  "A split over two hops, keyed on the film's own key."
  actors: [Actor!]! @splitQuery @reference(path: [{table: "film_actor"}, {table: "actor"}])
}

type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }

"Read off the film row it is nested under."
type FilmFacts {
  length: Int
  releaseYear: Int @field(name: "release_year")
  "Down a path from the nesting level, named within the nesting field's result key."
  languageName: String @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")
}

"A discriminated interface over one table: a field it declares is written under its name by every participant, a field a participant declares under the participant's."
interface Item @table(name: "content") @discriminate(on: "content_type") {
  contentId: Int! @field(name: "content_id")
  filmDescription: String @reference(path: [{key: "content_film_id_fkey"}]) @field(name: "description")
}

type FilmItem implements Item @table(name: "content") @discriminator(value: "FILM") {
  contentId: Int! @field(name: "content_id")
  filmDescription: String @reference(path: [{key: "content_film_id_fkey"}]) @field(name: "description")
  filmReleaseYear: Int @reference(path: [{key: "content_film_id_fkey"}]) @field(name: "release_year")
}

type ShortItem implements Item @table(name: "content") @discriminator(value: "SHORT") {
  contentId: Int! @field(name: "content_id")
  filmDescription: String @reference(path: [{key: "content_film_id_fkey"}]) @field(name: "description")
}

type Language @table(name: "language") {
  name: String
  "Nullable: when it is null is not stated yet."
  spoken: LanguageNote
}

"Read off the language row it is nested under."
type LanguageNote { name: String }

type Query {
  films: [Film!]!
  languages: [Language!]!
  items: [Item!]!
}

# The columns each occurrence binds on its unit's table, nested ones on the same row.
extend schema @expectEquals(relation: "graphitron_occurrence_column", where: "coordinate LIKE 'Film.%'", rows: """
  coordinate,               table_name, column_name
  Film.title,               film,       title
  Film.languageName,        language,   name
  Film.facts.length,        film,       length
  Film.facts.releaseYear,   film,       release_year
  Film.facts.languageName,  language,   name
  """)

# The node id packs the film's key column.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate = 'Film.id'", rows: """
  coordinate, node_type_name, table_name, column_name, position
  Film.id,    Film,           film,       film_id,     0
  """)
