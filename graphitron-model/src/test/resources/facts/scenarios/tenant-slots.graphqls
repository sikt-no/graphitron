# Every value a @service call's or a root read's tenant is read from, under a database-per-tenant build
# whose tenant column is film_id: an argument a $tenant pair names, one written @tenant, an input field
# a jOOQ record binds to film_id, a node id whose key is film_id, and a root read's argument its
# predicate binds to film_id, on its own table or on one a @reference reaches. A value a call may be
# given none of is said by graphitron_occurrence_optional, whatever its slot; how each is present, once
# or once per element of a list the call's own argument holds, is stated on the slot, a fact of its
# occurrence.
#
# A stub node, one this subgraph does not fetch by its id, routes a call by its key all the same (Alf,
# 2026-11-24): FilmActorCode's key holds film_id, so the decoded record names the call's tenant and
# Query.filmActorByStub has a slot its call is routed by. InventoryCode's key leaves film_id out, so
# Query.inventoryByStub has none and runs unscoped, its children inheriting that.

extend schema @withConfiguration(tenantColumn: "film_id")

interface Node { id: ID! }
type Film implements Node @table(name: "film") @node { id: ID! title: String }

type Inventory @table(name: "inventory") { inventoryId: Int! @field(name: "inventory_id") }

type FilmActorCode implements Node @table(name: "film_actor") @node(resolvable: false) { id: ID! }
type InventoryCode implements Node @table(name: "inventory") @node(resolvable: false) { id: ID! }
input FilmActorPick { id: ID! @nodeId(typeName: "FilmActorCode") }
input InventoryPick { id: ID! @nodeId(typeName: "InventoryCode") }

input FilmIn @table(name: "film") {
  filmId: Int! @field(name: "film_id")
  title: String
}

type Query {
  filmByPair(id: Int!, org: Int!): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById", argMapping: "id: id, $tenant: org"})
  filmMarked(id: Int! @tenant): Film
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmById"})
  filmByRecord(in: FilmIn!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService",
      method: "modifyFilmRecord"})
  markedFilms(ids: [Int!]! @tenant): [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService",
      method: "filmsByIds"})
  filmByNode(in: ID! @nodeId(typeName: "Film")): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService",
      method: "modifyFilmRecord"})
  filmActorByStub(in: FilmActorPick!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService",
      method: "modifyFilmActorRecord"})
  inventoryByStub(in: InventoryPick!): String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmRecordService",
      method: "modifyInventoryRecord"})
  films(filmId: Int! @field(name: "film_id")): [Film!]!
  filmsByKey(filmId: [Int!]! @field(name: "film_id") @lookupKey): [Film]!
  inventoriesOfFilm(filmId: Int! @field(name: "film_id")
    @reference(path: [{key: "inventory_film_id_fkey"}])): [Inventory!]!
}

# What an author wrote: the pair and the directive are one fact, told apart by where it was written.
extend schema @expectEquals(relation: "graphitron_occurrence_binding_tenant", rows: """
  coordinate,             call_coordinate,  call,     origin,     key_position
  Query.filmByPair(org:), Query.filmByPair, producer, ARGMAPPING,
  Query.filmMarked(id:),  Query.filmMarked, producer, DIRECTIVE,
  Query.markedFilms(ids:), Query.markedFilms, producer, DIRECTIVE,
  """)

# Every value each call's tenant is read from, and how.
extend schema @expectEquals(relation: "graphitron_occurrence_tenant_slot", rows: """
  producer_coordinate,    kind,          coordinate,                     key_position, guaranteed, per_element, own_argument
  Query.filmByPair,   AUTHORED,      Query.filmByPair(org:),         ,             TRUE,       FALSE,       TRUE
  Query.filmMarked,   AUTHORED,      Query.filmMarked(id:),          ,             TRUE,       FALSE,       TRUE
  Query.markedFilms,  AUTHORED,      Query.markedFilms(ids:),        ,             FALSE,      TRUE,        TRUE
  Query.filmByRecord, COLUMN,        Query.filmByRecord(in.filmId:), ,             TRUE,       FALSE,       TRUE
  Query.films,        COLUMN,        Query.films(filmId:),           ,             TRUE,       FALSE,       TRUE
  Query.filmsByKey,   COLUMN,        Query.filmsByKey(filmId:),      ,             FALSE,      TRUE,        TRUE
  Query.inventoriesOfFilm, COLUMN,   Query.inventoriesOfFilm(filmId:), ,           TRUE,       FALSE,       TRUE
  Query.filmByNode,   NODE_ID_KEY,   Query.filmByNode(in:),          0,            TRUE,       FALSE,       TRUE
  Query.filmActorByStub, NODE_ID_KEY, Query.filmActorByStub(in.id:), 1,          TRUE,       FALSE,       TRUE
  """)

# A root read's slot rests on the column binding its predicate lands on: film's own film_id for a
# read of film, and film's film_id reached by inventoriesOfFilm's @reference for a read of inventory.
extend schema @expectEquals(relation: "graphitron_occurrence_tenant_slot_column",
    where: "producer_coordinate IN ('Query.films', 'Query.inventoriesOfFilm')", rows: """
  producer_coordinate,     coordinate,                       bound
  Query.films,             Query.films(filmId:),             public.film
  Query.inventoriesOfFilm, Query.inventoriesOfFilm(filmId:), public.film
  """)

# Every tenant value here is required; the record's title, which names no tenant, may be left out.
extend schema @expectEquals(relation: "graphitron_occurrence_optional",
    where: "coordinate LIKE 'Query.filmBy%'", rows: """
  coordinate
  Query.filmByRecord(in.title:)
  """)
