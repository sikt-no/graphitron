# The corpus and library-named on one classpath, in that order. Both declare a FilmBlurbHolder, and
# the store holds both, each entry being read alone; the graph resolves a class name two of its
# entries declare to the first of them, as a classloader would, so the corpus's holder backs Holder
# and LibHolder alike and only its FilmBlurb is reached from either. The library's own service and
# input still ground, being declared once.
extend schema @withConfiguration(classpath: "corpus-and-library-named")
extend schema @withFacts(docs: [{path: "shapes/type-backing-partition"}])

extend schema @expectEquals(relation: "graphitron_type_backing", rows: """
  type_name,       class_name,                                               declared_via
  Holder,          no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder, PRODUCER
  Blurb,           no.sikt.graphitron.rewrite.test.services.FilmBlurb,       ACCESSOR
  LibHolder,       no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder, PRODUCER
  LibBlurb,        no.sikt.graphitron.rewrite.test.services.FilmBlurb,       ACCESSOR
  AssignmentInput, lib.Assignment,                                           PRODUCER
  """)

# The class each name resolves to, which the backings above read: FilmBlurbHolder, declared by both
# entries, is the corpus's, and lib.HolderService, declared by the library alone, is the library's.
extend schema @expectEquals(relation: "code_graph_class",
    where: "class_name IN ('no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder', 'lib.HolderService') AND source_name LIKE '%library-named'",
    rows: """
  class_name
  lib.HolderService
  """)
extend schema @expectEquals(relation: "code_graph_class",
    where: "class_name = 'no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder' AND source_name NOT LIKE '%library-named'",
    rows: """
  class_name
  no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder
  """)
