# A bare @nodeId whose consuming field returns a multi-table polymorphic container: an interface
# binding no table of its own, or a union. The target it is inferred from is one table per
# participant, so it is one row per participant, each naming the node type over that participant's
# table, and the rows differ in nothing else. A written typeName: at the same field is one row, and so
# is a bare one on a discriminated interface binding one table: what fans out is the inference over
# several tables. The branches disagreeing is not a refused decode.

interface Node { id: ID! }

interface Media { id: ID! }

interface MediaItem @table(name: "film") @discriminate(on: "text_rating") { title: String }

type Film implements Node & Media & MediaItem @table(name: "film") @node @discriminator(value: "G") {
  id: ID!
  title: String
}

type Actor implements Node & Media @table(name: "actor") @node {
  id: ID!
}

union Occupant = Film | Actor

input MediaFilter {
  someId: ID @nodeId
}

type Query {
  media(
    someId: ID @nodeId
    # Actor reaches film through film_actor, which a written typeName: on a multi-table field states.
    filmId: ID @nodeId(typeName: "Film")
      @referenceFor(type: "Actor", path: [{key: "film_actor_actor_id_fkey"}, {key: "film_actor_film_id_fkey"}])
  ): [Media]
  occupants(someId: ID @nodeId): [Occupant]
  films(where: MediaFilter): [Film]
  mediaItems(someId: ID @nodeId): [MediaItem]
}

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", rows: """
  coordinate,                 bound,        position, basis,                  node_type_name, column_name
  Actor.id,                   public.actor, 0,        OWN_ID_FIELD,           Actor,          actor_id
  Film.id,                    public.film,  0,        OWN_ID_FIELD,           Film,           film_id
  Query.films(where.someId:), public.film,  0,        TARGET_TABLE_NODE_TYPE, Film,           film_id
  Query.media(filmId:),       public.film,  0,        EXPLICIT_TYPE_NAME,     Film,           film_id
  Query.media(someId:),       public.actor, 0,        TARGET_TABLE_NODE_TYPE, Actor,          actor_id
  Query.media(someId:),       public.film,  0,        TARGET_TABLE_NODE_TYPE, Film,           film_id
  Query.mediaItems(someId:),  public.film,  0,        TARGET_TABLE_NODE_TYPE, Film,           film_id
  Query.occupants(someId:),   public.actor, 0,        TARGET_TABLE_NODE_TYPE, Actor,          actor_id
  Query.occupants(someId:),   public.film,  0,        TARGET_TABLE_NODE_TYPE, Film,           film_id
  """)

# Every column but the reading's time and the catalog source, so a column telling the two branches
# apart other than the node and its table would show.
extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: """
  coordinate = 'Query.media(someId:)'
  """, rows: """
  coordinate,           bound,        position, kind,    basis,                  node_type_name, table_schema, table_name, column_name
  Query.media(someId:), public.actor, 0,        NODE_ID, TARGET_TABLE_NODE_TYPE, Actor,          public,       actor,      actor_id
  Query.media(someId:), public.film,  0,        NODE_ID, TARGET_TABLE_NODE_TYPE, Film,           public,       film,       film_id
  """)

extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: """
  coordinate = 'Query.media(someId:)' AND code IN ('NODE_ID_SLOT_SHAPE_MISMATCH', 'NODE_ID_KEY_ARITY_EXCEEDS_SLOT', 'NODE_ID_KEY_COLUMN_TYPE_DISAGREEMENT', 'NODE_ID_CONTAINER_NOT_AT_A_SLOT', 'NODE_ID_SINGLE_TABLE_CONTAINER', 'NODE_ID_NO_TABLE_MEMBERS', 'NODE_ID_MEMBER_NOT_NODE_TYPE', 'NODE_ID_SLOT_NOT_SUPERTYPE_OF_MEMBER')
  """)
