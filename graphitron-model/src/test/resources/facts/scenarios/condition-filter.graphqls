# The filters a field's arguments and input fields write, where each binds a column on the table
# the field returns rows of: a scalar compares by equality, a list by membership, and a value read
# through an input object reads through it. The path from the field's table to the column is empty,
# so each is a predicate on that table itself. A @lookupKey argument is a key, not a filter, and
# binds its column too; the condition leaves it out. A value whose declaration writes a path binds
# the column where the path lands, each step joining on a key's columns or by a condition method.
# A node id binds the node's key, which the condition compares on the table the id lands on: the
# node's own key there, or the foreign key referencing it. An enum binds the column like any
# scalar.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node(typeId: "F") {
    id: ID!
    title: String
}

enum MpaaRating { G PG PG_13 R NC_17 }

input FilmRatingFilter {
    ratings: [MpaaRating!] @field(name: "rating")
}

type FilmActor implements Node @table(name: "film_actor") @node {
    id: ID!
}

type Inventory @table(name: "inventory") {
    inventoryId: Int @field(name: "inventory_id")
}

input FilmFilter {
    title: String
    releaseYear: Int @field(name: "release_year")
    inner: FilmLengthFilter
}

input FilmLengthFilter {
    length: Int
}

input FilmTitleInput { title: String }

type Customer @table(name: "customer") {
    firstName: String @field(name: "first_name")
}

type LanguageNode implements Node @table(name: "language") @node {
    id: ID!
}

# A node of a composite key, (org_id, project_id), which project_note references by a composite
# foreign key.
type Project implements Node @table(name: "project") @node {
    id: ID!
}

type ProjectNote @table(name: "project_note") {
    body: String
}

# A node id whose @condition is applied to the table it identifies, reached from project_note over
# the composite foreign key, the method taking that table and the decoded key as a Row2.
input ProjectNoteByProjectFilter {
    projectId: ID @nodeId(typeName: "Project")
        @condition(condition: {
            className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
            method: "projectNameAtlas"
        }, override: true)
}

# A node id a field's @condition takes one key column of, by an argMapping descending onto it.
input OptionalLanguageFilter {
    languageRef: ID @nodeId(typeName: "LanguageNode")
        @reference(path: [{key: "film_language_id_fkey"}])
}

input FilmCastFilter {
    firstName: String @field(name: "first_name")
        @reference(path: [{key: "film_actor_film_id_fkey"}, {key: "film_actor_actor_id_fkey"}])
}

type Query {
    filmsByTitle(title: String): [Film!]!
    filmById(filmId: Int! @field(name: "film_id")): Film
    filmsByLengths(lengths: [Int!] @field(name: "length")): [Film!]!
    filmsByFilter(filter: FilmFilter): [Film!]!
    filmsByKey(film_id: [Int!] @lookupKey, title: String): [Film]!
    filmsByRating(rating: MpaaRating, filter: FilmRatingFilter): [Film!]!
    filmByNodeId(id: ID! @nodeId(typeName: "Film")): Film
    filmsByNodeIds(ids: [ID!] @nodeId(typeName: "Film")): [Film!]!
    filmActorsByNodeIds(ids: [ID!] @nodeId(typeName: "FilmActor")): [FilmActor!]!
    inventoriesByFilm(filmId: ID @nodeId(typeName: "Film")): [Inventory!]!
    customersByCityId(cityId: ID @field(name: "city_id") @reference(path: [{key: "customer_address_id_fkey"}])): [Customer!]!
    filmsByCast(cast: FilmCastFilter): [Film!]!
    filmsByBridgedActorFirstName(
        firstName: String @field(name: "first_name") @reference(path: [
            {key: "film_actor_film_id_fkey"},
            {condition: {
                className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
                method: "filmActorJunctionToActor"
            }}
        ])
    ): [Film!]!
    # An argument's @condition with override: true owns its predicate, its argument binding no column.
    filmsByTitlePrefix(titlePrefix: String @condition(condition: {
        className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
        method: "filmTitlePrefixCondition"}, override: true)): [Film!]!
    # The same beside a generated term: the two compose.
    filmsByLengthAndTitlePrefix(length: Int, titlePrefix: String @condition(condition: {
        className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
        method: "filmTitlePrefixCondition"}, override: true)): [Film!]!
    # A field's @condition with override: true suppresses the generated term, the method taking the
    # argument by type.
    filmsByTitleOverridden(title: String): [Film!]! @condition(condition: {
        className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
        method: "filmTitlePrefixCondition"}, override: true)
    # A @condition taking an input object as a bean, built from the map before the call.
    filmsByTitleBean(by: FilmTitleInput): [Film!]! @condition(condition: {
        className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
        method: "filmTitleRecord", argMapping: "filter: by"}, override: true)
    # A @condition reading the request context, its key named in contextArguments.
    customersSeen: [Customer!]! @condition(condition: {
        className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
        method: "customerSeenByUser"}, contextArguments: ["userId"])
    # The node id's @condition, called on project only where the id is present.
    projectNotesByProject(filter: ProjectNoteByProjectFilter): [ProjectNote!]!
        @defaultOrder(primaryKey: true)
    # The projected key column, null where the client leaves the node id out; override: true leaves
    # the method the only thing narrowing the rows.
    filmsByOptionalLanguage(pick: OptionalLanguageFilter!): [Film!]!
        @condition(condition: {
            className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
            method: "filmsOfOptionalLanguage",
            argMapping: "languageId: pick.languageRef.language_id"
        }, override: true)
        @defaultOrder(primaryKey: true)
    # A list of node ids a field's @condition takes the key column of, one value per decoded id: by
    # naming the column past the list, beside a single id named the same way, and by descending onto
    # a list inside an input object.
    filmsByLanguages(
        languageIds: [ID!] @nodeId(typeName: "LanguageNode") @reference(path: [{key: "film_language_id_fkey"}])
    ): [Film!]!
        @condition(condition: {
            className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
            method: "filmsOfLanguages",
            argMapping: "languageIds: languageIds.language_id"
        }, override: true)
        @defaultOrder(primaryKey: true)
    filmsByLanguagesWithOriginal(
        languageIds: [ID!]! @nodeId(typeName: "LanguageNode") @reference(path: [{key: "film_language_id_fkey"}])
        originalId: ID! @nodeId(typeName: "LanguageNode") @reference(path: [{key: "film_original_language_id_fkey"}])
    ): [Film!]!
        @condition(condition: {
            className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
            method: "filmsOfLanguagesWithOriginal",
            argMapping: "languageIds: languageIds.language_id, originalLanguageId: originalId.language_id"
        }, override: true)
        @defaultOrder(primaryKey: true)
    filmsByPickedLanguages(pick: LanguagesPick): [Film!]!
        @condition(condition: {
            className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
            method: "filmsOfLanguages",
            argMapping: "languageIds: pick.languageIds.language_id"
        }, override: true)
        @defaultOrder(primaryKey: true)
}

input LanguagesPick {
    languageIds: [ID!] @nodeId(typeName: "LanguageNode") @reference(path: [{key: "film_language_id_fkey"}])
}

extend schema @expectEquals(relation: "graphitron_occurrence_node_id",
    where: "coordinate LIKE 'Query.%'", rows: """
  coordinate,                          bound,             position, basis,              node_type_name, column_name
  Query.filmActorsByNodeIds(ids:),     public.film_actor, 0,        EXPLICIT_TYPE_NAME, FilmActor,      actor_id
  Query.filmActorsByNodeIds(ids:),     public.film_actor, 1,        EXPLICIT_TYPE_NAME, FilmActor,      film_id
  Query.filmByNodeId(id:),             public.film,       0,        EXPLICIT_TYPE_NAME, Film,           film_id
  Query.filmsByNodeIds(ids:),          public.film,       0,        EXPLICIT_TYPE_NAME, Film,           film_id
  Query.inventoriesByFilm(filmId:),    public.film,       0,        EXPLICIT_TYPE_NAME, Film,           film_id
  Query.filmsByOptionalLanguage(pick.languageRef:), public.language, 0, EXPLICIT_TYPE_NAME, LanguageNode, language_id
  Query.filmsByLanguages(languageIds:),             public.language, 0, EXPLICIT_TYPE_NAME, LanguageNode, language_id
  Query.filmsByLanguagesWithOriginal(languageIds:), public.language, 0, EXPLICIT_TYPE_NAME, LanguageNode, language_id
  Query.filmsByLanguagesWithOriginal(originalId:),  public.language, 0, EXPLICIT_TYPE_NAME, LanguageNode, language_id
  Query.filmsByPickedLanguages(pick.languageIds:),  public.language, 0, EXPLICIT_TYPE_NAME, LanguageNode, language_id
  Query.projectNotesByProject(filter.projectId:),   public.project,  0, EXPLICIT_TYPE_NAME, Project,      org_id
  Query.projectNotesByProject(filter.projectId:),   public.project,  1, EXPLICIT_TYPE_NAME, Project,      project_id
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_column",
    where: "coordinate LIKE 'Query.%'", rows: """
  coordinate,                                         bound,          column_name,  matched_by
  Query.customersByCityId(cityId:),                   public.address, city_id,      SQL_NAME
  Query.filmsByBridgedActorFirstName(firstName:),     public.actor,   first_name,   SQL_NAME
  Query.filmsByCast(cast.firstName:),                 public.actor,   first_name,   SQL_NAME
  Query.filmById(filmId:),                   public.film, film_id,      SQL_NAME
  Query.filmsByFilter(filter.inner.length:), public.film, length,       SQL_NAME
  Query.filmsByFilter(filter.releaseYear:),  public.film, release_year, SQL_NAME
  Query.filmsByFilter(filter.title:),        public.film, title,        SQL_NAME
  Query.filmsByKey(film_id:),                public.film, film_id,      SQL_NAME
  Query.filmsByKey(title:),                  public.film, title,        SQL_NAME
  Query.filmsByLengths(lengths:),            public.film, length,       SQL_NAME
  Query.filmsByRating(rating:),              public.film, rating,       SQL_NAME
  Query.filmsByRating(filter.ratings:),      public.film, rating,       SQL_NAME
  Query.filmsByTitle(title:),                public.film, title,        SQL_NAME
  Query.filmsByLengthAndTitlePrefix(length:), public.film, length,     SQL_NAME
  Query.filmsByTitleOverridden(title:),      public.film, title,        SQL_NAME
  Query.filmsByTitleBean(by.title:),         public.film, title,        SQL_NAME
  """)

# Every unwritten one reaches its column over an empty path, as does each input object it is read
# through; a written path is its steps.
extend schema @expectEquals(relation: "graphitron_path",
    where: "coordinate LIKE 'Query.%(%'", rows: """
  coordinate,                                      target_type, kind, origin
  Query.customersByCityId(cityId:),                Customer,    JOIN, WRITTEN
  Query.filmsByBridgedActorFirstName(firstName:),  Film,        JOIN, WRITTEN
  Query.filmsByCast(cast.firstName:),              Film,        JOIN, WRITTEN
  Query.filmsByCast(cast:),                        Film,        JOIN, EMPTY
  Query.filmActorsByNodeIds(ids:),                 FilmActor,   JOIN, EMPTY
  Query.filmByNodeId(id:),                         Film,        JOIN, EMPTY
  Query.filmsByNodeIds(ids:),                      Film,        JOIN, EMPTY
  Query.filmsByRating(rating:),                    Film,        JOIN, EMPTY
  Query.filmsByRating(filter.ratings:),            Film,        JOIN, EMPTY
  Query.filmsByRating(filter:),                    Film,        JOIN, EMPTY
  Query.inventoriesByFilm(filmId:),                Inventory,   JOIN, INFERRED
  Query.filmsByOptionalLanguage(pick.languageRef:), Film,       JOIN, WRITTEN
  Query.filmsByOptionalLanguage(pick:),            Film,        JOIN, EMPTY
  Query.filmsByLanguages(languageIds:),            Film,        JOIN, WRITTEN
  Query.filmsByLanguagesWithOriginal(languageIds:), Film,       JOIN, WRITTEN
  Query.filmsByLanguagesWithOriginal(originalId:), Film,        JOIN, WRITTEN
  Query.filmsByPickedLanguages(pick.languageIds:), Film,        JOIN, WRITTEN
  Query.filmsByPickedLanguages(pick:),             Film,        JOIN, EMPTY
  Query.projectNotesByProject(filter.projectId:),  ProjectNote, JOIN, INFERRED
  Query.projectNotesByProject(filter:),            ProjectNote, JOIN, EMPTY
  Query.filmById(filmId:),                   Film,        JOIN, EMPTY
  Query.filmsByFilter(filter.inner.length:), Film,        JOIN, EMPTY
  Query.filmsByFilter(filter.inner:),        Film,        JOIN, EMPTY
  Query.filmsByFilter(filter.releaseYear:),  Film,        JOIN, EMPTY
  Query.filmsByFilter(filter.title:),        Film,        JOIN, EMPTY
  Query.filmsByFilter(filter:),              Film,        JOIN, EMPTY
  Query.filmsByKey(film_id:),                Film,        JOIN, EMPTY
  Query.filmsByKey(title:),                  Film,        JOIN, EMPTY
  Query.filmsByLengths(lengths:),            Film,        JOIN, EMPTY
  Query.filmsByLengthAndTitlePrefix(length:), Film,       JOIN, EMPTY
  Query.filmsByLengthAndTitlePrefix(titlePrefix:), Film,  JOIN, EMPTY
  Query.filmsByTitleOverridden(title:),      Film,        JOIN, EMPTY
  Query.filmsByTitlePrefix(titlePrefix:),    Film,        JOIN, EMPTY
  Query.filmsByTitleBean(by.title:),         Film,        JOIN, EMPTY
  Query.filmsByTitleBean(by:),               Film,        JOIN, EMPTY
  Query.filmsByTitle(title:),                Film,        JOIN, EMPTY
  """)

# A @condition's bean is built from its input object as a service's is, its member matched on the
# field's own name, since @field there names the column a filter compares rather than a member.
extend schema @assertContains(relation: "graphitron_occurrence_built_class", rows: """
  coordinate,                  class_name,                                                     declared_via, member_names
  Query.filmsByTitleBean(by:), no.sikt.graphitron.rewrite.test.conditions.FilmTitleFilter,     PARAMETER,    GRAPHQL
  """)
extend schema @assertContains(relation: "graphitron_occurrence_binding_member", rows: """
  coordinate,                        bound
  Query.filmsByTitleBean(by.title:), no.sikt.graphitron.rewrite.test.conditions.FilmTitleFilter#title
  """)

# A condition's values land as its method and its bean take them, and fit: the member the record
# component is, and the String parameter the argument fills by type.
extend schema @expectEquals(relation: "graphitron_occurrence_value_slot",
    where: "coordinate IN ('Query.filmsByTitleBean(by.title:)', 'Query.filmsByTitleOverridden(title:)')", rows: """
  coordinate,                           kind,      stated_by, element_class,    takes_many, arrives_many, arrival_kind, fits
  Query.filmsByTitleBean(by.title:),    MEMBER,    CONDITION, java.lang.String, FALSE,      FALSE,        EXACT,        TRUE
  Query.filmsByTitleOverridden(title:), PARAMETER, CONDITION, java.lang.String, FALSE,      FALSE,        EXACT,        TRUE
  """)

# What each @condition says, as written, by the site it sits on: an object field's in one relation,
# an argument's or an input object field's in the other, and an override the author did not write
# NULL rather than the definition's false.
extend schema @expectEquals(relation: "graphitron_ast_field_condition_entry", rows: """
  source_line, method,                   override
  115,         filmTitlePrefixCondition, TRUE
  119,         filmTitleRecord,          TRUE
  123,         customerSeenByUser,
  132,         filmsOfOptionalLanguage,  TRUE
  144,         filmsOfLanguages,         TRUE
  154,         filmsOfLanguagesWithOriginal, TRUE
  161,         filmsOfLanguages,         TRUE
  """)

extend schema @expectEquals(relation: "graphitron_ast_input_value_condition_entry", rows: """
  source_line, method,                   override
  66,          projectNameAtlas,         TRUE
  106,         filmTitlePrefixCondition, TRUE
  110,         filmTitlePrefixCondition, TRUE
  """)
