# One input field's @reference path walked once per occurrence, from where its argument starts.
# CityFilter is passed to a field over customer and to one over staff; each reaches address by its own
# key, and from address the second element takes the one key to city whichever table the walk left
# from. The occurrence keeps the two walks apart, and the argument holding the input field, writing
# nothing, ends where it starts.

type Customer @table(name: "customer") { customerId: Int @field(name: "customer_id") }
type Staff @table(name: "staff") { staffId: Int @field(name: "staff_id") }

input CityFilter {
  inCity: String @field(name: "city") @reference(path: [{table: "address"}, {table: "city"}])
}

extend type Query {
  customers(filter: CityFilter): [Customer!]!
  staff(filter: CityFilter): [Staff!]!
}

extend schema @expectEquals(relation: "graphitron_join_path_step", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, element_place, from_table, to_table
  Query.customers(filter.inCity:), Customer, 0, 0, customer, address
  Query.customers(filter.inCity:), Customer, 1, 1, address, city
  Query.staff(filter.inCity:), Staff, 0, 0, staff, address
  Query.staff(filter.inCity:), Staff, 1, 1, address, city
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_inferred_key", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, position, constraint_name
  Query.customers(filter.inCity:), Customer, 0, customer_address_id_fkey
  Query.customers(filter.inCity:), Customer, 1, address_city_id_fkey
  Query.staff(filter.inCity:), Staff, 0, staff_address_id_fkey
  Query.staff(filter.inCity:), Staff, 1, address_city_id_fkey
  """)

extend schema @expectEquals(relation: "graphitron_join_path", where: "coordinate LIKE 'Query.%'", rows: """
  coordinate, target_type, target_table
  Query.customers(filter.inCity:), Customer, city
  Query.customers(filter:), Customer, customer
  Query.staff(filter.inCity:), Staff, city
  Query.staff(filter:), Staff, staff
  """)

