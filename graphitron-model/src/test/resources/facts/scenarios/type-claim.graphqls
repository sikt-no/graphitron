# What an author says a type stands for is its claim: rows of a table (TABLE_TYPE), or an error
# its handlers fill from an exception (ERROR_TYPE). A type claims where it is declared, whether or
# not any field reaches it, and an extension's directive claims for the type it extends. A type
# claiming both is a conflict, which the claims-conflict document holds. A type with no claiming
# directive has none.

type Film @table(name: "film") { title: String }

interface Content @table(name: "film") { title: String }

input FilmInput @table(name: "film") { title: String }

type FilmNotFound @error(handlers: [{handler: DATABASE}]) { message: String }

type Extended { title: String }
extend type Extended @table(name: "film")

type Plain { title: String }

extend type Query {
  films: [Film]
}

# The prelude's own claim is left out.
extend schema @expectEquals(relation: "graphitron_claim", where: """
  kind IN ('TABLE_TYPE', 'ERROR_TYPE') AND coordinate <> 'FactAnchor'
  """, rows: """
  coordinate,   kind,       priority
  Content,      TABLE_TYPE, 0
  Extended,     TABLE_TYPE, 0
  Film,         TABLE_TYPE, 0
  FilmInput,    TABLE_TYPE, 0
  FilmNotFound, ERROR_TYPE, 0
  """)
