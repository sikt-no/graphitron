# minted-element-sweep, read in steps: an element macro expansion mints lives as long as the
# application asking for it. Every emitted element row carries the reading that wrote it, and a
# reading drops what it did not write again, so a carrier that stops expanding takes its minted
# types, fields and arguments with it while what the reading still derives stays. A type whose kind
# changes is written again under the new kind, and its table binding with it. Each @withFacts writes
# the files of one reading, the clock moving between readings, and the claims after it check what
# that reading left.

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/minted-element-sweep/m-t0", as: "minted-element-sweep.m"}])

extend schema @expectEquals(relation: "graphitron_element", where: """
  coordinate IN ('Film', 'PageInfo', 'QueryFilmsConnection', 'QueryFilmsConnectionEdge',
                 'Query.films(first:)')
  """, rows: """
  coordinate,               element_kind,   touched_at
  Film,                     NAMED_TYPE,     1000000000
  PageInfo,                 NAMED_TYPE,     1000000000
  QueryFilmsConnection,     NAMED_TYPE,     1000000000
  QueryFilmsConnectionEdge, NAMED_TYPE,     1000000000
  Query.films(first:),      FIELD_ARGUMENT, 1000000000
  """)

extend schema @expectEquals(relation: "graphitron_type", where: "type_name = 'Film'", rows: """
  type_name, kind
  Film,      OBJECT
  """)

extend schema @expectEquals(relation: "graphitron_tabletype", where: "type_name = 'Film'", rows: """
  type_name, named_type_kind, table_name
  Film,      OBJECT,          film
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/minted-element-sweep/m-t60", as: "minted-element-sweep.m"}])

# Nothing mints them now, so this reading does not write them and they go; Film, which it still
# derives, stays under this reading's mark.
extend schema @expectEquals(relation: "graphitron_element", where: """
  coordinate IN ('Film', 'PageInfo', 'QueryFilmsConnection', 'QueryFilmsConnectionEdge',
                 'Query.films(first:)')
  """, rows: """
  coordinate, element_kind, touched_at
  Film,       NAMED_TYPE,   1000000060
  """)

extend schema @assertEmpty(relation: "graphitron_type_minted")

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/minted-element-sweep/m-t120", as: "minted-element-sweep.m"}])

extend schema @expectEquals(relation: "graphitron_type", where: "type_name = 'Film'", rows: """
  type_name, kind
  Film,      INTERFACE
  """)

extend schema @expectEquals(relation: "graphitron_tabletype", where: "type_name = 'Film'", rows: """
  type_name, named_type_kind, table_name
  Film,      INTERFACE,       film
  """)
