# A @nodeId argument on a field returning a union of three tables, each declaring its own foreign key
# to the node type's table and all three pairing the same two column names. Each branch is its own
# path and its own pairing, and the node id binds the node's key positions once, not once per branch.

interface Node { id: ID! }

type Project implements Node @table(name: "project") @node {
  id: ID!
}

type ProjectNote @table(name: "project_note") { body: String }
type ProjectEvent @table(name: "project_event") { summary: String }
type DescribeHub @table(name: "describe_hub") { hubCode: String @field(name: "hub_code") }

union ProjectRecord = ProjectNote | ProjectEvent | DescribeHub

type Query {
  projectRecords(ofProject: ID @nodeId(typeName: "Project")): [ProjectRecord]
}

extend schema @expectEquals(relation: "graphitron_join_path_step_column", where: "coordinate = 'Query.projectRecords(ofProject:)'", rows: """
  target_type,  position, ordinal, from_table,    from_column, to_table, to_column
  DescribeHub,  0,        0,       describe_hub,  org_id,      project,  org_id
  DescribeHub,  0,        1,       describe_hub,  project_id,  project,  project_id
  ProjectEvent, 0,        0,       project_event, org_id,      project,  org_id
  ProjectEvent, 0,        1,       project_event, project_id,  project,  project_id
  ProjectNote,  0,        0,       project_note,  org_id,      project,  org_id
  ProjectNote,  0,        1,       project_note,  project_id,  project,  project_id
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate = 'Query.projectRecords(ofProject:)'", rows: """
  bound,          position, node_type_name, column_name
  public.project, 0,        Project,        org_id
  public.project, 1,        Project,        project_id
  """)
