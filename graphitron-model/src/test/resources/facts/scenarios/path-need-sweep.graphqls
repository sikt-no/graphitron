# path-need-sweep, read in steps: each @withFacts writes the files of one reading, the clock
# moving between readings, and the claims after it check what that reading left.

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/path-need-sweep/a-t0", as: "path-need-sweep.a"}])

extend schema @expectEquals(relation: "graphitron_path_need", where: """
  coordinate LIKE 'Customer.%' OR coordinate LIKE 'Query.customers%'
  """, rows: """
  coordinate,               target_type, start_table, landing_table, touched_at
  Customer.address,         Address,     customer,    address,       1000000000
  Customer.firstName,       String,      customer,    customer,      1000000000
  Query.customers(first:),  Customer,    customer,    customer,      1000000000
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/path-need-sweep/a-t60", as: "path-need-sweep.a"}])

extend schema @expectEquals(relation: "graphitron_path_need", where: """
  coordinate LIKE 'Customer.%' OR coordinate LIKE 'Query.customers%'
  """, rows: """
  coordinate,               target_type, start_table, landing_table, touched_at
  Customer.firstName,       String,      customer,    customer,      1000000060
  Query.customers(first:),  Customer,    customer,    customer,      1000000060
  """)

extend schema @assertEmpty(relation: "graphitron_path_need", where: """
  coordinate = 'Customer.address'
  """)
