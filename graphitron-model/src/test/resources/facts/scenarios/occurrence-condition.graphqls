# A @condition is a call per table its occurrence binds: a field's rows' table, each participant's on
# a multitable field, an argument's column's table, or the table a scalar it takes lands on. The
# overload called on a table is the one whose table parameter takes that table by its own class, else
# the one taking any table; the table parameter is filled with the table the call is applied to.

type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }
type Film @table(name: "film") { title: String }
type Customer @table(name: "customer") { firstName: String @field(name: "first_name") }
type Staff @table(name: "staff") { firstName: String @field(name: "first_name") }

union AddressOccupant = Customer | Staff

input FilmTitleInput { title: String }
scalar BigDecimal @scalarType(scalar: "graphql.scalars.ExtendedScalars.GraphQLBigDecimal")
input RentalRateRange { fra: BigDecimal  til: BigDecimal }
input FilmRentalRangeFilter {
  rentalRateRange: RentalRateRange @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "rentalRateRange"}, override: true)
}
input FilmPrefixInput { titlePrefix: String }
# Bounds named apart from the parameters they fill, so only the argMapping can bind them.
input RentalRateBounds { fraVerdi: BigDecimal  tilVerdi: BigDecimal }
input FilmRentalBoundsFilter {
  bounds: RentalRateBounds @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "rentalRateRange", argMapping: "fra: bounds.fraVerdi, til: bounds.tilVerdi"}, override: true)
}

type Query {
  # On the field: one call, on the field's own table.
  actorsM: [Actor!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.MultiTableConditionFixtures",
      method: "firstNameStartsWithM"})
  # On a scalar argument no column takes: one call, on the table the argument lands on.
  filmsByPrefix(titlePrefix: String @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition"}, override: true)): [Film!]!
  # On an argument whose column each participant has: one call per participant's table, each
  # calling the declaration taking that table.
  occupantsByTypedNamePrefix(firstName: String @field(name: "first_name") @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.MultiTableConditionFixtures",
      method: "occupantTypedNamePrefix"}, override: true)): [AddressOccupant!]!
  # A table's own declaration where there is one, the one taking any table where there is not.
  occupantsByMixedNamePrefix(firstName: String @field(name: "first_name") @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.MultiTableConditionFixtures",
      method: "occupantMixedNamePrefix"})): [AddressOccupant!]!

  # The fills, the first that applies. A pair's path.
  filmsByPath(filter: FilmPrefixInput): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition", argMapping: "titlePrefix: filter.titlePrefix"}, override: true)
  # By type, one and one: an input object and a bean nothing else in it could be.
  filmsByBean(input: FilmTitleInput): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.BeanConditionFixtures",
      method: "filmTitleRecord"}, override: true)
  # By type, a Java type once on each side.
  filmsByType(title: String): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition"}, override: true)
  # By type, one level into an input object by name and type.
  filmsByField(filter: FilmPrefixInput): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmTitlePrefixCondition"}, override: true)
  # On an input field: one level into it by name and type, a custom scalar's class its @scalarType's.
  filmsByRentalRateRange(filter: FilmRentalRangeFilter): [Film!]!
  # On an input field, its input object's fields through argMapping, the head the field's own name.
  filmsByRentalRateBounds(filter: FilmRentalBoundsFilter): [Film!]!
  # A contextArguments key of the parameter's name.
  customersSeen: [Customer!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "customerSeenByUser"}, contextArguments: ["userId"])
}

extend schema @expectEquals(relation: "graphitron_occurrence_condition", rows: """
  coordinate,                                   bound,           call,                     override_written
  Query.actorsM,                                public.actor,    condition:public.actor,    FALSE
  Query.customersSeen,                          public.customer, condition:public.customer, FALSE
  Query.filmsByBean,                            public.film,     condition:public.film,     TRUE
  Query.filmsByField,                           public.film,     condition:public.film,     TRUE
  Query.filmsByPath,                            public.film,     condition:public.film,     TRUE
  Query.filmsByPrefix(titlePrefix:),            public.film,     condition:public.film,     TRUE
  Query.filmsByRentalRateBounds(filter.bounds:), public.film,    condition:public.film,     TRUE
  Query.filmsByRentalRateRange(filter.rentalRateRange:), public.film, condition:public.film, TRUE
  Query.filmsByType,                            public.film,     condition:public.film,     TRUE
  Query.occupantsByMixedNamePrefix(firstName:), public.customer, condition:public.customer, FALSE
  Query.occupantsByMixedNamePrefix(firstName:), public.staff,    condition:public.staff,    FALSE
  Query.occupantsByTypedNamePrefix(firstName:), public.customer, condition:public.customer, TRUE
  Query.occupantsByTypedNamePrefix(firstName:), public.staff,    condition:public.staff,    TRUE
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_call_method", where: "call_kind = 'CONDITION'", rows: """
  coordinate,                                   call,                      method_name,               method_descriptor
  Query.actorsM,                                condition:public.actor,    firstNameStartsWithM,      (Lorg/jooq/Table;)Lorg/jooq/Condition;
  Query.customersSeen,                          condition:public.customer, customerSeenByUser,        (Lno/sikt/graphitron/rewrite/test/jooq/public_/tables/Customer;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.filmsByBean,                            condition:public.film,     filmTitleRecord,           (Lorg/jooq/Table;Lno/sikt/graphitron/rewrite/test/conditions/FilmTitleFilter;)Lorg/jooq/Condition;
  Query.filmsByField,                           condition:public.film,     filmTitlePrefixCondition,  (Lorg/jooq/Table;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.filmsByPath,                            condition:public.film,     filmTitlePrefixCondition,  (Lorg/jooq/Table;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.filmsByPrefix(titlePrefix:),            condition:public.film,     filmTitlePrefixCondition,  (Lorg/jooq/Table;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.filmsByRentalRateBounds(filter.bounds:), condition:public.film, rentalRateRange, (Lorg/jooq/Table;Ljava/math/BigDecimal;Ljava/math/BigDecimal;)Lorg/jooq/Condition;
  Query.filmsByRentalRateRange(filter.rentalRateRange:), condition:public.film, rentalRateRange, (Lorg/jooq/Table;Ljava/math/BigDecimal;Ljava/math/BigDecimal;)Lorg/jooq/Condition;
  Query.filmsByType,                            condition:public.film,     filmTitlePrefixCondition,  (Lorg/jooq/Table;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.occupantsByMixedNamePrefix(firstName:), condition:public.customer, occupantMixedNamePrefix,   (Lno/sikt/graphitron/rewrite/test/jooq/public_/tables/Customer;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.occupantsByMixedNamePrefix(firstName:), condition:public.staff,    occupantMixedNamePrefix,   (Lorg/jooq/Table;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.occupantsByTypedNamePrefix(firstName:), condition:public.customer, occupantTypedNamePrefix,   (Lno/sikt/graphitron/rewrite/test/jooq/public_/tables/Customer;Ljava/lang/String;)Lorg/jooq/Condition;
  Query.occupantsByTypedNamePrefix(firstName:), condition:public.staff,    occupantTypedNamePrefix,   (Lno/sikt/graphitron/rewrite/test/jooq/public_/tables/Staff;Ljava/lang/String;)Lorg/jooq/Condition;
  """)

# The table parameter takes the table the call is applied to.
extend schema @assertContains(relation: "graphitron_occurrence_call_parameter", rows: """
  coordinate,                                   call,                      position, fill
  Query.actorsM,                                condition:public.actor,    0,        TABLE
  Query.filmsByPrefix(titlePrefix:),            condition:public.film,     0,        TABLE
  Query.occupantsByTypedNamePrefix(firstName:), condition:public.customer, 0,        TABLE
  Query.occupantsByTypedNamePrefix(firstName:), condition:public.staff,    0,        TABLE
  """)

# What fills each condition parameter that is not the table.
extend schema @expectEquals(relation: "graphitron_occurrence_call_parameter",
    where: "call_kind = 'CONDITION' AND fill <> 'TABLE'", rows: """
  coordinate,                                   call,                      position, fill,        landing_coordinate,                           context_key
  Query.customersSeen,                          condition:public.customer, 1,        CONTEXT_KEY, ,                                             userId
  Query.filmsByBean,                            condition:public.film,     1,        ARGUMENT,    Query.filmsByBean(input:),
  Query.filmsByField,                           condition:public.film,     1,        ARGUMENT,    Query.filmsByField(filter.titlePrefix:),
  Query.filmsByPath,                            condition:public.film,     1,        ARGUMENT,    Query.filmsByPath(filter.titlePrefix:),
  Query.filmsByPrefix(titlePrefix:),            condition:public.film,     1,        ARGUMENT,    Query.filmsByPrefix(titlePrefix:),
  Query.filmsByRentalRateBounds(filter.bounds:), condition:public.film, 1, ARGUMENT, Query.filmsByRentalRateBounds(filter.bounds.fraVerdi:),
  Query.filmsByRentalRateBounds(filter.bounds:), condition:public.film, 2, ARGUMENT, Query.filmsByRentalRateBounds(filter.bounds.tilVerdi:),
  Query.filmsByRentalRateRange(filter.rentalRateRange:), condition:public.film, 1, ARGUMENT, Query.filmsByRentalRateRange(filter.rentalRateRange.fra:),
  Query.filmsByRentalRateRange(filter.rentalRateRange:), condition:public.film, 2, ARGUMENT, Query.filmsByRentalRateRange(filter.rentalRateRange.til:),
  Query.filmsByType,                            condition:public.film,     1,        ARGUMENT,    Query.filmsByType(title:),
  Query.occupantsByMixedNamePrefix(firstName:), condition:public.customer, 1,        ARGUMENT,    Query.occupantsByMixedNamePrefix(firstName:),
  Query.occupantsByMixedNamePrefix(firstName:), condition:public.staff,    1,        ARGUMENT,    Query.occupantsByMixedNamePrefix(firstName:),
  Query.occupantsByTypedNamePrefix(firstName:), condition:public.customer, 1,        ARGUMENT,    Query.occupantsByTypedNamePrefix(firstName:),
  Query.occupantsByTypedNamePrefix(firstName:), condition:public.staff,    1,        ARGUMENT,    Query.occupantsByTypedNamePrefix(firstName:),
  """)

extend schema @assertContains(relation: "code_scalar_constant", rows: """
  class_name,                      field_name,        input_type
  graphql.scalars.ExtendedScalars, GraphQLBigDecimal, java.math.BigDecimal
  """)

# The class each scalar arrives as: a built-in's by graphql-java, BigDecimal's by the constant its
# @scalarType names.
extend schema @assertContains(relation: "graphitron_scalar_class", rows: """
  type_name,  java_class
  BigDecimal, java.math.BigDecimal
  String,     java.lang.String
  """)

# The type each element a condition could bind takes, and the class it arrives as: an input object
# none, the custom scalar inside it its @scalarType's.
extend schema @assertContains(relation: "graphitron_occurrence_input_type", rows: """
  coordinate,                                                type_name,       type_kind,    is_list, java_class
  Query.filmsByRentalRateRange(filter.rentalRateRange:),     RentalRateRange, INPUT_OBJECT, FALSE,
  Query.filmsByRentalRateRange(filter.rentalRateRange.fra:), BigDecimal,      SCALAR,       FALSE,   java.math.BigDecimal
  Query.filmsByType(title:),                                 String,          SCALAR,       FALSE,   java.lang.String
  """)

# The bounds' fills came from the argMapping's pairs, a parameter filled by name having no row; and
# their input object builds into no class, the call taking its fields one by one.
extend schema @expectEquals(relation: "graphitron_occurrence_call_parameter_pair",
    where: "coordinate LIKE 'Query.filmsByRentalRate%'", rows: """
  coordinate,                                    call,                  position, target_name
  Query.filmsByRentalRateBounds(filter.bounds:), condition:public.film, 1,        fra
  Query.filmsByRentalRateBounds(filter.bounds:), condition:public.film, 2,        til
  """)
extend schema @assertAbsent(relation: "graphitron_occurrence_built_class", rows: """
  coordinate
  Query.filmsByRentalRateBounds(filter.bounds:)
  """)
