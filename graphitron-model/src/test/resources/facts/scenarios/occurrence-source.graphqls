# What each occurrence's values come from, stated on the occurrence: rows of one or more tables, or an
# instance of a class. A field of a table-bound type, an interface's included, reads that table, and
# a root @routine the table its function returns. A root field with nothing else written has no
# source. A nested field reads what its parent's producer hands back: a table record is rows of its
# table, the field's key row's where it has one, else the record class's; a class that is no table's
# record is an object source, a key row of kind COLUMNS still giving the field its table. A field
# nested in a plain type reads its parent's tables, or, where its parent field writes a path, the
# tables that path's join path lands on, and under an object source a field has none yet. A write's payload is what the write produces: a payload field
# with a table-bound target is lifted from the keys the write returned and reads its target's table,
# and any other payload field, an id list among them, has none until that result is stated. An
# argument reads its field's target tables, each member's for a union, the write's table for a write
# whose target binds none, and its field's own tables where the target binds none, or, where its
# field writes a path, the tables that path's join path lands on; an input field reads its parent's.
# A connection's fields hang under the field returning it and read the page its producer produces,
# which no table source states, so they have none yet; its arguments read the element's table.

interface MediaItem @table(name: "film") @discriminate(on: "text_rating") {
  title: String
}

type Film implements MediaItem @table(name: "film") @discriminator(value: "G") {
  title: String
  details: FilmDetails
  # A scalar that writes a path: its arguments read where its join path lands, language.
  languageName(upper: Boolean): String
    @reference(path: [{key: "film_language_id_fkey"}]) @field(name: "name")
  # A plain type reached by a written path: its fields read where its join path lands,
  # film_translation.
  titleTexts: TranslatedTexts
    @reference(path: [{table: "film_translation"}])
    @pivot(on: "lang_code", value: "title_txt", vocabulary: "PivotLang")
  # A connection under a table-bound parent, its path inferred from film_actor's one key to film, split
  # into its own query as the generator requires of a connection on a table field.
  actorRows: [FilmActor!]! @asConnection @splitQuery
}

type FilmActor @table(name: "film_actor") { actorId: Int @field(name: "actor_id") }

type FilmDetails { length: Int }

enum PivotLang {
  nn @field(name: "nno")
  en @field(name: "eng")
}

type TranslatedTexts { nn: String en: String }

interface Node { id: ID! }

type Language implements Node @table(name: "language") @node { id: ID! name: String }

union Searchable = Film | Language

input FilmFilter {
  title: String
  span: YearSpan
}

input YearSpan { from: Int @field(name: "release_year") }

type Row { title: String }

# Backed by the FilmRecord list the service hands back: filmId reads the record, language its key row.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# Backed by the FilmRecord the service hands back, whose film field refetches by its key row.
type FilmServicePayload {
  film: Film
}

# A plain class whose films() returns FilmRecords: an ACCESSOR key row, so films reads the object.
type CreateFilmsPayload {
  films: [Film!]!
}

# A plain class whose blurb() is what blurb reads.
type FilmBlurbHolder {
  blurb: FilmBlurb
}

type FilmBlurb { description: String }

input FilmInput @table(name: "film") { title: String }

type FilmInvalid @error(handlers: [{handler: DATABASE}]) { path: [String!]!, message: String! }
union FilmFailure = FilmInvalid

type AddFilmOutcome { film: Film, errors: [FilmFailure] }

input LanguageDeleteInput { languageId: Int! @field(name: "language_id") }

# A delete's payload: the ids of the deleted languages, which read off what the write produced.
type DeletedLanguagesPayload { deletedIds: [ID!] }

type Query {
  films(filter: FilmFilter, first: Int): [Film!]!
  search(languageId: Int @field(name: "language_id")): [Searchable]
  topMedia(title: String): MediaItem
  rows(actorId: Int!, minLength: Int!): [Row!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @defaultOrder(fields: [{name: "film_id"}])
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  serviceFilmById(id: Int!): FilmServicePayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  recentlyCreatedFilmsBatched: [CreateFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CreateFilmsPayloadService", method: "recentlyCreatedFilmsBatched"})
  filmBlurbHolder(filmId: Int!): FilmBlurbHolder
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmBlurbHolderService", method: "byId"})
}

type Mutation {
  addFilm(input: FilmInput): AddFilmOutcome @mutation(typeName: INSERT)
  deleteLanguages(in: [LanguageDeleteInput!]!): DeletedLanguagesPayload
    @mutation(typeName: DELETE, table: "language")
  # A write returning a scalar binds no table either; its arguments read the table it mutates.
  deleteLanguage(in: LanguageDeleteInput!): ID @mutation(typeName: DELETE, table: "language")
}

extend schema @expectEquals(relation: "graphitron_occurrence_source",
    where: "coordinate NOT IN ('Query.anchor', 'FactAnchor.paymentId')", rows: """
  coordinate,                                kind
  Film.actorRows,                            TABLE
  Film.actorRows(after:),                    TABLE
  Film.actorRows(first:),                    TABLE
  FilmActor.actorId,                         TABLE
  Film.details,                              TABLE
  Film.details.length,                       TABLE
  Film.titleTexts,                           TABLE
  Film.titleTexts.en,                        TABLE
  Film.titleTexts.nn,                        TABLE
  Film.languageName,                         TABLE
  Film.languageName(upper:),                 TABLE
  Film.title,                                TABLE
  Language.id,                               TABLE
  Language.name,                             TABLE
  MediaItem.title,                           TABLE
  Mutation.addFilm(input:),                  TABLE
  Mutation.addFilm(input.title:),            TABLE
  Mutation.addFilm.film,                     TABLE
  Mutation.deleteLanguage(in:),              TABLE
  Mutation.deleteLanguage(in.languageId:),   TABLE
  Mutation.deleteLanguages(in:),             TABLE
  Mutation.deleteLanguages(in.languageId:),  TABLE
  Query.filmBlurbHolder.blurb,               OBJECT
  Query.filmDetailsBatch.filmId,             TABLE
  Query.filmDetailsBatch.language,           TABLE
  Query.films(filter:),                      TABLE
  Query.films(filter.span:),                 TABLE
  Query.films(filter.span.from:),            TABLE
  Query.films(filter.title:),                TABLE
  Query.films(first:),                       TABLE
  Query.recentlyCreatedFilmsBatched.films,   OBJECT
  Query.rows,                                TABLE
  Query.rows(actorId:),                      TABLE
  Query.rows(minLength:),                    TABLE
  Query.rows.title,                          TABLE
  Query.search(languageId:),                       TABLE
  Query.serviceFilmById.film,                TABLE
  Query.topMedia(title:),                   TABLE
  """)

