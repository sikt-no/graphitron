extend schema @expectEquals(relation: "graphitron_occurrence_source_object",
    where: "coordinate NOT IN ('Query.anchor', 'FactAnchor.paymentId')", rows: """
  coordinate,                               class_name,                                                   class_name_ref
  Query.filmBlurbHolder.blurb,              no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder,     no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder
  Query.recentlyCreatedFilmsBatched.films,  no.sikt.graphitron.rewrite.test.services.CreateFilmsPayload,  no.sikt.graphitron.rewrite.test.services.CreateFilmsPayload
  """)

# Occurrences that stand with no source: a root field with no @routine, its arguments where the target
# binds no table, an errors field, a write payload's field whose target binds no table, and a field
# read off an object source, and a connection's fields.
extend schema @assertContains(relation: "graphitron_occurrence", rows: """
  coordinate
  Query.films
  Query.filmBlurbHolder(filmId:)
  Mutation.addFilm.errors
  Mutation.deleteLanguages.deletedIds
  Query.filmBlurbHolder.blurb.description
  Film.actorRows.edges
  Film.actorRows.edges.node
  Film.actorRows.nodes
  Film.actorRows.pageInfo
  Film.actorRows.totalCount
  """)

extend schema @assertAbsent(relation: "graphitron_occurrence_source", rows: """
  coordinate
  Query.films
  Query.filmBlurbHolder(filmId:)
  Mutation.addFilm.errors
  Mutation.deleteLanguages.deletedIds
  Query.filmBlurbHolder.blurb.description
  Film.actorRows.edges
  Film.actorRows.edges.node
  Film.actorRows.nodes
  Film.actorRows.pageInfo
  Film.actorRows.totalCount
  """)
