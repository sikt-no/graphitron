# Which key column a parameter takes out of a node id: the one the path names past the @nodeId slot
# it opens, whether the slot is the argument's or an input field an input object leads onto. Nothing
# infers one, though the node's key has one column. filmsByNamed names film_id past its slot;
# filmsByPicked descends through pick onto film and names film_id past it. A routine parameter takes
# one value the same way: rentFilmProjected names customer_id past its Customer id. The projection is
# a fact of the argMapping landing, and each fill a pair wrote states it. Off a list of ids a
# projection is the list of that column across the decoded ids, at every @condition site:
# filmsByIdList names film_id past a list of Film ids at the field, filmsByPickedList past one an
# input object leads onto, filmsByKeyList at the argument, and FilmKeysFilter.films at an input
# field, each parameter a List<Integer>.

interface Node { id: ID! }

type Film implements Node @table(name: "film") @node {
  id: ID!
  title: String
}

type Customer implements Node @table(name: "customer") @node {
  id: ID!
}

type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }

input FilmPick { film: ID @nodeId(typeName: "Film") }

input FilmListPick { films: [ID!] @nodeId(typeName: "Film") }

input FilmKeysFilter {
  films: [ID!] @nodeId(typeName: "Film") @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
      method: "filmKeysIn", argMapping: "filmIds: films.film_id"}, override: true)
}

type Query {
  filmsByNamed(id: ID @nodeId(typeName: "Film")): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals", argMapping: "filmId: id.film_id"}, override: true)
  filmsByPicked(pick: FilmPick): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures",
      method: "filmIdKeyEquals", argMapping: "filmId: pick.film.film_id"}, override: true)
  filmsByKeys(filter: FilmKeysFilter): [Film!]!
  filmsByIdList(ids: [ID!] @nodeId(typeName: "Film")): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
      method: "filmKeysIn", argMapping: "filmIds: ids.film_id"}, override: true)
  filmsByPickedList(pick: FilmListPick): [Film!]! @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
      method: "filmKeysIn", argMapping: "filmIds: pick.films.film_id"}, override: true)
  filmsByKeyList(ids: [ID!] @nodeId(typeName: "Film") @condition(condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ProjectedKeyConditionFixtures",
      method: "filmKeysIn", argMapping: "filmIds: ids.film_id"}, override: true)): [Film!]!
}

type Mutation {
  rentFilmProjected(inventoryId: Int!, customerId: ID! @nodeId(typeName: "Customer")): [Rental!]!
    @routine(name: "rent_film", argMapping: "pInventoryId: inventoryId, pCustomerId: customerId.customer_id")
    @reference(path: [{table: "rental"}])
}

# Whether each written path descends past the slot it opens, and so what it hands over.
extend schema @expectEquals(relation: "graphitron_argmapping_landing",
    where: "directive_name = 'condition'", rows: """
  call_coordinate,     landing_coordinate,              trailing_name, descends, receives
  Query.filmsByNamed,  Query.filmsByNamed(id:),         film_id,       FALSE,    COLUMN
  Query.filmsByPicked, Query.filmsByPicked(pick.film:), film_id,       TRUE,     COLUMN
  Query.filmsByKeys(filter.films:), Query.filmsByKeys(filter.films:), film_id, FALSE, COLUMN
  Query.filmsByIdList, Query.filmsByIdList(ids:),       film_id,       FALSE,    COLUMN
  Query.filmsByPickedList, Query.filmsByPickedList(pick.films:), film_id, TRUE, COLUMN
  Query.filmsByKeyList(ids:), Query.filmsByKeyList(ids:), film_id,  FALSE,    COLUMN
  """)

# The key column each projecting landing takes.
extend schema @expectEquals(relation: "graphitron_argmapping_landing_key_column",
    where: "directive_name = 'condition'", rows: """
  call_coordinate,     landing_coordinate,              bound,       position
  Query.filmsByNamed,  Query.filmsByNamed(id:),         public.film, 0
  Query.filmsByPicked, Query.filmsByPicked(pick.film:), public.film, 0
  Query.filmsByKeys(filter.films:), Query.filmsByKeys(filter.films:), public.film, 0
  Query.filmsByIdList, Query.filmsByIdList(ids:),       public.film, 0
  Query.filmsByPickedList, Query.filmsByPickedList(pick.films:), public.film, 0
  Query.filmsByKeyList(ids:), Query.filmsByKeyList(ids:), public.film, 0
  """)

# The fills a written pair made state it.
extend schema @expectEquals(relation: "graphitron_occurrence_call_parameter_pair",
    where: "coordinate LIKE 'Query.films%'", rows: """
  coordinate,          call,                  position, target_name
  Query.filmsByNamed,  condition:public.film, 1,        filmId
  Query.filmsByPicked, condition:public.film, 1,        filmId
  Query.filmsByKeys(filter.films:), condition:public.film, 1, filmIds
  Query.filmsByIdList, condition:public.film, 1,        filmIds
  Query.filmsByPickedList, condition:public.film, 1,    filmIds
  Query.filmsByKeyList(ids:), condition:public.film, 1, filmIds
  """)

# A pair naming a key column past the node id at a routine parameter takes that column; the plain
# inventoryId beside it takes its value.
extend schema @expectEquals(relation: "graphitron_argmapping_landing",
    where: "directive_name = 'routine'", rows: """
  target_name,  landing_coordinate,                  trailing_name, descends, receives
  pInventoryId, Mutation.rentFilmProjected(inventoryId:), ,              FALSE,    WHOLE
  pCustomerId,  Mutation.rentFilmProjected(customerId:),  customer_id,    FALSE,    COLUMN
  """)

# Customer's key column, as the path names it.
extend schema @expectEquals(relation: "graphitron_argmapping_landing_key_column",
    where: "directive_name = 'routine'", rows: """
  target_name, landing_coordinate,                 bound,           position
  pCustomerId, Mutation.rentFilmProjected(customerId:), public.customer, 0
  """)

# The routine parameter is the id's slot, at the binding type the catalog states, and takes the
# projected column's value.
extend schema @assertContains(relation: "graphitron_occurrence_node_id_slot", rows: """
  coordinate,                         kind,      list_depth, slot_shape, landing_class
  Mutation.rentFilmProjected(customerId:), PARAMETER, 0,          SINGLE,     java.lang.Integer
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_node_id_slot_projection",
    where: "call_coordinate = 'Mutation.rentFilmProjected'", rows: """
  call,     position, coordinate,                         bound,           key_position
  producer, 1,        Mutation.rentFilmProjected(customerId:), public.customer, 0
  """)

extend schema @assertContains(relation: "graphitron_occurrence_node_id_shape", rows: """
  coordinate,                         bound,           decode_shape
  Mutation.rentFilmProjected(customerId:), public.customer, KEY_VALUE
  """)

# A list of ids opened with its key column, or descended onto, lands on a slot one list deep, and its
# parameter takes the column of each decoded id: the slot projection and the KEY_VALUE shape, at the
# List<Integer> each @condition declares.
extend schema @assertContains(relation: "graphitron_occurrence_node_id_slot", rows: """
  coordinate,                                 kind,      list_depth
  Query.filmsByKeys(filter.films:),           PARAMETER, 1
  Query.filmsByIdList(ids:),                  PARAMETER, 1
  Query.filmsByPickedList(pick.films:),       PARAMETER, 1
  Query.filmsByKeyList(ids:),                 PARAMETER, 1
  """)

extend schema @assertContains(relation: "graphitron_occurrence_node_id_slot_projection", rows: """
  coordinate,                       position, bound,       key_position
  Query.filmsByKeys(filter.films:), 1,        public.film, 0
  Query.filmsByIdList(ids:),        1,        public.film, 0
  Query.filmsByPickedList(pick.films:), 1,    public.film, 0
  Query.filmsByKeyList(ids:),       1,        public.film, 0
  """)

extend schema @assertContains(relation: "graphitron_occurrence_node_id_shape", rows: """
  coordinate,                       bound,       decode_shape
  Query.filmsByKeys(filter.films:), public.film, KEY_VALUE
  Query.filmsByIdList(ids:),        public.film, KEY_VALUE
  Query.filmsByPickedList(pick.films:), public.film, KEY_VALUE
  Query.filmsByKeyList(ids:),       public.film, KEY_VALUE
  """)

# A node id reaches the parameter it binds decoded into its record, the parameter taking the key
# column the pair names past it.
extend schema @assertContains(relation: "graphitron_occurrence_binding_extraction", rows: """
  coordinate,                              extraction,     component
  Mutation.rentFilmProjected(customerId:), NODE_ID_RECORD, customer_id
  Query.filmsByIdList(ids:),               NODE_ID_RECORD, film_id
  """)
