# Deprecation is one fact with two markers. GraphQL forbids @deprecated on a directive definition and
# admits it on the definition's arguments, so graphitron says the first with a token standing on its
# own in the description, the prose around it being the reason, and the store captures both rather
# than leaving a reader to match a pattern. The bundled vocabulary is read with every corpus, so its
# own two docstring deprecations are rows here too: the two the convention exists for.
extend schema @withFacts(docs: [{path: "layouts/anchor"}])

"@deprecated use @sortBy(index:) instead"
directive @legacySort(name: String) on ENUM_VALUE

"Connect this enum value to a sorting specification."
directive @sortBy(index: String) on ENUM_VALUE

"write to my@deprecated.example for the migration guide"
directive @keep(name: String) on ENUM_VALUE

directive @paged(
  defaultFirstValue: Int
  pagedName: String @deprecated(reason: "own your Connection type")
) on FIELD_DEFINITION

directive @bare(legacy: String @deprecated) on FIELD_DEFINITION

# The marked directive and the marked arguments, each under the coordinate naming it; the directive
# beside the marked one has a description too, and a token inside a word marks nothing.
extend schema @expectEquals(relation: "graphitron_deprecated",
    where: """
  (coordinate LIKE '@legacySort%' OR coordinate LIKE '@sortBy%' OR coordinate LIKE '@keep%'
    OR coordinate LIKE '@paged%' OR coordinate LIKE '@bare%') AND reason <> ''
  """, rows: """
  coordinate,         reason
  @legacySort,        @deprecated use @sortBy(index:) instead
  @paged(pagedName:), own your Connection type
  """)

# A marker with no reason still deprecates, and stores the empty string rather than a null.
extend schema @expectEquals(relation: "graphitron_deprecated", where: "reason = ''", rows: """
  coordinate
  @bare(legacy:)
  """)

# @index is the deprecated alias of @order(index:) and @record no longer binds anything, and both say
# so in prose because GraphQL gives them nowhere else to say it.
extend schema @assertContains(relation: "graphitron_deprecated", rows: """
  coordinate
  @index
  @record
  """)
