# element-declaration, read in steps: each @withFacts writes the files of one reading, the clock
# moving between readings, and the claims after it check what that reading left.

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/element-declaration/shelf-t0", as: "element-declaration.shelf"}])

extend schema @expectEquals(relation: "graphql_ast_element_entry", where: "coordinate IN ('Shelf', 'Shelf.books', 'Shelf.books(first:)', 'ShelfInput', 'ShelfInput.name', 'Size', 'Size.SMALL', '@shelved', '@shelved(at:)')", rows: """
  coordinate,          declaration_kind,     declaration_line, declaration_column
  Shelf,               TYPE_DECLARATION,     5,                1
  Shelf.books,         TYPE_DECLARATION,     5,                1
  Shelf.books(first:), TYPE_DECLARATION,     5,                1
  ShelfInput,          TYPE_DECLARATION,     9,                1
  ShelfInput.name,     TYPE_DECLARATION,     9,                1
  Size,                TYPE_DECLARATION,     13,               1
  Size.SMALL,          TYPE_DECLARATION,     13,               1
  @shelved,            DIRECTIVE_DEFINITION, 17,               1
  @shelved(at:),       DIRECTIVE_DEFINITION, 17,               1
  """)

# The schema block the file declares is its own declaration too.
extend schema @assertContains(relation: "graphql_ast_element_entry", rows: """
  coordinate, source_line, declaration_kind,  declaration_line, declaration_column
  $schema,    19,          SCHEMA_DEFINITION, 19,               1
  """)
