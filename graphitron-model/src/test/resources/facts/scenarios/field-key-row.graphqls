# A producer that fetches its own rows under a parent holding an object takes the keys off that
# object, and how is stated per producer, as its fill. COLUMNS reads them as columns: the target's
# own key where the object is what a service produced of that table (a re-fetch), or the first key's
# columns where a path departs from a table's record. ACCESSOR takes the table records a member of
# the object returns: of the target's table, or of the table a union's members hang off.

# A service under a table row takes its keys off that row, its fill naming the row's table.
type Film @table(name: "film") {
  title: String
  # Selections under a row graphitron selected take their key off it: one hop forward is a target
  # lift, keyed on the language's key the film row's foreign key references,
  languageSplit: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  # two hops a source lift, keyed on the film's primary key,
  actors: [Actor!]! @splitQuery @reference(path: [{table: "film_actor"}, {table: "actor"}])
  # A plain object under a film row, whose split field is read off the same selected row.
  details: FilmSplitDetails
  titleUppercase: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
  # A service returning a table-bound type, or a list of one, takes its keys off the film row as
  # the scalar one does: the film's, not the table its result is of.
  languageByService: Language @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "languageByService"})
  castMembers: [FilmActor!]! @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "castMembersByFilm"})
}
type FilmActor @table(name: "film_actor") { actorId: Int @field(name: "actor_id") }
type Language @table(name: "language") {
  name: String
  # one hop back along a key, for a list, a target lift keyed on the language's key the films' key
  # references,
  films: [Film!]! @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
}
type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }
# Not bound to a table, but passing on its parent's selected film row rather than a record handed
# over, so the split field under it is lifted off the film row, as one under the film row is.
type FilmSplitDetails {
  language: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
}
type Address @table(name: "address") { address: String }
type Customer @table(name: "customer") {
  firstName: String @field(name: "first_name")
  # and one hop carrying a condition a source lift, keyed on the customer's primary key.
  address: Address @splitQuery @reference(path: [{key: "customer_address_id_fkey", condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
      method: "customerToAddress"}}])
}
type Staff @table(name: "staff") { firstName: String @field(name: "first_name") }
union AddressOccupant = Customer | Staff

# Backed by FilmRecord: a path departs from film by its first key.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# A plain class whose films() returns a list of FilmRecord.
type CreateFilmsPayload {
  films: [Film!]!
}

# Backed by a record nested in another class, NestedFilmsPayloadHolder.Payload, whose films() returns
# a list of FilmRecord: a nested class is read for its members like any other.
type NestedFilmsPayload {
  films: [Film!]!
}

# Backed by FilmRecord, the target's own record: the field refetches it.
type FilmServicePayload {
  film: Film
  census: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "keyCensus"})
}

# A record whose film() component returns the FilmRecord a service under it batches on: the service
# takes its keys through that member, found by what it returns.
type FilmKeySummary {
  label: String
  keyCensus: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "keyCensus"})
  "A list of language records per summary: its source is its own result's table, and its keys still come off the member."
  languages: [Language!]! @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmReturnShapeService", method: "languagesByFilm"})
}

# A node type over film: a service under it takes its keys off the film row as under Film.
interface Node { id: ID! }
type FilmNode implements Node @table(name: "film") @node {
  id: ID!
  "One language record per film node, lifted onto its row."
  languageByService: Language @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "languageByService"})
  "A list of film_actor records per film node, lifted onto their rows."
  castMembers: [FilmActor!]! @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "castMembersByFilm"})
}

# A plain type nested in a city row: the service under it takes its keys off that row, as a Row1.
type NamedCity @table(name: "city") {
  cityName: String @field(name: "city")
  names: CityNames
}
type CityNames {
  "A scalar per city, keyed on the outer city row's key."
  lowercase: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CityService", method: "cityLowercase"})
}

# A routine's result object, under which rental is re-read by its key matched out of the routine's
# result by name.
type Rental @table(name: "rental") { rentalId: Int! @field(name: "rental_id") }
type RentFilmPayload { rental: Rental }

# A plain class whose addresses() returns AddressRecords, the table the union's members hang off.
type OccupantsBatchPayload {
  occupants: [AddressOccupant!]! @field(name: "addresses")
}

type Query {
  films: [Film!]!
  filmNodes: [FilmNode!]!
  namedCities: [NamedCity!]!
  languages: [Language!]!
  customers: [Customer!]!
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  recentlyCreatedFilmsBatched: [CreateFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CreateFilmsPayloadService", method: "recentlyCreatedFilmsBatched"})
  serviceFilmById(id: Int!): FilmServicePayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  nestedRecentlyCreatedFilms: [NestedFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NestedFilmsPayloadService", method: "nestedRecentlyCreatedFilms"})
  filmKeySummaries: [FilmKeySummary!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "summaries"})
  occupantsBatch: [OccupantsBatchPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayloadService", method: "occupantsBatch"})
}

type Mutation {
  rentFilmPayload(inventoryId: Int!, customerId: Int!): RentFilmPayload
    @routine(name: "rent_film", argMapping: "pInventoryId: inventoryId, pCustomerId: customerId")
}

# The key each child producer is filled with from its source, per occurrence: a member handing over
# the key's records, a re-fetch of the target's own record, a selection under a record handed over
# whose path leaves the record's table by its first key, a re-read of the target's rows matched out
# of a routine's result, and a service keyed on the table of the row or record its parent holds,
# whether a record handed over or a row graphitron selected, whatever its own result is of
# (Film.titleUppercase, Film.languageByService, Film.castMembers). A selection under a row graphitron
# selected, under a table-bound type or a plain one nesting on its row, takes a target lift on its one
# hop's key where that hop has no condition, and a source lift on the source's primary key otherwise.
extend schema @expectEquals(relation: "graphitron_occurrence_producer_lift", rows: """
  coordinate,                                   read,     arity, key_table, key_constraint
  Query.filmDetailsBatch.language,              COLUMNS,  ONE,   film,      film_pkey
  Query.recentlyCreatedFilmsBatched.films,      ACCESSOR, MANY,  film,      film_pkey
  Query.nestedRecentlyCreatedFilms.films,       ACCESSOR, MANY,  film,      film_pkey
  Query.serviceFilmById.film,                   COLUMNS,  ONE,   film,      film_pkey
  Query.serviceFilmById.census,                 COLUMNS,  ONE,   film,      film_pkey
  Query.filmKeySummaries.keyCensus,             ACCESSOR, ONE,   film,      film_pkey
  Query.filmKeySummaries.languages,             ACCESSOR, ONE,   film,      film_pkey
  Query.occupantsBatch.occupants,               ACCESSOR, MANY,  address,   address_pkey
  Film.titleUppercase,                          COLUMNS,  ONE,   film,      film_pkey
  Film.languageByService,                       COLUMNS,  ONE,   film,      film_pkey
  Film.castMembers,                             COLUMNS,  ONE,   film,      film_pkey
  FilmNode.languageByService,                   COLUMNS,  ONE,   film,      film_pkey
  FilmNode.castMembers,                         COLUMNS,  ONE,   film,      film_pkey
  NamedCity.names.lowercase,                    COLUMNS,  ONE,   city,      city_pkey
  Mutation.rentFilmPayload.rental,              COLUMNS,  ONE,   rental,    rental_pkey
  Film.languageSplit,                           COLUMNS,  ONE,   language,  language_pkey
  Film.actors,                                  COLUMNS,  ONE,   film,      film_pkey
  Film.details.language,                        COLUMNS,  ONE,   language,  language_pkey
  Language.films,                               COLUMNS,  ONE,   language,  language_pkey
  Customer.address,                             COLUMNS,  ONE,   customer,  customer_pkey
  """)

# A key read through a member names the member, its one candidate: the record component the
# payload's class offers, so the frame calls that member on the parent.
extend schema @expectEquals(relation: "graphitron_occurrence_producer_lift_accessor", rows: """
  coordinate,                              slot_class_name,                                                            slot_method_name
  Query.recentlyCreatedFilmsBatched.films, no.sikt.graphitron.rewrite.test.services.CreateFilmsPayload,                films
  Query.nestedRecentlyCreatedFilms.films,  no.sikt.graphitron.rewrite.test.services.NestedFilmsPayloadHolder$Payload,  films
  Query.filmKeySummaries.keyCensus,        no.sikt.graphitron.rewrite.test.services.FilmKeySummary,                    film
  Query.filmKeySummaries.languages,        no.sikt.graphitron.rewrite.test.services.FilmKeySummary,                    film
  Query.occupantsBatch.occupants,          no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayload,             addresses
  """)

# A service handing back a table's records under a parent holding an object reads off its own
# result, and its keys still come off the member of the parent's class: no refusal at the field.
extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: """
  coordinate = 'FilmKeySummary.languages'
  """)

extend schema @assertContains(relation: "graphitron_occurrence_call_method", rows: """
  coordinate,                       call,     call_kind, method_name
  FilmNode.languageByService,       producer, SERVICE,   languageByService
  FilmNode.castMembers,             producer, SERVICE,   castMembersByFilm
  NamedCity.names.lowercase,        producer, SERVICE,   cityLowercase
  """)
extend schema @assertEmpty(relation: "graphitron_entry_defect_site", where: """
  coordinate IN ('FilmNode.languageByService', 'FilmNode.castMembers', 'CityNames.lowercase')
  """)
