# A field that fetches its own rows under a parent holding an object takes the keys off that object,
# and how is stated per field. COLUMNS reads them as columns: the target's own key where the object
# is what a service produced of that table (a re-fetch), or the first key's columns where a path
# departs from a table's record. ACCESSOR takes the table records a member of the object returns: of
# the target's table, or of the table a union's members hang off.

# A service under a table row takes its keys off that row, so it states no key row of its own.
type Film @table(name: "film") {
  title: String
  # One hop riding film's own key to language, forward: a target lift keyed on that key.
  languageSplit: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
  # Two hops: a source lift keyed on film's primary key.
  actors: [Actor!]! @splitQuery @reference(path: [{table: "film_actor"}, {table: "actor"}])
  # A plain object under a film row, whose split field is read off a row graphitron selected.
  details: FilmSplitDetails
  titleUppercase: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
}
type Language @table(name: "language") {
  name: String
  # One hop back along film's key to language, a list: a target lift keyed on language's own key.
  films: [Film!]! @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
}
type Actor @table(name: "actor") { firstName: String @field(name: "first_name") }
# Not bound to a table: the forward hop under it is read off its parent's film row, but is taken
# for a record handed over until the source says which it is, so it restarts from the source.
type FilmSplitDetails {
  language: Language @splitQuery @reference(path: [{key: "film_language_id_fkey"}])
}
type Address @table(name: "address") { address: String }
type Customer @table(name: "customer") {
  firstName: String @field(name: "first_name")
  # One hop riding customer's key with a condition on it, which reads the customer: a source lift.
  address: Address @splitQuery @reference(path: [{key: "customer_address_id_fkey", condition: {
      className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
      method: "customerToAddress"}}])
}
type Staff @table(name: "staff") { firstName: String @field(name: "first_name") }
union AddressOccupant = Customer | Staff

# Backed by FilmRecord: a path departs from film by its first key.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# A plain class whose films() returns a list of FilmRecord.
type CreateFilmsPayload {
  films: [Film!]!
}

# Backed by a record nested in another class, NestedFilmsPayloadHolder.Payload, whose films() returns
# a list of FilmRecord: a nested class is read for its members like any other.
type NestedFilmsPayload {
  films: [Film!]!
}

# Backed by FilmRecord, the target's own record: the field refetches it.
type FilmServicePayload {
  film: Film
  census: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "keyCensus"})
}

# A record whose film() component returns the FilmRecord a service under it batches on: the service
# takes its keys through that member, found by what it returns.
type FilmKeySummary {
  label: String
  keyCensus: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "keyCensus"})
}

# A plain class whose addresses() returns AddressRecords, the table the union's members hang off.
type OccupantsBatchPayload {
  occupants: [AddressOccupant!]! @field(name: "addresses")
}

type Query {
  films: [Film!]!
  languages: [Language!]!
  customers: [Customer!]!
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  recentlyCreatedFilmsBatched: [CreateFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CreateFilmsPayloadService", method: "recentlyCreatedFilmsBatched"})
  serviceFilmById(id: Int!): FilmServicePayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  nestedRecentlyCreatedFilms: [NestedFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.NestedFilmsPayloadService", method: "nestedRecentlyCreatedFilms"})
  filmKeySummaries: [FilmKeySummary!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "summaries"})
  occupantsBatch: [OccupantsBatchPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayloadService", method: "occupantsBatch"})
}

extend schema @expectEquals(relation: "graphitron_field_key_row", rows: """
  type_name,             field_name, kind,     table_name, arity
  FilmDetailsCarrier,    language,   COLUMNS,  film,       ONE
  CreateFilmsPayload,    films,      ACCESSOR, film,       MANY
  NestedFilmsPayload,    films,      ACCESSOR, film,       MANY
  FilmServicePayload,    film,       COLUMNS,  film,       ONE
  FilmServicePayload,    census,     COLUMNS,  film,       ONE
  FilmKeySummary,        keyCensus,  ACCESSOR, film,       ONE
  OccupantsBatchPayload, occupants,  ACCESSOR, address,    MANY
  """)


# An ACCESSOR key row names the member it takes its keys through: the record component the
# payload's class offers, by its method and descriptor, so the frame calls that member on the parent.
extend schema @expectEquals(relation: "graphitron_field_key_row_accessor", rows: """
  type_name,             field_name, slot_class_name,                                                slot_method_name, slot_descriptor
  CreateFilmsPayload,    films,      no.sikt.graphitron.rewrite.test.services.CreateFilmsPayload,    films,            ()Ljava/util/List;
  OccupantsBatchPayload, occupants,  no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayload, addresses,        ()Ljava/util/List;
  NestedFilmsPayload,    films,      no.sikt.graphitron.rewrite.test.services.NestedFilmsPayloadHolder$Payload, films, ()Ljava/util/List;
  FilmKeySummary,        keyCensus,  no.sikt.graphitron.rewrite.test.services.FilmKeySummary,        film,             ()Lno/sikt/graphitron/rewrite/test/jooq/public_/tables/records/FilmRecord;
  """)

# The lift each child producer restarts its query by, per occurrence (code-generation-triggers.adoc §
# Producer). A member handing over the target's records, and a re-fetch of the target's own record,
# are target lifts keyed on its primary key; the forward key off a record a service handed over, and
# a service taking its parent's own records, restart from the source, keyed on the source's primary
# key. Under a film row, one hop riding a key is a target lift, forward on film's key to language or,
# for a list, back on it to language's own key; two hops, or a hop carrying a condition, restart from
# the source. Departures from the field-keyed key row above: FilmDetailsCarrier.language takes a source
# lift where the field row reads film's columns off the record, a handed record guaranteeing only its
# key; a service under a table row, Film.titleUppercase, states its lift where it stated none; and a
# plain type under a film row, FilmSplitDetails, takes a source lift for its forward hop, its source
# not yet saying the row is one graphitron selected.
extend schema @expectEquals(relation: "graphitron_occurrence_producer_lift", rows: """
  coordinate,                                   lift,   read,     arity, key_table, key_constraint
  Query.filmDetailsBatch.language,              SOURCE, COLUMNS,  ONE,   film,      film_pkey
  Query.recentlyCreatedFilmsBatched.films,      TARGET, ACCESSOR, MANY,  film,      film_pkey
  Query.nestedRecentlyCreatedFilms.films,       TARGET, ACCESSOR, MANY,  film,      film_pkey
  Query.serviceFilmById.film,                   TARGET, COLUMNS,  ONE,   film,      film_pkey
  Query.serviceFilmById.census,                 SOURCE, COLUMNS,  ONE,   film,      film_pkey
  Query.filmKeySummaries.keyCensus,             TARGET, ACCESSOR, ONE,   film,      film_pkey
  Query.occupantsBatch.occupants,               TARGET, ACCESSOR, MANY,  address,   address_pkey
  Film.titleUppercase,                          SOURCE, COLUMNS,  ONE,   film,      film_pkey
  Film.languageSplit,                           TARGET, COLUMNS,  ONE,   film,      film_language_id_fkey
  Language.films,                               TARGET, COLUMNS,  ONE,   language,  language_pkey
  Film.actors,                                  SOURCE, COLUMNS,  ONE,   film,      film_pkey
  Customer.address,                             SOURCE, COLUMNS,  ONE,   customer,  customer_pkey
  Film.details.language,                        SOURCE, COLUMNS,  ONE,   film,      film_pkey
  """)

# An ACCESSOR lift names the member it reads through, its one candidate, as the field-keyed accessor
# row above does.
extend schema @expectEquals(relation: "graphitron_occurrence_producer_lift_accessor", rows: """
  coordinate,                              slot_class_name,                                                            slot_method_name
  Query.recentlyCreatedFilmsBatched.films, no.sikt.graphitron.rewrite.test.services.CreateFilmsPayload,                films
  Query.nestedRecentlyCreatedFilms.films,  no.sikt.graphitron.rewrite.test.services.NestedFilmsPayloadHolder$Payload,  films
  Query.filmKeySummaries.keyCensus,        no.sikt.graphitron.rewrite.test.services.FilmKeySummary,                    film
  Query.occupantsBatch.occupants,          no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayload,             addresses
  """)
