# A field that fetches its own rows under a parent holding an object takes the keys off that object,
# and how is stated per field. COLUMNS reads them as columns: the target's own key where the object
# is what a service produced of that table (a re-fetch), or the first key's columns where a path
# departs from a table's record. ACCESSOR takes the table records a member of the object returns: of
# the target's table, or of the table a union's members hang off.

type Film @table(name: "film") { title: String }
type Language @table(name: "language") { name: String }
type Address @table(name: "address") { address: String }
type Customer @table(name: "customer") { firstName: String @field(name: "first_name") }
type Staff @table(name: "staff") { firstName: String @field(name: "first_name") }
union AddressOccupant = Customer | Staff

# Backed by FilmRecord: a path departs from film by its first key.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# A plain class whose films() returns a list of FilmRecord.
type CreateFilmsPayload {
  films: [Film!]!
}

# Backed by FilmRecord, the target's own record: the field refetches it.
type FilmServicePayload {
  film: Film
  census: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "keyCensus"})
}

# A record whose film() component returns the FilmRecord a service under it batches on: the service
# takes its keys through that member, found by what it returns.
type FilmKeySummary {
  label: String
  keyCensus: String @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "keyCensus"})
}

# A plain class whose addresses() returns AddressRecords, the table the union's members hang off.
type OccupantsBatchPayload {
  occupants: [AddressOccupant!]! @field(name: "addresses")
}

extend type Query {
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  recentlyCreatedFilmsBatched: [CreateFilmsPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CreateFilmsPayloadService", method: "recentlyCreatedFilmsBatched"})
  serviceFilmById(id: Int!): FilmServicePayload
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmById"})
  filmKeySummaries: [FilmKeySummary!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmKeySummaryService", method: "summaries"})
  occupantsBatch: [OccupantsBatchPayload!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayloadService", method: "occupantsBatch"})
}

extend schema @expectEquals(relation: "graphitron_field_key_row", rows: """
  type_name,             field_name, kind,     table_name, arity
  FilmDetailsCarrier,    language,   COLUMNS,  film,       ONE
  CreateFilmsPayload,    films,      ACCESSOR, film,       MANY
  FilmServicePayload,    film,       COLUMNS,  film,       ONE
  FilmServicePayload,    census,     COLUMNS,  film,       ONE
  FilmKeySummary,        keyCensus,  ACCESSOR, film,       ONE
  OccupantsBatchPayload, occupants,  ACCESSOR, address,    MANY
  """)


# An ACCESSOR key row names the member it takes its keys through: the record component the
# payload's class offers, by its method and descriptor, so the frame calls that member on the parent.
extend schema @expectEquals(relation: "graphitron_field_key_row_accessor", rows: """
  type_name,             field_name, slot_class_name,                                                slot_method_name, slot_descriptor
  CreateFilmsPayload,    films,      no.sikt.graphitron.rewrite.test.services.CreateFilmsPayload,    films,            ()Ljava/util/List;
  OccupantsBatchPayload, occupants,  no.sikt.graphitron.rewrite.test.services.OccupantsBatchPayload, addresses,        ()Ljava/util/List;
  FilmKeySummary,        keyCensus,  no.sikt.graphitron.rewrite.test.services.FilmKeySummary,        film,             ()Lno/sikt/graphitron/rewrite/test/jooq/public_/tables/records/FilmRecord;
  """)
