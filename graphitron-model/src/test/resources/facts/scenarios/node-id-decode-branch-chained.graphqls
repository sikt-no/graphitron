# One written two-hop path over a union of two tables is two paths. Each branch's first hop arrives
# at an intermediate of its own, and the two intermediates depart their second hop from columns of one
# name, so the second hops look interchangeable. Each branch walks its own chain only, from a column of
# the table it departed, and the node id binds the one node's key once.

interface Node { id: ID! }

type Rolle implements Node @table(name: "rolle") @node {
  id: ID!
}

type EmneRolle @table(name: "emnerolle") { emneCode: String @field(name: "emne_code") }
type KlasseRolle @table(name: "klasserolle") { klasseCode: String @field(name: "klasse_code") }

union Roller = EmneRolle | KlasseRolle

input RolleFilter {
  rolleId: ID @nodeId(typeName: "Rolle") @reference(path: [{key: "link_fkey"}, {key: "rolle_fkey"}])
}

type Query {
  personroller(filter: RolleFilter): [Roller]
}

extend schema @expectEquals(relation: "graphitron_join_path_step_column", where: "coordinate = 'Query.personroller(filter.rolleId:)'", rows: """
  target_type, position, ordinal, from_table,  from_column, to_table,    to_column
  EmneRolle,   0,        0,       emnerolle,   emne_code,   emne_link,   link_code
  EmneRolle,   1,        0,       emne_link,   link_code,   rolle,       rollekode
  KlasseRolle, 0,        0,       klasserolle, klasse_code, klasse_link, link_code
  KlasseRolle, 1,        0,       klasse_link, link_code,   rolle,       rollekode
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_node_id", where: "coordinate = 'Query.personroller(filter.rolleId:)'", rows: """
  bound,        position, node_type_name, column_name
  public.rolle, 0,        Rolle,          rollekode
  """)
