# configuration-sweep, read in steps: each @withFacts writes the files of one reading, the clock
# moving between readings, and the claims after it check what that reading left.

extend schema @withConfiguration(
  tenantColumn: "tenant_id",
  maxAllowedPageSize: 1000,
  sessionState: true,
  sessionHandle: "com.example.Identity"
)

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/configuration-sweep/config-t0", as: "configuration-sweep.config"}])

extend schema @expectEquals(relation: "store_graph_tenant_column", rows: """
  column_name, touched_at
  tenant_id,   1000000000
  """)

extend schema @expectEquals(relation: "store_graph_max_allowed_page_size", rows: """
  max_page_size, touched_at
  1000,          1000000000
  """)

extend schema @expectEquals(relation: "store_graph_session_handle", rows: """
  handle_class,         touched_at
  com.example.Identity, 1000000000
  """)

extend schema @tick(ms: 60000)

extend schema @withConfiguration(
  sessionState: true
)

extend schema @withFacts(docs: [
  {path: "shapes/configuration-sweep/config-t60", as: "configuration-sweep.config"}])

extend schema @assertEmpty(relation: "store_graph_tenant_column")

extend schema @assertEmpty(relation: "store_graph_max_allowed_page_size")

extend schema @assertEmpty(relation: "store_graph_session_handle")

extend schema @expectEquals(relation: "store_graph_session_supplied", rows: """
  touched_at
  1000000060
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/configuration-sweep/other-t120", as: "configuration-sweep.other"}])

extend schema @expectEquals(relation: "store_graph_session_supplied", rows: """
  touched_at
  1000000120
  """)
