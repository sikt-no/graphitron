# A key name two schemas both declare. note is bound to multischema_a's, a bare name both schemas
# declare binding none, so its path departs from that schema's note alone and the bare key reaches
# that schema's event. A schema qualifier on the key scopes it to that schema, and a qualified
# spelling is a SQL constraint name. A spelling no site writes is not in the spelling population.

type Note @table(name: "multischema_a.note") {
  anyEvent: Event @reference(path: [{key: "note_event_fk"}])
  thisSchemasEvent: Event @reference(path: [{key: "multischema_a.note_event_fk"}])
}

type Event @table(name: "multischema_a.event") { eventId: Int @field(name: "event_id") }

type Query { notes: [Note!]! }

extend schema @expectEquals(relation: "graphitron_join_path_step", rows: """
  coordinate,            position, from_schema,   from_table, to_schema,     to_table
  Note.anyEvent,         0,        multischema_a, note,       multischema_a, event
  Note.thisSchemasEvent, 0,        multischema_a, note,       multischema_a, event
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_key", rows: """
  coordinate,            position, constraint_schema, constraint_name
  Note.anyEvent,         0,        multischema_a,     note_event_fk
  Note.thisSchemasEvent, 0,        multischema_a,     note_event_fk
  """)

extend schema @assertEmpty(relation: "graphitron_spelled_table", where: "spelling = 'event'")
