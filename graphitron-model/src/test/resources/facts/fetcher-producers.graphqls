"Every output field of an object type has one fetcher, and it either produces a result or reads one. A producer runs something, and its kind says what: a select, a lookup by keys, a count or the facets over a connection's statement, a write, a routine or a service. A reader reads from a result its parent produced. One field of each producer kind, the readers beside them, and the one field the rule cannot place, which is a defect at that field rather than an absence nobody can explain."

type Film @table(name: "film") {
  filmId: ID @field(name: "film_id")
  "A column of the parent's row: a reader."
  title: String
  "Split, so it runs a statement of its own over the keys its parents hand it: a producer."
  language: Language @splitQuery
  "A split lookup on a table type, which a write returning Film must not take for its re-read."
  languagesByKey(languageId: [Int!] @lookupKey): [Language]! @splitQuery
  "An expression inlined into the parent's statement: a reader."
  titleUppercase: String
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.services.FilmService"})
}

type Language @table(name: "language") {
  name: String
}

input FilmFilter { rating: [String!] @field(name: "rating") @asFacet }

input FilmInput @table(name: "film") {
  filmId: ID @field(name: "film_id")
  title: String
}

extend type Query {
  "Every root field runs something; with nothing written, it selects."
  films: [Film!]!
  "Keys handed in by the caller, one position per key: a lookup."
  filmsById(filmId: [ID!]! @lookupKey): [Film]!
  "A connection selects; its totalCount and facets are producers over its statement."
  pagedFilms(filter: FilmFilter): [Film!]! @asConnection
  "The routine is what it runs, keyed to its first @routine."
  filmsForActor(actorId: Int, minLength: Int): [Film!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
  "A Java method."
  uppercased: [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
  "A service whose method the class does not declare: still a producer, with nothing to say it calls."
  unresolved: [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "noSuchMethod"})
  "Two kinds written on one field: no producer row, and a defect at the field."
  conflicted: [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "titleUppercase"})
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId")
}

type Mutation {
  "An insert names no row; it mutates film and produces Film by re-reading the keys it made."
  addFilm(input: FilmInput): Film @mutation(typeName: INSERT)
  "An identifying write, one row per input as multiRow was not written."
  renameFilm(input: FilmInput): Film @mutation(typeName: UPDATE)
  "The same verb on a filter that may match several; it produces ids and mutates the table it names."
  dropFilms(input: [FilmInput!]!): [ID!]! @mutation(typeName: DELETE, multiRow: true, table: "film")
  "A payload with no table of its own: the insert mutates the table its one data field re-reads."
  addFilmWithPayload(input: FilmInput): AddFilmPayload @mutation(typeName: INSERT)
}

type AddFilmPayload {
  "The re-read, over the keys the insert returned."
  film: Film
}

# Each producer is a fetcher on the producer side. The readers are the next relation's.
extend schema @assertContains(relation: "graphitron_fetcher", rows: """
  type_name,                 field_name,    side
  Query,                     ping,          PRODUCER
  Query,                     films,         PRODUCER
  Mutation,                  addFilm,       PRODUCER
  Film,                      language,      PRODUCER
  QueryPagedFilmsConnection, totalCount,    PRODUCER
  """)

# Input types and the fields that read are no producers.
extend schema @assertEmpty(relation: "graphitron_producer", where: """
  type_name IN ('FilmFilter', 'FilmInput', 'Language')
  OR (type_name = 'Film' AND field_name IN ('filmId', 'title', 'titleUppercase'))
  OR (type_name = 'QueryPagedFilmsConnection' AND field_name IN ('edges', 'nodes', 'pageInfo'))
  """)

extend schema @expectEquals(relation: "graphitron_producer", where: """
  type_name IN ('Query', 'Mutation', 'Film', 'QueryPagedFilmsConnection', 'AddFilmPayload')
  """, rows: """
  type_name,                 field_name,         kind
  Query,                     ping,               ROUTINE
  Query,                     films,              SELECT
  Query,                     filmsById,          LOOKUP
  Query,                     pagedFilms,         SELECT
  Query,                     filmsForActor,      ROUTINE
  Query,                     uppercased,         SERVICE
  Query,                     unresolved,         SERVICE
  Mutation,                  addFilm,            INSERT
  Mutation,                  renameFilm,         UPDATE
  Mutation,                  dropFilms,          DELETE
  Mutation,                  addFilmWithPayload, INSERT
  AddFilmPayload,            film,               LOOKUP
  Film,                      language,      SELECT
  Film,                      languagesByKey, LOOKUP
  QueryPagedFilmsConnection, totalCount,    COUNT
  QueryPagedFilmsConnection, facets,        FACETS
  """)

# The field the rule finds two kinds for is no producer, and says why where it was written.
extend schema @assertAbsent(relation: "graphitron_fetcher", rows: """
  type_name, field_name
  Query,     conflicted
  """)
extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  coordinate,       code
  Query.conflicted, PRODUCER_KINDS_CONFLICT
  """)

# What each kind runs, resolved. A produced type is not here: it is the field's target, so the
# delete that produces ids still names the table it mutates.
extend schema @expectEquals(relation: "graphitron_producer_write", where: """
  type_name = 'Mutation'
  """, rows: """
  type_name, field_name,         kind,   matches, table_schema, table_name
  Mutation,  addFilm,            INSERT,        , public,       film
  Mutation,  renameFilm,         UPDATE, ONE,     public,       film
  Mutation,  dropFilms,          DELETE, MANY,    public,       film
  Mutation,  addFilmWithPayload, INSERT,        , public,       film
  """)

# The first @routine is the producer's; the prelude's ping is one more routine producer.
extend schema @expectEquals(relation: "graphitron_producer_routine", rows: """
  type_name, field_name,    table_schema,  routine_name
  Query,     ping,          multischema_b, ms_ping
  Query,     filmsForActor, public,        films_for_actor
  """)

# A reference that resolved is a row; Query.unresolved, whose method is missing, is a producer
# with no row here, the code-reference defect saying why.
extend schema @expectEquals(relation: "graphitron_producer_service", rows: """
  type_name, field_name, method_class_name,                                    method_name
  Query,     uppercased, no.sikt.graphitron.rewrite.test.services.FilmService, titleUppercase
  """)
extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  coordinate,       code
  Query.unresolved, CODE_REFERENCE_METHOD_NOT_FOUND
  """)

