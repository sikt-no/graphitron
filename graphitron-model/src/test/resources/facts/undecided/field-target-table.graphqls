# Where a root field's statements land: the table its producer lifts its records onto, none where
# the records are of several tables or none named, and the tables its target type's rows are rows
# of, which a connection's element answers. A type with no table, or one binding ambiguously, holds
# rows of no table.

type Film @table(name: "film") { title: String }
type Reel @table(name: "film") { title: String }
type Actor @table(name: "actor") { title: String }
type Note { text: String }
# event is declared in two schemas, so this binding is ambiguous.
type Event @table(name: "event") { title: String }

union Reels = Film | Reel
union Mixed = Actor | Note | Event

interface Credited @table(name: "actor") { title: String }
type Clip implements Credited @table(name: "actor") { title: String }

extend type Query {
  film: Film
  reels: [Reels!]!
  mixed: [Mixed!]!
  credited: [Credited!]!
  note: Note
  films: [Film!]! @asConnection
}

extend schema @expectEquals(relation: "graphitron_occurrence_producer_result",
    where: "coordinate <> 'Query.anchor'", rows: """
  coordinate,     shape,         table_name
  Query.film,     SINGLE_RECORD, film
  Query.reels,    RECORD_LIST,
  Query.mixed,    RECORD_LIST,
  Query.credited, RECORD_LIST,   actor
  Query.films,    CONNECTION,
  """)

extend schema @expectEquals(relation: "graphitron_result_table", where: "type_name <> 'FactAnchor'", rows: """
  type_name, table_name
  Film,      film
  Reel,      film
  Actor,     actor
  Credited,  actor
  Clip,      actor
  """)
