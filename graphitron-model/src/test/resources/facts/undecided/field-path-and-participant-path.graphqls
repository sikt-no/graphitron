# A field's path and a participant's path are two groupings of the same element grammar. Repeated
# @reference applications compose, with @routine, one path for the field; each @referenceFor
# application is one participant's complete path, and a participant not named keeps discovery. So
# a @referenceFor element is never a step of the field's path, and each participant's path is
# numbered on its own.

type Actor @table(name: "actor") {
  firstName: String @field(name: "first_name")
}

type Customer @table(name: "customer") {
  firstName: String @field(name: "first_name")
}

type Staff @table(name: "staff") {
  firstName: String @field(name: "first_name")
}

union Person = Actor | Customer | Staff

type Film @table(name: "film") {
  title: String
  # Two participants with paths of their own; Customer is left to discovery.
  people: [Person!]!
    @referenceFor(type: "Actor", path: [{table: "film_actor"}, {table: "actor"}])
    @referenceFor(type: "Staff", path: [{table: "staff"}])
  # A path of two applications, concatenated in written order.
  actors: [Actor!]!
    @reference(path: [{table: "film_actor"}])
    @reference(path: [{table: "actor"}])
  # A path of one application, its elements in the order written inside it.
  cast: [Actor!]!
    @reference(path: [{table: "film_actor"}, {table: "actor"}])
}

extend type Query {
  films: [Film!]!
}

# A field's own applications have places in its path, and a participant's have none.
extend schema @expectEquals(relation: "graphitron_ast_field_path_entry", where: """
  (graph_name, source_name, field_line, field_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_definition_entry WHERE type_name = 'Film' AND name = 'actors')
  """, rows: """
  position, element_column
  0,        23
  1,        23
  """)

extend schema @expectEquals(relation: "graphitron_ast_field_path_entry", where: """
  (graph_name, source_name, field_line, field_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_definition_entry WHERE type_name = 'Film' AND name = 'cast')
  """, rows: """
  position, element_column
  0,        23
  1,        46
  """)

extend schema @assertEmpty(relation: "graphitron_ast_field_path_entry", where: """
  (graph_name, source_name, field_line, field_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_definition_entry WHERE type_name = 'Film' AND name = 'people')
  """)

extend schema @expectEquals(relation: "graphitron_field_participant_path", rows: """
  type_name, field_name, participant_type_ref, position
  Film,      people,     Actor,                0
  Film,      people,     Actor,                1
  Film,      people,     Staff,                0
  """)

# The walk starts each field that wrote a path on the table its parent's result is a row of, and
# steps through the field's own elements, two applications or one alike.
extend schema @expectEquals(relation: "graphitron_field_path_start", rows: """
  type_name, field_name, start_table, kind
  Film,      actors,     film,        RESULT
  Film,      cast,       film,        RESULT
  """)

extend schema @expectEquals(relation: "graphitron_field_path", rows: """
  type_name, field_name, start_table, position, from_table, to_table
  Film,      actors,     film,        0,        film,       film_actor
  Film,      actors,     film,        1,        film_actor, actor
  Film,      cast,       film,        0,        film,       film_actor
  Film,      cast,       film,        1,        film_actor, actor
  """)
