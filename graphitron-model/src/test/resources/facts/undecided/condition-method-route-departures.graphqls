# A condition whose departure names no generated table, by the wildcard or by a primitive, departs
# from wherever the path stands and arrives where its second parameter says. The step is taken from
# customer either way; the wildcard's overload takes the pair, and no overload takes customer for a
# primitive.

type Customer @table(name: "customer") { customerId: Int }

type Query {
  customers(
    wildcard: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "anythingToAddress"}}])
    primitive: String @reference(path: [{condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "intToAddress"}}])
  ): [Customer!]!
}

# Departures no signature names, among them, every one arriving at address.
extend schema @expectEquals(relation: "graphitron_join_path_step", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Customer.%'", rows: """
  coordinate, target_type, position, element_place, from_table, to_table
  Query.customers(primitive:), Customer, 0, 0, customer, address
  Query.customers(wildcard:), Customer, 0, 0, customer, address
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step_method", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Customer.%'", rows: """
  coordinate, target_type, position, method_name
  Query.customers(wildcard:), Customer, 0, anythingToAddress
  """)

extend schema @assertEmpty(relation: "graphitron_join_path_stop")

extend schema @expectEquals(relation: "graphitron_entry_defect_site", where: "coordinate LIKE 'Query.%' OR coordinate LIKE 'Customer.%'", rows: """
  code, coordinate
  COLUMN_UNRESOLVED, Customer.customerId
  CONDITION_NO_OVERLOAD_FOR_PAIR, Query.customers(primitive:)
  """)
