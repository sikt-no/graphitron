# occurrence-source-kind, read in steps: each @withFacts writes the files of one reading, the clock
# moving between readings, and the claims after it check what that reading left.

extend schema @withFacts(docs: [
  {path: "layouts/anchor"},
  {path: "shapes/occurrence-source-kind/a-t0", as: "occurrence-source-kind.a"}])

extend schema @expectEquals(relation: "graphitron_occurrence_source", where: """
  coordinate IN ('Film.title', 'Query.carrier.filmId')
  """, rows: """
  coordinate,            kind,  touched_at
  Film.title,            TABLE, 1000000000
  Query.carrier.filmId,  TABLE, 1000000000
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_source_table", where: """
  coordinate = 'Query.carrier.filmId'
  """, rows: """
  coordinate,            table_name, touched_at
  Query.carrier.filmId,  film,       1000000000
  """)

extend schema @assertEmpty(relation: "graphitron_occurrence_source_object", where: """
  coordinate = 'Query.carrier.filmId'
  """)

extend schema @tick(ms: 60000)

extend schema @withFacts(docs: [
  {path: "shapes/occurrence-source-kind/a-t60", as: "occurrence-source-kind.a"}])

extend schema @expectEquals(relation: "graphitron_occurrence_source", where: """
  coordinate IN ('Film.title', 'Query.carrier.filmId')
  """, rows: """
  coordinate,            kind,   touched_at
  Film.title,            TABLE,  1000000060
  Query.carrier.filmId,  OBJECT, 1000000060
  """)

extend schema @expectEquals(relation: "graphitron_occurrence_source_object", where: """
  coordinate = 'Query.carrier.filmId'
  """, rows: """
  coordinate,            class_name,                                                touched_at
  Query.carrier.filmId,  no.sikt.graphitron.rewrite.test.services.FilmBlurbHolder,  1000000060
  """)

extend schema @assertEmpty(relation: "graphitron_occurrence_source_table", where: """
  coordinate = 'Query.carrier.filmId'
  """)
