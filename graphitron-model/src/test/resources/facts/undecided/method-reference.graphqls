# Every Java method the graph's directives name, once per site that names it: the class and the
# method each code reference states, at the application that wrote it.

type Film @table(name: "film") {
  title: String
}

input FilmFilter {
  title: String @condition(condition: {
    className: "no.sikt.graphitron.rewrite.generators.TestFilmService",
    method: "inputFieldCondition"})
}

type Language @table(name: "language") {
  name: String
  films: [Film!]! @condition(condition: {
    className: "no.sikt.graphitron.rewrite.generators.TestFilmService",
    method: "fieldCondition"})
}

# A path element of a @reference names a method too, and it is as much a naming of that class as a
# @service is.
type City @table(name: "city") {
  name: String
  films: [Film!]! @reference(path: [
    {table: "film", condition: {
      className: "no.sikt.graphitron.rewrite.generators.TestFilmService",
      method: "stepCondition"}}])
}

extend type Query {
  languages: [Language!]! @service(service: {
    className: "no.sikt.graphitron.rewrite.generators.TestFilmService",
    method: "getFilms"})
  cities: [City!]!
}

extend schema @assertContains(relation: "graphitron_code_reference_site", rows: """
  directive_name, coordinate,       kind,         class_name,                                            method_name
  service,        Query.languages,  ROOT,         no.sikt.graphitron.rewrite.generators.TestFilmService, getFilms
  condition,      Language.films,   ROOT,         no.sikt.graphitron.rewrite.generators.TestFilmService, fieldCondition
  condition,      FilmFilter.title, ROOT,         no.sikt.graphitron.rewrite.generators.TestFilmService, inputFieldCondition
  reference,      City.films,       PATH_ELEMENT, no.sikt.graphitron.rewrite.generators.TestFilmService, stepCondition
  """)
