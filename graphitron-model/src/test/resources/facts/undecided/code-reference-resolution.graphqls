# Each written code reference met with the classpath. A reference naming a method resolves to it
# where exactly one method answers; every other one is a defect at the position it was written, and
# which of three follows from what the classpath holds under the names. The classes are real Java
# in the classpath corpus, so a resolution is what a reading of the bytes found.

type City @table(name: "city") {
  cityId: ID @field(name: "CITY_ID")
  # One method answers, so this is a row.
  uppercase: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CityService", method: "cityUppercase"})
  # The class was read and declares no method of this name.
  misspelt: String
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CityService", method: "cityUpercase"})
  # No reading read this class at all, which is a different thing to tell an author.
  unread: String
    @service(service: {className: "no.example.Absent", method: "anything"})
}

# An @externalField naming no method names its field, so isEnglish resolves with no method written
# and missing is a defect for the same reason. A condition is resolved like any other reference,
# and a name two public overloads answer resolves to neither. Only where the generator calls one
# method is that a defect: the @service topRated names FilmService's two overloads and draws
# CODE_REFERENCE_METHOD_AMBIGUOUS, while the @condition on overloaded names an overload set, which
# is what a condition takes, and draws nothing here.
type Film @table(name: "film") {
  filmId: ID @field(name: "FILM_ID")
  isEnglish: Boolean
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmExtensions"})
  missing: String
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.test.extensions.FilmExtensions"})
  overloaded: [City!]!
    @condition(condition: {className: "no.sikt.graphitron.rewrite.test.conditions.MultiTableConditionFixtures", method: "occupantTypedNamePrefix"})
  topRated: [Film!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "topRated"})
}

# A FieldSort.method is called as exactly one method too, so naming the two overloads draws the
# defect, as naming a method the class lacks does; a condition a FieldSort.path element names is an element's condition, which takes an
# overload set, and draws nothing here, the agreeingOnBoth pair notwithstanding.
type Language @table(name: "language") {
  name: String
  filmsByTopRated: [Film!]!
    @defaultOrder(fields: [{method: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "topRated"}}])
  filmsByPathCondition: [Film!]!
    @defaultOrder(fields: [{name: "title", path: [{table: "language", condition: {className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures", method: "agreeingOnBoth"}}]}])
  filmsByMissingMethod: [Film!]!
    @defaultOrder(fields: [{method: {className: "no.sikt.graphitron.rewrite.test.services.FilmService", method: "noSuchMethod"}}])
}

# A class reference names no method, so it is neither resolved here nor a defect.
enum Rating @enum(enumReference: {className: "no.example.RatingEnum"}) {
  G
}

extend type Query {
  cities: [City!]!
  films: [Film!]!
  languages: [Language!]!
}

extend schema @expectEquals(relation: "graphitron_code_reference", rows: """
  method_class_name,                                          method_name
  no.sikt.graphitron.rewrite.test.services.CityService,       cityUppercase
  no.sikt.graphitron.rewrite.test.extensions.FilmExtensions,  isEnglish
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,                            type_name, field_name, detail
  CODE_REFERENCE_METHOD_NOT_FOUND, City,      misspelt,   no.sikt.graphitron.rewrite.test.services.CityService.cityUpercase
  CODE_REFERENCE_CLASS_NOT_READ,   City,      unread,     no.example.Absent
  CODE_REFERENCE_METHOD_NOT_FOUND, Film,      missing,    no.sikt.graphitron.rewrite.test.extensions.FilmExtensions.missing
  CODE_REFERENCE_METHOD_AMBIGUOUS, Film,      topRated,   no.sikt.graphitron.rewrite.test.services.FilmService.topRated
  CODE_REFERENCE_METHOD_AMBIGUOUS, Language,  filmsByTopRated, no.sikt.graphitron.rewrite.test.services.FilmService.topRated
  CODE_REFERENCE_METHOD_NOT_FOUND, Language,  filmsByMissingMethod, no.sikt.graphitron.rewrite.test.services.FilmService.noSuchMethod
  NO_ROUTE_TO_TARGET,              Film,      overloaded,      public.film to public.city
  ROUTE_AMBIGUOUS,                 Language,  filmsByTopRated, public.language to public.film by film_language_id_fkey or film_original_language_id_fkey
  ROUTE_AMBIGUOUS,                 Language,  filmsByPathCondition, public.language to public.film by film_language_id_fkey or film_original_language_id_fkey
  ROUTE_AMBIGUOUS,                 Language,  filmsByMissingMethod, public.language to public.film by film_language_id_fkey or film_original_language_id_fkey
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,                            type_name, field_name
  CODE_REFERENCE_METHOD_AMBIGUOUS, Film,      overloaded
  CODE_REFERENCE_METHOD_AMBIGUOUS, Language,  filmsByPathCondition
  """)
