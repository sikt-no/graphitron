# The tables each occurrence of a field reads from: its parent type's table, or where the parent
# type has none, the table its parent occurrence reads, through any number of such types. A type
# reached from parents on two tables is read from each, one occurrence per parent, and a path
# written on one of its fields is read from where the read stands rather than refused.

type Film @table(name: "film") {
  title: String
  details: FilmDetails
  throughAPath: ReachedByAPath @reference(path: [{key: "film_language_id_fkey"}])
}

# Reached only through a field that wrote a path, so it reads the rows that path lands on rather
# than film's.
type ReachedByAPath { name: String }

type Customer @table(name: "customer") {
  details: FilmDetails
}

# No table of its own: read on the table of whichever field reached it.
type FilmDetails {
  summary: String
  language: Language @reference(path: [{key: "film_language_id_fkey"}])
  more: MoreDetails
}

# Two levels down, still on the table the outer field departs from. A field returning its own
# type stops the walk rather than recursing.
type MoreDetails {
  note: String
  again: MoreDetails
}

type Language @table(name: "language") { name: String }

extend type Query {
  film: Film
}

extend schema @assertContains(relation: "graphitron_occurrence_source_table", rows: """
  coordinate,                 table_name
  Film.title,                 film
  Film.details,               film
  Film.details.summary,       film
  Customer.details.summary,   customer
  Film.details.language,      film
  Film.details.more,          film
  Film.details.more.note,     film
  Customer.details.more.note, customer
  Film.details.more.again,    film
  Language.name,              language
  """)

# A type reached only through a field that wrote a path reads the rows that path lands on.
extend schema @assertContains(relation: "graphitron_occurrence_source_table", rows: """
  coordinate,             table_name
  Film.throughAPath.name, language
  """)

# A root field departs from nothing.
extend schema @assertEmpty(relation: "graphitron_occurrence_source_table", where: "coordinate = 'Query.film'")

# Reached under Customer.details, the written key departs film and not customer, so that occurrence's
# path has no move from where it stands; under Film.details it walks.
extend schema @assertContains(relation: "graphitron_entry_defect_site", rows: """
  code,                    coordinate
  NO_ROUTE_FROM_DEPARTURE, FilmDetails.language
  """)

extend schema @expectEquals(relation: "graphitron_join_path_stop", rows: """
  coordinate,                 target_type, position, moves
  Customer.details.language,  Language,    0,        0
  """)
