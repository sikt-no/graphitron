# A root's @routine is where its query starts: the walk starts on the function its name resolves to,
# folded against the catalog in parts, a qualified name in its own schema, whether the routine ends
# the path or a hop follows it.

type Film @table(name: "film") { title: String }
type Row { title: String }

type Query {
  films: [Film!]!
  rows(actorId: Int!, minLength: Int!): [Row!]!
    @routine(name: "films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
  hopped(actorId: Int!, minLength: Int!): [Film!]!
    @routine(name: "public.films_for_actor", argMapping: "pActorId: actorId, pMinLength: minLength")
    @reference(path: [{table: "film"}])
}

# Capture composes the field's path across its applications in the order they were written: the
# routine at 0, applied at column 5, and its @reference's one element after it, written at column 23.
extend schema @expectEquals(relation: "graphitron_ast_field_path_entry", where: """
  (graph_name, source_name, field_line, field_column) IN (
    SELECT graph_name, source_name, source_line, source_column
      FROM graphql_ast_field_definition_entry WHERE type_name = 'Query' AND name = 'hopped')
  """, rows: """
  position, element_column
  0,        5
  1,        23
  """)

# A root's routine is where its query starts, so its walk starts on the function's table and is no
# step of it: a routine alone has no step, and the element after it is the first step, written at the
# place after the routine, leaving the function's table for film by the key matched by name.
extend schema @assertContains(relation: "graphitron_path_need", rows: """
  coordinate,   target_type, start_table
  Query.rows,   Row,         films_for_actor
  Query.hopped, Film,        films_for_actor
  """)

extend schema @expectEquals(relation: "graphitron_join_path_step", rows: """
  coordinate,   target_type, position, element_place, from_table,      to_table
  Query.hopped, Film,        0,        1,             films_for_actor, film
  """)

extend schema @assertContains(relation: "graphitron_join_path_step_column", rows: """
  coordinate,   position, from_table,      from_column, to_table, to_column
  Query.hopped, 0,        films_for_actor, film_id,     film,     film_id
  """)
