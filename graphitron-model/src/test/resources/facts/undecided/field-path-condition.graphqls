# A chain link a condition method routes, read off the method's signature and keyed to the method.
# filmToFilmActor(Film, FilmActor) is real Java in the classpath corpus and the tables are the sakila
# catalog's: the first parameter names the departure and the second the arrival, each the table
# whose generated class is the parameter's erased class.
type Film @table(name: "film") {
  title: String
  filmActors: [FilmActor!]! @reference(path: [{condition: {
    className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
    method: "filmToFilmActor"
  }}])
}
type FilmActor @table(name: "film_actor") { lastUpdate: String @field(name: "last_update") }

# Two declarations of one name that agree on both slots, agreeingOnBoth(Customer, Address) and the
# same with a third parameter beside: two readings, one per declaration, and one route, so the path
# resolves to one link.
type Customer @table(name: "customer") {
  customerId: Int @field(name: "customer_id")
  addressByOverloads: Address @reference(path: [{condition: {
    className: "no.sikt.graphitron.rewrite.test.conditions.ConditionMethodRouteFixtures",
    method: "agreeingOnBoth"
  }}])
}
type Address @table(name: "address") { addressId: Int @field(name: "address_id") }

extend type Query { films: [Film!]! customers: [Customer!]! }

extend schema @assertContains(relation: "graphitron_field_path_resolution_condition", rows: """
  type_name, field_name, position, method_class_name,                                                         method_name,     from_table, to_table
  Film,      filmActors, 0,        no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures, filmToFilmActor, film,       film_actor
  """)

extend schema @assertContains(relation: "graphitron_field_path_resolution_condition", rows: """
  type_name, field_name,         method_name,    from_table, to_table
  Customer,  addressByOverloads, agreeingOnBoth, customer,   address
  """)

extend schema @assertContains(relation: "graphitron_field_table_link", rows: """
  type_name, field_name,         position, via,       from_table, to_table
  Customer,  addressByOverloads, 0,        CONDITION, customer,   address
  """)

# The walk takes a condition alone as the step its method's signature routes, joined by the method
# and no column, and a condition beside nothing else whose overloads agree as one step.
extend schema @assertContains(relation: "graphitron_field_path", rows: """
  type_name, field_name,         start_table, position, from_table, to_table
  Film,      filmActors,         film,        0,        film,       film_actor
  Customer,  addressByOverloads, customer,    0,        customer,   address
  """)

extend schema @assertContains(relation: "graphitron_field_path_method", rows: """
  type_name, field_name, position, method_class_name,                                                         method_name
  Film,      filmActors, 0,        no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures, filmToFilmActor
  """)

extend schema @assertAbsent(relation: "graphitron_field_path_column", rows: """
  type_name, field_name
  Film,      filmActors
  Customer,  addressByOverloads
  """)

extend schema @assertAbsent(relation: "graphitron_field_path_stop", rows: """
  type_name, field_name
  Customer,  addressByOverloads
  """)
