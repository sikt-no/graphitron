# Which table a column name written at a field's site resolves against. An object field resolves
# against where it lands, its target's own table where nothing walks it there; a field with a written
# path against where that path's walk arrives; and a scalar's own column is read on that table, or on
# its parent's where no path is written. A written path that stops, or arrives nowhere, is a silence
# and never the parent standing in; so is a field whose producer claims disagree. The editor reads
# the claims, stops, join paths and needs below.

type Film @table(name: "film") {
  title: String
  # film declares two keys to language: two routes, so the walk stops and arrives nowhere.
  languageName: String @reference(path: [{table: "language"}])
  actorName: String @reference(path: [{table: "film_actor"}, {table: "actor"}])
  # The applications compose, and the first already stops.
  twice: String @reference(path: [{table: "language"}]) @reference(path: [{table: "film_actor"}])
  # A written path ending short of the target's table walks to no landing.
  credits: Actor @reference(path: [{table: "film_actor"}])
  nowhere: String @reference(path: [{table: "no_such_table"}])
  twoTerminals: String @reference(path: [{table: "event"}])
  languages: [Language]
  pagedLanguages: [Language] @asConnection
  languageConnection: LanguageConnection
  related: Media
  serviced: [Language] @service(service: {className: "no.example.Svc", method: "langs"})
  pivoted: [Language] @pivot(on: "kind", value: "value")
  venues: [Venue]
  missings: [Missing]
  # Contested: two claims that exclude each other.
  contested: String @reference(path: [{table: "language"}])
    @service(service: {className: "no.example.Svc", method: "get"})
    @externalField(reference: {className: "no.example.Fields", method: "rating"})
  contestedNowhere: String @reference(path: [{table: "no_such_table"}])
    @service(service: {className: "no.example.Svc", method: "get"})
    @externalField(reference: {className: "no.example.Fields", method: "rating"})
  contestedTitle: String
    @service(service: {className: "no.example.Svc", method: "get"})
    @externalField(reference: {className: "no.example.Fields", method: "rating"})
}

type Language @table(name: "language") { name: String }
type Actor @table(name: "actor") { name: String @field(name: "first_name") }

# Bound to a bare name two schemas declare, so it binds nothing.
type Venue @table(name: "event") { name: String }

# Bound to a name no table carries, so it binds nothing either.
type Missing @table(name: "no_such_table") { name: String }

type LanguageConnection { edges: [LanguageEdge] }
type LanguageEdge { node: Language }

# A table-bound interface is one table per participant, not one table.
interface Media @table(name: "film") { title: String }

type Note { text: String }

# @table and @error contest the type: a type-grain conflict, which is no site here.
type Errored @table(name: "film") @error(handlers: [{handler: DATABASE}]) { title: String }

# A path written on an input field is a claim; nothing walks it to a landing yet.
input FilmFilter { languageName: String @reference(path: [{key: "film_language_id_fkey"}]) }

type Query {
  films(filter: FilmFilter): [Film]
  notes: [Note]
  erroreds: [Errored]
}

# Where a path is written: the fields whose column names follow it rather than their parent's.
extend schema @expectEquals(relation: "graphitron_join_path_claim", rows: """
  element_coordinate,      target_type, claim_kind
  Film.actorName,          String,      FIELD
  Film.contested,          String,      FIELD
  Film.contestedNowhere,   String,      FIELD
  Film.credits,            Actor,       FIELD
  Film.languageName,       String,      FIELD
  Film.nowhere,            String,      FIELD
  Film.twice,              String,      FIELD
  Film.twoTerminals,       String,      FIELD
  FilmFilter.languageName, String,      INPUT_FIELD
  """)

# A written path that stops is silent: two routes, or none.
extend schema @expectEquals(relation: "graphitron_join_path_stop", rows: """
  coordinate,            target_type, position, moves
  Film.contested,        String,      0,        2
  Film.contestedNowhere, String,      0,        0
  Film.languageName,     String,      0,        2
  Film.nowhere,          String,      0,        0
  Film.twice,            String,      0,        2
  Film.twoTerminals,     String,      0,        0
  """)

# A scalar's written path arrives where its walk does.
extend schema @assertContains(relation: "graphitron_join_path", rows: """
  coordinate,     target_type, target_table
  Film.actorName, String,      actor
  """)

# An object field with nothing written lands on its target's own table, where its column names
# resolve. Film.credits writes a path ending on film_actor, so no join path reaches Actor and its
# site is silent, though its need still names actor.
extend schema @assertContains(relation: "graphitron_path_need_table", rows: """
  coordinate,              target_type, start_table, landing_table
  Film.credits,            Actor,       film,        actor
  Film.languageConnection, Language,    film,        language
  Film.languages,          Language,    film,        language
  Film.pagedLanguages,     Language,    film,        language
  """)

# A scalar's own column, at each occurrence: none for a field whose walk arrives nowhere or whose
# claims disagree, nor under a @table that binds no table.
extend schema @expectEquals(relation: "graphitron_occurrence_column",
    where: "coordinate <> 'FactAnchor.paymentId'", rows: """
  coordinate,    bound,           column_name
  Actor.name,    public.actor,    first_name
  Errored.title, public.film,     title
  Film.title,    public.film,     title
  Language.name, public.language, name
  Media.title,   public.film,     title
  """)

# A @table that binds no table, ambiguous or unresolved, is its own defect and a row of no table:
# Venue and Missing are rows, never their parent's, and no one table says which.
extend schema @expectEquals(relation: "graphitron_result", where: "type_name IN ('Venue', 'Missing')", rows: """
  type_name, shape
  Missing,   ROW
  Venue,     ROW
  """)
extend schema @assertEmpty(relation: "graphitron_result_table", where: "type_name IN ('Venue', 'Missing')")
