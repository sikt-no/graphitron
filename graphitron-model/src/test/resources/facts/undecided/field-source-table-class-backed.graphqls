# A type with no table of its own that a class backs still has fields that depart from a table. One
# backed by a table's own record class is read on that table.

type Film @table(name: "film") { title: String }
type Language @table(name: "language") { name: String }

# Backed by FilmRecord, the record class of film, through the service that produces it.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

type Query {
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
}

extend schema @assertContains(relation: "graphitron_occurrence_source_table", rows: """
  coordinate,                      table_name
  Query.filmDetailsBatch.filmId,   film
  Query.filmDetailsBatch.language, film
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,                    coordinate
  NO_ROUTE_FROM_DEPARTURE, FilmDetailsCarrier.language
  """)

# A field under an object that wrote a path starts it on the key row it lifts the object onto: the
# columns of the table record the object is.
extend schema @assertContains(relation: "graphitron_path_need", rows: """
  coordinate,                      target_type, start_table
  Query.filmDetailsBatch.language, Language,    film
  """)

# And the path lands where it goes from there.
extend schema @assertContains(relation: "graphitron_join_path", rows: """
  coordinate,                      target_type, target_table
  Query.filmDetailsBatch.language, Language,    language
  """)
