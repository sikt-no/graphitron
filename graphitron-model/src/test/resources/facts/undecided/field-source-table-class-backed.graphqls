# A type with no table of its own that a class backs still has fields that depart from a table. One
# backed by a table's own record class is read on that table. A field carrying @sourceRow departs
# from the table declaring its path's first key, whose source-side columns the lifter returns.

type Film @table(name: "film") { title: String }
type Language @table(name: "language") { name: String }
type Address @table(name: "address") { address: String }

# Backed by FilmRecord, the record class of film, through the service that produces it.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
  language: [Language!]! @reference(path: [{key: "film_language_id_fkey"}])
}

# Backed by a plain class; the lifter returns customer.address_id.
type CustomerAddressSummary {
  customerId: Int!
  address: [Address!]!
    @sourceRow(
      className: "no.sikt.graphitron.rewrite.test.services.CustomerAddressSummaryLifter",
      method: "addressIdOf"
    )
    @reference(path: [{key: "customer_address_id_fkey"}])
  # The key in its schema, and by its generated constant.
  qualifiedAddress: [Address!]!
    @sourceRow(
      className: "no.sikt.graphitron.rewrite.test.services.CustomerAddressSummaryLifter",
      method: "addressIdOf"
    )
    @reference(path: [{key: "public.customer_address_id_fkey"}])
  constantAddress: [Address!]!
    @sourceRow(
      className: "no.sikt.graphitron.rewrite.test.services.CustomerAddressSummaryLifter",
      method: "addressIdOf"
    )
    @reference(path: [{key: "CUSTOMER__CUSTOMER_ADDRESS_ID_FKEY"}])
  # Two applications compose one path, and its first key is the first application's: element 0 of
  # the second, a key held by address, is not where the field departs.
  chainedAddress: [Address!]!
    @sourceRow(
      className: "no.sikt.graphitron.rewrite.test.services.CustomerAddressSummaryLifter",
      method: "addressIdOf"
    )
    @reference(path: [{key: "customer_address_id_fkey"}])
    @reference(path: [{key: "address_city_id_fkey"}])
}

extend type Query {
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  customerAddressSummary(customerId: Int!): CustomerAddressSummary
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CustomerAddressSummaryService", method: "lookup"})
}

extend schema @assertContains(relation: "graphitron_field_source_table", rows: """
  type_name,              field_name, from_table, basis
  FilmDetailsCarrier,     filmId,     film,       RECORD_CLASS
  FilmDetailsCarrier,     language,   film,       RECORD_CLASS
  CustomerAddressSummary, address,    customer,   SOURCE_ROW
  CustomerAddressSummary, qualifiedAddress, customer, SOURCE_ROW
  CustomerAddressSummary, constantAddress,  customer, SOURCE_ROW
  CustomerAddressSummary, chainedAddress,   customer, SOURCE_ROW
  """)

extend schema @assertAbsent(relation: "graphitron_field_source_table", rows: """
  type_name,              field_name,     from_table, basis
  CustomerAddressSummary, chainedAddress, address,    SOURCE_ROW
  """)

extend schema @assertAbsent(relation: "graphitron_entry_defect_site", rows: """
  code,                    coordinate
  NO_ROUTE_FROM_DEPARTURE, FilmDetailsCarrier.language
  NO_ROUTE_FROM_DEPARTURE, CustomerAddressSummary.address
  NO_ROUTE_FROM_DEPARTURE, CustomerAddressSummary.qualifiedAddress
  NO_ROUTE_FROM_DEPARTURE, CustomerAddressSummary.constantAddress
  """)

# A field under an object that wrote a path starts it on the key row it lifts the object onto: the
# columns of the table record the object is, or the columns a @sourceRow lifter returns.
extend schema @expectEquals(relation: "graphitron_field_path_start_lifted", rows: """
  type_name,              field_name,       start_table, kind,   key_kind
  FilmDetailsCarrier,     language,         film,        LIFTED, COLUMNS
  CustomerAddressSummary, address,          customer,    LIFTED, SOURCE_ROW
  CustomerAddressSummary, qualifiedAddress, customer,    LIFTED, SOURCE_ROW
  CustomerAddressSummary, constantAddress,  customer,    LIFTED, SOURCE_ROW
  CustomerAddressSummary, chainedAddress,   customer,    LIFTED, SOURCE_ROW
  """)

# And the path lands where it goes from there.
extend schema @assertContains(relation: "graphitron_field_path_landing", rows: """
  type_name,              field_name,     start_table, table_name
  FilmDetailsCarrier,     language,       film,        language
  CustomerAddressSummary, address,        customer,    address
  CustomerAddressSummary, chainedAddress, customer,    city
  """)
