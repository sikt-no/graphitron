# The column a scalar field with no path reads, on each table its read departs from. The spelling is
# the @field(name:) where one is written and the field's own name otherwise, folded by case, and the
# SQL name answers before the generated one. A spelling naming no column there, or several, has no
# row and is a defect at the field. case_twins has "Code" and "code", which its codegen names
# CAPITAL_CODE and CODE.

type Film @table(name: "film") {
  # Its own name, and @field with the case changed.
  title: String
  name: String @field(name: "TITLE")
  # Names no column.
  titel: String
  renamed: String @field(name: "no_such_column")
  details: Details
  # Produces an object of its own, whose fields are read off it rather than off film.
  sharedTranslations: SharedTranslations @service(service: {
    className: "no.sikt.graphitron.rewrite.test.services.SharedValueTypeService",
    method: "translationsByFilm"
  })
}

type SharedTranslations {
  nb: String
  en: String
}

# The same through @externalField, and a level further down.
type Inventory @table(name: "inventory") {
  filmCardData: FilmCardWrapper @externalField(reference: {
    className: "no.sikt.graphitron.rewrite.test.extensions.InventoryExtensions",
    method: "filmCardData"
  })
}

type FilmCardWrapper {
  example: RecordExample
}

type RecordExample {
  fieldA: String
  fieldC: String @field(name: "rebound")
}

# A nesting type implementing Node reads id as a node's identity. One that does not reads it as a
# column, even under a node, and language has none.
interface Node { id: ID! }

type Lang implements Node @table(name: "language") @node {
  id: ID!
  info: LangInfo
  plain: LangPlain
}

type LangInfo implements Node {
  id: ID!
  name: String
}

type LangPlain {
  id: ID!
}

# An input type is no read; its deprecated @table binds it, and nothing here judges its fields.
input FilmFilter @table(name: "film") {
  titel: String
}

type Language @table(name: "language") {
  details: Details
}

# No table of its own: reached from Film and from Language, its fields read both tables. title is
# film's alone, so read from Language it names nothing.
type Details {
  lastUpdate: String @field(name: "last_update")
  title: String
}

type Twins @table(name: "case_twins") {
  # Only the generated name of "Code" answers.
  capital: String @field(name: "CAPITAL_CODE")
  # Both columns fold onto it.
  code: String
}

# Backed by FilmRecord, the record class of film, so read off the record.
type FilmDetailsCarrier {
  filmId: Int @field(name: "film_id")
}

# Backed by a plain class with no table: read off the object, no column.
type CustomerAddressSummary {
  customerId: Int!
}

extend type Query {
  films: [Film!]!
  filteredFilms(filter: FilmFilter): [Film!]!
  inventories: [Inventory!]!
  langs: [Lang!]!
  languages: [Language!]!
  twins: [Twins!]!
  filmDetailsBatch(ids: [Int!]!): [FilmDetailsCarrier!]!
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.FilmCarrierService", method: "filmsByIds"})
  customerAddressSummary(customerId: Int!): CustomerAddressSummary
    @service(service: {className: "no.sikt.graphitron.rewrite.test.services.CustomerAddressSummaryService", method: "lookup"})
}

extend schema @expectEquals(relation: "graphitron_field_target_column", rows: """
  type_name,          field_name, from_table, column_name, matched_by
  Details,            lastUpdate, film,       last_update, SQL_NAME
  Details,            lastUpdate, language,   last_update, SQL_NAME
  Details,            title,      film,       title,       SQL_NAME
  Film,               name,       film,       title,       SQL_NAME
  Film,               title,      film,       title,       SQL_NAME
  FilmDetailsCarrier, filmId,     film,       film_id,     SQL_NAME
  LangInfo,           name,       language,   name,        SQL_NAME
  Twins,              capital,    case_twins, Code,        JOOQ_NAME
  """)

extend schema @expectEquals(relation: "graphitron_entry_defect_site", rows: """
  code,              type_name, field_name, detail
  COLUMN_AMBIGUOUS,  Twins,     code,       code
  COLUMN_UNRESOLVED, Details,   title,      title
  COLUMN_UNRESOLVED, Film,      renamed,    no_such_column
  COLUMN_UNRESOLVED, Film,      titel,      titel
  COLUMN_UNRESOLVED, LangPlain, id,         id
  """)

# The columns an ambiguous spelling folds onto are the match's rows, one each.
extend schema @assertContains(relation: "graphitron_field_target_column_match", rows: """
  type_name, field_name, from_table, column_name, candidates
  Twins,     code,       case_twins, Code,        2
  Twins,     code,       case_twins, code,        2
  """)

# Nothing departs from the parent's table through a field producing its own object.
extend schema @assertAbsent(relation: "graphitron_field_source_table", rows: """
  type_name,          field_name
  SharedTranslations, nb
  FilmCardWrapper,    example
  RecordExample,      fieldA
  """)
