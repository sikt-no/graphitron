<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-model</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        The generator's fact tier: the fact-schema DDL, the jOOQ compile-time surface generated
        from it, the in-memory H2 bootstrap a run captures into, and capture itself, which reads a
        consumer's GraphQL schema, jOOQ-generated database classes and compiled Java and writes
        down what it found. Builds before graphitron so core compiles against the generated
        classes and cannot reach back into the tier that feeds it.
    </description>

    <properties>
        <!--
            Where the codegen driver writes and build-helper reads. Never committed; the DDL
            resource is the single source and this tree is derived from it on every build.
        -->
        <model.generated.sources>${project.build.directory}/generated-sources/jooq</model.generated.sources>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>
        <!--
            The embedded store, at both cadences: the build-time codegen driver boots it so jOOQ
            reads live H2 metadata, and the run-time bootstrap boots it so a generator run has
            somewhere to capture into. One engine, one DDL, so a bootstrap regression fails
            codegen with a real H2 error before it can fail a generator run.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <!--
            The consumer's GraphQL schema is one of the three sources capture reads, so the module
            that says what a schema fact is parses schemas itself. Not a leak upward: nothing here
            walks the classified graph, it reads the SDL a consumer wrote.
        -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
        </dependency>
        <!-- Federation's directive vocabulary, which the schema assembly applies before capture. -->
        <dependency>
            <groupId>com.apollographql.federation</groupId>
            <artifactId>federation-graphql-java-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- SchemaRecipe's one glob dialect; version pinned in the root pom's properties. -->
        <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
        </dependency>
        <!--
            Build-time only: the codegen driver's GenerationTool. Provided rather than compile so
            consumers of the model artifact do not inherit jOOQ's code generator; the driver class
            it compiles is a build tool that happens to live in the module's source tree, per the
            single-module driver wiring the H2-functions spike settled on.
        -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen</artifactId>
            <version>${version.org.jooq}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-sakila-db</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Renaming or dropping a relation deletes its generated source, but the class compiled
                from it survives in target/classes and still resolves, so a stale jar installs and
                the failure surfaces as "cannot find symbol" in a downstream module. Wiping the
                output between codegen and the compile that follows keeps the promise the DDL header
                makes, that editing the schema and following the compiler is the whole procedure.

                The phase is load-bearing. The javadoc reference gate forks generate-sources at
                verify, which re-runs everything bound at or before that phase; a clean bound there
                would fire again after packaging and strip target/classes of the classes the run had
                already compiled. process-sources is past the fork's reach and still ahead of
                compile, which recompiles both source roots from scratch.
            -->
            <!--
                The compile-time surface, generated from the fact schema the DDL states.

                H2 runs the DDL inside jOOQ's own connection through INIT=RUNSCRIPT, and the
                database is in-memory and never persisted. Both halves are load-bearing. A
                persisted database reopened by a second process loses its comments on view
                columns: H2 rebuilds a view from the SQL it stored and the column comments do not
                come with it, which silently drops 1142 of this schema's 3468 column comments from
                the generated source. Running the script on the generating connection is what
                keeps them, and is why this is one execution rather than a schema step and a
                codegen step.

                Reading the DDL from src/main/resources directly, rather than off the classpath,
                is what makes "edit the DDL and follow the compiler" true on every build without a
                resource copy sequenced ahead of codegen.
            -->
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>${version.com.h2database}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-model-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <jdbc>
                                <driver>org.h2.Driver</driver>
                                <url>jdbc:h2:mem:graphitron-model-codegen;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM '${project.basedir}/src/main/resources/no/sikt/graphitron/model/graphitron-model.sql'</url>
                                <user>sa</user>
                                <password></password>
                            </jdbc>
                            <generator>
                                <database>
                                    <name>org.jooq.meta.h2.H2Database</name>
                                    <inputSchema>PUBLIC</inputSchema>
                                    <includes>.*</includes>
                                    <excludes></excludes>
                                    <includeRoutines>false</includeRoutines>
                                    <includeIndexes>false</includeIndexes>
                                    <includeSequences>false</includeSequences>
                                    <includeUDTs>false</includeUDTs>
                                    <forcedTypes>
                                        <forcedType>
                                            <userType>no.sikt.graphitron.model.vocabulary.EntryKind</userType>
                                            <enumConverter>true</enumConverter>
                                            <includeExpression>PUBLIC\.GRAPHQL_AST_ENTRY\.ENTRY_KIND</includeExpression>
                                            <includeTypes>.*</includeTypes>
                                        </forcedType>
                                    </forcedTypes>
                                </database>
                                <generate>
                                    <comments>true</comments>
                                    <commentsOnCatalogs>false</commentsOnCatalogs>
                                    <commentsOnSchemas>false</commentsOnSchemas>
                                    <implicitJoinPathsToMany>false</implicitJoinPathsToMany>
                                    <daos>false</daos>
                                    <pojos>false</pojos>
                                    <interfaces>false</interfaces>
                                    <globalObjectNames>true</globalObjectNames>
                                </generate>
                                <target>
                                    <packageName>no.sikt.graphitron.model</packageName>
                                    <directory>${model.generated.sources}</directory>
                                    <clean>true</clean>
                                </target>
                            </generator>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>drop-stale-generated-classes</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}/no/sikt/graphitron/model</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                The javadoc reference gate reads the project's source roots, and inside this module
                the generated tables are a source-only symbol: every other module resolves
                no.sikt.graphitron.model.Tables off this module's jar, but here it exists only under
                target/generated-sources until compile. The gate forks generate-sources, which
                regenerates the tree, yet the source root build-helper adds during that fork does not
                reach the sourcepath the forked javadoc run is given, so a hand-written class in this
                module that names a generated relation fails the gate with "cannot find symbol"
                rather than with a dangling link. Naming both roots here is what lets model code use
                the compile-checked table constants like every downstream reader does.

                The cost, since it is visible: javadoc parses what it resolves, so the generated
                tree's own comments are scanned too and the gate's output carries a block of
                "unknown tag" warnings from DDL prose that reads as a javadoc tag (@field, @enum).
                Warnings, not errors, and failOnWarnings is deliberately unset on the gate in the
                parent pom. The alternatives were worse: excluding this module's read-side classes
                would hollow out the gate exactly where new code lands, and dropping the generated
                constants for dynamic SQL would trade a compile-checked column name for a string.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-link-references</id>
                        <configuration>
                            <sourcepath>${project.basedir}/src/main/java:${model.generated.sources}</sourcepath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Republish the compiled tests as a test-jar. What consumers want from it is the
                store harness under no/sikt/graphitron/model/test: the named store-lifetime entry
                points and the seeding helpers over the relations this module's DDL declares.
                Every module downstream builds its own fixtures over that floor rather than
                re-deriving one against GraphitronModelStore, which is what four independent
                copies of the same store bootstrap had already cost.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-model-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${model.generated.sources}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
