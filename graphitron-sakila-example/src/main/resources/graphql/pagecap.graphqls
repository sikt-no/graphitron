# Page-size maximum fixture, generated by the rewrite-generate-page-cap execution with
# <maxAllowedPageSize>2</maxAllowedPageSize>. Isolated from schema.graphqls because that schema's
# tests read pages larger than any maximum would leave them and pin the uncapped overflow error.
#
# One connection of each kind the maximum has to reach through ConnectionHelper.pageRequest: a root
# @asConnection with no defaultFirstValue, a root connection type declared by hand whose first has
# no default, a @splitQuery child connection, and a multi-table polymorphic connection. The fixture
# rows are few (five films, three customers in store 1 and two in store 2, two staff), so the
# maximum is 2: every connection has more rows than that, and store 2 has exactly that many.
#
# Kept apart from the definitions by the blank line below, so the published schema does not take
# these lines as Query's description.

type Query {
    films: [Film!]! @asConnection @defaultOrder(primaryKey: true)
    filmsConnection(
        first: Int, last: Int, after: String, before: String
    ): FilmsConnection! @defaultOrder(primaryKey: true)
    stores: [Store!]! @defaultOrder(primaryKey: true)
    occupants: [Occupant!]! @asConnection
}

type Film @table(name: "film") {
    filmId: Int! @field(name: "film_id")
    title: String!
}

type Store @table(name: "store") {
    storeId: Int! @field(name: "store_id")
    customers: [Customer!]! @asConnection @splitQuery
        @reference(path: [{key: "customer_store_id_fkey"}]) @defaultOrder(primaryKey: true)
}

type Customer @table(name: "customer") {
    customerId: Int! @field(name: "customer_id")
}

type Staff @table(name: "staff") {
    staffId: Int! @field(name: "staff_id")
}

union Occupant = Customer | Staff

type FilmsConnection {
    edges: [FilmsEdge!]!
    nodes: [Film!]!
    pageInfo: PageInfo!
}

type FilmsEdge {
    cursor: String!
    node: Film!
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}
