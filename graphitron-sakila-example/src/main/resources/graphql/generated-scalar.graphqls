# A wrong generated scalar value routed into a payload through @error, generated by the
# rewrite-generate-generated-scalar execution: the decode at the call refuses it with the generated
# GraphitronClientException, naming the argument, and a GENERIC handler naming that class claims it
# into the payload's errors. On its own execution because the handler names the client exception
# under this execution's output package. Every other case of a generated scalar's decode is
# graphitron's GeneratedScalarCallExecutionTest, over a fact scenario.

scalar Path @generatedScalar(kind: SCHEMA_PATH)

type Query {
    films: [Film!]!
    endType(path: Path @assertType(component: "endType", type: {is: "Film"})): EndTypePayload
        @service(service: {className: "no.sikt.graphitron.rewrite.test.services.GeneratedScalarService",
            method: "endType", argMapping: "end: path.endType"})
}

type Film @table(name: "film") {
    title: String
}

type EndTypePayload {
    endType: String
    errors: [EndTypeError]
}

type PathRefused @error(handlers: [{
    handler: GENERIC,
    className: "no.sikt.graphitron.generated.generatedscalar.schema.GraphitronClientException"
}]) {
    path: [String!]!
    message: String!
}

union EndTypeError = PathRefused
