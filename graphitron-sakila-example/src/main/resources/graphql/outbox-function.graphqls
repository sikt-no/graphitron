# @outbox through the <function> target, generated by the rewrite-generate-outbox-function execution
# whose <outbox> names the stored routine outbox_emit instead of the outbox table. Isolated from
# schema.graphqls because a build configures one outbox target, and that schema's @outbox fields write
# to the table.
#
# One insert and one ID-returning delete: the insert reads two columns of the written row, so its
# message is evaluated from the written rows, and the delete can only name the node id.

interface Node { id: ID! }

type Query {
    films: [Film!]!
}

type Film implements Node @table(name: "film") @node {
    id: ID! @nodeId
    title: String!
}

input FilmCreateInput {
    title:      String! @field(name: "title")
    languageId: Int!    @field(name: "language_id")
}

input FilmDeleteInput {
    filmId: Int! @field(name: "film_id")
}

type Mutation {
    createFilmRoutine(in: FilmCreateInput!): Film
        @mutation(typeName: INSERT)
        @outbox(event: "FilmCreated", argMapping: "filmId: $result.id, title: $result.title")
    deleteFilmRoutine(in: FilmDeleteInput!): ID
        @mutation(typeName: DELETE, table: "film")
        @outbox(event: "FilmDeleted", argMapping: "id: $result")
}
