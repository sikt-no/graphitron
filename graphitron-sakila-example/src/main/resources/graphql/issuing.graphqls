extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

# Issuing fixture (VoucherIssueExecutionTest). A film below its language vouches for itself to
# another subgraph: the voucher absorbs the film's id and title, the title being vouched for, and the
# subgraph publishes FilmVoucher with the voucher alone. Kept out of the shared schemas, since a build
# that vouches takes voucher keys on every runtime.

type Query {
  languages: [Language!]!
  applications: [Application!]!
}

type Language @table(name: "language") {
  name: String
  films: [FilmVoucher!]! @reference(path: [{key: "film_language_id_fkey"}])
}

type FilmVoucher @table(name: "film") @issue(scope: "films", ttl: "PT5M", vouchesFor: "title") {
  filmId: ID! @field(name: "film_id")
  title: String!
}

# The voucher handover (VoucherAcceptExecutionTest): an application's results, written the way the
# accepting graph's key looks. Each result vouches for its owner, and its id is the lookup part.
type Application @table(name: "vouched_application") {
  applicationId: Int! @field(name: "application_id")
  results: [VgsResultat!]! @reference(path: [{key: "vouched_application_result_application_id_fkey"}])
}

type VgsResultat @table(name: "vouched_application_result") @issue(scope: "vgs-resultater", ttl: "PT5M", vouchesFor: "eierId") {
  id: ID! @field(name: "result_id")
  eierId: String! @field(name: "owner_id")
}
