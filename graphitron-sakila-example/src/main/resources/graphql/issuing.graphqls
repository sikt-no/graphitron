extend schema @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key"])

# Issuing fixture (VoucherIssueExecutionTest). A film below its language vouches for itself to
# another subgraph: the voucher absorbs the film's id and title, the title being the claims, and the
# subgraph publishes FilmVoucher with the voucher alone. Kept out of the shared schemas, since a build
# that vouches takes voucher keys on every runtime.

type Query {
  languages: [Language!]!
}

type Language @table(name: "language") {
  name: String
  films: [FilmVoucher!]! @reference(path: [{key: "film_language_id_fkey"}])
}

type FilmVoucher @table(name: "film") {
  filmId: ID! @field(name: "film_id")
  title: String!
  voucher: String! @issue(scope: "films", ttl: "PT5M", claims: "title")
}
