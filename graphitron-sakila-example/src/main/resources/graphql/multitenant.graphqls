# Multi-tenant fixture: compiled with <tenantColumn>film_id</tenantColumn> (see the
# rewrite-generate-multitenant execution in this module's pom), so this is the compile-tier
# proof that operation-divined tenant routing emits valid Java 17 for every TenantBinding arm.
# The sakila catalog's film_id plays the tenant id: film, inventory and film_actor classify
# tenant-scoped; language (no film_id column) classifies global and serves as the default-source
# reference data, or the request's default tenant's when it names one. Kept deliberately slim: one
# field per arm, nothing else.

interface Node { id: ID! }

# @node with the tenant column as its whole key: decoding one of its ids yields the tenant
# directly. Serves two shapes below, an UPDATE keyed by its own id and an INSERT naming it as an
# FK target, and widens the node-dispatch coverage beside FilmActor from a composite key to a
# single-column one.
type Film implements Node @table(name: "film") @node(keyColumns: ["film_id"]) {
    id: ID! @nodeId
    title: String
    # Inherited arm: a batched child below the divining root. The DataLoader registration reads
    # the tenant-partitioned loader name and the rows method re-acquires from the handed-down
    # tenant, so each batch stays tenant-homogeneous.
    inventories: [Inventory!]! @splitQuery @reference(path: [{key: "inventory_film_id_fkey"}])
    # Inline nested projection: under a fanned root this multiset rides inside each tenant's own
    # statement, so the subtree inherits the tenant by construction.
    actors: [FilmActor!] @reference(path: [{key: "film_actor_film_id_fkey"}])
    # The $session per-key proof: a batched child service under fan-out runs each tenant's
    # batch on that tenant's own pinned connection, and the bound identity parameter reads
    # that connection's mounted handle, so two tenants in one operation observe two distinct
    # handles.
    mountedPrincipal: String @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.SessionIdentityService",
        method: "mountedPrincipal",
        argMapping: "identity: $session"
    })
    # Connection-binding child services: they reach no table of their own, but are handed a
    # DSLContext, so under a tenant-bound parent they run on the parent's tenant. One takes the
    # DSLContext as a parameter, the other through its holder's constructor.
    servedBy: String @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService", method: "servedBy"})
    servedByHolder: String @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingHolderService", method: "servedBy"})
}

type Inventory @table(name: "inventory") {
    inventoryId: Int @field(name: "inventory_id")
    # Global-read batched child of a tenant-scoped parent: store is global, so its batch runs on
    # the request's default tenant, else the default source, whatever tenant the inventory came from.
    store: Store @splitQuery @reference(path: [{key: "inventory_store_id_fkey"}])
}

# Global reference data reached from below a tenant-bound root. Its endorsements path is a
# condition join between two global tables that returns every fixture endorsement, so an
# endorsement of another tenant's film is reachable under a bound tenant.
type Store @table(name: "store") {
    storeId: Int @field(name: "store_id")
    endorsements: [FilmEndorsement!]! @splitQuery @reference(path: [{condition: {
        className: "no.sikt.graphitron.rewrite.test.conditions.ReferencePathConditionFixtures",
        method: "everyTenantFixtureEndorsement"}}])
}

# ParentRowBound arm: film_endorsement is global, and its foreign key endorsed_film lands on
# film.film_id, the tenant column. Each endorsement row names the tenant that holds its film, so
# the batched film child routes per parent row, partitions its loader per tenant, and hands the
# tenant down to the film's own children.
type FilmEndorsement @table(name: "film_endorsement") {
    note: String
    film: Film @splitQuery
}

# ParentRowBound at every cardinality, over a reference that may point nowhere: film_bookmark is
# global and its nullable bookmarked_film lands on film.film_id. The list and connection fields
# take a two-hop path whose first hop carries the tenant, so the inventory statement runs in the
# tenant the bookmark names. A bookmark of no film answers null, [] and an empty page.
type FilmBookmark @table(name: "film_bookmark") {
    note: String
    film: Film @splitQuery
    inventories: [Inventory!]! @splitQuery @reference(path: [
        {key: "film_bookmark_bookmarked_film_fkey"}, {key: "inventory_film_id_fkey"}])
    inventoriesConnection(first: Int, after: String): [Inventory!]! @asConnection @splitQuery
        @reference(path: [{key: "film_bookmark_bookmarked_film_fkey"}, {key: "inventory_film_id_fkey"}])
        @defaultOrder(primaryKey: true)
}

# Global-read arm: global reference data on the request's default tenant, else the default source.
type Language @table(name: "language") {
    name: String
    # Default-source arm: a child service on a global parent runs on the default source whatever
    # default tenant the request names, since its SQL is opaque to the build.
    servedBy: String @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService", method: "languageServedBy"})
    # FanOut batched form: a fanned child of an untenanted parent. The marker itself forces the
    # fetcher boundary (no @splitQuery needed), and the rows method runs one batch statement per
    # tenant per parent batch through the scatter helper.
    films: [Film] @reference(path: [{key: "film_language_id_fkey"}]) @tenantFanOut
}

# NodeIdBound arm: the node id key embeds the tenant column (position 1), so a nodes(ids:) batch
# spanning tenants partitions per decoded tenant at the dispatch surface.
type FilmActor implements Node @table(name: "film_actor") @node(keyColumns: ["actor_id", "film_id"]) {
    id: ID! @nodeId
    actorId: Int @field(name: "actor_id")
}

# A three-column key with the tenant in the middle (slot 1), whose note_txt is a writable non-key
# column: the composite-key UPDATE keyed by a node id, beside the arity-1 Film UPDATE below.
type FilmActorNote implements Node @table(name: "film_actor_note")
        @node(keyColumns: ["actor_id", "film_id", "lang_code"]) {
    id: ID! @nodeId
    noteTxt: String @field(name: "note_txt")
}

# A composite key (film_id, scene_no) whose self-FK film_scene_parent_fk repeats the tenant column:
# a reference to a sibling scene carries a tenant of its own.
type FilmScene implements Node @table(name: "film_scene") @node(keyColumns: ["film_id", "scene_no"]) {
    id: ID! @nodeId
    label: String @field(name: "label")
    parentSceneNo: Int @field(name: "parent_scene_no")
}

# ArgumentBound mutation arm: the INSERT input's filmId maps to the tenant column and divines
# the routing for the write (and its follow-up re-read, which reuses the pinned connection).
input InventoryCreateInput {
    filmId: Int! @field(name: "film_id")
    storeId: Int! @field(name: "store_id")
}

type Query {
    # ArgumentBound root: filter argument mapping to the tenant column routes the subtree.
    films(filmId: Int! @field(name: "film_id")): [Film!]!
    # The read-side decoded-slot arm: a same-table composite @nodeId filter whose key embeds the
    # tenant column. The wire value is an encoded key rather than the tenant value, so the routed
    # acquisition decodes it and reads slot 1; every id in one call must decode to one tenant.
    filmActorsByNodeId(ids: [ID!] @nodeId(typeName: "FilmActor")): [FilmActor!]!
    # The suppressed-predicate arm: the field-level override takes every argument's implicit
    # predicate over, so no predicate names film_id, yet the argument still binds the tenant
    # column and routes the statement. The only field here whose slot cannot come from a
    # predicate. Compile-only: the authored method names a column film does not carry.
    filmsUnderOverride(filmId: Int! @field(name: "film_id")): [Film!]!
        @condition(condition: {className: "no.sikt.graphitron.rewrite.test.conditions.InputFieldConditionFixtures", method: "tilgangAdminOnly"}, override: true)
    # FanOut arm: the query runs once per tenant in the request's fan-out domain (the factory's
    # tenant collection intersected with the tenant map) and the results union in domain order;
    # each row carries its tenant as per-element localContext, so children (the @splitQuery
    # inventories child included) inherit and route with no extra machinery. Nullable elements:
    # a failed tenant contributes one null element plus a path-bearing error (partial success).
    filmsEverywhere: [Film] @tenantFanOut
    # The strict-elements variant: any tenant failure nulls the whole field via null-bubbling.
    filmsEverywhereStrict: [Film!] @tenantFanOut
    # ROUTED carrier: an ArgumentBound connection root. The routed DSLContext rides the
    # generated connection carrier, so the lazy totalCount aggregate runs against the same
    # divined tenant source as the page query instead of re-acquiring by environment.
    filmsConnectionScoped(filmId: Int! @field(name: "film_id"), first: Int, after: String):
        [Film!]! @asConnection @defaultOrder(primaryKey: true)
    # Global-read root: acquires dslGlobal(), the request's default tenant when it names one,
    # never the divined context.
    languages: [Language!]!
    # Global-read connection: the page and its totalCount ride one carrier on the default tenant.
    languagesConnection: [Language!]! @asConnection @defaultOrder(primaryKey: true)
    # Global-read multi-table polymorphic root.
    globalThings: [GlobalThing!]!
    # A root service returning a global @table: the service's SQL is opaque, so it runs on the
    # default source, and graphitron re-reads its rows on that same connection.
    languagesOnConnection: [Language!]! @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "languagesOnConnection"})
    # Untenanted root over the global endorsements, whose film child routes on each row.
    endorsements(note: String! @field(name: "note")): [FilmEndorsement!]!
    # Untenanted root over the global bookmarks, whose children route on each row or answer empty.
    bookmarks(note: String! @field(name: "note")): [FilmBookmark!]!
    # @globalData: a root service handed a connection whose arguments name no tenant. Unmarked
    # it would be a build error; the marker states its SQL touches only global data, so it runs on
    # the default source.
    globalServedBy: String @globalData @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "globalServedBy"})
    # A @globalData producer whose payload re-projects a global row on its own coordinate.
    globalLanguage: GlobalLanguagePayload @globalData @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "globalLanguage"})
    node(id: ID!): Node
    nodes(ids: [ID!]!): [Node]!
}

# The decoded-key write inputs. Each identifies its rows by a node id whose key embeds the
# tenant column, so the tenant is a slot of the decode the carrier already performs rather than
# a value the input names.
input DeleteFilmActorByNodeIdInput {
    id: ID! @nodeId(typeName: "FilmActor")
}

# The arity-1 carrier: the decoded key is one column and that column is the tenant, so the read
# is the whole decode's slot 0. Rides the WHERE partition; the SET partition is the title.
input UpdateFilmByNodeIdInput {
    id: ID! @nodeId(typeName: "Film")
    title: String @field(name: "title")
}

# The composite carrier on the WHERE partition: the decoded key is (actor_id, film_id, lang_code)
# and the tenant is its slot 1; the SET partition is the note text.
input UpdateFilmActorNoteByNodeIdInput {
    id: ID! @nodeId(typeName: "FilmActorNote")
    noteTxt: String @field(name: "note_txt")
}

# The FK-target reference carrier: the decoded Film key lifts onto inventory.film_id through
# inventory_film_id_fkey, and that lifted own-table column is the tenant column, so the INSERT
# routes without naming film_id at all.
input InventoryCreateByFilmRefInput {
    filmRef: ID! @nodeId(typeName: "Film")
    storeId: Int! @field(name: "store_id")
}

# The agreement-checked SET slot: parent writes film_id in SET through the self-FK, a value the
# walker checks equal to id's, so it co-binds the tenant beside id and a parent naming another
# tenant is refused before any connection. label keeps a SET field when parent is omitted.
input UpdateFilmSceneParentInput {
    id: ID! @nodeId(typeName: "FilmScene")
    parent: ID @nodeId(typeName: "FilmScene") @reference(path: [{key: "film_scene_parent_fk"}])
    label: String @field(name: "label")
}

# The divining @service inputs: each names the tenant through a decoded node id bound to a jOOQ
# record, so the service call runs on that tenant's connection and hands the tenant down to the
# rows it returns. A row's optional second id joins the agreement fold when it is sent.
input FilmRatingInput {
    film: ID! @nodeId(typeName: "Film")
    alsoFilm: ID @nodeId(typeName: "Film")
    rating: String
}

# A jOOQ record parameter whose composite key carries the tenant at position 1.
input FilmActorRatingInput {
    id: ID! @nodeId(typeName: "FilmActor")
}

# A create-shaped input: no row or id exists yet, so the input names the tenant by value, and
# @tenant marks that value as what routes the service.
input RateByFilmIdInput {
    filmId: Int! @tenant
    rating: Int
}

# The marked value beside a decoded id: both name a tenant, and they must agree.
input RateByFilmIdAndFilmInput {
    filmId: Int! @tenant
    film: ID! @nodeId(typeName: "Film")
}

# A non-table wrapper: ranOn is the database the service ran on, and films inherit the tenant.
type RateFilmsPayload {
    ranOn: String
    films: [Film!]!
}

# The same beside a global row: language re-projects the service's record on its own coordinate,
# a global read, so the request's default tenant answers it whatever tenant the service ran on.
# Typed GlobalLanguage rather than Language: Language.films is @tenantFanOut, and fan-out refuses a
# field reachable below a tenant-bound ancestor on any path.
type RatedFilmsLanguagePayload {
    ranOn: String
    films: [Film!]!
    language: GlobalLanguage
}

# The language table again, slim and with no fanned child, so it can sit below tenant-bound edges:
# the tenant-routed payload above, and node dispatch, which divines a tenant for the tenant-scoped
# node types. A node type, so node dispatch over a global type follows the default tenant too.
type GlobalLanguage implements Node @table(name: "language") @node(keyColumns: ["language_id"]) {
    id: ID! @nodeId
    name: String
}

# A default-source producer's payload: servedBy is the database the @globalData service ran on,
# and language is a global read like any other, so it reads the request's default tenant.
type GlobalLanguagePayload {
    servedBy: String
    language: Language
}

# A polymorphic root over global participants only.
union GlobalThing = Language | Store

# A global write: film_endorsement has no tenant column, so the insert runs on the default source
# whatever default tenant the request names.
input FilmEndorsementCreateInput {
    endorsedFilm: Int! @field(name: "endorsed_film")
    note: String! @field(name: "note")
}

# The same wrapper on the error channel: the stamped return is the Outcome-wrapped payload.
type RateFilmsCheckedPayload {
    ranOn: String
    films: [Film!]
    errors: [RateFilmsError]
}

type RateFilmsDbError @error(handlers: [{handler: DATABASE}]) {
    path: [String!]!
    message: String!
}

union RateFilmsError = RateFilmsDbError

type Mutation {
    # ArgumentBound @service arms: the tenant is divined from the batch's ids before the service
    # is called, so a batch naming two tenants is refused without running it.
    rateFilms(in: [FilmRatingInput!]!): RateFilmsPayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilms", argMapping: "ratings: in"})
    # Binds no DSLContext, so the call needs no connection, yet the divined tenant still rides
    # down to the returned rows.
    # A tenant-routed producer whose payload re-projects a global row on its own coordinate.
    rateFilmsWithLanguage(in: [FilmRatingInput!]!): RatedFilmsLanguagePayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilmsWithLanguage", argMapping: "ratings: in"})
    rateFilmsOffline(in: [FilmRatingInput!]!): RateFilmsPayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilmsOffline", argMapping: "ratings: in"})
    rateFilmsChecked(in: [FilmRatingInput!]!): RateFilmsCheckedPayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilmsChecked", argMapping: "ratings: in"})
    rateFilmsByFilmId(in: [RateByFilmIdInput!]!): RateFilmsPayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilmsByFilmId", argMapping: "ratings: in"})
    rateFilmsByFilmIdAndFilm(in: [RateByFilmIdAndFilmInput!]!): RateFilmsPayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilmsByFilmIdAndFilm", argMapping: "ratings: in"})
    rateFilmActors(in: [FilmActorRatingInput!]!): RateFilmsPayload @service(service: {
        className: "no.sikt.graphitron.rewrite.test.services.FilmRatingService",
        method: "rateFilmActors", argMapping: "actors: in"})
    createInventory(in: InventoryCreateInput!): Inventory @mutation(typeName: INSERT)
    createEndorsement(in: FilmEndorsementCreateInput!): FilmEndorsement @mutation(typeName: INSERT, table: "film_endorsement")
    createInventoryByFilmRef(in: InventoryCreateByFilmRefInput!): Inventory @mutation(typeName: INSERT, table: "inventory")
    # Single and bulk: the bulk form is where the agreement guard earns its keep, refusing a
    # batch whose ids decode to two tenants before any SQL runs.
    deleteFilmActorByNodeId(in: DeleteFilmActorByNodeIdInput!): ID @mutation(typeName: DELETE, table: "film_actor")
    deleteFilmActorsByNodeId(in: [DeleteFilmActorByNodeIdInput!]!): [ID!]! @mutation(typeName: DELETE, table: "film_actor")
    updateFilmByNodeId(in: UpdateFilmByNodeIdInput!): Film @mutation(typeName: UPDATE, table: "film")
    updateFilmActorNoteByNodeId(in: UpdateFilmActorNoteByNodeIdInput!): ID @mutation(typeName: UPDATE, table: "film_actor_note")
    updateFilmSceneParent(in: UpdateFilmSceneParentInput!): ID @mutation(typeName: UPDATE, table: "film_scene")
    updateFilmSceneParents(in: [UpdateFilmSceneParentInput!]!): [ID!]! @mutation(typeName: UPDATE, table: "film_scene")
}
