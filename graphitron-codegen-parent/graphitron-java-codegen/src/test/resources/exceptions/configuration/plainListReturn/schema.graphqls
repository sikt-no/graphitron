type Mutation {
  mutation(in: [CustomerInputTable]): Response @service(service: {name: "RESOLVER_MUTATION_SERVICE", method: "mutationPlain"})
}

type Response {
  customers: [CustomerTable]
  errors: [BatchError]
}

type BatchError implements Error @error(handlers: [{handler: GENERIC, className: "java.lang.IllegalStateException"}]) {
  path: [String!]!
  message: String!
}
