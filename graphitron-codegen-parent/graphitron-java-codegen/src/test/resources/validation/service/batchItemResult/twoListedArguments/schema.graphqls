type Mutation {
  mutation(in0: [CustomerInputTable], in1: [CustomerInputTable]): Response @service(service: {name: "RESOLVER_MUTATION_SERVICE", method: "mutationBatch"})
}

type Response {
  customers: [CustomerTable]
  errors: [BatchError]
}

type BatchError implements Error {
  path: [String!]!
  message: String!
}
