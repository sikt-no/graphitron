type Query {
    query: Payload @service(service: {className: "MapperFetchService", method: "cityQuery"})
}

type Payload {
    cities: [City]
}

type City @table {
    wrapper: CityWrapper
}

type CityWrapper {
    city: String
    addresses: [Address] @splitQuery
}

type Address @table {
    id: ID
}
