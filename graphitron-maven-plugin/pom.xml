<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <url>https://github.com/sikt-no/graphitron</url>

    <prerequisites>
        <maven>3.9</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-lsp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          The two test-jars carrying the shared fact-store harness: the store's own lifetime and
          the writer level from the model, and the capture level from the generator, which is where
          a store filled by a build still comes from. Test scope, so nothing the plugin ships can
          reach a fixture; what they buy is that a test here takes its store from the harness that
          owns its subject rather than standing one up of its own.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!--
            The two clients' test-jars. This module is where both tiers meet, DevMojo being what
            wires the generator to a language server and an MCP server, so it is where a test whose
            subject is the two agreeing belongs. Those tests carry their clients' own fixture
            vocabulary rather than a second copy of it, which is what these two scopes buy; neither
            adds a module dependency, both being second scopes on edges declared above.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-lsp</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-mcp</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!--
            The generated jOOQ catalog the relocated cross-tier tests capture against, so a @table
            binding and a column match resolve the way they do in a consumer's own build. Test scope
            only; a consumer brings their own generated model.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-sakila-db</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- DevServerTest loads the graphitron-lsp jar, which calls the restricted
                         FFM method SymbolLookup.libraryLookup (via BundledLibraryLookup) to load
                         tree-sitter. Declare native access here too, matching graphitron-lsp's own
                         surefire argLine, so this module's test JVM does not emit the runtime
                         "restricted method ... has been called" warning. @{argLine} leads so the
                         JaCoCo agent flags from -Pcoverage survive this override. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                    <!-- DevMojo is the one goal whose store home is the per-user cache, and its
                         resolver consults this property the way Maven would inject the parameter.
                         Without the pin, a test constructing a DevMojo writes the developer's or CI
                         runner's actual cache and orphans one workspace segment per @TempDir run.
                         The three build goals put their store under the module's build directory
                         and ignore this, so it is a dev-tier pin rather than a blanket one;
                         DevMojoTest clears it for the two cases whose subject is the cache branch
                         itself. -->
                    <systemPropertyVariables>
                        <graphitron.store.directory>${project.build.directory}/test-store</graphitron.store.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <!-- Groovy 4 uses ASM 9.7+ which supports Java 25 class files (major version 69). -->
                    <!-- Without this override, the bundled Groovy 3.x fails on Java 25 JVMs. -->
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>4.0.31</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <postBuildHookScript>verify.groovy</postBuildHookScript>
                    <showErrors>true</showErrors>
                    <!--
                      No store pin here, and that is the assertion rather than an omission. Every IT
                      runs generate or capture, whose store is the module's own build output under
                      the clone's target/, so the tree is hermetic because of where the goal puts
                      its store rather than because this pom told it somewhere else, and
                      capture-only's verify.groovy checks exactly that. A pin would take that claim
                      back and test the pom instead of the goal.

                      What it costs: these ITs used to share one home under three artifactIds, which
                      exercised the multi-graph store for free. One store per module is one graph per
                      store, so that exercise is gone from this tier. The population it covered is
                      covered deliberately in graphitron-model, by
                      WarmStartRefreshTest.aSiblingGraphsPartitionSurvivesARefresh, which is where a
                      claim about sibling partitions belongs anyway.
                    -->
                    <extraArtifacts>
                        <extraArtifact>no.sikt:graphitron-sakila-db:${project.version}</extraArtifact>
                    </extraArtifacts>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>graphitron</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>mojo-descriptor</id>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>help-mojo</id>
                        <goals>
                            <goal>helpmojo</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
