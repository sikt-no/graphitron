<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <url>https://github.com/sikt-no/graphitron</url>

    <prerequisites>
        <maven>3.9</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-lsp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- DevServerTest loads the graphitron-lsp jar, which calls the restricted
                         FFM method SymbolLookup.libraryLookup (via BundledLibraryLookup) to load
                         tree-sitter. Declare native access here too, matching graphitron-lsp's own
                         surefire argLine, so this module's test JVM does not emit the runtime
                         "restricted method ... has been called" warning. @{argLine} leads so the
                         JaCoCo agent flags from -Pcoverage survive this override. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                    <!-- The mojo tests construct and execute real mojos, so without a pinned home
                         resolveStoreDirectory would write the developer's or CI runner's actual
                         user cache and orphan one workspace segment per @TempDir run. Same
                         hermeticity move as the invoker <properties> below. -->
                    <systemPropertyVariables>
                        <graphitron.store.directory>${project.build.directory}/test-store</graphitron.store.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.10.1</version>
                <dependencies>
                    <!-- Groovy 4 uses ASM 9.7+ which supports Java 25 class files (major version 69). -->
                    <!-- Without this override, the bundled Groovy 3.x fails on Java 25 JVMs. -->
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>4.0.31</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <postBuildHookScript>verify.groovy</postBuildHookScript>
                    <showErrors>true</showErrors>
                    <!--
                      The ITs are real consumer builds, so left alone they would resolve the fact
                      store's default home and write into the developer's or CI runner's actual
                      user cache; worse, their basedir is a fresh clone under target/it on every
                      build, so each run would orphan the previous workspace segment. Pinning the
                      home under this module's build directory keeps the tree hermetic and lets
                      mvn clean remove it; the three ITs then share one store under three distinct
                      artifactIds, which is a free extra exercise of the multi-graph store.
                    -->
                    <properties>
                        <graphitron.store.directory>${project.build.directory}/it-store</graphitron.store.directory>
                    </properties>
                    <extraArtifacts>
                        <extraArtifact>no.sikt:graphitron-sakila-db:${project.version}</extraArtifact>
                    </extraArtifacts>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>graphitron</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>mojo-descriptor</id>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>help-mojo</id>
                        <goals>
                            <goal>helpmojo</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
