<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>

    <artifactId>graphitron-lsp</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>

    <properties>
        <version.lsp4j>0.24.0</version.lsp4j>
        <version.jtreesitter>0.26.0</version.jtreesitter>
    </properties>

    <dependencies>
        <!--
          The fact store's generated query surface and its read vocabulary. Declared rather than
          inherited through graphitron, because the direction of travel is that the store is what
          this module reads and the graphitron dependency below is what it sheds, one type at a
          time; a transitive edge would leave the pom claiming the opposite.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          The fact-store harness, at test scope: the store's own lifetime, the writer level, and the
          capture level that stands a store up by running real capture rather than by inserting rows.
          A second scope on an edge this module already declares, so it adds no module dependency.

          There is deliberately no graphitron dependency here, at any scope. The language server
          parses the buffer under the cursor with tree-sitter and reads everything else out of the
          fact store, so nothing it ships needs the generator, and nothing it tests does either: the
          tests that did want a build were about the build and the editor agreeing, and they moved
          above both tiers into graphitron-maven-plugin.
        -->
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>${version.lsp4j}</version>
        </dependency>

        <dependency>
            <groupId>io.github.tree-sitter</groupId>
            <artifactId>jtreesitter</artifactId>
            <version>${version.jtreesitter}</version>
        </dependency>

        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-tree-sitter-natives</artifactId>
            <version>0.26.9-1</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.sikt</groupId>
            <artifactId>graphitron-sakila-db</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            jOOQ's org.jooq.conf.Settings is JAXB-annotated and jOOQ declares
            jakarta.xml.bind-api as <optional>, so it is not on the classpath transitively.
            DeclarationHoverStatementCountTest derives a Configuration to attach a statement
            counter, which reaches Settings; without the API javac cannot resolve those
            annotation methods and the warnings it emits are rejected by -Werror. Test scope
            only, the same fix graphitron carries for its emitted-code harness.
        -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Republish the compiled tests as a test-jar. What the plugin's test scope wants from
                it is the fixture level this module owns: the captured-store fixture its own tests
                read, and the support the relocated cross-tier tests still need. Those tests are
                about this module and the generator agreeing, so they live above both; keeping their
                fixtures here is what lets them go on being this module's own vocabulary rather than
                a second copy that drifts.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      jtreesitter calls SymbolLookup.libraryLookup, a restricted FFM API.
                      Without this flag JDK 25 only warns, but a future release will block
                      the call; declare the access up-front. @{argLine} leads so the JaCoCo
                      agent flags from -Pcoverage survive this override.
                    -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
