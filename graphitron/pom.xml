<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>no.sikt</groupId>
        <artifactId>graphitron-rewrite-parent</artifactId>
        <version>10-SNAPSHOT</version>
    </parent>
    <artifactId>graphitron</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <url>https://github.com/sikt-no/graphitron</url>

    <properties>
        <generated.test.schemas>${project.build.directory}/generated-test-sources/graphitron</generated.test.schemas>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>graphitron-javapoet</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The fact store: its jOOQ compile-time surface is what the capture package writes
            through, and its bootstrap is what opens the per-run database. The module builds
            first, so editing the fact-schema DDL fails javac here for every relation a consumer
            touched.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The model's test-jar: the store harness a test here builds on rather than opening a
            store of its own. Test scope on an artifact this module already depends on at compile
            scope, so it adds a second scope on an existing edge and no new module dependency.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>graphitron-model</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apollographql.federation</groupId>
            <artifactId>federation-graphql-java-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- SchemaRecipe's one glob dialect; version pinned in the root pom's properties. -->
        <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>graphitron-sakila-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Phase 3 of R101: graphql-java-extended-scalars is the canonical convention-layer
             artifact. Carried at test scope so ScalarTypeResolverTest, the convention-table
             drift test, and pipeline tests can exercise the resolver against real constants;
             the runtime artifact is the consumer's choice and graphitron stays out of it. -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java-extended-scalars</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- R410 slice 5: the incremental-compile acceptance harness (IncrementalCompileHarnessTest)
             compiles the generated runtime, which references jakarta.validation (GraphitronContext /
             ConstraintViolations); the API is a consumer runtime choice, carried here at test scope
             only so the harness can compile that generated code. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            jOOQ's org.jooq.conf.Settings is a JAXB-generated class annotated with
            @XmlElement / @XmlAccessorType, and jOOQ declares jakarta.xml.bind-api as
            <optional>, so it is not on the classpath transitively. The emitted-code
            harness tests drive the generated session-hook and runtime classes with real
            Settings instances; without the API javac cannot resolve those annotation
            methods and floods the test compile with "Cannot find annotation method
            'defaultValue()'" warnings, which -Werror rejects. Test scope only; the same
            fix graphitron-sakila-example carries at provided scope for its generated
            sources.
        -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.2</version>
            <scope>test</scope>
        </dependency>
        <!-- The tests of generated code run it against a real PostgreSQL: the database
             -Dtest.db.url names, else one Testcontainers starts per test JVM, seeded from the
             sakila init.sql graphitron-sakila-service brings in. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${version.testcontainers.postgresql}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${version.testcontainers.postgresql}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${version.postgresql}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers' shaded Guava keeps the annotations' original names, so javac reading
             its classes looks for com.google.common.annotations and error-prone's annotation types
             and, finding neither, warns, which -Werror rejects. Guava brings both. Test scope only;
             graphitron-sakila-example has them through Quarkus. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.5.0-jre</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.google.j2objc</groupId>
                    <artifactId>j2objc-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <parameters>true</parameters>
                </configuration>
                <executions>
                    <!-- The test tree compiles with -parameters (services / conditions resolve
                         arg names by reflection). The codereferences.noparams package is the one
                         exception: R201 needs a name-less POJO to pin the ctor-arm reject when a
                         @field(name:) targets a class compiled without -parameters. Exclude that
                         package from the default -parameters test compile and compile it in a
                         dedicated pass with -parameters off. The package is self-contained, so no
                         other test class references it at compile time. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <testExcludes>
                                <testExclude>no/sikt/graphitron/codereferences/noparams/**</testExclude>
                            </testExcludes>
                        </configuration>
                    </execution>
                    <!-- The launcher that generates the test schemas, compiled ahead of the rest of
                         the test sources: it runs in generate-test-sources, before they compile.
                         Test code because it opens a store, which the generator never does. -->
                    <execution>
                        <id>test-compile-schema-launcher</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <testIncludes>
                                <testInclude>no/sikt/graphitron/rewrite/test/generate/**</testInclude>
                            </testIncludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile-noparams</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <parameters>false</parameters>
                            <testIncludes>
                                <testInclude>no/sikt/graphitron/codereferences/noparams/**</testInclude>
                            </testIncludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Republish compiled tests as a test-jar so other modules
                 (graphitron-sakila-example) can consume the tier-annotation
                 vocabulary (@UnitTier / @PipelineTier / @CompilationTier /
                 @ExecutionTier) without putting it on this module's main
                 classpath. The annotations live under
                 src/test/java/no/sikt/graphitron/rewrite/test/tier/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!-- junit-platform.properties configures this module's own test runs
                                 (autodetection of ClassificationTraceContextExtension). It must not
                                 ride along in the test-jar: consumers (graphitron-sakila-example)
                                 that only want the tier-annotation vocabulary would otherwise get a
                                 second junit-platform.properties on their classpath, producing the
                                 "Discovered 2 'junit-platform.properties'" launcher warning on every
                                 surefire run. The extension itself is graphitron-internal and no
                                 consumer relies on it being auto-registered. -->
                            <excludes>
                                <exclude>junit-platform.properties</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The generated code under test: each fact scenario, graphitron-model's
                 facts/scenarios, generated into its own package before the test sources compile, by
                 GenerateTestSchemas, compiled just above, without the Maven plugin and so without the
                 language server or the MCP server. Forked on the test classpath, so the services and
                 the jOOQ catalog the scenarios name load as they do when the generated code compiles
                 and runs. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-test-schemas</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>no.sikt.graphitron.rewrite.test.generate.GenerateTestSchemas</argument>
                                <argument>${generated.test.schemas}</argument>
                                <argument>no.sikt.graphitron.rewrite.test.jooq</argument>
                                <argument>${project.basedir}/../graphitron-model/src/test/resources/facts</argument>
                                <argument>no.sikt.graphitron.generated.facts</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-generated-test-schemas</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${generated.test.schemas}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The tests of generated code connect to a pre-existing PostgreSQL instead of
             Testcontainers, as graphitron-sakila-example's execution tests do under the same
             profile. The caller runs the sakila init.sql against it beforehand; the tests never
             reset it, so one kept between runs serves as well. -->
        <profile>
            <id>local-db</id>
            <properties>
                <test.db.url>jdbc:postgresql://localhost:5432/rewrite_test</test.db.url>
                <test.db.username>postgres</test.db.username>
                <test.db.password>postgres</test.db.password>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <test.db.url>${test.db.url}</test.db.url>
                                <test.db.username>${test.db.username}</test.db.username>
                                <test.db.password>${test.db.password}</test.db.password>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
