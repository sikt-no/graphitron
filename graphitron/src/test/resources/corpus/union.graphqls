type Film @table(name: "film") { title: String }
type Actor @table(name: "actor") { firstName: String @field(name: "FIRST_NAME") }
union FilmOrActor @classifiedType(as: UnionType) = Film | Actor
type FilmActor @table(name: "film_actor") {
  related: FilmOrActor @classified(source: OnlyChild, operations: [Select], target: Single, targetShape: Union)
  "The batched half of the union child; the film_actor foreign-key columns sit inside its primary key, which is what makes the parent-holds-FK side list-valued."
  relatedList: [FilmOrActor!]! @classified(source: OnlyChild, operations: [Select], target: List, targetShape: Union)
}
extend type Query {
  filmActor: FilmActor @commits(source: AnchorTable, result: SingleRecord)
  "The union root, same Select verdict as the child."
  search: FilmOrActor @classified(source: Query, operations: [Select], target: Single, targetShape: Union)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  Actor,        firstName,  TABLE_COLUMN, INFERRED
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Film,         title,      TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  Actor,        actor
  CorpusAnchor, category
  Film,         film
  FilmActor,    film_actor
  """)

{ filmActor { related { ... on Film { title } ... on Actor { firstName } } } }
