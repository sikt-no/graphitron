type Film implements Node @table(name: "film") @node { id: ID! @nodeId title: String }
extend type Query {
  "Relay's own entry point: one global id at a time."
  node(id: ID!): Node @classified(source: Query, operations: [NodeResolve], target: Single, targetShape: Interface)
  "The list form of the same signature."
  nodes(ids: [ID!]!): [Node] @classified(source: Query, operations: [NodeResolve], target: List, targetShape: Interface)
  "Not named `node`, and classified as one anyway: the signature is the trigger."
  internalFilmNode(id: ID): Node @classified(source: Query, operations: [NodeResolve], target: Single, targetShape: Interface)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Film,         id,         NODE_ID,      AUTHORED
  Film,         title,      TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name, classifier, trigger, decoded
  Film,      id,         NODE_ID,    nodeId,  TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  """)

{
  node(id: "1") {
    id
    ... on Film { title }
  }
  nodes(ids: ["1", "2"]) {
    id
  }
  internalFilmNode(id: "1") {
    id
  }
}
