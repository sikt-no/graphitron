type Film @table(name: "film") {
  "Child, and the reason is the edges and nodes lists rather than the connection field, which is single."
  title: String @classified(source: Child, operations: [Select], target: Single, targetShape: Column)
}
"The wrapper that transmits the arrival: its list edges are what make the element Many."
type FilmsConnection {
  edges: [FilmsEdge!]! nodes: [Film!]! pageInfo: PageInfo!
}
type FilmsEdge { cursor: String! node: Film! }
type PageInfo {
  hasNextPage: Boolean! hasPreviousPage: Boolean! startCursor: String endCursor: String
}
extend type Query { films: FilmsConnection @commits(source: AnchorTable, result: Connection) }
