type FilmDetails { title: String }
extend type Query {
  "A root @service into a record-backed type: the call produces the record, which is materialized rather than projected from the catalog. The root analog of a scalar service child, with the producer's reflected return type binding the payload."
  filmDetails: FilmDetails
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "getDetails"})
    @classified(source: Query, operations: [ServiceCall], target: Single, targetShape: Record)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,  classifier,   tier
  CorpusAnchor, name,        TABLE_COLUMN, INFERRED
  Query,        filmDetails, SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,  classifier, trigger, decoded
  Query,     filmDetails, SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  """)
