interface Content @table(name: "content") @discriminate(on: "CONTENT_TYPE") @classifiedType(as: TableInterfaceType) {
  contentId: Int! @field(name: "CONTENT_ID")
  title: String! @field(name: "TITLE")
}
type FilmContent implements Content @table(name: "content") @discriminator(value: "FILM") {
  contentId: Int! @field(name: "CONTENT_ID")
  title: String! @field(name: "TITLE")
}
type ShortContent implements Content @table(name: "content") @discriminator(value: "SHORT") {
  contentId: Int! @field(name: "CONTENT_ID")
  title: String! @field(name: "TITLE")
}
input ContentInput {
  title: String! @field(name: "TITLE")
  contentType: String! @field(name: "CONTENT_TYPE")
}
extend type Query { content: Content @commits(source: DiscriminatedTable, result: SingleRecord) }
type Mutation {
  "An INSERT returning a single-table discriminated interface: the write lands the shared base table, then the follow-up read is the participant-driven discriminated composition restricted to the keys RETURNING captured. The verdict is the plain projected INSERT's; only the launcher row differs, because the return expression is what decides the source arm."
  createContent(in: ContentInput!): Content
    @mutation(typeName: INSERT, table: "content")
    @classified(source: Mutation, operations: [Insert, Reentry], target: Single, targetShape: Table)
    @commits(source: DiscriminatedReentry, result: SingleRecord)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,    classifier,   tier
  Content,      contentId,     TABLE_COLUMN, INFERRED
  Content,      title,         TABLE_COLUMN, INFERRED
  CorpusAnchor, name,          TABLE_COLUMN, INFERRED
  FilmContent,  contentId,     TABLE_COLUMN, INFERRED
  FilmContent,  title,         TABLE_COLUMN, INFERRED
  Mutation,     createContent, MUTATION,     AUTHORED
  ShortContent, contentId,     TABLE_COLUMN, INFERRED
  ShortContent, title,         TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,    classifier, trigger,  decoded
  Mutation,  createContent, MUTATION,   mutation, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  Content,      content
  CorpusAnchor, category
  FilmContent,  content
  ShortContent, content
  """)
