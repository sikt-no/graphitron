type Film @table(name: "film") { title: String }
input FilmFilter {
    title: [String!] @field(name: "title") @asFacet
}
extend type Query {
    "A paginated read whose filter input also yields facet counts."
    films(filter: FilmFilter): [Film!]! @asConnection @defaultOrder(primaryKey: true)
        @classified(source: Query, operations: [OnReturnTable, OrderBy, Paginate, Select], target: Single, targetShape: Connection)

        @synthesises(mints: [
            {name: "QueryFilmsConnection", as: ConnectionType},
            {name: "QueryFilmsEdge", as: EdgeType},
            {name: "QueryFilmsConnectionFacets", as: FacetsType},
            {name: "StringFacetValue", as: FacetValueType},
            {name: "PageInfo", as: PageInfoType}])
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Film,         title,      TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  Query,     films,        AnchorTable, Connection
  """)

{
  films(filter: {title: ["A"]}) {
    edges { node { title } }
  }
}
