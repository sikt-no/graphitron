"The @error contract restricts the field set to exactly path and message, and both resolve off the developer-supplied error class through graphql-java's default property read."
type MyError @error(handlers: [{handler: GENERIC, className: "java.lang.IllegalArgumentException"}]) {
  "The list-shaped half of the contract: the leaf carries the field's own return wrapper, so target follows the SDL list."
  path: [String!]! @classified(source: OnlyChild, operations: [], target: List, targetShape: Field, sourceShape: Record)
  message: String! @classified(source: OnlyChild, operations: [], target: Single, targetShape: Field, sourceShape: Record)
}
extend type Query { err: MyError }

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  """)
