type Language @table(name: "language") { name: String }

type FilmDetails {
  "A terminal record read: the property comes off the record the producer handed back, so there is no operation at all."
  title: String @classified(source: Child, operations: [], target: Single, targetShape: Field, sourceShape: Record)
}

type Film @table(name: "film") {
  details: FilmDetails
  "A scalar a service produces. A child @service resolves through a DataLoader, so the developer method takes the batch keys and returns them keyed, and a per-parent call has no emission."
  rating: String
    @service(service: {className: "no.sikt.graphitron.rewrite.generators.TestFilmService", method: "getRatingMapped"})
    @classified(source: Child, operations: [ServiceCall], target: Single, targetShape: Record)

  "A service re-query into a @table: what the method hands back becomes catalog rows again, which is the Reentry member beside the call."
  language: Language
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "getLanguageByKey"})
    @classified(source: Child, operations: [Reentry, ServiceCall], target: Single, targetShape: Table)

}

extend type Query {
  film: Film
  prodFilmDetails: FilmDetails
    @service(service: {className: "no.sikt.graphitron.codereferences.dummyreferences.DummyService", method: "makeDetailsProps"})
  "The root spelling of the same re-query: a service produces the rows and the coordinate projects them from the catalog."
  externalFilm: Film
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "getFilm"})
    @classified(source: Query, operations: [Reentry, ServiceCall], target: Single, targetShape: Table)

}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,      classifier,   tier
  CorpusAnchor, name,            TABLE_COLUMN, INFERRED
  Film,         language,        SERVICE,      AUTHORED
  Film,         rating,          SERVICE,      AUTHORED
  Language,     name,            TABLE_COLUMN, INFERRED
  Query,        externalFilm,    SERVICE,      AUTHORED
  Query,        prodFilmDetails, SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,      classifier, trigger, decoded
  Film,      language,        SERVICE,    service, TRUE
  Film,      rating,          SERVICE,    service, TRUE
  Query,     externalFilm,    SERVICE,    service, TRUE
  Query,     prodFilmDetails, SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  Language,     language
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,           result
  Film,      language,     ServiceTableLift, LoaderDelegated
  Film,      rating,       ServiceCall,      LoaderDelegated
  Query,     corpusAnchor, AnchorTable,      SingleRecord
  Query,     externalFilm, ProjectedReentry, SingleRecord
  Query,     film,         AnchorTable,      SingleRecord
  """)
