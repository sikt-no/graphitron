type Film implements Node @node @table(name: "film") { id: ID! @nodeId  title: String }
type FilmErr @error(handlers: [{handler: GENERIC, className: "java.lang.IllegalArgumentException"}]) {
  path: [String!]!
  message: String!
}
union DeleteFilmsError = FilmErr
type FilmIdsPayload {
  "The @service id carrier: node ids encoded straight off the producer's in-memory records, with no re-fetch. The @nodeId(typeName:) grounds the encode on Film's @table."
  filmIds: [ID] @nodeId(typeName: "Film") @classified(source: OnlyChild, operations: [], target: List, targetShape: Column, sourceShape: Record)
  "The payload's error channel."
  errors: [DeleteFilmsError]
}
type Mutation {
  deleteFilms: FilmIdsPayload
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "getFilmsAsList"})
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,      field_name,  classifier,   tier
  CorpusAnchor,   name,        TABLE_COLUMN, INFERRED
  Film,           id,          NODE_ID,      AUTHORED
  Film,           title,       TABLE_COLUMN, INFERRED
  FilmIdsPayload, filmIds,     NODE_ID,      AUTHORED
  Mutation,       deleteFilms, SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name,      field_name,  classifier, trigger, decoded
  Film,           id,          NODE_ID,    nodeId,  TRUE
  FilmIdsPayload, filmIds,     NODE_ID,    nodeId,  TRUE
  Mutation,       deleteFilms, SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)
