type Language @table(name: "language") {
  name: String
  "A scalar a service produces; no SQL of its own."
  rank: Int @service(
    service: {className: "no.sikt.graphitron.rewrite.generators.TestFilmService", method: "getRankMapped"})
    @classified(source: OnlyChild, operations: [ServiceCall], target: Single, targetShape: Record)
    @commits(source: ServiceCall, result: LoaderDelegated)
}
extend type Query { language: Language @commits(source: AnchorTable, result: SingleRecord) }

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Language,     name,       TABLE_COLUMN, INFERRED
  Language,     rank,       SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name, classifier, trigger, decoded
  Language,  rank,       SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Language,     language
  """)

{
  language {
    name
    rank
  }
}
