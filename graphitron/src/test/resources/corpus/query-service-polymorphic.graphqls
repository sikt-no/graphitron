interface Searchable @classifiedType(as: InterfaceType) { name: String }
type Film implements Searchable @table(name: "film") { name: String @field(name: "TITLE") }
type Actor implements Searchable @table(name: "actor") { name: String @field(name: "FIRST_NAME") }
extend type Query {
  "A root @service returning a multi-table interface: the method hands back a key-populated table record per branch and the fetcher dispatches on its runtime class, which needs the participants to sit in distinct tables. A @service returning a union is rejected at classify."
  searchService: Searchable
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "getFilm"})
    @classified(source: Query, operations: [ServiceCall], target: Single, targetShape: Interface)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,    classifier,   tier
  Actor,        name,          TABLE_COLUMN, INFERRED
  CorpusAnchor, name,          TABLE_COLUMN, INFERRED
  Film,         name,          TABLE_COLUMN, INFERRED
  Query,        searchService, SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,    classifier, trigger, decoded
  Query,     searchService, SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  Actor,        actor
  CorpusAnchor, category
  Film,         film
  """)
