type FilmStats {
  count: Int @classified(source: Child, operations: [], target: Single, targetShape: Field, sourceShape: Record)
}

type FilmDetails {
  stats: FilmStats @classified(source: Child, operations: [], target: Single, targetShape: Field, sourceShape: Record)
}

type Film @table(name: "film") {
  title: String @classified(source: OnlyChild, operations: [Select], target: Single, targetShape: Column)
  details: FilmDetails
}

extend type Query {
  film: Film @commits(source: AnchorTable, result: SingleRecord)
  "What binds FilmDetails to a record: a type acquires its backing class by reflection on the @service producer's return type, never from a directive."
  prodFilmDetails: FilmDetails
    @service(service: {className: "no.sikt.graphitron.codereferences.dummyreferences.DummyService", method: "makeFilmDetailsRecord"})
  "The same binding one level down, which is what makes FilmStats.count a property read rather than a column."
  prodFilmStats: FilmStats
    @service(service: {className: "no.sikt.graphitron.codereferences.dummyreferences.DummyService", method: "makeFilmStatsRecord"})
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,      classifier,   tier
  CorpusAnchor, name,            TABLE_COLUMN, INFERRED
  Film,         title,           TABLE_COLUMN, INFERRED
  Query,        prodFilmDetails, SERVICE,      AUTHORED
  Query,        prodFilmStats,   SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,      classifier, trigger, decoded
  Query,     prodFilmDetails, SERVICE,    service, TRUE
  Query,     prodFilmStats,   SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

{ film { title details { stats { count } } } }
