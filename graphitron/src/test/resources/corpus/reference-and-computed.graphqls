type Film @table(name: "film") {
  "Reached over a named foreign key."
  languageName: String @field(name: "name") @reference(path: [{key: "film_language_id_fkey"}])
    @classified(source: OnlyChild, operations: [Join, Select], target: Single, targetShape: Column)
  "Computed in Java, not read from a column."
  computedRating: String
    @externalField(reference: {className: "no.sikt.graphitron.rewrite.TestExternalFieldStub", method: "rating"})
    @classified(source: OnlyChild, operations: [Select], target: Single, targetShape: Column)
}
extend type Query { film: Film }

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,     classifier,     tier
  CorpusAnchor, name,           TABLE_COLUMN,   INFERRED
  Film,         computedRating, EXTERNAL_FIELD, AUTHORED
  Film,         languageName,   TABLE_COLUMN,   INFERRED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,     classifier,     trigger,       decoded
  Film,      computedRating, EXTERNAL_FIELD, externalField, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  Query,     film,         AnchorTable, SingleRecord
  """)

{
  film {
    languageName
    computedRating
  }
}
