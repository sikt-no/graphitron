interface Named @classifiedType(as: InterfaceType) { name: String }
type Address implements Named @table(name: "address") { name: String @field(name: "ADDRESS") }
type Customer @table(name: "customer") {
  address: Named @classified(source: OnlyChild, operations: [Select], target: Single, targetShape: Interface)
}
type City @table(name: "city") {
  "The batched half of the same verdict: at list cardinality with a table-bound participant the child goes through a DataLoader, which is delivery rather than a tuple axis. Here the child holds the foreign key, address.city_id pointing at the parent."
  namedPlaces: [Named!]! @classified(source: OnlyChild, operations: [Select], target: List, targetShape: Interface)
}
extend type Query {
  customer: Customer
  city: City
  "The polymorphic root, same verdict as the child: the projection lands on the participants' own table rows."
  anyNamed: Named @classified(source: Query, operations: [Select], target: Single, targetShape: Interface)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  Address,      name,       TABLE_COLUMN, INFERRED
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  Address,      address
  City,         city
  CorpusAnchor, category
  Customer,     customer
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     city,         AnchorTable, SingleRecord
  Query,     corpusAnchor, AnchorTable, SingleRecord
  Query,     customer,     AnchorTable, SingleRecord
  """)

{ customer { address { name } } }
