type Film @table(name: "film") { title: String }
type FilmInsertBulkPayload { films: [Film!] @commits(source: CorrelatedChain, result: SingleRecord) }
type FilmUpdatePayload {
  "The data field owns the read-back, a new keyed query off the written record's keys."
  film: Film
    @classified(source: OnlyChild, operations: [Reentry, Select], target: Single, targetShape: Table, sourceShape: Record)
    @commits(source: CorrelatedChain, result: SingleRecord)
}
type FilmUpdateBulkPayload { films: [Film!] @commits(source: CorrelatedChain, result: SingleRecord) }
input FilmCreateInput { title: String }
input FilmUpdateInput { filmId: Int! @field(name: "film_id") title: String }
type Mutation {
  "The bulk INSERT carrier: the same claim as the single UPDATE carrier with a list-shaped data field, on distinct payload types so the per-kind carrier scans stay isolated."
  createFilmsPayload(in: [FilmCreateInput!]!): FilmInsertBulkPayload
    @mutation(typeName: INSERT)
    @classified(source: Mutation, operations: [Insert], target: Single, targetShape: Record)
  updateFilmPayload(in: FilmUpdateInput!): FilmUpdatePayload
    @mutation(typeName: UPDATE)
    @classified(source: Mutation, operations: [Update], target: Single, targetShape: Record)
  "The bulk UPDATE carrier, the list sibling of the payload above."
  updateFilmsPayload(in: [FilmUpdateInput!]!): FilmUpdateBulkPayload
    @mutation(typeName: UPDATE)
    @classified(source: Mutation, operations: [Update], target: Single, targetShape: Record)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,         classifier,   tier
  CorpusAnchor, name,               TABLE_COLUMN, INFERRED
  Film,         title,              TABLE_COLUMN, INFERRED
  Mutation,     createFilmsPayload, MUTATION,     AUTHORED
  Mutation,     updateFilmPayload,  MUTATION,     AUTHORED
  Mutation,     updateFilmsPayload, MUTATION,     AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name,         classifier, trigger,  decoded
  Mutation,  createFilmsPayload, MUTATION,   mutation, TRUE
  Mutation,  updateFilmPayload,  MUTATION,   mutation, TRUE
  Mutation,  updateFilmsPayload, MUTATION,   mutation, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

mutation {
  updateFilmPayload {
    film { title }
  }
}
