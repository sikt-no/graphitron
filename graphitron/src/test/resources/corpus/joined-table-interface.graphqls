interface Party @table(name: "party") @discriminate(on: "party_kind") @classifiedType(as: TableInterfaceType) {
  partyId: Int! @field(name: "party_id")
  displayName: String! @field(name: "display_name")
}
type Individual implements Party @table(name: "party_individual") @discriminator(value: "INDIVIDUAL") {
  partyId: Int! @field(name: "party_id")
  displayName: String! @reference(path: [{key: "party_individual_party_id_fkey"}]) @field(name: "display_name")
  birthDate: String @field(name: "birth_date")
}
type Company implements Party @table(name: "party_company") @discriminator(value: "COMPANY") {
  partyId: Int! @field(name: "party_id")
  displayName: String! @reference(path: [{key: "party_company_party_id_fkey"}]) @field(name: "display_name")
  orgNumber: String @field(name: "org_number")
}
extend type Query {
  "A discriminated interface root over participants in tables of their own: each participant reaches the shared display_name over its own foreign key back to party."
  allParties: [Party!]! @classified(source: Query, operations: [OrderBy, Select], target: List, targetShape: Table)

}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name,  classifier,   tier
  Company,      displayName, TABLE_COLUMN, INFERRED
  Company,      orgNumber,   TABLE_COLUMN, INFERRED
  Company,      partyId,     TABLE_COLUMN, INFERRED
  CorpusAnchor, name,        TABLE_COLUMN, INFERRED
  Individual,   birthDate,   TABLE_COLUMN, INFERRED
  Individual,   displayName, TABLE_COLUMN, INFERRED
  Individual,   partyId,     TABLE_COLUMN, INFERRED
  Party,        displayName, TABLE_COLUMN, INFERRED
  Party,        partyId,     TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  Company,      party_company
  CorpusAnchor, category
  Individual,   party_individual
  Party,        party
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,             result
  Query,     allParties,   DiscriminatedTable, RecordList
  Query,     corpusAnchor, AnchorTable,        SingleRecord
  """)
