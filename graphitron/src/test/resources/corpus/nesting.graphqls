type FilmDetails @classifiedType(as: NestingType) { title: String description: String }
type Film @table(name: "film") {
  "A grouping type with no table of its own."
  details: FilmDetails @classified(source: OnlyChild, operations: [], target: Single, targetShape: Table)
}
extend type Query { film: Film @commits(source: AnchorTable, result: SingleRecord) }

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)

{
  film {
    details {
      title
      description
    }
  }
}
