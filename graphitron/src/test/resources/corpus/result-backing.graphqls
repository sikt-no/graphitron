type PojoBacked @classifiedType(as: Backed) { id: ID }
type JavaRecordBacked @classifiedType(as: JavaRecordType) {
  name: String @classified(source: OnlyChild, operations: [], target: Single, targetShape: Field, sourceShape: Record)
}
type JooqTableRecordBacked @classifiedType(as: JooqTableRecordType) { title: String }
extend type Query {
  "A plain Java class: the field resolves against a readable accessor."
  pojo: PojoBacked
    @service(service: {className: "no.sikt.graphitron.codereferences.dummyreferences.DummyService", method: "makeDummyRecord"})
  "A Java record: the field resolves against a record component."
  javaRecord: JavaRecordBacked
    @service(service: {className: "no.sikt.graphitron.codereferences.dummyreferences.DummyService", method: "makeTestRecordDto"})
  "A jOOQ TableRecord: the field resolves against a column of the record's table."
  jooqRecord: JooqTableRecordBacked
    @service(service: {className: "no.sikt.graphitron.rewrite.TestServiceStub", method: "getFilm"})
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Query,        javaRecord, SERVICE,      AUTHORED
  Query,        jooqRecord, SERVICE,      AUTHORED
  Query,        pojo,       SERVICE,      AUTHORED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name, classifier, trigger, decoded
  Query,     javaRecord, SERVICE,    service, TRUE
  Query,     jooqRecord, SERVICE,    service, TRUE
  Query,     pojo,       SERVICE,    service, TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  """)

{
  pojo { id }
  javaRecord { name }
  jooqRecord { title }
}
