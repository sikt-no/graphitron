"@node seeds the arrival fold: node and entity lookups arrive batched, so this type is Many however few field edges reach it."
type Film implements Node @table(name: "film") @node(keyColumns: ["film_id"])
    @classifiedType(as: NodeType) {
  id: ID! @nodeId
  "Child under a single root, which is what the seed arm of the fold means: the absorbing Many wins."
  title: String @classified(source: Child, operations: [Select], target: Single, targetShape: Column)
}
extend type Query {
  film: Film @classified(source: Query, operations: [Select], target: Single, targetShape: Table)
    @commits(source: AnchorTable, result: SingleRecord)
}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Film,         id,         NODE_ID,      AUTHORED
  Film,         title,      TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_authored_field_claim", rows: """
  type_name, field_name, classifier, trigger, decoded
  Film,      id,         NODE_ID,    nodeId,  TRUE
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  """)
