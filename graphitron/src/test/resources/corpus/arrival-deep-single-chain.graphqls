"The terminus of a chain with no list wrapper and no fan-in anywhere above it."
type Language @table(name: "language") {
  "The terminal column, still One: nothing on the chain above it multiplies it."
  name: String @classified(source: OnlyChild, operations: [Select], target: Single, targetShape: Column)
}
type Film @table(name: "film") {
  "A single @reference edge, so arrival stays the One identity: the coordinate folds to OnlyChild."
  language: Language @reference(path: [{key: "film_language_id_fkey"}])
    @classified(source: OnlyChild, operations: [Join, Select], target: Single, targetShape: Table)
}
extend type Query {
  "A single root, so the whole subtree below it arrives once. This is the arrival fold's One corner."
  film: Film @classified(source: Query, operations: [Select], target: Single, targetShape: Table)

}

extend schema @expectEquals(relation: "intent_resolved_field_claim", rows: """
  type_name,    field_name, classifier,   tier
  CorpusAnchor, name,       TABLE_COLUMN, INFERRED
  Language,     name,       TABLE_COLUMN, INFERRED
  """)

extend schema @expectEquals(relation: "intent_bound_table", rows: """
  type_name,    table_name
  CorpusAnchor, category
  Film,         film
  Language,     language
  """)

extend schema @expectEquals(relation: "plan_launcher_command", rows: """
  type_name, field_name,   source,      result
  Query,     corpusAnchor, AnchorTable, SingleRecord
  Query,     film,         AnchorTable, SingleRecord
  """)
